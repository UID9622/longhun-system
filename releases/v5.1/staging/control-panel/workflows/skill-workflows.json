{
  "workflows": [
    {
      "id": "brand-kit",
      "name": "品牌套件流水线",
      "description": "品牌指南 → 主题工厂 → Web 工件构建器",
      "steps": [
        {"skill": "skill-2-brand-guidelines", "action": "render", "note": "生成品牌指南页面"},
        {"skill": "skill-9-theme-factory", "action": "run", "payload": {"base": "longhun-cyber", "name": "brand-kit"}, "note": "根据品牌生成主题"},
        {"skill": "skill-10-web-artifacts-builder", "action": "run", "payload": {"artifact_id": "brand-landing", "name": "Brand Landing", "type": "html", "code": "<h1>龍魂品牌着陆页</h1>"}, "note": "生成品牌着陆页"}
      ]
    },
    {
      "id": "art-to-brand",
      "name": "艺术到品牌",
      "description": "算法艺术 → 品牌指南",
      "steps": [
        {"skill": "skill-1-algorithmic-art", "action": "render", "note": "生成算法艺术"},
        {"skill": "skill-2-brand-guidelines", "action": "render", "note": "导出品牌规范"}
      ]
    },
    {
      "id": "doc-publish",
      "name": "文档发布流水线",
      "description": "文档协作 → Web 工件",
      "steps": [
        {"skill": "skill-4-doc-coauthoring", "action": "render", "note": "编辑 Markdown 文档"},
        {"skill": "skill-10-web-artifacts-builder", "action": "run", "payload": {"artifact_id": "doc-site", "name": "Doc Site", "type": "html", "code": "<article>龍魂文档</article>"}, "note": "生成文档站点"}
      ]
    },
    {
      "id": "comms-theme",
      "name": "通讯主题化",
      "description": "内部通讯 → 主题工厂",
      "steps": [
        {"skill": "skill-5-internal-comms", "action": "render", "note": "内部通讯面板"},
        {"skill": "skill-9-theme-factory", "action": "run", "payload": {"base": "longhun-cyber", "name": "comms"}, "note": "生成通讯主题"}
      ]
    },
    {
      "id": "mcp-skill",
      "name": "MCP + 技能框架",
      "description": "MCP 服务器构建 → 技能创建框架",
      "steps": [
        {"skill": "skill-6-mcp-builder", "action": "run", "payload": {"name": "longhun-mcp", "tools": [{"name": "echo", "description": "Echo tool", "parameters": {"msg": {"type": "string"}}}]}, "note": "构建 MCP 服务器"},
        {"skill": "skill-7-skill-creator", "action": "run", "payload": {"skill_id": "mcp-client", "name": "MCP Client", "category": "integration"}, "note": "创建配套技能"}
      ]
    },
    {
      "id": "shield-audit-chain",
      "name": "龍盾 → CNSH → 融合審計聯動",
      "description": "入口檢查 → 代碼底座對齊 → 系統十維審計",
      "steps": [
        {"foundation": "shield.check", "payload": {"file": "shield_test_example.py"}, "note": "龍盾入口風險檢查"},
        {"foundation": "cnsh.align", "payload": {"text": "def verify_dna():\n    return calculate_hash()", "context": "workflow"}, "note": "CNSH 對齊檢查"},
        {"foundation": "audit.integrated", "payload": {"mode": "system"}, "note": "十維融合審計"}
      ]
    },
    {
      "id": "full-governance",
      "name": "完整治理檢查",
      "description": "腳本管理 + 龍盾驗證 + 審計",
      "steps": [
        {"foundation": "cnsh.script-manager", "payload": {}, "note": "全腳本掃描"},
        {"foundation": "shield.validate", "payload": {"file": "shield_test_example.py"}, "note": "龍盾完整驗證"},
        {"foundation": "audit.integrated", "payload": {"mode": "system"}, "note": "系統審計"}
      ]
    },
    {
      "id": "instruction-demo",
      "name": "DNA 指令執行示範",
      "description": "執行 @shield.check 等 DNA 指令",
      "steps": [
        {"foundation": "instruction.execute", "payload": {"instruction": "@shield.check shield_test_example.py"}, "note": "解析並執行 DNA 指令"}
      ]
    }
  ]
}
