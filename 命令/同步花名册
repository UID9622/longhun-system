#!/usr/bin/env bash
# Notion 龍芯家族花名册 → 本机大脑（~/.longhun/roster/）
# DNA: #龍芯⚡️2026-05-16-同步花名册-v1.0
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
VENV_PY="${ROOT}/venv/bin/python"
ENGINE="${ROOT}/engine"

if [[ ! -x "$VENV_PY" ]]; then
  VENV_PY="python3"
fi

echo "════════════════════════════════════════"
echo "  🧬 同步花名册（Notion → 本机大脑）"
echo "════════════════════════════════════════"

cd "$ENGINE"
OUT="$("$VENV_PY" roster_notion_sync.py 2>&1)" || {
  echo "$OUT"
  exit 1
}

echo "$OUT" | "$VENV_PY" -c "
import sys, json
d = json.load(sys.stdin)
print(f\"  时间: {d.get('synced_at', '?')}\")
print(f\"  条数: {d.get('row_count', 0)} · 模块: {d.get('module_count', 0)}\")
u = d.get('urgent') or []
print(f\"  紧急: {len(u)} 条\")
if u:
    print('')
    print('  ══ 只看这些 ══')
    for x in u[:8]:
        print(f\"  {x.get('audit','?')} {x.get('title','?')} — {x.get('reason','')}\")
else:
    print('  🟢 无紧急项')
print('')
print('  镜像: ~/.longhun/roster/notion_mirror.json')
print('  通知: ~/.longhun/roster/urgent_latest.txt')
"

if [[ -f "${HOME}/.longhun/roster/urgent_latest.txt" ]]; then
  echo ""
  echo "── 通知摘要 ──"
  head -12 "${HOME}/.longhun/roster/urgent_latest.txt"
fi

echo ""
echo "✅ 同步完成。操作台刷新「花名册·路由」即可看到最新。"
