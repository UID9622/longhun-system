#!/usr/bin/env bash
# 操作台 MVP（8765 静态站 + 自动打开浏览器）
# DNA: #龍芯⚡️2026-05-15-开操作台-v1.0
set -euo pipefail

ROOT="${HOME}/longhun-system"
PORT=8765
URL="http://127.0.0.1:${PORT}/00_main_control/操作台v3/components/龍魂操作台_MVP_v1.html"
RUN_DIR="${ROOT}/.run"
LOG_DIR="${ROOT}/logs"
PID_FILE="${RUN_DIR}/mvp_http_${PORT}.pid"
mkdir -p "$RUN_DIR" "$LOG_DIR"

if lsof -nP -iTCP:"${PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "✅ 端口 ${PORT} 已在监听（操作台网页服务）"
else
  echo "📟 启动操作台静态服务 端口 ${PORT} …"
  cd "$ROOT"
  nohup python3 -m http.server "$PORT" >>"${LOG_DIR}/mvp8765.out.log" 2>&1 &
  echo $! >"$PID_FILE"
  sleep 0.5
fi

if lsof -nP -iTCP:"${PORT}" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "🌐 打开操作台 ${URL}"
  open "$URL"
else
  echo "❌ 8765 未起来·请看 ${LOG_DIR}/mvp8765.out.log"
  exit 1
fi
