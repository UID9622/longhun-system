#!/usr/bin/env bash
set -euo pipefail

_SCRIPT="${BASH_SOURCE[0]}"
while [[ -L "$_SCRIPT" ]]; do _SCRIPT="$(readlink "$_SCRIPT")"; done
ROOT_DIR="$(cd "$(dirname "$_SCRIPT")/.." && pwd)"
LOG_DIR="$ROOT_DIR/logs"
RUN_DIR="$ROOT_DIR/.run"
GATEWAY_SCRIPT="$ROOT_DIR/engines/AI网关_v0.1.py"
TUNNEL_SCRIPT="$ROOT_DIR/deploy/cloudflared/start_tunnel.sh"

GATEWAY_LOG="$LOG_DIR/ai_gateway.out.log"
TUNNEL_LOG="$LOG_DIR/cloudflared.out.log"
GATEWAY_PID_FILE="$RUN_DIR/ai_gateway.pid"
TUNNEL_PID_FILE="$RUN_DIR/cloudflared.pid"

mkdir -p "$LOG_DIR" "$RUN_DIR"

echo "═══ 龍魂一键启动 ═══"
echo "时间: $(date '+%Y-%m-%d %H:%M:%S %Z (%A)')"
echo

if lsof -nP -iTCP:9633 -sTCP:LISTEN >/dev/null 2>&1; then
  echo "🌐 9633 网关已在运行，跳过启动。"
else
  echo "🌐 启动 AI 网关 :9633 ..."
  nohup python3 "$GATEWAY_SCRIPT" >"$GATEWAY_LOG" 2>&1 &
  gateway_pid=$!
  echo "$gateway_pid" > "$GATEWAY_PID_FILE"
  sleep 1
  if lsof -nP -iTCP:9633 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "✅ 网关启动成功 (PID: $gateway_pid)"
  else
    echo "❌ 网关启动失败，查看日志: $GATEWAY_LOG"
    exit 1
  fi
fi

if pgrep -af "cloudflared tunnel --config $ROOT_DIR/deploy/cloudflared/config.yml run" >/dev/null 2>&1; then
  echo "☁️  Tunnel 已在运行，跳过启动。"
else
  echo "☁️ 启动 Cloudflare Tunnel ..."
  nohup bash "$TUNNEL_SCRIPT" >"$TUNNEL_LOG" 2>&1 &
  tunnel_pid=$!
  echo "$tunnel_pid" > "$TUNNEL_PID_FILE"
  sleep 2
  if pgrep -af "cloudflared tunnel --config $ROOT_DIR/deploy/cloudflared/config.yml run" >/dev/null 2>&1; then
    echo "✅ Tunnel 启动成功 (PID: $tunnel_pid)"
  else
    echo "🟡 Tunnel 未启动（本机 9625/操作台不受影响）"
    echo "   日志: $TUNNEL_LOG"
    echo "   只要本机用: bash ${ROOT_DIR}/bin/本机开机.sh"
  fi
fi

echo
echo "═══ 启动后自检 ═══"
local_ok="FAIL"
public_ok="FAIL"
for _ in 1 2 3 4 5; do
  if curl -s --max-time 6 http://127.0.0.1:9633/api/v1/health | python3 -c 'import sys,json;d=json.load(sys.stdin);print("OK" if d.get("ok") else "FAIL")' 2>/dev/null | grep -q '^OK$'; then
    local_ok="OK"
    break
  fi
  sleep 1
done
for _ in 1 2 3 4 5; do
  if curl -s --max-time 8 https://api.longhun888.com/api/v1/health | python3 -c 'import sys,json;d=json.load(sys.stdin);print("OK" if d.get("ok") else "FAIL")' 2>/dev/null | grep -q '^OK$'; then
    public_ok="OK"
    break
  fi
  sleep 1
done
echo "本地网关: $local_ok"
echo "公网网关: $public_ok"
echo
echo "可用入口:"
echo "  https://api.longhun888.com/api/v1/health"
echo "  https://api.longhun888.com/api/v1/providers"
echo "  https://api.longhun888.com/api/v1/ollama/chat"
echo "  https://api.longhun888.com/notion_webhook"
echo
echo "本机主控台网页（静态）:"
echo "  bash $ROOT_DIR/bin/开主控台"
echo "  http://127.0.0.1:9620/longhun-master-control.html"
