<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.longhun.disk-guard</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/zuimeidedeyihan/longhun-system/bin/lh_disk_guard.py</string>
        <string>watch</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/zuimeidedeyihan/longhun-system</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/zuimeidedeyihan/longhun-system/logs/disk_guard_daemon.out.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/zuimeidedeyihan/longhun-system/logs/disk_guard_daemon.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>LONGHUN_ROOT</key>
        <string>/Users/zuimeidedeyihan/longhun-system</string>
    </dict>

    <key>ThrottleInterval</key>
    <integer>2</integer>
</dict>
</plist>
