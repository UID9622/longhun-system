{
  "_comment": "龍魂系統生產部署配置模板 - 請根據實際環境修改",

  "environment": "production",

  "api_configuration": {
    "api_host": "api.longhun.example.com",
    "api_port": 8443,
    "api_url": "https://api.longhun.example.com:8443",
    "max_concurrent_connections": 10000,
    "request_timeout_seconds": 30,
    "keepalive_timeout_seconds": 60
  },

  "database_configuration": {
    "db_type": "postgresql",
    "db_host": "prod-postgresql.example.com",
    "db_port": 5432,
    "db_name": "longhun_production",
    "db_user": "longhun_app",
    "db_password": "${LONGHUN_DB_PASSWORD}",
    "db_pool_size": 20,
    "db_backup_location": "/var/backups/longhun",
    "db_backup_retention_days": 30,
    "db_replication_enabled": true,
    "db_replica_host": "prod-postgresql-replica.example.com"
  },

  "cache_configuration": {
    "cache_type": "redis",
    "redis_host": "prod-redis.example.com",
    "redis_port": 6379,
    "redis_password": "${LONGHUN_REDIS_PASSWORD}",
    "redis_db": 0,
    "redis_pool_size": 50,
    "cache_ttl_seconds": 3600,
    "cache_eviction_policy": "allkeys-lru"
  },

  "security_configuration": {
    "ssl_enabled": true,
    "ssl_cert_path": "/etc/ssl/certs/longhun-prod.crt",
    "ssl_key_path": "/etc/ssl/private/longhun-prod.key",
    "ssl_cipher_suite": "HIGH:!aNULL:!eNULL:!EXPORT:!DES:!MD5:!PSK:!RC4",
    "tls_version": "1.3",
    "cors_enabled": true,
    "cors_allowed_origins": [
      "https://longhun.example.com",
      "https://app.longhun.example.com"
    ],
    "rate_limiting_enabled": true,
    "rate_limit_requests_per_minute": 1000,
    "rate_limit_per_ip_per_minute": 100,
    "rate_limit_per_api_key_per_minute": 10000,
    "audit_logging_enabled": true,
    "audit_log_location": "/var/log/longhun/audit.log",
    "firewall_enabled": true,
    "firewall_rules": [
      "allow-http-80-redirect",
      "allow-https-443",
      "allow-ssh-22-restricted",
      "deny-all-other-inbound"
    ]
  },

  "monitoring_configuration": {
    "monitoring_service": "datadog",
    "datadog_api_key": "${DATADOG_API_KEY}",
    "datadog_app_key": "${DATADOG_APP_KEY}",
    "monitoring_enabled": true,
    "metrics_collection_interval_seconds": 60,
    "key_metrics": [
      "api_response_time_p95",
      "api_request_rate",
      "api_error_rate",
      "db_connection_pool_usage",
      "db_query_latency",
      "cache_hit_rate",
      "cpu_usage_percent",
      "memory_usage_percent",
      "disk_io_read_bytes",
      "disk_io_write_bytes"
    ]
  },

  "logging_configuration": {
    "log_aggregation_service": "elasticsearch",
    "elasticsearch_host": "prod-elasticsearch.example.com",
    "elasticsearch_port": 9200,
    "elasticsearch_index": "longhun-prod",
    "elasticsearch_retention_days": 30,
    "log_level": "INFO",
    "log_format": "json",
    "log_location": "/var/log/longhun",
    "log_rotation_enabled": true,
    "log_rotation_size_mb": 100,
    "log_rotation_max_backups": 10
  },

  "alerting_configuration": {
    "alerting_enabled": true,
    "alert_channels": [
      "slack",
      "pagerduty",
      "email"
    ],
    "slack_webhook": "${SLACK_WEBHOOK_URL}",
    "pagerduty_integration_key": "${PAGERDUTY_INTEGRATION_KEY}",
    "alert_email_recipients": [
      "ops-team@longhun.example.com",
      "sre-team@longhun.example.com"
    ],
    "critical_alerts": [
      {
        "name": "High Error Rate",
        "condition": "error_rate > 0.01",
        "severity": "critical",
        "notification_channels": ["slack", "pagerduty"]
      },
      {
        "name": "High Response Time",
        "condition": "p95_latency > 500ms",
        "severity": "high",
        "notification_channels": ["slack"]
      },
      {
        "name": "Database Connection Pool Exhausted",
        "condition": "db_pool_usage > 0.9",
        "severity": "critical",
        "notification_channels": ["slack", "pagerduty"]
      },
      {
        "name": "Disk Space Low",
        "condition": "disk_available < 0.1",
        "severity": "critical",
        "notification_channels": ["slack", "pagerduty"]
      },
      {
        "name": "SSL Certificate Expiring Soon",
        "condition": "ssl_cert_expiry < 30 days",
        "severity": "high",
        "notification_channels": ["email"]
      }
    ]
  },

  "deployment_configuration": {
    "deployment_strategy": "blue-green",
    "blue_environment": "prod-blue",
    "green_environment": "prod-green",
    "canary_enabled": false,
    "canary_percentage": 5,
    "canary_duration_minutes": 30,
    "health_check_interval_seconds": 30,
    "health_check_timeout_seconds": 10,
    "readiness_probe_path": "/health",
    "liveness_probe_path": "/health",
    "graceful_shutdown_timeout_seconds": 30
  },

  "kubernetes_configuration": {
    "k8s_enabled": true,
    "k8s_cluster": "prod-cluster",
    "k8s_namespace": "longhun-prod",
    "k8s_deployment_name": "longhun-prod",
    "k8s_replicas": 3,
    "k8s_image_registry": "registry.example.com",
    "k8s_image_name": "longhun",
    "k8s_image_tag": "prod-2026-06-08-v1.0",
    "k8s_resource_requests_cpu": "2",
    "k8s_resource_requests_memory": "4Gi",
    "k8s_resource_limits_cpu": "4",
    "k8s_resource_limits_memory": "8Gi",
    "k8s_node_affinity": "production-nodes"
  },

  "skills_configuration": {
    "skills_enabled": 10,
    "skills": [
      {
        "id": "skill-1-algorithmic-art",
        "name": "龍魂算法藝術生成器",
        "enabled": true,
        "max_concurrent_executions": 100,
        "timeout_seconds": 30
      },
      {
        "id": "skill-2-brand-guidelines",
        "name": "品牌指南構建工具",
        "enabled": true,
        "max_concurrent_executions": 100,
        "timeout_seconds": 30
      },
      {
        "id": "skill-3-canvas-design",
        "name": "Canvas 動態設計工具",
        "enabled": true,
        "max_concurrent_executions": 100,
        "timeout_seconds": 30
      },
      {
        "id": "skill-4-doc-coauthoring",
        "name": "文檔協作編輯系統",
        "enabled": true,
        "max_concurrent_executions": 50,
        "timeout_seconds": 60
      },
      {
        "id": "skill-5-internal-comms",
        "name": "內部溝通平台",
        "enabled": true,
        "max_concurrent_executions": 200,
        "timeout_seconds": 30
      },
      {
        "id": "skill-6-mcp-builder",
        "name": "MCP 服務器構建工具",
        "enabled": true,
        "max_concurrent_executions": 50,
        "timeout_seconds": 60
      },
      {
        "id": "skill-7-skill-creator",
        "name": "Skill 創建助手",
        "enabled": true,
        "max_concurrent_executions": 50,
        "timeout_seconds": 60
      },
      {
        "id": "skill-8-slack-gif-creator",
        "name": "Slack GIF 生成器",
        "enabled": true,
        "max_concurrent_executions": 100,
        "timeout_seconds": 30
      },
      {
        "id": "skill-9-theme-factory",
        "name": "主題生成工廠",
        "enabled": true,
        "max_concurrent_executions": 100,
        "timeout_seconds": 30
      },
      {
        "id": "skill-10-web-artifacts-builder",
        "name": "Web 構件生成器",
        "enabled": true,
        "max_concurrent_executions": 100,
        "timeout_seconds": 30
      }
    ]
  },

  "backup_configuration": {
    "backup_enabled": true,
    "backup_frequency": "daily",
    "backup_time": "02:00",
    "backup_retention_days": 30,
    "backup_location": "/var/backups/longhun",
    "backup_to_s3": true,
    "s3_bucket": "longhun-prod-backups",
    "s3_region": "us-east-1",
    "backup_verification_enabled": true
  },

  "disaster_recovery_configuration": {
    "dr_enabled": true,
    "dr_site_location": "us-west-2",
    "dr_rto_minutes": 15,
    "dr_rpo_minutes": 5,
    "dr_replication_enabled": true,
    "dr_backup_frequency": "every-6-hours",
    "dr_failover_automated": false
  },

  "feature_flags": {
    "enable_canary_deployment": false,
    "enable_auto_scaling": true,
    "enable_rate_limiting": true,
    "enable_caching": true,
    "enable_compression": true,
    "enable_ipv6": true
  },

  "dna": "#龍芯⚡️2026-06-08-PROD-CONFIG-TEMPLATE-v1.0",
  "confirmation_code": "#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z"
}
