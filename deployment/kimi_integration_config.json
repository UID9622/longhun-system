{
  "_comment": "龍魂 × Kimi 集成配置 - 环境变量方案 A",

  "kimi_configuration": {
    "api_endpoint": "https://api.moonshot.cn/v1",
    "api_key_env": "KIMI_API_KEY",
    "timeout_seconds": 30,
    "max_retries": 3,
    "retry_delay_seconds": 1.0
  },

  "integration_modes": {
    "1_backup_model": {
      "enabled": true,
      "description": "Claude 主模型 → Kimi 备用（故障转移）",
      "circuit_breaker": {
        "failure_threshold": 3,
        "timeout_seconds": 60
      },
      "fallback_strategy": "retry_then_local"
    },

    "2_multimodal": {
      "enabled": true,
      "description": "多模态处理 - 图像/文件分析",
      "supported_formats": ["jpg", "png", "gif", "pdf", "docx", "txt"],
      "max_file_size_mb": 50
    },

    "3_realtime_chat": {
      "enabled": true,
      "description": "实时对话 - 用户直接与 Kimi 交互",
      "timeout_seconds": 30,
      "max_conversation_length": 20,
      "session_persistence": true
    },

    "4_skill_engine": {
      "enabled": true,
      "description": "Skill 特定引擎集成",
      "supported_skills": [
        "skill-3-canvas-design",
        "skill-4-doc-coauthoring",
        "skill-6-mcp-builder"
      ]
    }
  },

  "gateway_configuration": {
    "host": "0.0.0.0",
    "port": 5000,
    "debug": false,
    "endpoints": [
      "POST /kimi/backup-inference",
      "POST /kimi/image",
      "POST /kimi/document",
      "POST /kimi/chat/start",
      "POST /kimi/chat/message",
      "POST /kimi/skill",
      "GET /kimi/report",
      "GET /health"
    ]
  },

  "monitoring": {
    "log_location": "/tmp/longhun-kimi/logs",
    "log_level": "INFO",
    "metrics_enabled": true,
    "circuit_breaker_monitoring": true
  },

  "deployment": {
    "environment_setup": {
      "1_set_env": "export KIMI_API_KEY='apisk-kimi-***'",
      "2_verify": "python3 -c 'from kimi import KimiClient; KimiClient().health_check()'",
      "3_test_gateway": "python3 kimi_gateway.py"
    }
  },

  "dna": "#龍芯⚡️2026-06-08-KIMI-INTEGRATION-CONFIG-v1.0",
  "confirmation_code": "${LONGHUN_CONFIRM_CODE}"
}
