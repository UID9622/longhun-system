{
  "_comment": "生產部署引擎·Staging 環境測試配置",

  "environment": "staging-prod-test",

  "api_configuration": {
    "api_host": "localhost",
    "api_port": 8443,
    "api_url": "https://localhost:8443",
    "max_concurrent_connections": 5000,
    "request_timeout_seconds": 30,
    "keepalive_timeout_seconds": 60
  },

  "database_configuration": {
    "db_type": "sqlite",
    "db_host": "localhost",
    "db_port": 0,
    "db_name": "/tmp/longhun-staging/staging_prod_test.db",
    "db_user": "staging_user",
    "db_password": "${LONGHUN_DB_PASSWORD}",
    "db_pool_size": 10,
    "db_backup_location": "/tmp/longhun-staging/backups",
    "db_backup_retention_days": 7,
    "db_replication_enabled": false
  },

  "cache_configuration": {
    "cache_type": "memory",
    "redis_host": "localhost",
    "redis_port": 6379,
    "redis_password": "${LONGHUN_REDIS_PASSWORD}",
    "redis_db": 0,
    "redis_pool_size": 10,
    "cache_ttl_seconds": 1800,
    "cache_eviction_policy": "allkeys-lru"
  },

  "security_configuration": {
    "ssl_enabled": true,
    "ssl_cert_path": "/tmp/longhun-staging/certs/staging.crt",
    "ssl_key_path": "/tmp/longhun-staging/certs/staging.key",
    "ssl_cipher_suite": "HIGH:!aNULL:!eNULL",
    "tls_version": "1.2",
    "cors_enabled": true,
    "cors_allowed_origins": [
      "http://localhost:3000",
      "http://localhost:8000"
    ],
    "rate_limiting_enabled": true,
    "rate_limit_requests_per_minute": 500,
    "rate_limit_per_ip_per_minute": 50,
    "rate_limit_per_api_key_per_minute": 5000,
    "audit_logging_enabled": true,
    "audit_log_location": "/tmp/longhun-staging/logs/audit.log",
    "firewall_enabled": false
  },

  "monitoring_configuration": {
    "monitoring_service": "prometheus",
    "monitoring_enabled": true,
    "metrics_collection_interval_seconds": 60,
    "key_metrics": [
      "api_response_time_p95",
      "api_request_rate",
      "api_error_rate"
    ]
  },

  "logging_configuration": {
    "log_aggregation_service": "file",
    "log_level": "INFO",
    "log_format": "json",
    "log_location": "/tmp/longhun-staging/logs",
    "log_rotation_enabled": true,
    "log_rotation_size_mb": 50,
    "log_rotation_max_backups": 5
  },

  "alerting_configuration": {
    "alerting_enabled": true,
    "alert_channels": [
      "file"
    ],
    "critical_alerts": [
      {
        "name": "High Error Rate",
        "condition": "error_rate > 0.05",
        "severity": "high"
      },
      {
        "name": "High Response Time",
        "condition": "p95_latency > 1000ms",
        "severity": "warning"
      }
    ]
  },

  "deployment_configuration": {
    "deployment_strategy": "blue-green",
    "blue_environment": "staging-blue",
    "green_environment": "staging-green",
    "canary_enabled": false,
    "health_check_interval_seconds": 5,
    "health_check_timeout_seconds": 5,
    "readiness_probe_path": "/health",
    "liveness_probe_path": "/health"
  },

  "skills_configuration": {
    "skills_enabled": 10,
    "skills_list": [
      "skill-1-algorithmic-art",
      "skill-2-brand-guidelines",
      "skill-3-canvas-design",
      "skill-4-doc-coauthoring",
      "skill-5-internal-comms",
      "skill-6-mcp-builder",
      "skill-7-skill-creator",
      "skill-8-slack-gif-creator",
      "skill-9-theme-factory",
      "skill-10-web-artifacts-builder"
    ]
  },

  "backup_configuration": {
    "backup_enabled": true,
    "backup_frequency": "manual",
    "backup_location": "/tmp/longhun-staging/backups",
    "backup_retention_days": 7
  },

  "feature_flags": {
    "enable_canary_deployment": false,
    "enable_auto_scaling": false,
    "enable_rate_limiting": true,
    "enable_caching": true,
    "enable_compression": true
  },

  "dna": "#龍芯⚡️2026-06-08-STAGING-PROD-TEST-CONFIG-v1.0",
  "confirmation_code": "${LONGHUN_CONFIRM_CODE}"
}
