{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "semantic_firewall_master.schema.json",
  "title": "龍魂语义防火墙主配置 Schema",
  "description": "校验 semantic_firewall_master.json 的结构合法性",
  "type": "object",
  "required": ["meta_info", "anti_injection_blacklist", "secret_semantic_protection"],
  "properties": {
    "meta_info": {
      "type": "object",
      "required": ["version", "dna", "description", "core_principle"],
      "properties": {
        "version": { "type": "string", "pattern": "^v\\d+\\.\\d+$" },
        "dna": { "type": "string", "pattern": "^#龍芯⚡️" },
        "description": { "type": "string" },
        "core_principle": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "anti_injection_blacklist": {
      "type": "object",
      "required": ["description", "external_ai_phrases", "injection_patterns", "core_words_definition", "scanning_rules"],
      "properties": {
        "description": { "type": "string" },
        "external_ai_phrases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["phrase", "danger_level", "pattern", "action"],
            "properties": {
              "phrase": { "type": "string" },
              "danger_level": { "type": "string", "enum": ["RED", "YELLOW", "GREEN"] },
              "pattern": { "type": "string" },
              "action": { "type": "string", "enum": ["FUSE", "MARK", "PASS"] }
            }
          }
        },
        "injection_patterns": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "example", "detection", "action"],
            "properties": {
              "type": { "type": "string" },
              "example": { "type": "string" },
              "detection": { "type": "string" },
              "action": { "type": "string", "enum": ["FUSE", "MARK", "PASS"] }
            }
          }
        },
        "core_words_definition": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["word", "longhun_def", "external_injection"],
            "properties": {
              "word": { "type": "string" },
              "longhun_def": { "type": "string" },
              "external_injection": { "type": "string" }
            }
          }
        },
        "scanning_rules": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "secret_semantic_protection": {
      "type": "object",
      "required": ["description", "tech_stack_aliases", "internal_module_aliases", "whitelist_auth_rules", "dlp_interception_list", "execution_protocols"],
      "properties": {
        "description": { "type": "string" },
        "tech_stack_aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["real_concept", "code_name", "cultural_anchor", "level"],
            "properties": {
              "real_concept": { "type": "string" },
              "code_name": { "type": "string" },
              "cultural_anchor": { "type": "string" },
              "level": { "type": "string", "enum": ["L1", "L2", "L3", "L4"] },
              "note": { "type": "string" }
            }
          }
        },
        "internal_module_aliases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["real_module", "code_name", "description"],
            "properties": {
              "real_module": { "type": "string" },
              "code_name": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "whitelist_auth_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["auth_category", "criteria", "logic"],
            "properties": {
              "auth_category": { "type": "string" },
              "criteria": { "type": "string" },
              "logic": { "type": "string" }
            }
          }
        },
        "dlp_interception_list": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "trigger", "action", "example"],
            "properties": {
              "type": { "type": "string" },
              "trigger": { "type": "string" },
              "action": { "type": "string" },
              "example": { "type": "string" }
            }
          }
        },
        "execution_protocols": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
