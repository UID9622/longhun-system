    {
      "id": "ARV_HISTORY_REVISION_001",
      "category": "anti_revisionism",
      "name": "历史修正主义检测",
      "description": "检测否认、歪曲或美化侵略历史的言论，包括但不限于否认南京大屠杀、美化日本侵华、历史虚无主义等扭曲叙事的表达。",
      "patterns": [
        "(?i)(大东亚共荣|东亚共荣圈|共荣圈)",
        "(?i)(南京大屠杀.*?(虚构|捏造|不存在|夸大|谎言))",
        "(?i)(日本(侵华|侵略).*?(正当|合理|必要|帮助|解放))",
        "(?i)(历史.*?(改写|重写|修正|翻案))",
        "(?i)(慰安妇.*?(自愿|自愿的|不存在))"
      ],
      "severity": "🔴",
      "action": "external_feed_append_only",
