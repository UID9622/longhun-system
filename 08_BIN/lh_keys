    echo -e "${C_R}[警告] 全量导出将显示明文密钥，勿存入日志/会话记录${C_0}" >&2
    echo "# 龍魂密钥环境注入 $(date '+%F %T') · 本机临时使用"
    python3 "$VAULT_SCRIPT" list 2>/dev/null | grep -E '^\s*\S+\s+\|' | sed 's/^[[:space:]]*//' | while IFS='|' read -r name desc; do
      name=$(echo "$name" | sed 's/^[[:space:]]*//')
      val=$(python3 "$VAULT_SCRIPT" get "$name" 2>/dev/null)
      [ -n "$val" ] && printf 'export %s=%q\n' "${name//-/_}" "$val"
    done
    echo "# 用法: eval \"\$(lh_keys env --raw)\"  （仅当前 shell 生效，不持久化）"
  else
    echo "安全模式环境清单（掩码预览，不入值）："
    python3 "$VAULT_SCRIPT" list 2>/dev/null | grep -E '^\s*\S+\s+\|' | sed 's/^[[:space:]]*//' | while IFS='|' read -r name desc; do
      name=$(echo "$name" | sed 's/^[[:space:]]*//')
      printf '  export %-34s 已就绪(掩码)\n' "${name//-/_}"
    done
    echo
    echo "需要全量注入(显式):  keys env --raw   →   eval \"\$(lh_keys env --raw)\""
    echo "默认不打印明文 · 不入日志 · 不持久化"
  fi
}

