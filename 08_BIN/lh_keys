# ---------- 3. 贴入待整理 ----------
cmd_add() {
  gate_check "密钥贴入(add) · 落 _inbox 待整理区"
  ensure_dirs
  local arg="${1:-}"
  local stamp
  stamp=$(ts)
  if [ -n "$arg" ]; then
    if [[ "$arg" == *=* ]]; then
      local nm="${arg%%=*}" val="${arg#*=}"
      nm=$(sanitize_name "$nm")
      [ -z "$nm" ] && nm="paste"
      printf '[%s]\n%s\n' "$nm" "$val" > "$INBOX/${stamp}_${nm}.txt"
    else
      printf '%s\n' "$arg" > "$INBOX/${stamp}_paste.txt"
    fi
    ok "已落 _inbox 待整理区: ${stamp}_*.txt"
  else
    echo "粘贴密钥内容，完成后按 Ctrl-D 提交："
    local data
    data=$(cat)
    if [ -z "$data" ]; then err "空内容"; exit 1; fi
    printf '%s\n' "$data" > "$INBOX/${stamp}_paste.txt"
    ok "已落 _inbox 待整理区: ${stamp}_paste.txt"
  fi
  echo "下一步: keys scan 识别并归档 | 查看: keys list"
}

# ---------- 4. 识别启发式 ----------
detect_type() {
  local content="$1"
  if grep -qE '(BEGIN |-----BEGIN )?.*PRIVATE KEY' <<<"$content"; then echo "PEM私钥(建议原位)"; return; fi
  if grep -qE '^eyJ[A-Za-z0-9_-]{12,}\.[A-Za-z0-9_-]{12,}\.' <<<"$content"; then echo "JWT/会话token"; return; fi
  if grep -qE 'ghp_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}' <<<"$content"; then echo "GitHub Token"; return; fi
  if grep -qE 'sk-[A-Za-z0-9]{20,}' <<<"$content"; then echo "OpenAI系 sk-*"; return; fi
  if grep -qE 'ck_[A-Za-z0-9]{16,}' <<<"$content"; then echo "CodeBuddy API"; return; fi
  if grep -qE 'eyJhbGciOi' <<<"$content"; then echo "JWT(签名头)"; return; fi
  if grep -qE 'NOTION|secret_[A-Za-z0-9]{20,}' <<<"$content"; then echo "Notion token"; return; fi
  if grep -qE '^[A-Za-z0-9+/]{40,}={0,2}$' <<<"$content"; then echo "长随机密钥(疑似API key)"; return; fi
  echo "未识别(需人工归类)"
}

# ---------- 5. 扫描+归档 ----------
cmd_scan() {
  gate_check "密钥待整理扫描与归档(scan)"
  ensure_dirs
  local i=0
  local files=( "$INBOX"/* )
  if [ ! -e "${files[0]:-}" ]; then
    warn "_inbox 为空，无待整理。贴入: keys add"
    return
  fi
  echo "扫描到 ${#files[@]} 个待整理文件："
  for f in "${files[@]}"; do
    [ -f "$f" ] || continue
    i=$((i+1))
    local content nm type
    content=$(cat "$f")
    nm=$(sed -nE '1s/^\[([^]]+)\].*/\1/p' "$f" | head -1)
    if [ -z "$nm" ]; then
      nm=$(grep -oE '^[A-Za-z0-9_]{2,40}=' "$f" | head -1 | tr -d '=')
    fi
    [ -z "$nm" ] && nm="${f##*/}"
    nm=$(sanitize_name "$nm")
    type=$(detect_type "$content")
    local conflict=""
    vault_has "$nm" && conflict=" · ${C_R}vault已有同名!${C_0}"
    echo
    echo "-----------------------------------------------"
    echo -e "[$i/${#files[@]}] ${C_Y}${f##*/}${C_0}"
    echo -e "    识别: ${C_C}$type${C_0}   建议名: ${C_G}${nm}${C_0}${conflict}"
    echo "    动作: [1]入vault  [2]留_archive  [3]弃_rejected  [s]跳过  回车=按建议"
    read -rp "    > " act
    case "${act:-1}" in
      1)
        if vault_has "$nm"; then
          warn "vault 已有 ${nm}，跳过入库(不覆盖)"
          mv "$f" "$ARCHIVE/${f##*/}"
        elif python3 "$VAULT_SCRIPT" put "$nm" --value "$content" --note "lh_keys 自动归档 $type" 2>/dev/null; then
          ok "已入 vault: ${nm}"
          mv "$f" "$ARCHIVE/${f##*/}"
        else
          err "入库失败(可能需解锁)，已保留原文件"
        fi ;;
      2) mv "$f" "$ARCHIVE/${f##*/}"; ok "已移 _archive";;
      3) mv "$f" "$REJECTED/${f##*/}"; ok "已隔离 _rejected";;
      *) warn "跳过";;
    esac
  done
  echo
  ok "扫描完成。vault 明细: keys list"
}

