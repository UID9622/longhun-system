# ---------- 颜色 ----------
if [ -t 1 ]; then
  C_G="\033[1;32m"; C_Y="\033[1;33m"; C_R="\033[1;31m"; C_C="\033[1;36m"; C_0="\033[0m"
else
  C_G=""; C_Y=""; C_R=""; C_C=""; C_0=""
fi
ok()   { echo -e "${C_G}[✓]${C_0} $*"; }
warn() { echo -e "${C_Y}[!]${C_0} $*"; }
err()  { echo -e "${C_R}[✗]${C_0} $*" >&2; }

# ---------- 基础 ----------
ensure_dirs() {
  mkdir -p "$KEYS_DIR" "$INBOX" "$ARCHIVE" "$REJECTED" "$HOME/.longhun"
  chmod 700 "$KEYS_DIR" 2>/dev/null || true
}

mask() { # 掩码: 只露头尾4位
  local s="$1" n=${#1}
  if [ "$n" -le 8 ]; then echo "****"; else echo "${s:0:4}…${s: -4}"; fi
}

ts() { date '+%Y%m%d_%H%M%S'; }

sanitize_name() { # 密钥名只留安全字符(空格截断)
  local s="$1"
  s="${s//[^A-Za-z0-9_.-]/_}"
  echo "$s"
}

# ---------- 七因素门禁(foundation_engine) ----------
# 写操作前置: 通过→继续 · 失败→熔断退出(自动写耻辱墙)
gate_check() {
  local desc="$1"
  if ! python3 "$FOUNDATION_SCRIPT" audit --decision "$desc" >/dev/null 2>&1; then
    err "七因素门禁熔断: $desc"
    err "耻辱墙: ~/.longhun/shame_wall/foundation_violations.jsonl"
    exit 1
  fi
}

# ---------- 到期元数据(~/.longhun/keys_meta.jsonl · append-only) ----------
# 输出: rows=[{name,expires_at,days}] · 排序近→远 · 只列 ≤limit 天(含已过期)
meta_rows() {
  LK_LIMIT="${1:-30}" KEYS_META="$KEYS_META" python3 - <<'PY'
import json, os
from datetime import date, datetime
lim = int(os.environ.get("LK_LIMIT", "30"))
path = os.environ.get("KEYS_META", "")
rows = []
if path and os.path.exists(path):
    last = {}
    for ln in open(path, encoding="utf-8"):
        ln = ln.strip()
        if not ln:
            continue
        try:
            e = json.loads(ln)
        except Exception:
            continue
        if e.get("name") and e.get("expires_at"):
            last[e["name"]] = e          # append-only → 同名以最新为准
    t = date.today()
    for n, e in last.items():
        try:
            dl = (datetime.strptime(e["expires_at"], "%Y-%m-%d").date() - t).days
        except Exception:
            continue
        if dl <= lim:
            rows.append({"name": n, "expires_at": e["expires_at"], "days": dl})
rows.sort(key=lambda r: r["days"])
print(json.dumps(rows, ensure_ascii=False))
PY
}

meta_expire() { # 追加一条到期记录(name 已 sanitize)
  local name="$1" d="$2"
  printf '{"action":"expire","name":"%s","expires_at":"%s","ts":"%s","dna":"lhkeys-v2-%s"}\n' \
    "$name" "$d" "$(date '+%Y-%m-%dT%H:%M:%S')" "$(date '+%s')" >> "$KEYS_META"
}

vault_has() { # vault 是否已有同名
  python3 "$VAULT_SCRIPT" list 2>/dev/null | awk -v n="$1" '{ if ($1==n) f=1 } END { exit f?0:1 }'
}

