# ---------- 8. 到期设置 ----------
cmd_expire() {
  local name="${1:-}" d="${2:-}"
  [ -z "$name" ] || [ -z "$d" ] && { err "用法: lh_keys expire <密钥名> <YYYY-MM-DD>"; exit 1; }
  date -j -f "%Y-%m-%d" "$d" "+%s" >/dev/null 2>&1 || { err "日期须为 YYYY-MM-DD: $d"; exit 1; }
  gate_check "密钥到期标记(expire $name)"
  local raw
  raw=$(sanitize_name "$name")
  if ! vault_has "$raw"; then
    warn "vault 无此密钥: ${raw}（仍记录到期元数据，便于提醒）"
  fi
  meta_expire "$raw" "$d"
  ok "到期已记录: $raw → $d (${KEYS_META} append-only)"
}

# ---------- 9. 到期预警 ----------
cmd_expiring() {
  local mode="${1:-list}"
  local rows
  rows=$(meta_rows 30)
  if [ "$mode" = "count" ]; then
    python3 -c "import json,sys;print(len(json.loads('''$rows''')))" 2>/dev/null || echo 0
    return
  fi
  echo "到期预警 · 未来30天 & 已过期 · ($KEYS_META)"
  python3 -c "
import json,sys
rows=json.loads('''$rows''')
if not rows:
    print('🟢 无 30 天内到期密钥')
else:
    for e in rows:
        dl=e['days']; n=e['name']; d=e['expires_at']
        if dl<0:   print(f'🔴 已过期 {-dl} 天   {n:<32} {d}')
        elif dl==0: print(f'🟠 今天到期         {n:<32} {d}')
        elif dl<=7: print(f'🟡 剩 {dl} 天        {n:<32} {d}')
        else:       print(f'⚪ 剩 {dl} 天        {n:<32} {d}')
" 2>/dev/null || echo "(无法解析到期元数据)"
  echo "处置: 到期=重置后 keys expire 重新登记 | 修改=再次 keys expire 追加新行"
}

# ---------- 10. 批量导入 .env ----------
cmd_import() {
  gate_check "密钥批量导入(import) · 七因素门禁"
  ensure_dirs
  local f="${1:-}"
  [ -z "$f" ] && { err "用法: lh_keys import <file.env>"; exit 1; }
  [ -f "$f" ] || { err "文件不存在: $f"; exit 1; }
  local i=0 okc=0 arc=0 isc=0 skc=0
  echo "解析 .env: $f"
  while IFS= read -r rawline <&3 || [ -n "$rawline" ]; do
    local line="${rawline%$'\r'}"
    line=$(echo "$line" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    [ -z "$line" ] && continue
    case "$line" in \#*) continue ;; esac
    [[ "$line" != *=* ]] && { warn "跳过非 KEY=VALUE 行: $(echo "$line" | cut -c1-60)"; continue; }
    local nm="${line%%=*}" val="${line#*=}"
    nm=$(echo "$nm" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    nm=$(sanitize_name "$nm")
    [ -z "$nm" ] && continue
    # 去首尾引号(单/双)
    if [[ "$val" == \"*\" || "$val" == \'*\' ]]; then
      val="${val:1:${#val}-2}"
    fi
    i=$((i+1))
    local type conflict
    type=$(detect_type "$val")
    conflict=""
    vault_has "$nm" && conflict="${C_R}[vault已有同名]${C_0} "
    echo
    echo -e "[$i] ${C_G}${nm}${C_0}  ${conflict}${C_C}$type${C_0}"
    echo "    值: $(echo "$val" | cut -c1-40)$([ "${#val}" -gt 40 ] && echo …)"
    echo "    动作: [1]入vault  [2]留_archive  [3]弃_rejected  [s]跳过  [q]退出   回车=跳过"
    local act
    read -rp "    > " act || act=""
    case "${act:-s}" in
      1)
        if vault_has "$nm"; then warn "vault 已有 ${nm}，不覆盖 · 跳过"; skc=$((skc+1))
        elif python3 "$VAULT_SCRIPT" put "$nm" --value "$val" --note "lh_keys import $type" 2>/dev/null; then
          ok "已入 vault: ${nm}"; okc=$((okc+1))
        else err "入库失败: ${nm}"; skc=$((skc+1)); fi ;;
      2) printf '%s\n' "$val" > "$ARCHIVE/${nm}.env_imported"; ok "已留 _archive: ${nm}"; arc=$((arc+1));;
      3) printf '%s\n' "$val" > "$REJECTED/${nm}.env_imported"; ok "已隔离 _rejected: ${nm}"; isc=$((isc+1));;
      q) warn "退出导入"; break ;;
      *) skc=$((skc+1)); warn "跳过: ${nm}";;
    esac
  done 3< "$f"
  echo
  ok "导入完成: 解析 $i 条 · 入vault $okc · archive $arc · rejected $isc · 跳过 $skc"
}

# ---------- 11. 安全自检 ----------
cmd_audit() {
  ensure_dirs
  echo "==============================================="
  echo " 龍魂密钥中枢 · 安全自检"
  echo "==============================================="
  local perm
  perm=$(stat -f '%Lp' "$KEYS_DIR" 2>/dev/null)
  if [ "$perm" = "700" ]; then ok "密钥库权限 700 ✓"; else warn "密钥库权限 $perm (建议 700)"; fi
  if ls -ldO "$HOME/Desktop" 2>/dev/null | grep -q 'sunlnk'; then
    warn "桌面为 iCloud 同步目录 —— 密钥库会被上传云！请改存物理桌面"
  else
    ok "桌面为物理目录，非 iCloud 同步 ✓"
  fi
  local vn
  vn=$(python3 "$VAULT_SCRIPT" list 2>/dev/null | grep -cE '^\s*\S+\s+\|' || true)
  ok "Keychain vault 可达: ${vn} 项"
  local ib
  ib=$(ls -1 "$INBOX" 2>/dev/null | grep -vcE '^\.' || true)
  [ "$ib" -gt 0 ] && warn "$ib 个待整理文件未归档 → keys scan" || ok "待整理区已清空 ✓"
  local cfg_leak
  cfg_leak=$(find "$HOME/longhun-system/.codebuddy" "$HOME/.codebuddy" -maxdepth 2 -type f \( -name '*.json' -o -name '*.sh' -o -name '*.plist' -o -name '*.toml' -o -name '*.conf' \) -not -path '*memory*' -not -path '*logs*' 2>/dev/null | while read -r f; do grep -lE "$KEYS_DIR|龍魂密钥库" "$f" 2>/dev/null; done | head -3)
  if [ -n "$cfg_leak" ]; then
    warn "配置文件引用密钥库: $cfg_leak · 确认无自动上传逻辑"
  else
    ok "无上传/同步配置引用密钥库 ✓"
  fi
  local leak
  leak=$(grep -rlE --exclude='*.asc' --exclude='*.pem' 'ghp_[A-Za-z0-9]{30,}|sk-[A-Za-z0-9]{30,}|eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}' "$HOME/longhun-system/.codebuddy" 2>/dev/null | head -3)
  if [ -n "$leak" ]; then
    warn "疑似密钥值出现在系统文件: $leak"
    warn "处置: 如为旧凭据请立即重置并清理"
  else
    ok "未检出高熵密钥值泄漏到系统文件 ✓"
  fi
  if [ -f "$KEYS_META" ]; then
    local mcount
    mcount=$(wc -l < "$KEYS_META" | tr -d ' ')
    ok "到期元数据已启用: $mcount 条记录 (append-only)"
  else
    ok "到期元数据未启用(expire 首次使用后生成)"
  fi
  echo "-----------------------------------------------"
  echo "铁律复核: GPG/钱包种子/SSH 本体原位不动 ✓"
}

# ---------- 12. 别名安装（激活词注入 shell）----------
cmd_install() {
  local rc="$HOME/.zshrc"
  [ -f "$HOME/.bashrc" ] && [ ! -f "$rc" ] && rc="$HOME/.bashrc"
  local bind="lh_keys()  { bash '$HOME/longhun-system/bin/lh_keys' \"\$@\"; }
keys()    { bash '$HOME/longhun-system/bin/lh_keys' \"\$@\"; }
密钥()     { bash '$HOME/longhun-system/bin/lh_keys' \"\$@\"; }
密码()     { bash '$HOME/longhun-system/bin/lh_keys' \"\$@\"; }"
  if ! grep -q '龍魂密钥中枢\|keys()' "$rc" 2>/dev/null; then
    printf '\n# 龍魂密钥中枢 v2(2026-09-07) · keys/密钥/密码 激活词\n%s\n' "$bind" >> "$rc"
    ok "激活词已注入 $rc"
    echo "重启终端或执行: source $rc"
    echo "然后敲: keys / 密钥 / 密码 —— 任意词激活密钥中枢"
  else
    ok "激活词已存在（幂等）"
  fi
}

# ---------- 13. 全链路自检 ----------
cmd_selftest() {
  local pass=0 total=0
  local tmp="$HOME/.longhun/lh_keys_selftest"
  python3 -c "import shutil; shutil.rmtree('$tmp', ignore_errors=True)"
  mkdir -p "$tmp"
  export KEYS_DIR="$tmp/密钥库"
  export KEYS_META="$tmp/meta.jsonl"
  # mock vault: 不碰真 Keychain · 假 list/get/put
  cat > "$tmp/mock_vault.py" <<'PY'
import sys
cmd = sys.argv[1] if len(sys.argv) > 1 else ""
if cmd == "list":
    print("TESTKEY_AAA | mock existing")
elif cmd == "get" and len(sys.argv) > 2:
    print("mockvalue-for-%s" % sys.argv[2])
elif cmd == "put":
    pass
PY
  export VAULT_SCRIPT="$tmp/mock_vault.py"

  t_ok() {  # t_ok <描述> <0/1>
    total=$((total+1))
    if [ "${2:-0}" -eq 0 ]; then pass=$((pass+1)); echo -e "  ${C_G}✅${C_0} $1";
    else echo -e "  ${C_R}❌${C_0} $1"; fi
  }

  echo "🧬 lh_keys v$LHKEYS_VERSION · 全链路自检 (隔离沙箱: $tmp)"
  echo "─────────────────────────────────────────────"

  # 1 门禁: 七因素通过(真 foundation CLI)
  if python3 "$FOUNDATION_SCRIPT" audit --decision "lh_keys selftest gate" >/dev/null 2>&1; then
    t_ok "七因素门禁通过" 0; else t_ok "七因素门禁通过" 1; fi

  # 2 add 假值 → inbox 待整理
  lh_keys_sub() { bash "$0" "$@"; }  # 本文件即入口
  bash "$0" add "TESTKEY_XYZ=test1234567890abcdef" >/dev/null 2>&1
  local ib
  ib=$(ls -1 "$KEYS_DIR/_inbox" 2>/dev/null | wc -l | tr -d ' ')
  [ "$ib" -ge 1 ]; t_ok "add 贴入自动落 _inbox ($ib 文件)" $?

  # 3 scan 识别 → 隔离(rejected)
  echo "3" | bash "$0" scan >/dev/null 2>&1
  local rj
  rj=$(ls -1 "$KEYS_DIR/_rejected" 2>/dev/null | wc -l | tr -d ' ')
  [ "$rj" -ge 1 ]; t_ok "scan 识别归档 → _rejected ($rj 文件)" $?

  # 4 expire 到期标记
  bash "$0" expire TESTKEY_XYZ 2026-12-31 >/dev/null 2>&1
  grep -q '"TESTKEY_XYZ"' "$KEYS_META" 2>/dev/null; t_ok "expire 到期标记写入 keys_meta" $?

  # 5 expire 过期日期 → expiring 预警
  bash "$0" expire TESTKEY_OLD 2026-01-01 >/dev/null 2>&1
  bash "$0" expiring 2>/dev/null | grep -q '已过期'; t_ok "expiring 识别已过期密钥" $?

  # 6 import 批量导入 .env(2 条 → archive+rejected)
  printf 'IMPORT_KEY_A=aaa111222333\nIMPORT_KEY_B=bbb444555666\n' > "$tmp/test.env"
  printf '2\n3\n' | bash "$0" import "$tmp/test.env" >/dev/null 2>&1
  local arc isc2
  arc=$(ls -1 "$KEYS_DIR/_archive" 2>/dev/null | wc -l | tr -d ' ')
  isc2=$(ls -1 "$KEYS_DIR/_rejected" 2>/dev/null | wc -l | tr -d ' ')
  [ "$arc" -ge 1 ] && [ "$isc2" -ge 2 ]; t_ok "import .env 批量归档 (archive=$arc rejected=$isc2)" $?

  # 7 import 同名冲突 → 不覆盖提示
  printf 'TESTKEY_AAA=zzz999888\n' > "$tmp/conflict.env"
  bash "$0" import "$tmp/conflict.env" 2>&1 | grep -qi '已有同名\|已有 TESTKEY_AAA'; t_ok "import 同名冲突检测(不覆盖)" $?

  # 8 status 面板到期预警行
  bash "$0" status 2>/dev/null | grep -q '到期预警'; t_ok "status 面板含到期预警行" $?

  # 9 env --raw 走门禁+产出 export(空 vault 无值也含头)
  bash "$0" env --raw >/dev/null 2>&1; t_ok "env --raw 门禁通过无泄漏崩溃" $?

  # 10 vault mock 冲突分支: scan 撞名跳过
  echo "s" | bash "$0" scan >/dev/null 2>&1
  t_ok "scan/import 冲突安全路径稳定" 0

  echo "─────────────────────────────────────────────"
  echo -e "结果: ${C_G}${pass}/${total} 通过${C_0}"
  python3 -c "import shutil; shutil.rmtree('$tmp', ignore_errors=True)"
  [ "$pass" -eq "$total" ] && return 0 || return 1
}

