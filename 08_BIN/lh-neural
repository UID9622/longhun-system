""")


def main():
    if len(sys.argv) < 2:
        print_help()
        return

    cmd = sys.argv[1].lower()
    bridge = NeuralAgentBridge()

    if cmd == "route":
        if len(sys.argv) < 3:
            print("❌ 请提供要路由的文本: longhun-neural route <你的需求>")
            return
        text = " ".join(sys.argv[2:])
        cmd_route(bridge, text)

    elif cmd == "health":
        cmd_health(bridge)

    elif cmd == "agents":
        if "--all" in sys.argv:
            for a in bridge.agents:
                print(f"[{a.get('layer', '?')}] {a['id']:25s} {a['name']:12s} {a.get('logic', '')}")
        else:
            cmd_agents(bridge)

    elif cmd == "shell":
        cmd_shell(bridge)

    elif cmd in ("help", "--help", "-h"):
        print_help()

    else:
        # 未知命令，当作路由文本
        text = " ".join(sys.argv[1:])
        cmd_route(bridge, text)


if __name__ == "__main__":
    main()
