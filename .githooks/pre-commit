          echo -e "${RED}   修复: 补DNA签章 #龍芯⚡️YYYY-MM-DD-功能-v1.0 · 补签名 python3 bin/lh_gpg_sign.py sign --force <文件>${NC}"
        fi
        TOTAL_EXIT=1
        ;;
    esac
  fi
else
  echo -e "${YELLOW}[!] lh_align_checker.py 未找到，跳过对齐扫描${NC}"
fi

# ============================================================
# 阶段三b · 归属名硬检查（新增文件必须含实名·P0级指令 2026-08-22）
# 背景: 老大宣布"所有以后的文件全部有归属名好吧"→ 归属名=诸葛鑫(实名)
# 规则: 新增文件(A状态)缺归属名=🔴阻塞; 修改存量文件=🟡警告(由阶段三判定)
# ============================================================
ATTRIBUTION_HARD_FAIL=0
NEW_FILES="$(git diff --cached --name-only --diff-filter=A 2>/dev/null || true)"
if [ -n "$NEW_FILES" ]; then
  # 过滤机器生成/二进制/签名文件（这些天然无归属名且不可加注释）
  ATTRIBUTION_TARGETS=$(printf '%s' "$NEW_FILES" | grep -vE '\.(asc|sig|png|jpe?g|gif|ico|pdf|zip|gz|mp4|mp3|woff2?|ttf|exe|so|dll|pyc|class|jar|jsonl?|db|sqlite3?|sha256|csv|vsix|skill)$' || true)
  if [ -n "$ATTRIBUTION_TARGETS" ]; then
    echo -e "${GREEN}🏷️  阶段三b · 归属名硬检查（新增 ${ATTRIBUTION_TARGETS}）${NC}"
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      # 只查文本文件（file 判定·防二进制误报）
      if file "$REPO_ROOT/$f" 2>/dev/null | grep -q 'text'; then
        if ! grep -qE '诸葛鑫|归属名|ZHUGEXIN' "$REPO_ROOT/$f" 2>/dev/null; then
          echo -e "${RED}  🔴 新增文件缺归属名（实名·诸葛鑫）: $f${NC}"
          ATTRIBUTION_HARD_FAIL=1
        fi
      fi
    done <<< "$ATTRIBUTION_TARGETS"
    if [ "$ATTRIBUTION_HARD_FAIL" -eq 1 ]; then
      echo -e "${RED}[x] 阶段三b失败：新增文件必须含归属名「诸葛鑫」${NC}"
      echo -e "${RED}    修复: 文件头加一行 → 归属名: 诸葛鑫 | UID9622 · 龍芯北辰${NC}"
      echo -e "${RED}    批量工具: python3 08_BIN/lh_fix_attribution.py --core --fix${NC}"
      TOTAL_EXIT=1
    else
      echo -e "${GREEN}[✓] 阶段三b通过 · 新增文件全部含归属名${NC}"
    fi
  fi
fi

# ============================================================
# 阶段四挂载 · G3 DNA链/零宽/硬回滚（pre-commit-phase4.sh）
# ============================================================
if [ -f "$REPO_ROOT/.githooks/pre-commit-phase4.sh" ]; then
  source "$REPO_ROOT/.githooks/pre-commit-phase4.sh"
elif [ -n "${HOOK_DIR:-}" ] && [ -f "$HOOK_DIR/pre-commit-phase4.sh" ]; then
  source "$HOOK_DIR/pre-commit-phase4.sh"
else
  echo -e "${YELLOW}[!] pre-commit-phase4.sh 未找到，跳过阶段四${NC}"
fi

# ============================================================
# 阶段五 · 记忆压缩守护（MEMORY.md 超限自动压缩 v1.0）
# 只对 compress 类（MEMORY.md）自动压；report 类超限仅提示不阻塞
# 正常状态零输出零开销——仅 MEMORY.md > 7500B 才触发
# ============================================================
echo -e "${GREEN}🗜️ 阶段五 · 记忆压缩守护${NC}"
if [ -f "$REPO_ROOT/bin/compress_all.py" ]; then
  MEM_SIZE="$(python3 -c "import os;print(os.path.getsize('$REPO_ROOT/.codebuddy/memory/MEMORY.md'))" 2>/dev/null || echo 0)"
  if [ "${MEM_SIZE:-0}" -gt 7500 ]; then
    echo -e "${YELLOW}[!] MEMORY.md ${MEM_SIZE}B > 7500B 安全线，自动压缩...${NC}"
    python3 "$REPO_ROOT/bin/compress_all.py" --run 2>&1 | tail -6
    git add .codebuddy/memory/MEMORY.md 2>/dev/null || true
    echo -e "${GREEN}[✓] 阶段五 · MEMORY.md 已压缩并重新 stage${NC}"
  else
    echo -e "${GREEN}[✓] 阶段五通过 · MEMORY.md ${MEM_SIZE:-0}B 在安全线内${NC}"
  fi
else
  echo -e "${YELLOW}[!] compress_all.py 未找到，跳过压缩守护${NC}"
fi

# ============================================================
# 最终裁决
# ============================================================
echo ""
if [ $TOTAL_EXIT -eq 0 ]; then
  echo -e "${GREEN}══════════════════════════════════════════════${NC}"
  echo -e "${GREEN}  🟢 永恒审计通过 · 可以提交${NC}"
  echo -e "${GREEN}══════════════════════════════════════════════${NC}"
  exit 0
else
  echo -e "${RED}══════════════════════════════════════════════${NC}"
  echo -e "${RED}  🔴 审计未通过 · 提交已阻止${NC}"
  echo -e "${RED}  紧急跳过: SKIP_AUDIT=1 git commit -m '紧急修复'${NC}"
  echo -e "${RED}══════════════════════════════════════════════${NC}"
  exit 1
fi
