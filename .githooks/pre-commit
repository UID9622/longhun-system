set -euo pipefail

# REPO_ROOT 优先用 git 自解析（兼容全局 core.hooksPath 场景；../.. 硬算在
# ~/.git-hooks 软链下会错成 /Users 导致 mkdir /Users/.git 权限失败）
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  HOOK_DIR="$(cd "$(dirname "$0")" && pwd)"
  REPO_ROOT="$(cd "$HOOK_DIR/../.." && pwd)"
fi

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

TOTAL_EXIT=0

# ============================================================
# 阶段一 · 密钥硬编码快速拦截（v1.0 原版）
# ============================================================
echo -e "${GREEN}🔑 阶段一 · 密钥硬编码扫描${NC}"

SECRET_PATTERNS=(
  'ntn_[0-9a-zA-Z]{20,}'
  'sk-[A-Za-z0-9]{30,}'
  'sk-ant-[A-Za-z0-9_-]{40,}'
  'ghp_[A-Za-z0-9]{30,}'
  'gho_[A-Za-z0-9]{30,}'
  'ghu_[A-Za-z0-9]{30,}'
  'ghs_[A-Za-z0-9]{30,}'
  'ghr_[A-Za-z0-9]{30,}'
  'github_pat_[A-Za-z0-9_]{22,}'
  'AKIA[A-Za-z0-9]{16,}'
  'AIza[A-Za-z0-9_-]{30,}'
  'ya29\.[A-Za-z0-9_-]{50,}'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
)

KEY_BLOCKED=0
# 性能优化(2026-08-22): 文件列表只取一次(原13个pattern循环各取一次git diff)
#   + 模式合并为单个扩展正则 + xargs -0 批量扫描(原-I{}逐个fork=23万进程)。
#   语义不变：同样的模式、同样的排除规则，只是不再重复跑 git diff。
STAGED_FILES=$(git -C "$REPO_ROOT" diff --cached --name-only -z 2>/dev/null || true)
if [ -n "$STAGED_FILES" ]; then
  COMBINED_PATTERN=$(IFS='|'; echo "${SECRET_PATTERNS[*]}")
  HITS=$(
    cd "$REPO_ROOT" && printf '%s' "$STAGED_FILES" \
      | xargs -0 grep -lE "$COMBINED_PATTERN" 2>/dev/null || true
  )
  if [ -n "$HITS" ]; then
    while IFS= read -r f; do
      REAL_LEAKS=$(cd "$REPO_ROOT" && grep -nE "$COMBINED_PATTERN" "$f" 2>/dev/null | grep -vE "ntn_xxxxxxxx|ntn_\.\.\.|ntn_test|ntn_.*example|placeholder|redacted|示例|占位|\[REDACTED\]|xxxxx" || true)
      if [ -n "$REAL_LEAKS" ]; then
        echo -e "${RED}  🔴 密钥泄露: $f${NC}"
        echo -e "$REAL_LEAKS" | while read line; do
          echo -e "  ${RED}$(echo "$line" | sed 's/ntn_[0-9a-zA-Z]\{8,\}/[SECRET-REDACTED]/g')${NC}"
        done
        KEY_BLOCKED=1
      fi
    done <<< "$HITS"
  fi
fi

if [ "$KEY_BLOCKED" -eq 1 ]; then
  echo -e "${RED}[x] 阶段一失败：检测到硬编码密钥${NC}"
  TOTAL_EXIT=1
else
  echo -e "${GREEN}[✓] 阶段一通过${NC}"
fi

# ============================================================
# 阶段一b · lh_secret_guard 精确扫描（v1.0 · 2026-08-17 焊死）
#   同样的错不能放第二次：模式 + 已泄露值黑名单 双查
# ============================================================
echo ""
echo -e "${GREEN}🔐 阶段一b · 密钥泄露防护引擎（lh_secret_guard）${NC}"

SECRET_GUARD="$REPO_ROOT/bin/lh_secret_guard.py"
if [ -f "$SECRET_GUARD" ]; then
  set +e
  python3 "$SECRET_GUARD" scan --staged >/tmp/lh_secret_guard_precommit.log 2>&1
  guard_exit=$?
  set -e
  cat /tmp/lh_secret_guard_precommit.log | tail -25
  if [ $guard_exit -eq 1 ]; then
    echo -e "${RED}[x] 阶段一b失败：检测到泄露密钥/黑名单值 · 提交已阻止${NC}"
    echo -e "${RED}    处理: 移除明文 → 改用 bin/lh_secrets_loader.py 读取${NC}"
    TOTAL_EXIT=1
  elif [ $guard_exit -eq 2 ] || [ $guard_exit -eq 3 ]; then
    echo -e "${YELLOW}[!] 阶段一b异常（exit=$guard_exit）· 不阻塞提交但请检查${NC}"
  else
    echo -e "${GREEN}[✓] 阶段一b通过 · 暂存区无泄露${NC}"
  fi
else
  echo -e "${YELLOW}[!] lh_secret_guard.py 未找到，跳过精确扫描${NC}"
fi

# ============================================================
# 阶段二 · 永恒审计三问（Kimi 审查修正版）
# ============================================================
echo ""
echo -e "${GREEN}🧬 阶段二 · 永恒审计三问${NC}"

AUDIT_DIR="$REPO_ROOT/.git/audit"
AUDIT_LOG="$AUDIT_DIR/audit.log"
SKIP_LOG="$AUDIT_DIR/skip.log"
AUDIT_SCRIPT="$AUDIT_DIR/audit_engine.py"
mkdir -p "$AUDIT_DIR"

# 跳过检查
if [ "${SKIP_AUDIT:-0}" = "1" ] || [ -f "$AUDIT_DIR/skip.flag" ]; then
  echo "⚠️  跳过审计（紧急模式·已留痕）"
  echo "$(date '+%Y-%m-%d %H:%M:%S') | 跳过审计 | 用户: $(git -C "$REPO_ROOT" config user.name 2>/dev/null || echo 'unknown')" >> "$SKIP_LOG"
  exit $TOTAL_EXIT
fi

