# 设置定时监控
_setup_monitoring() {
    info "设置定时监控..."

    # 创建 crontab 任务
    CRON_JOB="0 */6 * * * $HOME/.longhun/scripts/huawei-billing-check.sh >> $HOME/.longhun/cron.log 2>&1"

    # 写入监控脚本
    cat > "$HOME/.longhun/scripts/huawei-billing-check.sh" << 'MONEOF'
#!/bin/bash
# 华为云扣费监控脚本
LOG="$HOME/.longhun/billing-monitor.log"
echo "$(date) | 自动检查华为云资源状态" >> "$LOG"
# 这里可以调用华为云 API 获取实际费用
# 目前先记录时间戳，后续接入 API
echo "$(date) | 监控完成 | 请手动登录控制台核对" >> "$LOG"
MONEOF

    chmod +x "$HOME/.longhun/scripts/huawei-billing-check.sh"

    # 添加到 crontab (如果不存在)
    (crontab -l 2>/dev/null | grep -v "huawei-billing-check"; echo "$CRON_JOB") | crontab -

    ok "定时监控已设置 (每6小时检查一次)"
}

