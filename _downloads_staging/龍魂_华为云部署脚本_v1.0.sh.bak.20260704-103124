set -e

# ── 配置区 ──
# 从本地密钥文件读取（用户已存本地）
HUAWEI_KEY_FILE="$HOME/.longhun/huawei-credentials.json"
DEPLOY_LOG="$HOME/.longhun/deploy-$(date +%Y%m%d-%H%M%S).log"

# 龍魂系统路径
LONGHUN_ROOT="$HOME/longhun-system"
CLOUD_CONFIG="$LONGHUN_ROOT/config/cloud"

# ── 颜色定义 ──
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# ── 函数区 ──

log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$DEPLOY_LOG"
}

ok() { echo -e "${GREEN}✓ $1${NC}"; log "[OK] $1"; }
warn() { echo -e "${YELLOW}⚠ $1${NC}"; log "[WARN] $1"; }
err() { echo -e "${RED}✗ $1${NC}"; log "[ERR] $1"; exit 1; }
info() { echo -e "${BLUE}ℹ $1${NC}"; log "[INFO] $1"; }

# 检查本地密钥
_check_credentials() {
    info "检查华为云密钥..."
    if [[ ! -f "$HUAWEI_KEY_FILE" ]]; then
        err "密钥文件不存在: $HUAWEI_KEY_FILE"
    fi

    # 解析密钥
    AK=$(python3 -c "import json; print(json.load(open('$HUAWEI_KEY_FILE'))['access_key'])")
    SK=$(python3 -c "import json; print(json.load(open('$HUAWEI_KEY_FILE'))['secret_key'])")
    REGION=$(python3 -c "import json; print(json.load(open('$HUAWEI_KEY_FILE')).get('region','cn-east-3'))")
    PROJECT_ID=$(python3 -c "import json; print(json.load(open('$HUAWEI_KEY_FILE')).get('project_id',''))")

    if [[ -z "$AK" || -z "$SK" ]]; then
        err "密钥解析失败，检查 $HUAWEI_KEY_FILE 格式"
    fi

    export HUAWEI_ACCESS_KEY="$AK"
    export HUAWEI_SECRET_KEY="$SK"
    export HUAWEI_REGION="$REGION"
    export HUAWEI_PROJECT_ID="$PROJECT_ID"

    ok "密钥加载成功 | 区域: $REGION"
}

# 安装华为云 CLI
_install_hcloud() {
    info "检查华为云 CLI..."
    if command -v hcloud &> /dev/null; then
        ok "华为云 CLI 已安装: $(hcloud version)"
        return 0
    fi

    info "正在安装华为云 CLI..."
    # macOS ARM64 (M4 Max)
    curl -sSL https://hwcloudcli.obs.cn-north-1.myhuaweicloud.com/install.sh | bash

    # 添加到 PATH
    export PATH="$PATH:$HOME/hcloud"
    echo 'export PATH="$PATH:$HOME/hcloud"' >> ~/.zshrc

    ok "华为云 CLI 安装完成"
}

# 配置华为云 CLI
_config_hcloud() {
    info "配置华为云 CLI..."
    hcloud configure set access_key "$HUAWEI_ACCESS_KEY"
    hcloud configure set secret_key "$HUAWEI_SECRET_KEY"
    hcloud configure set region "$HUAWEI_REGION"
    ok "华为云 CLI 配置完成"
}

