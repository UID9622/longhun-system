# 获取方式:
#   1. 在Notion中创建/打开L0数据库页面
#   2. 从页面URL中提取32位数据库ID
#   3. URL格式: https://www.notion.so/xxx/<DB_ID>?v=...
#   4. 将32位ID粘贴到下方
# ------------------------------------------------------------
DB_LU=xxxxxxxx

