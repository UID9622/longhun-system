{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DragonSoul Knowledge Graph - Edge Schema",
  "description": "Schema for edges (relationships) in the DragonSoul knowledge graph",
  "type": "object",
  "required": [
    "edge_id",
    "source",
    "target",
    "relation",
    "description",
    "dna"
  ],
  "properties": {
    "edge_id": {
      "type": "string",
      "description": "Unique edge identifier, format: edge_{4-digit sequence}"
    },
    "source": {
      "type": "string",
      "description": "Source node ID"
    },
    "target": {
      "type": "string",
      "description": "Target node ID"
    },
    "relation": {
      "type": "string",
      "enum": [
        "DEPENDS_ON",
        "TRIGGERS",
        "OVERRIDES",
        "CONTAINS",
        "LEADS_TO",
        "ENFORCES",
        "PROHIBITS",
        "ENABLES",
        "VIOLATES",
        "RESULTS_IN",
        "AUDITS",
        "IS_PARENT_OF",
        "IS_SUBTYPE_OF"
      ],
      "description": "Relationship type between nodes"
    },
    "description": {
      "type": "string",
      "description": "Human-readable description of the relationship"
    },
    "properties": {
      "type": "object",
      "description": "Edge attributes",
      "properties": {
        "weight": {
          "type": "number",
          "description": "Relationship strength (0-10)"
        },
        "conditional": {
          "type": "boolean",
          "description": "Whether this edge is conditional"
        },
        "bidirectional": {
          "type": "boolean",
          "description": "Whether the relationship is bidirectional"
        }
      }
    },
    "dna": {
      "type": "string",
      "description": "DNA追溯码 for this edge"
    }
  }
}