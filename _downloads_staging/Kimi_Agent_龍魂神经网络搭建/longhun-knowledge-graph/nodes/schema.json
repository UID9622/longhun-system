{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DragonSoul Knowledge Graph - Node Schema",
  "description": "Schema for nodes in the DragonSoul (UID9622) knowledge graph",
  "type": "object",
  "required": [
    "node_id",
    "node_type",
    "name",
    "description",
    "layer",
    "properties",
    "state",
    "version",
    "dna",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "node_id": {
      "type": "string",
      "description": "Unique node identifier, format: {type}_{3-digit sequence}",
      "pattern": "^[a-z]+_[0-9]{3}$"
    },
    "node_type": {
      "type": "string",
      "enum": [
        "TERM",
        "CLAIM",
        "COMMITMENT",
        "BEHAVIOR",
        "MECHANISM",
        "AUDIT",
        "ROOT"
      ],
      "description": "Node classification type"
    },
    "name": {
      "type": "string",
      "description": "Human-readable display name (Chinese)"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the node"
    },
    "layer": {
      "type": "string",
      "enum": [
        "sovereignty",
        "governance",
        "mechanism"
      ],
      "description": "Architectural layer this node belongs to"
    },
    "properties": {
      "type": "object",
      "description": "Extended attributes (weight, percentage, severity, etc.)",
      "properties": {
        "weight": {
          "type": "number",
          "description": "Node importance weight (0-100)"
        },
        "severity": {
          "type": "string",
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ]
        },
        "auto_execute": {
          "type": "boolean",
          "description": "Whether this node triggers auto-execution"
        },
        "time_limit_days": {
          "type": "integer",
          "description": "Time limit in days for remediation"
        },
        "category": {
          "type": "string",
          "description": "Sub-category label"
        }
      }
    },
    "state": {
      "type": "string",
      "description": "Current state (must match state_machine states)"
    },
    "version": {
      "type": "string",
      "description": "Semantic version of this node definition"
    },
    "dna": {
      "type": "string",
      "description": "DNA追溯码: #龍芯⚡️{YYYY-MM-DD}-LHKG-{TYPE}-{ID}-v1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    }
  }
}