{
  "name": "DragonSoul Node State Machine",
  "description": "State transitions for all knowledge graph nodes",
  "version": "1.0",
  "states": [
    {
      "name": "active",
      "description": "节点处于活跃状态，正常运作",
      "color": "#00C853",
      "terminal": false
    },
    {
      "name": "pending",
      "description": "节点待激活，等待条件满足",
      "color": "#FFD600",
      "terminal": false
    },
    {
      "name": "suspended",
      "description": "节点被暂停，暂时不生效",
      "color": "#FF9100",
      "terminal": false
    },
    {
      "name": "terminated",
      "description": "节点已终止，永久失效",
      "color": "#9E9E9E",
      "terminal": true
    },
    {
      "name": "overridden",
      "description": "节点被覆盖，由更高优先级节点取代",
      "color": "#D50000",
      "terminal": false
    },
    {
      "name": "merged",
      "description": "节点已合并入其他节点",
      "color": "#2962FF",
      "terminal": true
    }
  ],
  "transitions": [
    {
      "from": "pending",
      "to": "active",
      "trigger": "auto_or_manual",
      "description": "条件满足后激活"
    },
    {
      "from": "active",
      "to": "suspended",
      "trigger": "admin_or_event",
      "description": "管理操作或事件暂停"
    },
    {
      "from": "suspended",
      "to": "active",
      "trigger": "admin_restore",
      "description": "管理操作恢复"
    },
    {
      "from": "active",
      "to": "terminated",
      "trigger": "violation_or_vote",
      "description": "违规或投票终止"
    },
    {
      "from": "suspended",
      "to": "terminated",
      "trigger": "timeout",
      "description": "超时自动终止"
    },
    {
      "from": "active",
      "to": "overridden",
      "trigger": "higher_priority",
      "description": "高优先级覆盖"
    },
    {
      "from": "overridden",
      "to": "active",
      "trigger": "priority_restore",
      "description": "优先级恢复"
    },
    {
      "from": "overridden",
      "to": "terminated",
      "trigger": "override_finalize",
      "description": "覆盖最终化"
    },
    {
      "from": "pending",
      "to": "merged",
      "trigger": "merge_action",
      "description": "合并入其他节点"
    },
    {
      "from": "active",
      "to": "merged",
      "trigger": "merge_action",
      "description": "合并入其他节点"
    },
    {
      "from": "suspended",
      "to": "merged",
      "trigger": "merge_action",
      "description": "合并入其他节点"
    }
  ],
  "transition_matrix": {
    "active": {
      "active": false,
      "pending": false,
      "suspended": true,
      "terminated": true,
      "overridden": true,
      "merged": true
    },
    "pending": {
      "active": true,
      "pending": false,
      "suspended": false,
      "terminated": false,
      "overridden": false,
      "merged": true
    },
    "suspended": {
      "active": true,
      "pending": false,
      "suspended": false,
      "terminated": true,
      "overridden": false,
      "merged": true
    },
    "terminated": {
      "active": false,
      "pending": false,
      "suspended": false,
      "terminated": false,
      "overridden": false,
      "merged": false
    },
    "overridden": {
      "active": true,
      "pending": false,
      "suspended": false,
      "terminated": true,
      "overridden": false,
      "merged": false
    },
    "merged": {
      "active": false,
      "pending": false,
      "suspended": false,
      "terminated": false,
      "overridden": false,
      "merged": false
    }
  }
}