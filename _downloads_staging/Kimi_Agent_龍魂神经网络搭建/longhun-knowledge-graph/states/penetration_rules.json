{
  "metadata": {
    "name": "状态穿透规则",
    "description": "上层节点状态变更时自动影响下层节点",
    "version": "v1.0",
    "created_at": "2026-06-27T00:00:00Z",
    "dna": "#龍芯⚡️2026-06-27-LHKG-PENETRATION-v1.0"
  },
  "rules": [
    {
      "rule_id": "penetration_001",
      "rule_name": "主权层→治理层状态穿透",
      "description": "当主权层节点状态变为 suspended 时，其下所有 governance 层节点状态变为 pending",
      "trigger": {
        "source_layer": "A",
        "source_status": "suspended",
        "affected_scope": "all_governance_nodes_in_B"
      },
      "response": {
        "target_layer": "B",
        "target_layer_filter": "governance",
        "new_status": "pending",
        "propagation": "cascade_all"
      },
      "priority": "critical",
      "dna_trace": "#龍芯⚡️2026-06-27-LHKG-PENETRATION-PN001-v1.0",
      "example": "sov_state_001.status='suspended' → principle_001~principle_005, contrib_001~contrib_004 全部变为 pending"
    },
    {
      "rule_id": "penetration_002",
      "rule_name": "治理层→机制层状态穿透",
      "description": "当治理层节点状态变为 terminated 时，关联的 mechanism 层节点状态变为 suspended",
      "trigger": {
        "source_layer": "B",
        "source_status": "terminated",
        "affected_scope": "related_mechanism_nodes"
      },
      "response": {
        "target_layer": "B",
        "target_layer_filter": "mechanism",
        "new_status": "suspended",
        "propagation": "related_only"
      },
      "priority": "high",
      "dna_trace": "#龍芯⚡️2026-06-27-LHKG-PENETRATION-PN002-v1.0",
      "example": "fuse_b001.status='terminated' → fuse_b002~fuse_b004, reward_001~reward_004 全部变为 suspended"
    },
    {
      "rule_id": "penetration_003",
      "rule_name": "治理层恢复联动",
      "description": "当主权层节点状态恢复为 active 时，治理层 governance 节点自动恢复为 active",
      "trigger": {
        "source_layer": "A",
        "source_status": "active",
        "previous_status": "suspended"
      },
      "response": {
        "target_layer": "B",
        "target_layer_filter": "governance",
        "new_status": "active",
        "propagation": "cascade_all"
      },
      "priority": "high",
      "dna_trace": "#龍芯⚡️2026-06-27-LHKG-PENETRATION-PN003-v1.0",
      "example": "sov_state_001.status='active' → 所有 governance 层节点恢复 active"
    }
  ]
}