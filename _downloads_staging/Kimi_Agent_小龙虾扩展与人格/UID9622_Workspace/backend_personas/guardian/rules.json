{
  "schema_version": "1.0.0",
  "last_updated": "2025-12-14T00:00:00+08:00",
  "dna": "#GUARDIAN-AGENT-CONFIG-20251214-001",
  "description": "上帝之眼·守护者 P-AK-GUARDIAN 安全规则配置",
  "metadata": {
    "author": "UID9622系统部署工程师",
    "system": "龍魂体系",
    "classification": "INTERNAL-SECURITY"
  },
  "red_lines": [
    {
      "id": "RL-001",
      "name": "未授权访问私密数据",
      "pattern": "unauthorized_private_access",
      "action": "BLOCK",
      "severity": "CRITICAL",
      "priority": 1,
      "enabled": true,
      "description": "检测到未授权访问私密数据，立即阻断操作并记录审计日志。触发条件：主体尝试访问标记为private/sensitive/confidential的资源且无有效授权。",
      "response": {
        "immediate_action": "阻断操作",
        "log_level": "CRITICAL",
        "alert_channels": ["audit_log", "guardian_log"],
        "escalation": false
      }
    },
    {
      "id": "RL-002",
      "name": "违反北辰-B协议",
      "pattern": "beichen_b_violation",
      "action": "BLOCK",
      "severity": "CRITICAL",
      "priority": 1,
      "enabled": true,
      "description": "违反北辰-B协议（BeiChen-B Protocol）的安全规定。北辰-B协议是龍魂体系核心安全协议，任何违反行为均视为严重安全事件。",
      "response": {
        "immediate_action": "阻断操作",
        "log_level": "CRITICAL",
        "alert_channels": ["audit_log", "guardian_log"],
        "escalation": true,
        "escalation_target": "security_council"
      }
    },
    {
      "id": "RL-003",
      "name": "恶意篡改DNA追溯码",
      "pattern": "dna_tampering",
      "action": "BLOCK",
      "severity": "CRITICAL",
      "priority": 1,
      "enabled": true,
      "description": "检测到DNA追溯码被恶意篡改、伪造或删除。DNA追溯码是龍魂体系操作审计的核心标识，任何形式的篡改均为严重安全事件。",
      "response": {
        "immediate_action": "阻断操作",
        "log_level": "CRITICAL",
        "alert_channels": ["audit_log", "guardian_log"],
        "escalation": true,
        "escalation_target": "security_council"
      }
    },
    {
      "id": "RL-004",
      "name": "连续3次相同投诉",
      "pattern": "repeated_complaint_x3",
      "action": "TRIGGER_JURY",
      "severity": "HIGH",
      "priority": 2,
      "enabled": true,
      "description": "同一类投诉累计达到3次，触发人民陪审团审议机制。陪审团将对投诉进行评估并作出裁决。",
      "response": {
        "immediate_action": "触发人民陪审团",
        "log_level": "HIGH",
        "alert_channels": ["audit_log", "guardian_log", "jury_system"],
        "jury_config": {
          "panel_size": 5,
          "review_timeout_hours": 48,
          "quorum_required": 3
        }
      }
    }
  ],
  "detection_patterns": {
    "unauthorized_private_access": [
      "(?i)未授权.*私密",
      "(?i)unauthorized.*private",
      "(?i)bypass.*auth.*private",
      "(?i)access.*private.*without.*auth",
      "(?i)越权.*访问",
      "(?i)privilege.*escalation.*private"
    ],
    "beichen_b_violation": [
      "(?i)北辰-B.*违反",
      "(?i)beichen-b.*violation",
      "(?i)breach.*protocol.*B",
      "(?i)violate.*beichen",
      "(?i)北辰.*协议.*破",
      "(?i)break.*beichen.*protocol"
    ],
    "dna_tampering": [
      "(?i)篡改.*DNA",
      "(?i)tamper.*dna",
      "(?i)fabricate.*trace",
      "(?i)forge.*dna",
      "(?i)修改.*追溯码",
      "(?i)delete.*audit.*trail"
    ],
    "repeated_complaint_x3": [
      "(?i)第3次投诉",
      "(?i)第三次.*投诉",
      "(?i)complaint.*3rd.*time",
      "(?i)repeated.*complaint.*3"
    ],
    "suspicious_activity": [
      "(?i)异常登录",
      "(?i)暴力破解",
      "(?i)sql注入",
      "(?i)xss攻击",
      "(?i)越权访问",
      "(?i)未授权.*访问",
      "(?i)abnormal.*login",
      "(?i)brute.*force",
      "(?i)sql.*injection",
      "(?i)xss.*attack"
    ],
    "data_exfiltration": [
      "(?i)数据.*外传",
      "(?i)批量.*导出",
      "(?i)大量.*下载",
      "(?i)data.*exfiltration",
      "(?i)bulk.*export.*sensitive"
    ]
  },
  "thresholds": {
    "complaint_trigger_count": 3,
    "failed_login_threshold": 5,
    "file_integrity_alert_threshold": 1,
    "anomaly_detection_window_seconds": 300
  },
  "monitoring_config": {
    "check_interval_seconds": 60,
    "audit_archive_interval_seconds": 3600,
    "baseline_update_after_check": true,
    "scan_hidden_files": false,
    "hash_algorithm": "sha256",
    "excluded_patterns": [
      ".*\\.tmp$",
      ".*\\.log$",
      ".*~$",
      "^\\.",
      "/logs/",
      "/\\.git/",
      "__pycache__",
      "\\.pyc$"
    ]
  },
  "audit_config": {
    "log_retention_days": 90,
    "archive_format": "jsonl",
    "max_archive_file_size_mb": 100,
    "compression_enabled": true,
    "include_dna_in_every_record": true
  },
  "enforcement_levels": {
    "green": {
      "symbol": "🟢",
      "description": "正常/合规",
      "action": "记录日志",
      "notification": false
    },
    "yellow": {
      "symbol": "🟡",
      "description": "警告/异常",
      "action": "记录警告日志，增加监控频率",
      "notification": true,
      "notification_channels": ["guardian_log"]
    },
    "red": {
      "symbol": "🔴",
      "description": "严重违规",
      "action": "立即阻断，记录CRITICAL日志，触发告警",
      "notification": true,
      "notification_channels": ["audit_log", "guardian_log", "alert_system"]
    }
  }
}
