.article-header {
  background: white;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
}

.article-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a2e;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.article-meta {
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.article-content {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.06);
  font-size: 30rpx;
  line-height: 1.8;
  color: #333;
}

.loading, .error {
  text-align: center;
  padding: 60rpx;
  color: #999;
  font-size: 28rpx;
}
