    ['实', ['实事求是求真务', '实至名归名实符', '实迷途其未远觉']],
    ['强', ['强弩之末势不能', '强词夺理不讲理', '强将手下无弱兵']],
    ['胜', ['胜不骄败不馁', '胜券在握把握大', '胜日寻芳泗水滨']],
    ['成', ['成竹在胸有把握', '成败得失人生常', '成也萧何败也萧']],
    ['功', ['功成名就功名成', '功败垂成将成功', '功不唐捐努力不']],
    ['名', ['名副其实其实名', '名垂青史青史名', '名岂文章著官应']],
    ['利', ['利令智昏贪利益', '利国利民为人民', '利锁名缰束缚人']],
    ['家', ['家家户户户户家', '家国情怀情怀家', '家书抵万金']],
    ['书', ['书山有路勤为径', '书香门第出英才', '书到用时方恨少']],
    ['文', ['文以载道道载文', '文采飞扬飞扬文', '文章千古事得失']],
    ['武', ['武功盖世盖世武', '文武双全双全文', '武侯祠下春水深']],
    ['诗', ['诗情画意画意诗', '诗书继世继世诗', '诗家清景在新春']],
    ['酒', ['酒逢知己千杯少', '酒入愁肠愁更愁', '酒不醉人人自醉']],
    ['剑', ['剑气纵横三万里', '剑胆琴心侠客风', '剑阁峥嵘而崔嵬']],
    ['琴', ['琴棋书画样样通', '琴瑟和鸣夫妻和', '琴声瑟瑟夜月寒']],
    ['棋', ['棋逢对手将遇才', '棋高一着技胜人', '棋局纵横变化多']],
    ['画', ['画栋雕梁建筑美', '画眉深浅入时无', '画船听雨眠']]
  ]);

  generate(headWord: string, style: string = '七言', theme: string = '通用'): AcrosticPoemData {
    const lines: string[] = [];
    const chars = headWord.split('');

    for (let i = 0; i < chars.length; i++) {
      const char = chars[i];
      const candidates = this.poemLines.get(char);
      if (candidates && candidates.length > 0) {
        const line = candidates[Math.floor(Math.random() * candidates.length)];
        lines.push(line);
      } else {
        // 未收录的字，使用空模板
        lines.push(`${char}___待赋新诗`);
      }
    }

    return new AcrosticPoemData({ headWord, lines, theme, style });
  }

  getAvailableChars(): string[] {
    return Array.from(this.poemLines.keys());
  }

  hasChar(char: string): boolean {
    return this.poemLines.has(char);
  }

  getLineCount(): number {
    let count = 0;
    this.poemLines.forEach(v => count += v.length);
    return count;
  }
}

export const acrosticEngine = new AcrosticEngine();
