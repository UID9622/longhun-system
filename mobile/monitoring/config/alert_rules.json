{
  "_dna": "2026-06-21-MOBILE-ALERT_RULES-v1.0",
  "rules": [
    {
      "id": "critical_error_spike",
      "name": "严重错误激增",
      "metric": "error_count",
      "threshold": 10,
      "window": 60,
      "severity": "critical"
    },
    {
      "id": "api_latency_spike",
      "name": "API延迟激增",
      "metric": "api_response_time",
      "threshold": 5000,
      "window": 300,
      "severity": "high"
    },
    {
      "id": "resource_exhaustion",
      "name": "资源耗尽",
      "metric": "cpu_usage",
      "threshold": 90,
      "window": 120,
      "severity": "high"
    }
  ]
}
