# 子命令處理
# ═══════════════════════════════════════════════════════════

def cmd_status():
    """系統狀態面板。"""
    os.chdir(LH_ROOT)
    
    # Git 資訊
    try:
        branch = subprocess.run(
            ["git", "symbolic-ref", "--short", "HEAD"],
            capture_output=True, text=True
        ).stdout.strip() or "未知"
        last_commit = subprocess.run(
            ["git", "log", "-1", "--format=%h %s (%ci)"],
            capture_output=True, text=True
        ).stdout.strip() or "未知"
        diff = subprocess.run(["git", "diff", "--quiet"], capture_output=True)
        staged = subprocess.run(["git", "diff", "--staged", "--quiet"], capture_output=True)
        git_status = "✅ 乾淨" if (diff.returncode == 0 and staged.returncode == 0) else "📝 有未提交改動"
    except Exception:
        branch, last_commit, git_status = "?", "?", "?"

    print(f"""
🐉 龍魂 {VERSION} · 完整狀態面板
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
📁 項目根目錄: {LH_ROOT}
🌿 Git 分支:  {branch}
🕐 最近提交:  {last_commit}
📊 Git 狀態:  {git_status}
""")

    # 核心組件檢查
    checks = [
        ("OPS 操作台", OPS_CONSOLE),
        ("CNSH 終端", LH_ROOT / "cnsh-terminal" / "cnsh_terminal_v5.py"),
        ("CNSH 編輯器", LH_ROOT / "cnsh-editor" / "cnsh_editor_engine_v2.0.py"),
        ("共生體服務", LH_ROOT / "tools" / "longhun_symbiote_server.py"),
        ("神經網絡橋接", CNSH_CORE / "neural_agent_bridge.py"),
        ("智能體編排器", AGENTS_DIR / "orchestrator.py"),
    ]
    for name, path in checks:
        ok = "✅" if path.exists() else "❌"
        print(f"   {ok} {name}")

    # Agents 統計
    orch = load_orchestrator()
    if orch:
        agents = orch.list_agents()
        layers = {}
        for a in agents:
            l = a.get("layer", "?")
            layers[l] = layers.get(l, 0) + 1
        print(f"\n🧬 Agents: {len(agents)} 個已註冊")
        for l in ["L1", "L2", "L3"]:
            if l in layers:
                print(f"   {l}: {layers[l]} 個")
    
    # 共生體服務狀態
    try:
        pid = subprocess.run(
            ["lsof", "-ti:9627"], capture_output=True, text=True
        ).stdout.strip()
        if pid:
            print(f"\n🧬 共生體服務: 🟢 運行中 (PID: {pid})")
            print(f"   🌐 http://127.0.0.1:9627/symbiote")
        else:
            print(f"\n🧬 共生體服務: 🔴 未運行 · lh sym start 啟動")
    except Exception:
        pass

    # 最近提交
    print(f"\n📝 最近 5 條提交:")
    try:
        log = subprocess.run(
            ["git", "log", "--oneline", "-5"],
            capture_output=True, text=True
        ).stdout
        for line in log.strip().split("\n"):
            if line:
                print(f"   {line}")
    except Exception:
        print("   (無法讀取)")
    
    print()


def cmd_health():
    """健康全景：神經網絡 + Agents。"""
    neural = load_neural_bridge()
    
    print(f"\n🧬 龍魂共生體 · 健康全景")
    print(f"{'─' * 50}")
    
    if neural:
        pano = neural.health_panorama()
        
        # 神經網絡
        nn = pano.get("neural", {})
        online = pano.get("neural_online", False)
        print(f"  神經網絡: {'🟢 在線' if online else '🔴 離線'}")
        if nn:
            print(f"  節點: {nn.get('nodes_total', 0)} · "
                  f"健康: {nn.get('healthy', 0)} · "
                  f"待啟: {nn.get('standby', 0)} · "
                  f"異常: {nn.get('error', 0)}")
            print(f"  健康率: {nn.get('health_rate', 0)}% · "
                  f"憲法層: {'🟢' if nn.get('constitution_ok') else '🔴'}")
            
            wx = nn.get("wuxing_health", {})
            if wx:
                print(f"  五行分布:")
                for wx_name, stats in wx.items():
                    bar = "█" * int(stats['rate'] / 10) + "░" * (10 - int(stats['rate'] / 10))
                    print(f"    {wx_name:6s} {bar} {stats['rate']}% "
                          f"({stats['healthy']}/{stats['total']})")
        
        # Agents
        print(f"\n  Agents: {pano.get('agents_total', 0)} 個")
        layers = pano.get("agents_layers", {})
        print(f"    L1: {layers.get('L1', 0)} · "
              f"L2: {layers.get('L2', 0)} · "
              f"L3: {layers.get('L3', 0)}")
        print(f"  憲法層: {'🟢 穩固' if pano.get('constitution_ok') else '🔴 異常'}")
    else:
        # 降級：只用 orchestrator
        orch = load_orchestrator()
        if orch:
            agents = orch.list_agents()
            print(f"  神經網絡: 🟡 未加載")
            print(f"  Agents: {len(agents)} 個")
        else:
            print("  ❌ 無可用路由引擎")
    
    # Dashboard 語法巡檢（記錯本 JS-SYNTAX-001/002）— 全項目掃描
    print(f"\n  📋 JS 語法巡檢（記錯本 JS-SYNTAX）:")
    try:
        import glob as _glob
        html_files = []
        for pattern in ['web/**/*.html', 'L5_服务层/**/*.html', 'L5_服务层/**/p0-controls/*.html', 'L5_服务层/**/portal/*.html', 'L5_服务层/**/portal/**/*.html']:
            html_files.extend(_glob.glob(str(LH_ROOT / pattern), recursive=True))
        html_files = sorted(set(html_files))
        
        # 快速過濾：只掃包含 escHtml 的文件（增大預讀窗口覆蓋大型 HTML）
        target_files = []
        for fpath in html_files:
            try:
                with open(fpath) as f:
                    if 'escHtml' in f.read(65536):
                        target_files.append(fpath)
            except Exception:
                pass
        
        all_issues = {}
        for fpath in target_files:
            try:
                content = open(fpath).read()
                lines = content.split('\n')
                issues = []
                for i, line in enumerate(lines):
                    s = line.strip()
                    if 'escHtml(`' in s:
                        found_close = False
                        for j in range(i, min(i+30, len(lines))):
                            closing = lines[j].rstrip()
                            if '`);' in closing or closing.endswith('`)') or closing.endswith('`);'):
                                found_close = True
                                break
                        if not found_close:
                            issues.append(f'    L{i+1}: escHtml(`) 缺收口')
                    if 'escHtml(' in s and '.map(' in s and '=> {' in s:
                        issues.append(f'    L{i+1}: escHtml + map 嵌套風險')
                if issues:
                    rel = fpath.replace(str(LH_ROOT)+'/', '')
                    all_issues[rel] = issues
            except Exception:
                pass
        
        if all_issues:
            print(f"  🔴 發現 {sum(len(v) for v in all_issues.values())} 個語法問題 ({len(all_issues)} 文件):")
            for fname, iss in sorted(all_issues.items()):
                print(f"  📄 {fname}:")
                for i in iss:
                    print(i)
            print(f"  📋 參見: L8_治理层/记错本.md → JS-SYNTAX-001/002")
        else:
            print(f"  🟢 全項目語法正常 (掃描 {len(target_files)}/{len(html_files)} 個 HTML)")
    except Exception as e:
        print(f"  ⚠️ 語法掃描失敗: {e}")

    print(f"{'─' * 50}\n")


def cmd_symbiote(action: str = "status"):
    """共生體服務管理。"""
    symbiote_path = LH_ROOT / "tools" / "longhun_symbiote_server.py"
    
    if action in ("status", ""):
        try:
            result = subprocess.run(
                ["lsof", "-ti:9627"], capture_output=True, text=True
            )
            pid = result.stdout.strip()
            if pid:
                print(f"🧬 共生體服務: 🟢 運行中 (PID: {pid})")
                print(f"   🌐 http://127.0.0.1:9627/symbiote")
                # 健康檢查
                import urllib.request
                try:
                    req = urllib.request.Request("http://127.0.0.1:9627/api/health")
                    with urllib.request.urlopen(req, timeout=3) as resp:
                        if resp.status == 200:
                            print(f"   ✅ API 健康檢查通過")
                except Exception:
                    print(f"   🟡 API 端口可達但健康檢查失敗")
            else:
                print(f"🧬 共生體服務: 🔴 未運行")
                print(f"   啟動: lh sym start")
        except Exception as e:
            print(f"❌ 檢查失敗: {e}")
    
    elif action == "start":
        if not symbiote_path.exists():
            print(f"❌ 共生體服務腳本未找到: {symbiote_path}")
            return
        print("🧬 啟動共生體服務...")
        subprocess.Popen(
            [sys.executable, str(symbiote_path)],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        time.sleep(2)
        cmd_symbiote("status")
    
    elif action == "stop":
        print("🧹 停止共生體服務...")
        subprocess.run(["lsof", "-ti:9627"], capture_output=True, text=True)
        result = subprocess.run(
            ["lsof", "-ti:9627"], capture_output=True, text=True
        )
        for pid in result.stdout.strip().split("\n"):
            if pid:
                subprocess.run(["kill", "-9", pid], capture_output=True)
        print("🟢 已停止")
    
    elif action == "restart":
        cmd_symbiote("stop")
        time.sleep(1)
        cmd_symbiote("start")
    
    else:
        print("用法: lh sym [status|start|stop|restart]")


def cmd_fuse(args: list):
    """熔斷控制。"""
    fuse_path = LH_ROOT / "bin" / "fuse_control.py"
    if fuse_path.exists():
        subprocess.run([sys.executable, str(fuse_path)] + args)
    else:
        print(f"❌ 熔斷控制器未找到: {fuse_path}")


def cmd_agents_list():
    """列出所有已注册 Agent。"""
    orch = load_orchestrator()
    if not orch:
        print("❌ 無法加載 Agent 編排器")
        return
    
    agents = orch.list_agents()
    print(f"\n🧬 龍魂 Agents · 共 {len(agents)} 個\n")
    
    # 按層級分組
    for layer in ["L1", "L2", "L3"]:
        layer_agents = [a for a in agents if a.get("layer") == layer]
        if not layer_agents:
            continue
        icons = {"L1": "🟢", "L2": "🔵", "L3": "🟣"}
        print(f"  {icons.get(layer, '⚪')} {layer} 層 ({len(layer_agents)} 個):")
        for a in layer_agents:
            name = a.get("name", "?")
            logic = a.get("logic", "")
            kws = a.get("keywords", [])[:3]
            kw_str = ", ".join(kws) if kws else ""
            print(f"     {a.get('id', '?'):20s} {name:12s} {logic:20s}")
            if kw_str:
                print(f"     {'':20s} {'':12s} 🔗 {kw_str}")
        print()
    print()


def cmd_shell():
    """交互模式：持續對話，自動路由。"""
    print("╔══════════════════════════════════════════════════════════╗")
    print("║  🧬 龍魂共生體 · 交互模式                                ║")
    print("║  說出你的需求，系統自動路由到正確的人格/工具               ║")
    print("║  命令: h=健康 | a=Agents | st=狀態 | q=退出               ║")
    print("╚══════════════════════════════════════════════════════════╝")
    
    while True:
        try:
            text = input("\n🐉 >> ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\n共生體待命。")
            break
        
        if not text:
            continue
        if text.lower() in ("q", "quit", "exit", "退出"):
            print("共生體待命。")
            break
        if text.lower() in ("h", "health", "健康"):
            cmd_health()
            continue
        if text.lower() in ("a", "agents", "agent", "人格", "角色"):
            cmd_agents_list()
            continue
        if text.lower() in ("st", "status", "狀態", "状态"):
            cmd_status()
            continue
        if text.lower() in ("sym", "共生体", "共生體"):
            cmd_symbiote("status")
            continue
        
        auto_route(text)


def cmd_patrol(args: list):
    """🛡️ 安全巡檢 — 主動測邊界，不躲避漏洞。"""
    patrol_script = LH_ROOT / "bin" / "patrol_security.py"
    if not patrol_script.exists():
        print("❌ 巡檢腳本未找到:", patrol_script)
        return

    快速 = any(a in ("--quick", "-q") for a in args)
    仅报告 = any(a in ("--report", "-r") for a in args)
    extra = [a for a in args if not a.startswith("-")]

    cmd = ["python3", str(patrol_script)]
    if 快速:
        cmd.append("--quick")
    if 仅报告:
        cmd.append("--report")

    subprocess.run(cmd)


def cmd_hub(args: list):
    """🧠 哲学落地总调度器 — 把「文章」文件夹里的哲学全变成可执行代码。"""
    hub_script = LH_ROOT / "scripts" / "round1" / "philosophy_hub.py"
    if not hub_script.exists():
        print("❌ 哲学调度器未找到:", hub_script)
        return

    # 如果有输入内容，传入处理
    if args:
        text = " ".join(args)
        # 快速模式：直接传入文本审计
        cmd = ["python3", str(hub_script)]
        subprocess.run(cmd)
    else:
        # 无参数：运行自测
        subprocess.run(["python3", str(hub_script)])


