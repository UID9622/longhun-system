def print_help():
    """幫助信息。"""
    print(f"""
🐉 龍魂統一入口 · lh {VERSION}

一個命令，統攝一切。

═══ 用法 ═══

  lh "你的需求"      自動路由到正確的人格/工具
  lh                 交互模式（持續對話）
  lh shell           共生體交互模式（同上）

═══ 常用命令 ═══

  lh status          系統狀態面板（Git + 組件 + Agents）
  lh health          神經網絡 + Agents 健康全景
  lh agents          列出所有已註冊 Agent/人格
  lh sym [start|stop|restart|status]  共生體服務管理
  lh patrol          安全巡檢（主動測邊界·掃P0/P1/P2漏洞）
  lh patrol --quick  快速巡檢（僅掃P0）
  lh hub             哲學落地總調度（歸源→三才→七因子→倫理→生態→審計）
  lh fuse            熔斷控制
  lh editor          打開 CNSH 編輯器
  lh v               版本信息

═══ 傳統命令（向後兼容 lh6） ═══

  lh 編輯器 / edit          CNSH 中文編輯器
  lh 熔斷 / fuse            熔斷控制
  lh 令牌 / token           主權令牌管理
  lh 八卦 / bagua           六十四卦路由查詢
  lh 五行 / wuxing          五行權限校驗
  lh DNA生成 / dna-gen      河圖洛書 DNA 生成
  lh 驗證 / auth            主權身份驗證
  lh 加密 / privacy          審計日誌加密
  lh 錯誤 / error           系統錯誤翻譯
  lh 審計變量 / av           CNSH 變量審計
  lh 審計插件 / ap           可插拔審計
  lh 資本審計 / clap         資本愛之審計
  lh 語義 / semantic        自然語言→命令解析
  lh 狀態 / status          完整狀態面板
  lh 共生體 / symbiote      共生體服務管理
  lh 出口 / export          導出用戶數據
  lh 行為 / behavior        人民行為引擎
  lh 範圍 / scope           人民技能邊界
  lh 行程 / going           創始人報備行程
  lh ops                    打開 OPS 操作台
  lh portal                 打開線上門戶
  lh help                   顯示此幫助

═══ 設計原則 ═══

  不記命令 → 系統讀你的意圖
  人格自動觸發 → 不需要手動選擇
  一個入口 → lh 即是全部

DNA: {DNA}
""")


# ═══════════════════════════════════════════════════════════
# 主入口
# ═══════════════════════════════════════════════════════════

def main():
    args = sys.argv[1:]
    
    # 無參數 → 交互模式
    if not args:
        cmd_shell()
        return
    
    cmd = args[0].lower()
    rest = args[1:]
    
    # ── lh 原生命令 ──
    if cmd in ("status", "st", "狀態", "状态"):
        cmd_status()
        return
    
    if cmd in ("health", "h", "健康"):
        cmd_health()
        return
    
    if cmd in ("shell", "sh", "交互"):
        cmd_shell()
        return
    
    if cmd in ("symbiote", "sym", "共生体", "共生體", "共生"):
        action = rest[0] if rest else "status"
        cmd_symbiote(action)
        return
    
    if cmd == "fuse" or cmd == "熔断" or cmd == "熔斷":
        cmd_fuse(rest)
        return
    
    if cmd in ("agents", "a", "agent", "人格", "角色"):
        cmd_agents_list()
        return

    if cmd in ("patrol", "p", "巡檢", "巡检", "安全掃描", "安全扫描"):
        cmd_patrol(rest)
        return

    if cmd in ("hub", "哲学", "哲學", "落地"):
        cmd_hub(rest)
        return

    if cmd in ("version", "v", "-v", "--version"):
        cmd_version()
        return
    
    if cmd in ("help", "--help", "-h", "?", "帮助", "幫助"):
        print_help()
        return
    
    # ── 向後兼容：轉發給舊 lh6 bash 腳本 ──
    if cmd in LH6_DELEGATE:
        lh6_path = LH_ROOT / "bin" / "lh6"
        if lh6_path.exists():
            # 重建完整參數列表（原樣傳遞）
            os.execv(str(lh6_path), ["lh6", cmd] + rest)
        else:
            print(f"❌ lh6 腳本未找到: {lh6_path}")
        return
    
    # ── 默認模式：自然語言自動路由 ──
    text = " ".join(args)
    auto_route(text)


if __name__ == "__main__":
    main()
