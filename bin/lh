# ═══════════════════════════════════════════════════════════
# 核心：自動路由引擎
# ═══════════════════════════════════════════════════════════

def load_orchestrator():
    """延遲加載 orchestrator（只在需要時加載，加快子命令響應）。"""
    try:
        from orchestrator import AgentOrchestrator
        return AgentOrchestrator()
    except Exception as e:
        return None


def load_neural_bridge():
    """延遲加載神經網絡橋接器。"""
    try:
        from neural_agent_bridge import NeuralAgentBridge
        return NeuralAgentBridge()
    except Exception:
        return None


def auto_route(text: str):
    """
    自動路由：輸入任何自然語言 → 找到最合適的人格/工具。
    
    四層路由：
    1. orchestrator 關鍵詞匹配
    2. empower-engine 語義兜底
    3. agent-eco 生態路由
    4. 神經網絡橋接器
    """
    orch = load_orchestrator()
    neural = load_neural_bridge()
    
    if not orch:
        # 降級：只用神經網絡
        if neural:
            result = neural.execute(text)
            _print_neural_result(result)
            return
        print("❌ 路由引擎未加載，請確認 agents/orchestrator.py 存在")
        return
    
    result = orch.route(text)
    _print_route_result(result, neural)


def _print_route_result(result: dict, neural):
    """美化打印路由結果。"""
    primary = result.get("primary_agent", {})
    mode = result.get("routing_mode", "unknown")
    matches = result.get("matches", [])
    
    # 模式圖標
    mode_icons = {
        "keyword": "🔑", "empower": "🧠", "agent-eco": "🌐",
        "neural": "🧬", "fallback": "⬇️",
    }
    icon = mode_icons.get(mode, "→")
    
    print(f"\n  {icon} 路由模式: {mode}")
    
    # 匹配到的 Agent 列表
    if matches:
        if len(matches) == 1:
            m = matches[0]
            print(f"  🎯 {m['name']} [{m['layer']}] · {m.get('logic', '')}")
        else:
            print(f"  🎯 主: {primary.get('name', '?')} [{primary.get('layer', '?')}]")
            for i, m in enumerate(matches[1:4], 1):
                print(f"     {i}. {m['name']} [{m['layer']}] · {m.get('logic', '')}")
    
    # 關鍵詞匹配詳情
    if mode == "keyword" and matches:
        kws = matches[0].get("matched_keywords", [])
        if kws:
            print(f"  🔗 命中: {', '.join(kws[:5])}")
    
    # 路由建議
    advice = result.get("routing_advice", "")
    if advice:
        print(f"  💡 {advice}")
    
    print(f"  ⚡ {result.get('processing_time_ms', 0)}ms · {result.get('dna', DNA)}\n")


def _print_neural_result(result: dict):
    """打印神經網絡路由結果（降級路徑）。"""
    primary = result.get("primary_agent", {})
    routing = result.get("routing", {})
    
    status = routing.get("neural_status", "offline")
    emoji = "🟢" if status == "online" else "🔴"
    
    print(f"\n  🧬 神經路由 · {emoji} {status}")
    print(f"  🎯 {primary.get('name', '?')} [{primary.get('layer', '?')}]")
    if routing.get("wuxing_flow"):
        print(f"  🌊 五行流: {routing['wuxing_flow']}")
    print(f"  💡 {result.get('advice', '')}")
    print(f"  ⚡ {result.get('processing_ms', 0)}ms\n")


