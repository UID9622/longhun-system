{
  "_meta": {
    "dna": "#龍芯⚡️2026-06-19-LONGHUN-DEPLOY-READY-v5.2",
    "version": "5.2",
    "description": "龍魂部署系统配置",
    "last_updated": "2026-06-19"
  },
  "app_name": "longhun-app",
  "python_min_version": [3, 9],
  "pip_min_version": [21, 0],
  "project_root": ".",
  "start_command": "python3 -m uvicorn app:app --host 0.0.0.0 --port 8000",
  "reload_command": "python3 -m uvicorn app:app --reload --host 0.0.0.0 --port 8000",
  "stop_command": "pkill -f 'uvicorn.*app:app' || true",
  "backup_command": "./backup.sh",
  "health_endpoint": "/health",
  "health_port": 8000,
  "health_timeout": 10,
  "database_migration": "alembic upgrade head",
  "database_rollback": "alembic downgrade -1",
  "required_ports": [8000, 8080, 5432, 6379, 9090, 3000],
  "required_env_vars": [
    "APP_ENV",
    "DATABASE_URL",
    "SECRET_KEY"
  ],
  "optional_env_vars": [
    "REDIS_URL",
    "LOG_LEVEL",
    "PORT",
    "WORKERS",
    "TIMEOUT"
  ],
  "required_files": [
    "requirements.txt",
    "config.yaml",
    "Dockerfile",
    ".env.example"
  ],
  "min_disk_gb": 5,
  "min_memory_mb": 512,
  "log_dir": "logs",
  "backup_dir": "backups",
  "checks_dir": "checks",
  "monitoring": {
    "prometheus_config": "prometheus.yml",
    "grafana_config": "grafana.ini",
    "alert_rules": "alerts.yml",
    "metrics_endpoint": "/metrics",
    "metrics_port": 9090,
    "grafana_port": 3000
  },
  "security": {
    "env_file_permissions": "600",
    "config_file_permissions": "644",
    "secret_min_length": 16,
    "allowed_hosts": ["localhost", "127.0.0.1"],
    "ssl_required": false
  },
  "stages": {
    "env": {"timeout": 30, "critical": true},
    "code": {"timeout": 60, "critical": true},
    "deps": {"timeout": 180, "critical": true},
    "config": {"timeout": 30, "critical": true},
    "db": {"timeout": 120, "critical": true},
    "service": {"timeout": 30, "critical": true},
    "health": {"timeout": 30, "critical": true},
    "monitor": {"timeout": 30, "critical": false},
    "log": {"timeout": 15, "critical": false},
    "backup": {"timeout": 60, "critical": false}
  }
}
