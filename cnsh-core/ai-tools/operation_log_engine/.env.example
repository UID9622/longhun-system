# 龍魂操作日記引擎環境配置
# DNA: #龍芯⚡️2026-05-30-ENV-CONFIG-v1.0
#
# 使用說明:
# 1. 複製本文件: cp .env.example .env
# 2. 根據需要修改 .env 文件中的值
# 3. 系統將自動加載 .env 中的環境變數

# ==================== 路徑配置 ====================

# 龍魂系統根目錄 (默認: ~/longhun-system)
LONGHUN_ROOT=/Users/zuimeidedeyihan/longhun-system

# USB 掛載路徑 (用於同步)
# macOS 示例: /Volumes/LONGHUN_USB
# Linux 示例: /mnt/usb
# Windows 示例: D:
USB_MOUNT_PATH=/Volumes/LONGHUN_USB

# ==================== 應用配置 ====================

# 應用模式: development, production, testing
APP_MODE=production

# 調試模式: true 或 false
DEBUG=false

# ==================== 性能配置 ====================

# 批量操作大小
BATCH_SIZE=1000

# 緩存 TTL (秒)
CACHE_TTL=3600

# 操作超時 (秒)
TIMEOUT=30

# 最大查詢結果數
MAX_QUERY_LIMIT=10000

# ==================== 日誌配置 ====================

# 日誌級別: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日誌文件大小 (MB)
LOG_MAX_SIZE=10

# 保留日誌備份數
LOG_BACKUP_COUNT=5

# ==================== 驗證配置 ====================

# UID9622 的驗證碼 (用於 3/3 驗證)
UID_EXPECTED=UID9622

# GPG 公鑰指紋 (用於簽名驗證)
GPG_KEY_FINGERPRINT=A2D0092CEE2E5BA87035600924C3704A8CC26D5F

# ==================== 後續配置 ====================

# 以下為 Phase 3 可選功能的配置

# Web 儀表板端口 (Phase 3.4)
# DASHBOARD_PORT=5000

# 數據庫連接 (Phase 3.3)
# DATABASE_URL=sqlite:///longhun.db

# 外部 API 端點 (Phase 3.4)
# API_ENDPOINT=https://api.longhun.dev
