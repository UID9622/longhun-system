# 龍魂操作日记引擎环境配置
# DNA:#龍芯⚡️2026-05-30-ENV-CONFIG-v1.0
#
# 使用说明:
# 1. 复制本文件: cp .env.example .env
# 2. 根据需要修改 .env 文件中的值
# 3. 系统将自动加载 .env 中的环境变数

# ==================== 路径配置 ====================

# 龍魂系统根目录 (默认: ~/longhun-system)
LONGHUN_ROOT=/Users/zuimeidedeyihan/longhun-system

# USB 挂载路径 (用于同步)
# macOS 示例: /Volumes/LONGHUN_USB
# Linux 示例: /mnt/usb
# Windows 示例: D:
USB_MOUNT_PATH=/Volumes/LONGHUN_USB

# ==================== 应用配置 ====================

# 应用模式: development, production, testing
APP_MODE=production

# 调试模式: true 或 false
DEBUG=false

# ==================== 性能配置 ====================

# 批量操作大小
BATCH_SIZE=1000

# 缓存 TTL (秒)
CACHE_TTL=3600

# 操作超时 (秒)
TIMEOUT=30

# 最大查询结果数
MAX_QUERY_LIMIT=10000

# ==================== 日志配置 ====================

# 日志级别: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# 日志文件大小 (MB)
LOG_MAX_SIZE=10

# 保留日志备份数
LOG_BACKUP_COUNT=5

# ==================== 验证配置 ====================

# UID9622 的验证码 (用于 3/3 验证)
UID_EXPECTED=UID9622

# GPG 公钥指纹 (用于签名验证)
GPG_KEY_FINGERPRINT=A2D0092CEE2E5BA87035600924C3704A8CC26D5F

# ==================== 后续配置 ====================

# 以下为 Phase 3 可选功能的配置

# Web 仪表板端口 (Phase 3.4)
# DASHBOARD_PORT=5000

# 数据库连接 (Phase 3.3)
# DATABASE_URL=sqlite:///longhun.db

# 外部 API 端点 (Phase 3.4)
# API_ENDPOINT=https://api.longhun.dev
