# CNSH 示例：龍魂三色審計簡化版
# DNA:#龍芯⚡️2026-06-16-CNSH-EXAMPLE-AUDIT-v1.0

定義 閘控檢查(請求, 風險閾值):
    # 評估請求風險
    風險分數 = 0
    如果 請求.風險等級 等於 "高":
        風險分數 = 100
    否則如果 請求.風險等級 等於 "中":
        風險分數 = 50
    否則:
        風險分數 = 10

    如果 風險分數 >= 風險閾值:
        返回 "🔴 阻斷"
    否則如果 風險分數 >= 風險閾值 / 2:
        返回 "🟡 標記"
    否則:
        返回 "🟢 通過"

類 請求:
    定義 初始化(自己, 名稱, 風險等級):
        自己.名稱 = 名稱
        自己.風險等級 = 風險等級

測試請求 = 請求("訪問核心數據庫", "高")
結果 = 閘控檢查(測試請求, 80)
打印(f"請求 '{測試請求.名稱}' 審計結果: {結果}")
