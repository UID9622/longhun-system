#
# 安装:
#   sudo cp docs/lh-api-systemd.service /etc/systemd/system/lh-api.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now lh-api
# 状态/日志:
#   sudo systemctl status lh-api && journalctl -u lh-api -f

[Unit]
Description=LongHun CIL API Gateway (127.0.0.1:9622)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/longhun/longhun-system
ExecStart=/usr/bin/python3 /opt/longhun/longhun-system/bin/lh_api.py --port 9622
Restart=always
RestartSec=5
StandardOutput=append:/opt/longhun/longhun-system/logs/lh_api.log
StandardError=append:/opt/longhun/longhun-system/logs/lh_api.log

[Install]
WantedBy=multi-user.target
