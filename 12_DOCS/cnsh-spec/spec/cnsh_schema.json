{
  "DNA": "#龍芯⚡️2026-08-21-CNSH-SCHEMA-v1.0-UID9622",
  "creator": "诸葛鑫（UID9622）",
  "license": "MulanPSL v2",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://uid9622.cn/spec/cnsh-schema-v1.json",
  "title": "CNSH Document Schema",
  "description": "CNSH (Chinese Natural Shell) 文档/程序 JSON Schema — 机器可解析的中文结构化语法规范",
  "version": "1.0.0",
  "type": "object",
  "required": ["program"],
  "properties": {
    "dna": {
      "type": "string",
      "pattern": "^#龍芯⚡️[0-9]{4}-[0-9]{2}-[0-9]{2}",
      "description": "DNA 追溯码（日期格式）"
    },
    "creator": {
      "type": "string",
      "description": "创建者，默认 UID9622"
    },
    "license": {
      "type": "string",
      "description": "许可证声明",
      "examples": ["CC BY-NC-SA 4.0"]
    },
    "confirm_code": {
      "type": "string",
      "description": "确认码 #CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z"
    },
    "program": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/statement"
      }
    },
    "audit": {
      "$ref": "#/definitions/verdict"
    }
  },
  "definitions": {
    "statement": {
      "type": "object",
      "required": ["subject", "verb", "object"],
      "properties": {
        "subject": {
          "type": "string",
          "description": "主语（执行主体）",
          "examples": ["系统", "宝宝", "用户"]
        },
        "verb": {
          "type": "string",
          "enum": [
            "输出", "打印", "回显", "读取", "接收", "获取",
            "执行", "运行", "调用", "审计", "检查", "验证",
            "启动", "初始化", "停止", "查询", "同步", "归档",
            "部署", "发布"
          ],
          "description": "谓语（动作）"
        },
        "object": {
          "type": "string",
          "description": "宾语（操作对象）"
        },
        "modifier": {
          "type": "string",
          "description": "修饰语（条件/参数）"
        },
        "comment": {
          "type": "string",
          "description": "注释（说明为什么）"
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["approved", "rejected", "pending", "penetrated"],
      "description": "三色审计判定: 🟢 approved / 🟡 pending / 🔴 rejected"
    },
    "dna_chain": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^#龍芯⚡️"
      },
      "description": "DNA 追溯链"
    },
    "fuse": {
      "type": "object",
      "required": ["level", "reason"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["L0", "L1", "L2", "L3"],
          "description": "熔断级别: ∞/L0 伦理 > L1 数据 > L2 人格 > L3 行为"
        },
        "reason": {
          "type": "string"
        }
      }
    }
  }
}
