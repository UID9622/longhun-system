{
  "name": "baobao-guardian-frontend",
  "version": "1.0.0",
  "description": "宝宝守护助手 · 龍魂系统心脏应用",
  "type": "module",
  "main": "dist/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "electron:build": "npm run build && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "axios": "^1.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "three": "^0.161.0",
    "ws": "^8.17.0",
    "zustand": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "vite": "^8.0.16"
  },
  "build": {
    "appId": "com.longhun.baobao",
    "productName": "宝宝守护助手",
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "../../backend/**/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  }
}
