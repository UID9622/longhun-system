[Unit]
Description=龍魂 · 流量拓扑 API网关 (:8970, 增量)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/longhun-system/08_BIN
Environment="PYTHONPATH=/opt/longhun-system/bin"
ExecStart=/opt/longhun-system/venv/bin/python /opt/longhun-system/08_BIN/lh_api_gateway.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=longhun-flow-api
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
