# 增量部署适配: 端口 18799 → 18800 (frps 占用 18799), 原名 longhun-bridge
[Unit]
Description=龍魂 · 流量拓扑 对话桥接 (:18800, Ollama SSE 代理, 增量)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/longhun-system/08_BIN
Environment="PYTHONPATH=/opt/longhun-system/bin"
ExecStart=/opt/longhun-system/venv/bin/python /opt/longhun-system/08_BIN/lh_chat_bridge.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=longhun-flow-bridge
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
