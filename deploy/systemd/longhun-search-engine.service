[Unit]
Description=龍魂·多源搜索引擎 :9631
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/longhun/longhun-system
ExecStart=/var/www/longhun/longhun-system/venv/bin/python3 bin/lh_search_engine.py serve --port 9631
Restart=always
RestartSec=10
StandardOutput=append:/var/log/longhun/search-engine.log
StandardError=append:/var/log/longhun/search-engine-error.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
