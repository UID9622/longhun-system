[Unit]
Description=龍魂·流场融合桥接引擎 :8777 (api.uid9622.cn 入口)
After=network.target longhun-memory-api.service
Wants=longhun-memory-api.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/longhun/longhun-system
ExecStart=/var/www/longhun/longhun-system/venv/bin/python3 bin/lh_flow_fusion_bridge.py --port 8777 --host 0.0.0.0
Restart=always
RestartSec=10
StandardOutput=append:/var/log/longhun/flow-fusion.log
StandardError=append:/var/log/longhun/flow-fusion-error.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
