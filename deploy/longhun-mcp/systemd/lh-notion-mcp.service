# 🐉 龍魂 · 鲲鹏 Notion 数据镜像只读端点 (8768)
# DNA: #龍芯⚡️2026-09-04-LH-NOTION-MCP-SERVICE-v1.0-UID9622
# 归属名: 诸葛鑫 | UID9622 · 龍芯北辰
# 由 deploy_to_kunpeng.sh 安装 → /etc/systemd/system/
# 架构: Mac 主控层持 token → 目录级快照推送本机 → 本端点只读(鸿蒙连接点)

[Unit]
Description=🐉 Longhun Notion Mirror MCP (8768)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/longhun-system
Environment=LH_ROOT=/opt/longhun-system
Environment=NOTION_MIRROR_DIR=/opt/longhun-system/deploy/longhun-mcp/notion
ExecStart=/usr/bin/python3 /opt/longhun-system/deploy/longhun-mcp/lh_mcp_notion.py --host 127.0.0.1 --port 8768
Restart=on-failure
RestartSec=5
# 只读镜像层：日志落系统日志文件（append-only）
StandardOutput=append:/var/log/longhun-mcp/notion.log
StandardError=append:/var/log/longhun-mcp/notion.log

[Install]
WantedBy=multi-user.target
