[Unit]
Description=龍魂本地保险柜 API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/longhun-system
ExecStart=/usr/bin/python3 /opt/longhun-system/bin/lh_vault_api.py --host 127.0.0.1 --port 8780
Restart=always
RestartSec=5
Environment=PYTHONPATH=/opt/longhun-system

[Install]
WantedBy=multi-user.target
