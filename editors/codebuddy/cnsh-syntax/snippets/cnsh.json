{
	"主入口": {
		"prefix": "main",
		"body": [
			"功能 主() {",
			"\t${1:打印(\"你好，龍魂！\")}",
			"}",
			"",
			"主()"
		],
		"description": "CNSH 程序主入口"
	},
	"功能定义": {
		"prefix": "fn",
		"body": [
			"功能 ${1:函数名}(${2:参数}: ${3:类型}) -> ${4:返回类型} {",
			"\t${5:返回 ${6:值}}",
			"}"
		],
		"description": "CNSH 功能（函数）定义"
	},
	"打印": {
		"prefix": "print",
		"body": ["打印(\"${1:内容}\")"],
		"description": "CNSH 打印输出"
	},
	"变量赋值": {
		"prefix": "var",
		"body": ["${1:变量名} = ${2:值}"],
		"description": "CNSH 变量赋值"
	},
	"如果条件": {
		"prefix": "if",
		"body": [
			"如果 ${1:条件} {",
			"\t${2}",
			"}"
		],
		"description": "CNSH 如果条件分支"
	},
	"如果否则链": {
		"prefix": "ife",
		"body": [
			"如果 ${1:条件} {",
			"\t${2}",
			"} 否则 如果 ${3:条件2} {",
			"\t${4}",
			"} 否则 {",
			"\t${5}",
			"}"
		],
		"description": "CNSH 如果-否则如果-否则 多分支"
	},
	"循环遍历": {
		"prefix": "for",
		"body": [
			"循环 ${1:元素} 在 ${2:列表} {",
			"\t${3}",
			"}"
		],
		"description": "CNSH 循环遍历"
	},
	"整数范围循环": {
		"prefix": "forn",
		"body": [
			"循环 ${1:i} 在 范围(${2:次数}) {",
			"\t${3}",
			"}"
		],
		"description": "CNSH 范围循环"
	},
	"返回语句": {
		"prefix": "return",
		"body": ["返回 ${1:值}"],
		"description": "CNSH 返回语句"
	},
	"列表字面量": {
		"prefix": "list",
		"body": ["${1:变量名} = [${2:元素1}, ${3:元素2}]"],
		"description": "CNSH 列表字面量"
	},
	"字典字面量": {
		"prefix": "dict",
		"body": ["${1:变量名} = {\"${2:键}\": ${3:值}}"],
		"description": "CNSH 字典字面量"
	},
	"导入模块": {
		"prefix": "import",
		"body": ["导入 ${1:模块名}"],
		"description": "CNSH 导入模块"
	},
	"DNA 文件头": {
		"prefix": "dna",
		"body": [
			"# DNA: #龍芯⚡️2026-09-04-${1:模块}-${2:动作}-v1.0-UID9622",
			"# CONFIRM: #CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z",
			"# 归属名: 诸葛鑫 | UID9622 · 龍芯北辰"
		],
		"description": "CNSH 文件头 DNA 追溯码模板"
	}
}
