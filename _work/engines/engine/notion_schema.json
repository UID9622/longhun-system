{
  "notion_database_schema": {
    "description": "通心译 v1.3 × Notion 数据库字段映射",
    "dna": "#龍芯⚡️2026-05-27-TONGXINYI-NOTION-SCHEMA-v1.0",
    "created": "2026-05-27T21:15:00+0800",

    "message_input_fields": {
      "Content": {
        "name": "Content",
        "type": "rich_text",
        "description": "原始消息内容",
        "required": true,
        "example": "git push origin main"
      },
      "Source": {
        "name": "Source",
        "type": "select",
        "description": "消息来源",
        "options": ["CLI", "Email", "Chat", "API", "Manual"],
        "example": "CLI"
      },
      "CreatedTime": {
        "name": "CreatedTime",
        "type": "date",
        "description": "消息创建时间"
      }
    },

    "processing_fields": {
      "Processed": {
        "name": "Processed",
        "type": "checkbox",
        "description": "是否已通过通心译处理",
        "default": false
      },
      "ProcessedTime": {
        "name": "ProcessedTime",
        "type": "date",
        "description": "处理时间"
      }
    },

    "tongxinyi_output_fields": {
      "Scenario": {
        "name": "Scenario",
        "type": "select",
        "description": "被动触发场景",
        "options": [
          "pure_command",
          "emotional_upset",
          "cultural_anchor",
          "translate_request",
          "reverse_request",
          "technical_block",
          "bilingual_publish"
        ],
        "example": "pure_command"
      },

      "Confidence": {
        "name": "Confidence",
        "type": "number",
        "description": "场景检测置信度 (0-1)",
        "format": "percent",
        "example": 0.95
      },

      "Color": {
        "name": "Color",
        "type": "select",
        "description": "三色审计标注",
        "options": ["🟢 High", "🟡 Medium", "🔴 Low"],
        "example": "🟢 High"
      },

      "Emotion": {
        "name": "Emotion",
        "type": "select",
        "description": "ETE L0 · 检测情绪",
        "options": [
          "neutral",
          "fatigue",
          "irritated",
          "happy",
          "sad",
          "angry",
          "anticipation"
        ],
        "example": "neutral"
      },

      "Intent": {
        "name": "Intent",
        "type": "select",
        "description": "ETE L1 · 检测意图",
        "options": [
          "ask_permission",
          "ask_method",
          "ask_reason",
          "ask_information",
          "correct_statement",
          "agreement",
          "technical_execution",
          "statement"
        ],
        "example": "technical_execution"
      },

      "CulturalNote": {
        "name": "CulturalNote",
        "type": "rich_text",
        "description": "ETE L2 · 文化校准备注"
      },

      "Wuxing": {
        "name": "Wuxing",
        "type": "select",
        "description": "五行属性",
        "options": ["金", "木", "水", "火", "土"],
        "example": "木"
      },

      "Personas": {
        "name": "Personas",
        "type": "multi_select",
        "description": "推荐 Persona 列表（最多 3 个）",
        "options": [
          "P00·三才决策者",
          "P01·諸葛亮·战略家",
          "P02·宝宝·执行官",
          "P03·朱元璋·治国",
          "P04·图灵·技术家",
          "P05·上帝之眼·监管",
          "P06·莫扎特·艺术家",
          "P07·孔子·儒家",
          "P08·老子·道家",
          "P09·庄子·逍遥",
          "P10·孙子·军事家",
          "P11·苏格拉底·哲学家",
          "P12·亚里士多德·逻辑",
          "P13·康德·道德律",
          "P14·龍慧通心译"
        ],
        "example": ["P04·图灵·技术家", "P12·亚里士多德·逻辑"]
      },

      "DNA": {
        "name": "DNA",
        "type": "rich_text",
        "description": "DNA 签名（唯一标识）",
        "example": "#龍芯⚡️202605271234-PURE_COMMAND-a1b2c3d4"
      },

      "UnclearType": {
        "name": "UnclearType",
        "type": "select",
        "description": "不清识别类型",
        "options": [
          "None",
          "semantic_ambiguity",
          "polysemy",
          "technical_jargon",
          "context_missing",
          "cultural_trap"
        ],
        "example": "None"
      }
    },

    "privacy_fields": {
      "PrivacyLevel": {
        "name": "PrivacyLevel",
        "type": "select",
        "description": "隐私分级",
        "options": [
          "🔴 PRIVATE",
          "🟡 SEMI_PRIVATE",
          "🟢 PUBLIC",
          "📖 LEGAL_PUBLIC"
        ],
        "example": "🟢 PUBLIC"
      }
    },

    "instructions": {
      "1_create_database": {
        "title": "第 1 步：在 Notion 中创建数据库",
        "steps": [
          "打开 Notion 页面",
          "点击 '+ New' → 'Database' → 'Table'",
          "命名为 '通心译消息处理库'",
          "完成数据库创建"
        ]
      },

      "2_add_fields": {
        "title": "第 2 步：添加字段",
        "steps": [
          "添加 'Content' (Rich text) - 原始消息",
          "添加 'Scenario' (Select) - 检测场景",
          "添加 'Emotion' (Select) - 情绪",
          "添加 'Intent' (Select) - 意图",
          "添加 'Personas' (Multi-select) - Persona 列表",
          "添加 'DNA' (Rich text) - DNA 签名",
          "添加 'Confidence' (Number) - 置信度",
          "添加 'Color' (Select) - 三色标注",
          "添加 'Processed' (Checkbox) - 是否已处理",
          "添加 'ProcessedTime' (Date) - 处理时间"
        ]
      },

      "3_get_integration_token": {
        "title": "第 3 步：获取 Notion Integration Token",
        "steps": [
          "访问 https://www.notion.so/my-integrations",
          "点击 '+ New integration'",
          "命名为 '通心译桥接'",
          "复制 'Internal Integration Token'",
          "在 `.env` 文件中设置: NOTION_TOKEN=ntn_xxx..."
        ]
      },

      "4_grant_database_access": {
        "title": "第 4 步：授予数据库访问权限",
        "steps": [
          "打开创建的 Notion 数据库",
          "点击右上角 '...' → 'Connections'",
          "选择 '通心译桥接' integration",
          "点击 'Confirm'",
          "复制数据库 ID（URL 中的长字符串）",
          "在 `.env` 文件中设置: NOTION_DATABASE_ID=xxx..."
        ]
      },

      "5_run_integration": {
        "title": "第 5 步：运行集成脚本",
        "code": "python on_translate_notion_bridge.py",
        "expected_output": [
          "✅ 连接 Notion 成功",
          "✅ 读取消息成功",
          "✅ 处理消息成功",
          "✅ 写入结果成功"
        ]
      }
    },

    "environment_variables": {
      "NOTION_TOKEN": {
        "description": "Notion Integration Token",
        "required": true,
        "format": "ntn_xxxxx...",
        "how_to_get": "https://www.notion.so/my-integrations"
      },
      "NOTION_DATABASE_ID": {
        "description": "Notion 数据库 ID",
        "required": true,
        "format": "xxxxxxxxxxxxxxxxxxxxxxxx",
        "how_to_get": "从数据库 URL 复制"
      }
    },

    "example_env_file": {
      "filename": ".env",
      "content": "# Notion 集成配置\nNOTION_TOKEN=ntn_your_integration_token_here\nNOTION_DATABASE_ID=your_database_id_here\n\n# 可选：日志级别\nLOG_LEVEL=INFO"
    },

    "workflow": {
      "description": "完整工作流程",
      "steps": [
        {
          "step": 1,
          "name": "消息输入",
          "description": "用户在 Notion 数据库中输入消息到 'Content' 字段"
        },
        {
          "step": 2,
          "name": "自动读取",
          "description": "通心译 × Notion 桥接定期查询未处理的消息"
        },
        {
          "step": 3,
          "name": "通心译处理",
          "description": "使用通心译 v1.3 引擎分析消息"
        },
        {
          "step": 4,
          "name": "结果提取",
          "description": "提取情绪、意图、Persona、DNA 签名等"
        },
        {
          "step": 5,
          "name": "写回 Notion",
          "description": "将所有结果写入对应字段"
        },
        {
          "step": 6,
          "name": "标记完成",
          "description": "设置 'Processed' 复选框和 'ProcessedTime'"
        }
      ]
    },

    "usage_example": {
      "python": {
        "description": "在 Python 代码中使用集成",
        "code": "from on_translate_notion_bridge import TongxinyiNotionBridge\n\n# 初始化\nbridge = TongxinyiNotionBridge(\n    notion_token='ntn_xxx...',\n    database_id='xxx...'\n)\n\n# 批量处理\nresult = bridge.process_batch(limit=10)\nprint(f\"成功: {result['success']}, 失败: {result['failed']}\")\n\n# 持续同步（可选）\nbridge.sync_continuous(interval=60, max_iterations=None)"
      }
    },

    "notes": {
      "important": [
        "确保 Notion Integration 有数据库的读写权限",
        "第一次使用需要手动在 Notion 中授予权限",
        "环境变量必须正确设置，否则会出现连接错误",
        "默认最多查询 10 条未处理消息"
      ],
      "tips": [
        "可以使用 Notion 的筛选功能只处理特定类型的消息",
        "支持持续同步模式，自动定期检查新消息",
        "所有操作都有详细的日志记录，便于调试",
        "DNA 签名唯一标识每条消息的处理结果"
      ]
    }
  }
}
