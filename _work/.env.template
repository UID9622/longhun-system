# ==========================================
# CNSH 翻译系统配置文件模板
# DNA: #龍芯⚡️2026-05-27-CNSH-ENV-TEMPLATE
# ==========================================
#
# 使用说明：
# 1. 复制本文件为 .env
# 2. 填入实际的配置值
# 3. 将 .env 添加到 .gitignore（防止泄露敏感信息）
# 4. 确保文件权限为 600 (chmod 600 .env)
#

# ==========================================
# [必填] Notion 配置
# ==========================================
NOTION_TOKEN=sk_live_your_notion_integration_token_here
DATABASE_ID=your_notion_database_id_here

# Notion 数据库字段名称（可自定义）
NOTION_STATUS_FIELD=状态
NOTION_SOURCE_FIELD=源文本
NOTION_TRANSLATION_FIELD=翻译结果
NOTION_DNA_FIELD=DNA签名


# ==========================================
# [必填] 翻译 API 配置
# ==========================================

# OpenAI API 配置
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_MODEL=gpt-4                    # 可选: gpt-4-turbo, gpt-3.5-turbo
OPENAI_ORG_ID=                        # 可选: 组织 ID

# Google 翻译 API 配置（可选）
GOOGLE_TRANSLATE_CREDENTIALS=path/to/credentials.json
GOOGLE_PROJECT_ID=your_project_id

# Azure 翻译 API 配置（可选）
AZURE_TRANSLATOR_ENDPOINT=https://your-region.api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=your_azure_key


# ==========================================
# [可选] 系统配置
# ==========================================

# 日志级别: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# 日志文件位置
LOG_DIR=~/.cnsh/logs
LOG_FILE_NAME=cnsh_translator.log

# 系统配置
WORKER_PROCESSES=4                   # 工作进程数（根据 CPU 核心数调整）
MAX_CONCURRENT_TASKS=5               # 最大并发翻译数
QUEUE_SCAN_INTERVAL=5                # 队列扫描间隔（秒）
TASK_TIMEOUT=30                      # 单个任务超时时间（秒）

# 批处理配置
BATCH_PROCESS_TIME=02:00             # UTC+7 时区·每天处理时间
BATCH_PROCESS_MAX_TASKS=100          # 单次批处理最多任务数


# ==========================================
# [可选] 监控与通知
# ==========================================

# 启用监控
ENABLE_MONITORING=true

# Slack 通知配置
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#cnsh-translations      # 默认频道
SLACK_USERNAME=CNSH 翻译系统          # 机器人名称

# 邮件通知配置（可选）
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=notifications@cnsh.local
ALERT_EMAIL=admin@example.com


# ==========================================
# [高级] 缓存配置
# ==========================================

# 缓存类型: memory / redis / none
CACHE_TYPE=memory

# Redis 配置（如果 CACHE_TYPE=redis）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 缓存配置
CACHE_TTL=3600                       # 缓存过期时间（秒）
CACHE_MAX_SIZE=1000                  # 最大缓存条目数


# ==========================================
# [高级] 数据库配置（可选）
# ==========================================

# 数据库类型: sqlite / postgresql / mysql
DATABASE_TYPE=sqlite
DATABASE_URL=sqlite:///./cnsh_translations.db

# PostgreSQL 配置示例：
# DATABASE_URL=postgresql://user:password@localhost:5432/cnsh_db


# ==========================================
# [高级] 安全配置
# ==========================================

# API 密钥加密（防止在日志中泄露）
ENCRYPT_SENSITIVE_DATA=true

# JWT 密钥（如果有 API 端点）
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600               # 过期时间（秒）


# ==========================================
# [高级] 性能优化
# ==========================================

# 启用缓存
ENABLE_CACHE=true

# 启用异步处理
ENABLE_ASYNC=true

# 批处理优化
BATCH_SIZE=10                        # 单个批次的任务数
BATCH_TIMEOUT=300                    # 批处理超时（秒）

# 连接池配置
CONNECTION_POOL_SIZE=20
CONNECTION_POOL_TIMEOUT=5


# ==========================================
# [开发] 调试配置
# ==========================================

# 启用调试模式
DEBUG=false

# 保存翻译请求日志
SAVE_REQUEST_LOG=true
REQUEST_LOG_DIR=~/.cnsh/logs/requests

# 性能分析
ENABLE_PROFILING=false
PROFILE_OUTPUT_DIR=~/.cnsh/logs/profiles


# ==========================================
# [其他] 自定义配置
# ==========================================

# 翻译提供商偏好（逗号分隔）
TRANSLATION_PROVIDERS=openai,google,azure

# 自动应用词汇表
AUTO_APPLY_GLOSSARY=true
GLOSSARY_FILE=glossaries/default.json

# 支持的语言对（逗号分隔）
SUPPORTED_LANGUAGE_PAIRS=zh-en,en-zh,zh-ja,ja-zh

# 项目标识符（用于统计和跟踪）
PROJECT_NAME=CNSH Translation System
PROJECT_VERSION=1.0.0
ENVIRONMENT=development              # development / staging / production
