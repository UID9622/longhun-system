# CNSH 翻译系统 Docker 镜像
# DNA: #龍芯⚡️2026-05-27-DOCKER-CNSH-v1.0

FROM python:3.11-slim

LABEL maintainer="UID9622 诸葛鑫"
LABEL description="CNSH Translation System v1.0"
LABEL version="1.0.0"

WORKDIR /app

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    LOG_LEVEL=INFO \
    TZ=Asia/Shanghai

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件
COPY requirements_cnsh.txt .

# 安装 Python 依赖
RUN pip install --no-cache-dir -r requirements_cnsh.txt

# 复制应用代码
COPY cnsh_translator_complete.py .
COPY .env.template .env

# 创建日志目录
RUN mkdir -p /var/log/cnsh /app/data

# 设置健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# 暴露端口（可选：用于 API 服务）
EXPOSE 8000

# 启动应用
CMD ["python", "-u", "cnsh_translator_complete.py"]
