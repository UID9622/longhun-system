#!/usr/bin/env bash
# 爸爸每天只跑这一条：全开服务 + 自检 + 三才烟测 + 印常用指令
# DNA: #龍芯⚡️2026-05-16-开机一條龍-v2.0
set -euo pipefail

_SCRIPT="${BASH_SOURCE[0]}"
while [[ -L "$_SCRIPT" ]]; do _SCRIPT="$(readlink "$_SCRIPT")"; done
ROOT="$(cd "$(dirname "$_SCRIPT")/.." && pwd)"
# shellcheck source=_longhun_common.sh
source "${ROOT}/bin/_longhun_common.sh"
mkdir -p "${HOME}/.longhun"

echo "════════════════════════════════════════"
echo "  🐉 龍魂开机一條龍（全开 + 自检 + 指令表）"
echo "  $(date '+%Y-%m-%d %H:%M:%S')"
echo "════════════════════════════════════════"
echo ""

# ①～④ 与全日开机相同
bash "${LONGHUN_ROOT}/bin/全日开机"
echo ""

echo "⑤ 帮你检查全部（依赖/9625/Ollama）"
bash "${LONGHUN_ROOT}/bin/帮你检查全部" || true
echo ""

echo "⑥ 同步花名册（Notion → 本机大脑 · 人不用管）"
bash "${LONGHUN_ROOT}/bin/同步花名册" || echo "   🟡 花名册同步跳过（缺 NOTION_TOKEN 或网络）"
echo ""

echo "⑦ 开机烟测（9625 健康 + 三才公式 + 流场演示）"
if curl -sf "http://127.0.0.1:9625/api/health" >/dev/null 2>&1; then
  echo -n "   9625 health: "
  curl -sf "http://127.0.0.1:9625/api/health" | python3 -c "import sys,json;d=json.load(sys.stdin);print(d.get('status',d))" 2>/dev/null || echo OK
  echo -n "   三才37年: "
  curl -sf -X POST "http://127.0.0.1:9625/api/demo/sancai" \
    -H "Content-Type: application/json" \
    -d '{"heaven":0.2,"earth":0.3,"human":1.0}' \
    | python3 -c "import sys,json;d=json.load(sys.stdin);print('得分',d['decision']['composite_score'],'达标' if d['decision']['passed'] else '未达标')" 2>/dev/null \
    || echo "🟡 三才接口未响应（引擎需重启加载 demo_api）"
  echo -n "   流场烟测: "
  curl -sf -X POST "http://127.0.0.1:9625/api/demo/flow-smoke" \
    -H "Content-Type: application/json" \
    -d '{"message":"开机烟测","tags":{"天":0.2,"地":0.3,"人":1.0},"operator_id":"UID9622"}' \
    | python3 -c "import sys,json;d=json.load(sys.stdin);r=d.get('flow_port',{});print(r.get('tricolor','?'), r.get('status','?'))" 2>/dev/null \
    || echo "🟡 flow-smoke 未响应"
else
  echo "   🟡 9625 未起来·跳过烟测（看 logs/engine9625.err.log）"
fi
echo ""

if curl -sf --max-time 8 "https://api.longhun888.com/api/v1/health" >/dev/null 2>&1; then
  echo "   公网 API: 🟢"
else
  echo "   公网 API: 🟡（隧道或网关未通时可再敲: 开）"
fi
echo ""

# 记下本次开机时间 · 供新终端显示指令表
date '+%Y-%m-%d %H:%M:%S' >"${HOME}/.longhun/last_boot.ok"
touch "${HOME}/.longhun/显示指令.flag"

echo "════════════════════════════════════════"
echo "  📋 常用中文指令（真源: bin/常用指令_真源.txt）"
echo "════════════════════════════════════════"
bash "${LONGHUN_ROOT}/bin/显示常用指令"

echo "✅ 开机一條龍完成。"
echo "   收工: 收工   或  bash ~/longhun-system/bin/收工一條龍"
echo "   随时看指令: 指令   或  帮助"
echo "   DNA 控制台: http://127.0.0.1:9625/console"
