# ============ 自然语言路由表 ============
路由 = {
    # 看看家底
    r'看看家底|家底|状态|什么情况|咋样了|还好吗': 看看家底,
    # 全开
    r'全开|全部打开|全开服务|一键全开|爸爸一键': 全开,
    # 开机
    r'开机|开机一条龍|启动|起来|醒了': 开机,
    # 开龍魂
    r'开龍魂|启动龍魂|龍魂启动|开服务': 开龍魂,
    # 检查
    r'检查|检查一下|查查|体检|看看健康': 检查一下,
    # 审计
    r'审计|三色审计|查账|审查': 审计,
    # 同步
    r'同步|git|状态|改了啥': 同步,
    # 推送
    r'推送|提交|push|上传|保存': 推送,
    # 备份
    r'备份|打包|存档|留底': 备份,
    # 清理
    r'清理|清垃圾|打扫|收拾': 清理,
    # 帮助
    r'帮助|help|怎么用|不会用|帮我': 帮助,
    # CNSH
    r'说话|cnsh|中文编程|编程': lambda: 跑(f"python3 {ROOT}/cnsh.py"),
}

def 解析(话):
    """解析人话，找到匹配的命令"""
    话 = 话.strip().lower()
    for 模式, 动作 in 路由.items():
        if re.search(模式, 话):
            return 动作
    return None

def main():
    if len(sys.argv) < 2:
        帮助()
        return
    
    输入 = ' '.join(sys.argv[1:])
    动作 = 解析(输入)
    
    if 动作:
        try:
            动作()
        except Exception as e:
            print(f"{R}❌ 出错了: {e}{NC}")
    else:
        print(f"{R}❌ 听不懂: '{输入}'{NC}")
        print(f"{Y}💡 试试: 龍魂 帮助{NC}")

if __name__ == '__main__':
    main()
