def 清理():
    """清理垃圾"""
    print(f"{Y}🧹 清理中...{NC}")
    跑("find . -name '*.pyc' -delete", cwd=ROOT)
    跑("find . -name '__pycache__' -type d -exec rm -rf {{}} + 2>/dev/null; true", cwd=ROOT)
