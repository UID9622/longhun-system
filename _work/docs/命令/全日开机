echo "① 公网 API + Cloudflare 隧道"
bash "${LONGHUN_ROOT}/bin/开龍魂"
echo ""

echo "② 9625 龍魂引擎（venv）"
bash "${LONGHUN_ROOT}/bin/开龍魂9625" || true
echo ""

echo "③ 官网静态 :9626"
bash "${LONGHUN_ROOT}/bin/开官网"
echo ""

echo "④ 操作台 MVP :8765"
bash "${LONGHUN_ROOT}/bin/开操作台" || true
echo ""

if [[ "$WITH_MASTER" == "1" ]]; then
  echo "⑤ 主控台静态 :9620"
  bash "${LONGHUN_ROOT}/bin/开主控台" || true
  echo ""
fi

bash "${LONGHUN_ROOT}/bin/龍魂状态"
