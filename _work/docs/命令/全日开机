source "$(dirname "$0")/_longhun_common.sh"

WITH_MASTER="${LONGHUN_WITH_MASTER:-0}"
if [[ "${1:-}" == "--主控" || "${1:-}" == "--master" ]]; then
  WITH_MASTER=1
fi

