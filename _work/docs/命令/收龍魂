#!/usr/bin/env bash
# 收掉 9633 网关 + Cloudflare 隧道（与 bin/开龍魂 对称）
set -euo pipefail

_SCRIPT="${BASH_SOURCE[0]}"
while [[ -L "$_SCRIPT" ]]; do _SCRIPT="$(readlink "$_SCRIPT")"; done
ROOT_DIR="$(cd "$(dirname "$_SCRIPT")/.." && pwd)"
RUN_DIR="$ROOT_DIR/.run"
TUNNEL_PID_FILE="$RUN_DIR/cloudflared.pid"
GATEWAY_PID_FILE="$RUN_DIR/ai_gateway.pid"

echo "═══ 龍魂一键收工 ═══"

if [[ -f "$TUNNEL_PID_FILE" ]]; then
  pid="$(cat "$TUNNEL_PID_FILE" 2>/dev/null || true)"
  [[ -n "${pid:-}" ]] && kill "$pid" 2>/dev/null || true
  rm -f "$TUNNEL_PID_FILE"
fi
pkill -f "cloudflared tunnel --config $ROOT_DIR/deploy/cloudflared/config.yml run" 2>/dev/null || true
echo "☁️  Tunnel 已收"

if [[ -f "$GATEWAY_PID_FILE" ]]; then
  pid="$(cat "$GATEWAY_PID_FILE" 2>/dev/null || true)"
  [[ -n "${pid:-}" ]] && kill "$pid" 2>/dev/null || true
  rm -f "$GATEWAY_PID_FILE"
fi
lsof -ti:9633 2>/dev/null | xargs kill -9 2>/dev/null || true
echo "🌐 9633 网关已收"
echo "✅ 龍魂公网收工完成"
