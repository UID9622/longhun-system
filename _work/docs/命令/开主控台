#!/usr/bin/env bash
# 本机静态页：longhun-master-control.html 等。默认端口 9620，避免占用 9622（隧道里留给审计 /audit/health）。
if [[ -z "${BASH_VERSION:-}" ]]; then
  echo "请用 bash 跑本脚本: bash \"$0\"" >&2
  exit 1
fi
set -euo pipefail

_SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
while [[ -L "$_SCRIPT_PATH" ]]; do
  _SCRIPT_PATH="$(readlink "$_SCRIPT_PATH")"
done
ROOT_DIR="$(cd "$(dirname "$_SCRIPT_PATH")/.." && pwd)"
LOG_DIR="$ROOT_DIR/logs"
RUN_DIR="$ROOT_DIR/.run"
mkdir -p "$LOG_DIR" "$RUN_DIR"

WEB_ROOT="${LONGHUN_FLOW_WEB:-$HOME/Pictures/longhun-flow-system}"
PORT="${LONGHUN_FLOW_PORT:-9620}"
PID_FILE="$RUN_DIR/flow_static_web.pid"
# 不用 LOG_FILE 作变量名：有人会在 zsh 里 export 了同名但未赋值，配合 nounset 会踩雷
_LH_FLOW_WEB_LOG="$LOG_DIR/flow_static_web.out.log"

echo "═══ 龍魂主控台 · 静态站 ═══"
echo "时间: $(date '+%Y-%m-%d %H:%M:%S %Z (%A)')"
echo

if [[ ! -d "$WEB_ROOT" ]]; then
  echo "❌ 网页根目录不存在: $WEB_ROOT"
  echo "   可 export LONGHUN_FLOW_WEB=/你的/longhun-flow-system"
  exit 1
fi

if [[ ! -f "$WEB_ROOT/longhun-master-control.html" ]]; then
  echo "⚠️  未找到 longhun-master-control.html，仍启动静态服务（目录里可能有别的页）。"
  echo "    根目录: $WEB_ROOT"
  echo
fi

if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  echo "📟 端口 $PORT 已在监听，跳过启动（若页面不对，先 收主控台 再开）。"
else
  echo "📟 启动 python http.server 端口 $PORT …"
  echo "    目录: $WEB_ROOT"
  cd "$WEB_ROOT"
  nohup python3 -m http.server "$PORT" >"$_LH_FLOW_WEB_LOG" 2>&1 &
  echo $! >"$PID_FILE"
  sleep 0.4
  if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    printf '✅ 已启动（日志: %s）\n' "$_LH_FLOW_WEB_LOG"
  else
    printf '❌ 启动失败，看日志: %s\n' "$_LH_FLOW_WEB_LOG"
    exit 1
  fi
fi

echo
echo "浏览器打开:"
echo "  http://127.0.0.1:$PORT/longhun-master-control.html"
echo "一键打开（macOS）:"
echo "  open \"http://127.0.0.1:$PORT/longhun-master-control.html\""
