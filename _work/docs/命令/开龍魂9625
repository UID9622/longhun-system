#!/usr/bin/env bash
# 启动 9625 本地引擎（必须用 venv）并打开 DNA 控制台
# DNA: #龍芯⚡️2026-05-15-开龍魂9625-v1.0
set -euo pipefail

ROOT="${HOME}/longhun-system"
ENGINE="${ROOT}/engine"
VENV_PY="${ROOT}/venv/bin/python"
RUN_DIR="${ROOT}/.run"
LOG_DIR="${ROOT}/logs"
mkdir -p "$RUN_DIR" "$LOG_DIR"

health() { curl -sf "http://127.0.0.1:9625/api/health" >/dev/null 2>&1; }

if [[ ! -x "$VENV_PY" ]]; then
  echo "❌ 未找到 venv：请先执行"
  echo "   cd ~/longhun-system && python3 -m venv venv && source venv/bin/activate && pip install -r engine/requirements.txt"
  exit 1
fi

if health; then
  echo "✅ 9625 已在运行（可能在你另一个终端窗口里·不用重复启动）"
else
  echo "🐉 启动龍魂9625（venv）…"
  cd "$ENGINE"
  nohup "$VENV_PY" main.py >>"${LOG_DIR}/engine9625.out.log" 2>>"${LOG_DIR}/engine9625.err.log" &
  echo $! >"${RUN_DIR}/engine9625.pid"
  for _ in $(seq 1 15); do
    sleep 1
    health && break
  done
fi

if health; then
  echo "🌐 打开 DNA 控制台 http://127.0.0.1:9625/console"
  open "http://127.0.0.1:9625/console"
else
  echo "❌ 引擎未起来·请看："
  echo "   ${LOG_DIR}/engine9625.err.log"
  echo ""
  echo "若提示缺 fastapi，整行复制安装依赖："
  echo "   ${VENV_PY} -m pip install -r ${ENGINE}/requirements.txt"
  exit 1
fi
