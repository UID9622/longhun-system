graph TD
    subgraph GOVERNANCE[🛡️ 治理层]
        style GOVERNANCE fill:#2563EB,stroke:#1E40AF,color:#fff
        principle_001[取之于民用之于民]:::governance
        principle_002[贡献即存档]:::governance
        principle_003[回馈不依赖商业利润]:::governance
        principle_004[世袭继承]:::governance
        principle_005[永不掩盖]:::governance
        contrib_001[贡献三维度]:::governance
        contrib_002[代码贡献40%]:::governance
        contrib_003[协议/文档贡献30%]:::governance
        contrib_004[传播/社区贡献30%]:::governance
    end

    subgraph MECHANISM[⚙️ 机制层]
        style MECHANISM fill:#7C3AED,stroke:#5B21B6,color:#fff
        reward_001[回馈机制]:::mechanism
        reward_002[回馈来源]:::mechanism
        reward_003[资金池分配]:::mechanism
        reward_004[回馈公式]:::mechanism
        pool_001[三池结构]:::mechanism
        pool_002[个人权益池]:::mechanism
        pool_003[基金池]:::mechanism
        pool_004[扶持池]:::mechanism
        fuse_b001[道德绑架熔断]:::mechanism
        fuse_b002[行为模式识别]:::mechanism
        fuse_b003[会话归档标记]:::mechanism
        fuse_b004[后续请求拒绝]:::mechanism
    end

    subgraph FOUNDATION[🏛️ 基础层]
        style FOUNDATION fill:#4B5563,stroke:#1F2937,color:#fff
        inherit_001[世袭继承机制]:::foundation
        inherit_002[贡献档案永久保留]:::foundation
        inherit_003[后代可继承权益]:::foundation
        inherit_004[DNA追溯链可延续]:::foundation
    end

    principle_001 --> principle_002
    principle_001 --> principle_003
    principle_002 --> principle_004
    principle_003 --> principle_005
    principle_001 --> contrib_001
    contrib_001 --> contrib_002
    contrib_001 --> contrib_003
    contrib_001 --> contrib_004
    contrib_001 --> reward_001
    reward_001 --> reward_002
    reward_001 --> reward_003
    reward_001 --> reward_004
    reward_001 --> pool_001
    reward_002 --> reward_003
    pool_001 --> pool_002
    pool_001 --> pool_003
    pool_001 --> pool_004
    pool_003 -.->|溢出| pool_004
    reward_004 --> pool_002
    inherit_001 --> inherit_002
    inherit_001 --> inherit_003
    inherit_001 --> inherit_004
    inherit_002 --> inherit_004
    fuse_b001 --> fuse_b002
    fuse_b001 --> fuse_b003
    fuse_b001 --> fuse_b004
    fuse_b002 --> fuse_b003
    fuse_b003 --> fuse_b004

    classDef governance fill:#2563EB,stroke:#1E40AF,color:#fff
    classDef mechanism fill:#7C3AED,stroke:#5B21B6,color:#fff
    classDef foundation fill:#4B5563,stroke:#1F2937,color:#fff
