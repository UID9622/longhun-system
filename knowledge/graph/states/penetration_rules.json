      "priority": "high",
      "description": "治理层终止时，关联机制层暂停"
    },
    {
      "rule_id": "penetration_003",
      "trigger_layer": "sovereignty",
      "trigger_state": "active",
      "target_layer": "governance",
      "target_action": "restore_active",
      "priority": "high",
      "description": "主权层恢复时，治理层恢复生效"
    }
  ]
