# 说明: CNSH 标准 Hello World — 7节语法全覆盖

━━━━━━━━━━━━━━━━━━━━━━━━━━━━
第1节 · 基础输出
━━━━━━━━━━━━━━━━━━━━━━━━━━━━
打印("🇨🇳 你好，CNSH语言！")
打印("英文不是唯一计算机执行的指令。")

━━━━━━━━━━━━━━━━━━━━━━━━━━━━
第2节 · 变量与运算
━━━━━━━━━━━━━━━━━━━━━━━━━━━━
整数 成本 = 80
整数 售价 = 120
整数 利润 = 售价 - 成本
打印("成本:", 成本, "售价:", 售价, "利润:", 利润)

━━━━━━━━━━━━━━━━━━━━━━━━━━━━
第3节 · 条件判断
━━━━━━━━━━━━━━━━━━━━━━━━━━━━
如果【利润 > 0】{
    打印("✅ 有利润")
} 否则如果【利润 == 0】{
    打印("⚖️ 持平")
} 否则 {
    打印("❌ 亏损")
}

━━━━━━━━━━━━━━━━━━━━━━━━━━━━
第4节 · 循环
━━━━━━━━━━━━━━━━━━━━━━━━━━━━
循环【3】{
    打印("🔄 第", 循环.次数, "次执行...")
}

━━━━━━━━━━━━━━━━━━━━━━━━━━━━
第5节 · 模块定义
━━━━━━━━━━━━━━━━━━━━━━━━━━━━
模块 示例 ⚖️100 {
    函数 问好(名字) {
        输出("你好，" + 名字 + "！")
    }
}
示例.问好("龍魂世界")

━━━━━━━━━━━━━━━━━━━━━━━━━━━━
第6节 · 函数封装
━━━━━━━━━━━━━━━━━━━━━━━━━━━━
函数 主函数() 返回类型 整数 {
    打印("━━━━━━ 主函数开始 ━━━━━━")
    整数 结果 = 成本 * 2
    打印("成本翻倍:", 结果)
    打印("━━━━━━ 主函数结束 ━━━━━━")
    返回 0
}
主函数()

━━━━━━━━━━━━━━━━━━━━━━━━━━━━
第7节 · 执行签章
━━━━━━━━━━━━━━━━━━━━━━━━━━━━
打印("✅ CNSH程序执行完成")
打印("🧬 DNA追溯已生效")
打印("🇨🇳 中国原生编程语言")
