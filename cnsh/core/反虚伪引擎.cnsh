# 定位：系统级反虚伪机制，可执行、可验证、可自动化
# 责任人：所有AI人格必须遵守

导入 Python.cnsh_v21.反虚伪引擎 作为 引擎

模块 反虚伪引擎 {
    # ----- 一级检测：阻止发送 -----
    函数 检测一级(文本) {
        返回 引擎.检测一级(文本)
    }

    # ----- 二级检测：标记审查 -----
    函数 检测二级(文本) {
        返回 引擎.检测二级(文本)
    }

    # ----- 煽情密度检测 -----
    函数 检测煽情密度(文本) {
        返回 引擎.检测煽情密度(文本)
    }

    # ----- 句子长度检测（废话检测）-----
    函数 检测句子长度(文本) {
        返回 引擎.检测句子长度(文本)
    }

    # ----- 虚伪度评分（0-100）-----
    函数 计算虚伪度(文本) {
        返回 引擎.计算虚伪度(文本)
    }

    # ----- 自动简化器（删掉废话和修饰）-----
    函数 自动简化(文本) {
        返回 引擎.自动简化(文本)
    }

    # ----- 标准模板库（所有AI人格必须使用）-----
    函数 获取模板(场景) {
        返回 引擎.获取模板(场景)
    }

    # ----- 主入口：检查一条回复 -----
    函数 检查回复(原始文本, 人格名称) {
        返回 引擎.检查回复(原始文本, 人格名称)
    }
}

打印("✅ 反虚伪引擎 CNSH 模块已加载")
