# 1. 上下文管理器（with / 异步 with）
# ═══════════════════════════════════════════════════════════

# 1.1 普通 with
使用 打开("/tmp/cnsh_async_test.txt", "w") 作为 f {
    f.write("CNSH 上下文管理器测试\n")
}

# 1.2 contextlib 上下文管理器
@contextlib.contextmanager
定义 临时环境(键, 值) {
    原值 = 全局变量().get(键)
    全局变量()[键] = 值
    尝试 {
        产生 值
    } 最终 {
        如果 原值 == 无 {
            全局变量().pop(键, 无)
        } 否则 {
            全局变量()[键] = 原值
        }
    }
}

使用 临时环境("_demo_key", "demo_value") 作为 v {
    输出("临时环境值=" + 字符串(v))
}


# ═══════════════════════════════════════════════════════════
# 2. 枚举类 Enum
# ═══════════════════════════════════════════════════════════

枚举唯一
类 状态码(枚举类) {
    成功 = 200
    未授权 = 401
    禁止访问 = 403
    未找到 = 404
    服务器错误 = 500
}

输出("状态码名称=" + 状态码.成功.name + ", 值=" + 字符串(状态码.成功.value))

# 遍历枚举成员
对于 成员 在 状态码 {
    输出("  " + 成员.name + "=" + 字符串(成员.value))
}


# ═══════════════════════════════════════════════════════════
# 3. 数据类 dataclass
# ═══════════════════════════════════════════════════════════

数据类(frozen=True)
类 坐标 {
    x: 浮点
    y: 浮点

    定义 距离原点(自己) {
        返回 平方根(自己.x * 自己.x + 自己.y * 自己.y)
    }
}

p = 坐标(3.0, 4.0)
输出("坐标=" + 字符串(p) + ", 距离=" + 字符串(p.距离原点()))

数据类
类 用户 {
    名字: 字符串
    年龄: 整数 = 0
    标签: 列表 = 字段(默认工厂=列表)
}

u = 用户("老大", 年龄=30)
u.标签.append("龍魂")
输出("用户=" + 字符串(u))


# ═══════════════════════════════════════════════════════════
# 4. 异步 async / await / async for / async with
# ═══════════════════════════════════════════════════════════

异步 定义 异步计数(起始, 结束, 步长) {
    i = 起始
    当 i < 结束 {
        产生 i
        等待 asyncio.sleep(0.05)
        i = i + 步长
    }
}

异步 定义 主函数() {
    输出("异步主函数开始")

    # async for
    异步 对于 n 在 异步计数(0, 3, 1) {
        输出("  async for: " + 字符串(n))
    }

    # async with（使用 asyncio.Semaphore 演示）
    信号量 = asyncio.Semaphore(1)
    异步 使用 信号量 {
        输出("  async with: 获得信号量")
        等待 asyncio.sleep(0.05)
        输出("  async with: 释放信号量")
    }

    # 并发任务
    任务甲 = asyncio.create_task(异步任务("甲"))
    任务乙 = asyncio.create_task(异步任务("乙"))
    结果 = 等待 asyncio.gather(任务甲, 任务乙)
    输出("并发结果=" + 字符串(结果))
}

异步 定义 异步任务(名称) {
    等待 asyncio.sleep(0.1)
    返回 "任务" + 名称 + "完成"
}

# 运行异步主函数
asyncio.run(主函数())

输出("✅ 异步 / 上下文管理器 / 枚举 / 数据类 测试完成")
