# 🐉 CNSH v2.1 测试：类、装饰器、生成器
# DNA: #龍芯⚡️2026-07-05-CNSH-CLASS-DECORATOR-GENERATOR-v2.1

# 1. 基础类
类 动物 {
    定义 初始化(自己, 名字) {
        自己.名字 = 名字
    }
    定义 叫声(自己) {
        返回 "发出声音" + 自己.名字
    }
}

a = 动物("小猫")
输出(a.叫声())

# 2. 继承 + super
类 狗(动物) {
    定义 初始化(自己, 名字, 品种) {
        超类().初始化(名字)
        自己.品种 = 品种
    }
    定义 叫声(自己) {
        返回 自己.名字 + "(" + 自己.品种 + ") 汪汪"
    }
}

d = 狗("阿黄", "土狗")
输出(d.叫声())

# 3. 属性 / 类方法 / 静态方法
类 圆 {
    定义 初始化(自己, 半径) {
        自己.半径 = 半径
    }

    @属性
    定义 面积(自己) {
        返回 圆周率 * 自己.半径 * 自己.半径
    }

    @类方法
    定义 单位圆(类本身) {
        返回 类本身(1)
    }

    @静态方法
    定义 公式说明() {
        返回 "面积 = π * r²"
    }
}

c = 圆(3)
输出("面积=" + 字符串(c.面积))
输出("单位圆半径=" + 字符串(圆.单位圆().半径))
输出(圆.公式说明())

# 4. 抽象方法
@抽象方法
定义 面积基(自己) {
    通过
}

# 5. 生成器
定义 计数器(最大) {
    n = 0
    当 n < 最大 {
        产生 n
        n = n + 1
    }
}
输出("生成器=" + 字符串(列表(计数器(5))))

# 6. yield from
定义 扁平(嵌套列表) {
    对于 子 在 嵌套列表 {
        如果 isinstance(子, 列表) {
            产生于 扁平(子)
        } 否则 {
            产生 子
        }
    }
}
输出("扁平=" + 字符串(列表(扁平([1, [2, 3], [[4, 5]]]))))

# 7. 生成器表达式
平方生成器 = (x * x 对于 x 在 范围(10) 如果 x > 2)
输出("生成器表达式=" + 字符串(列表(平方生成器)))

# 8. 异常处理
定义 可能出错() {
    抛出 例外("出错了")
}
尝试 {
    可能出错()
} 捕获 例外 作为 e {
    输出("已截获: " + 字符串(e))
}

输出("✅ 类/装饰器/生成器测试完成")
