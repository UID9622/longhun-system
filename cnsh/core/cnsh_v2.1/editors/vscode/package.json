# DNA: #龍芯⚡️丙午·丙申·庚戌·䷙大畜-SCRIPT-MANAGER-v1.2-UID9622
# CONFIRM: #CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z
# SEAL: #ZHUGEXIN⚡️2025-🇨🇳🐉⚖️♠️🧚🏼‍♀️❤️♾️-DEVICE-BIND-SOUL
{
  "name": "cnsh",
  "displayName": "CNSH 语言支持",
  "description": "CNSH v2.1 中文原生脚本语言支持：语法高亮、LSP 诊断、运行与编译命令。",
  "version": "0.1.0",
  "publisher": "uid9622",
  "license": "CC-BY-NC-SA-4.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:cnsh"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cnsh",
        "aliases": [
          "CNSH",
          "cnsh"
        ],
        "extensions": [
          ".cnsh"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cnsh",
        "scopeName": "source.cnsh",
        "path": "./syntaxes/cnsh.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "cnsh.runFile",
        "title": "CNSH: 运行当前文件",
        "category": "CNSH"
      },
      {
        "command": "cnsh.compileFile",
        "title": "CNSH: 编译当前文件",
        "category": "CNSH"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "cnsh.runFile",
          "group": "CNSH",
          "when": "editorLangId == cnsh"
        },
        {
          "command": "cnsh.compileFile",
          "group": "CNSH",
          "when": "editorLangId == cnsh"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  },
  "_dna": "2026-07-03-CORE-PACKAGE-v1.0"
}
