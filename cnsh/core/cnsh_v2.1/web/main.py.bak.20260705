# -*- coding: utf-8 -*-
"""
CNSH v2.1 Web 技术站
DNA: #龍芯⚡️2026-06-29-CNSH-WEB-v2.1

本地启动：
    python3 -m uvicorn web.main:app --host 127.0.0.1 --port 8443
或：
    python3 -m web.main
"""
import io
import sys
from pathlib import Path
from typing import List

from fastapi import FastAPI, Request
from fastapi.staticfiles import StaticFiles
from fastapi.templating import Jinja2Templates
from pydantic import BaseModel

from cnsh_v21 import compile_source, run_source


app = FastAPI(title="CNSH Web 技术站", version="2.1.0")

WEB_ROOT = Path(__file__).parent
PROJECT_ROOT = WEB_ROOT.parent

app.mount("/static", StaticFiles(directory=str(WEB_ROOT / "static")), name="static")
templates = Jinja2Templates(directory=str(WEB_ROOT / "templates"))


class RunPayload(BaseModel):
    source: str
    optimize: int = 0
    strict_types: bool = False


class CompilePayload(BaseModel):
    source: str
    target: str = "python"
    optimize: int = 0


@app.get("/")
async def index(request: Request):
    return templates.TemplateResponse("index.html", {"request": request})


@app.get("/api/examples")
async def list_examples():
    examples_dir = PROJECT_ROOT / "examples"
    return [{"name": p.name} for p in examples_dir.glob("*.cnsh")]


@app.get("/api/examples/{name}")
async def get_example(name: str):
    path = PROJECT_ROOT / "examples" / name
    if not path.exists():
        return {"error": "示例不存在"}
    return {"name": name, "content": path.read_text(encoding="utf-8")}


@app.post("/api/run")
async def run_code(payload: RunPayload):
    diagnostics: List[str] = []

    def diag_cb(errors, warnings):
        diagnostics.extend(warnings)
        diagnostics.extend(errors)

    stdout_capture = io.StringIO()
    old_stdout = sys.stdout
    sys.stdout = stdout_capture
    try:
        result = run_source(
            payload.source,
            optimize_level=payload.optimize,
            strict_types=payload.strict_types,
            type_check=True,
            diagnostics_callback=diag_cb,
        )
        return {
            "success": True,
            "stdout": stdout_capture.getvalue(),
            "result": repr(result),
            "diagnostics": diagnostics,
        }
    except Exception as exc:
        return {
            "success": False,
            "stdout": stdout_capture.getvalue(),
            "error": str(exc),
            "diagnostics": diagnostics,
        }
    finally:
        sys.stdout = old_stdout


@app.post("/api/compile")
async def compile_code(payload: CompilePayload):
    try:
        code = compile_source(
            payload.source,
            target=payload.target,
            optimize_level=payload.optimize,
        )
        return {"success": True, "code": code}
    except Exception as exc:
        return {"success": False, "error": str(exc)}


@app.get("/api/docs")
async def docs():
    readme = PROJECT_ROOT / "README.md"
    if readme.exists():
        return {"content": readme.read_text(encoding="utf-8")}
    return {"content": "暂无文档"}


def main():
    import uvicorn

    uvicorn.run("web.main:app", host="127.0.0.1", port=8443, reload=False)


if __name__ == "__main__":
    main()
