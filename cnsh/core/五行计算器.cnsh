# ----- 六、核心函数：计算数字根 -----

功能 计算数字根(文本) {
    """
    输入任意文本，提取其中所有数字，反复相加到一位数。
    无数字返回 0。
    """
    数字列表 = []
    循环 字符 in 文本 {
        如果 字符.是数字() {
            数字列表.追加(字符.转整数())
        }
    }
    如果 数字列表.长度 == 0 {
        返回 0
    }
    总和 = 数字列表.求和()
    当 总和 >= 10 {
        总和 = 总和.转字符串().每个字符.转整数().求和()
    }
    返回 总和
}

# ----- 七、核心函数：三色审计 -----

功能 三色审计(数字根) {
    """
    根据数字根返回审计颜色：
    - dr ∈ {3,9} → 🔴 熔断
    - dr == 6   → 🟡 待审
    - 其他      → 🟢 通行
    """
    如果 数字根 在 熔断数字根 {
        返回 "🔴"
    }
    如果 数字根 == 6 {
        返回 "🟡"
    }
    返回 "🟢"
}

# ----- 八、核心函数：判断五行关系（生克泄耗比和）-----

功能 判断五行关系(A, B) {
    """
    判断两个五行之间的关系：
    - 比和：相同五行
    - 相生：A生B
    - 相克：A克B
    - 相泄：B生A（A被泄）
    - 相耗：B克A（A被耗）
    """
    如果 A == B {
        返回 "比和"
    }
    如果 五行相生.获取(A) == B {
        返回 "相生"
    }
    如果 五行相克.获取(A) == B {
        返回 "相克"
    }
    如果 五行相生.获取(B) == A {
        返回 "相泄"
    }
    如果 五行相克.获取(B) == A {
        返回 "相耗"
    }
    返回 "混合"
}

# ----- 九、核心函数：计算五行强度（四柱权重计分）-----

功能 计算五行强度(四柱) {
    """
    输入四柱字典，输出五行得分、最强、最弱、均衡指数、缺失五行。
    四柱格式：{"年柱":{"天干":"甲","地支":"子"}, ...}
    """
    得分 = {"金": 0.0, "木": 0.0, "水": 0.0, "火": 0.0, "土": 0.0}

    循环 柱位, 干支 in 四柱.每一项() {
        权重 = 位置权重表.获取(柱位)
        天干 = 干支["天干"]
        地支 = 干支["地支"]
        如果 天干五行表.包含(天干) {
            得分[天干五行表[天干]] += 权重["天干"]
        }
        如果 地支五行表.包含(地支) {
            得分[地支五行表[地支]] += 权重["地支"]
        }
    }

    总分 = 得分.所有值().求和() + 0.001
    均值 = 总分 / 5
    方差 = 0
    循环 分值 in 得分.所有值() {
        方差 += (分值 - 均值) ** 2
    }
    方差 = 方差 / 5
    均衡指数 = 最大值(0.0, 1.0 - (方差 ** 0.5) / (均值 + 0.001))
    均衡指数 = 四舍五入(均衡指数, 3)

    缺失五行 = []
    循环 五行名, 分值 in 得分.每一项() {
        如果 分值 == 0.0 {
            缺失五行.追加(五行名)
        }
    }

    最强 = 得分.取最大值键()
    最弱 = 得分.取最小值键()

    返回 {
        "五行得分": 得分,
        "最强": 最强,
        "最弱": 最弱,
        "均衡指数": 均衡指数,
        "缺失五行": 缺失五行
    }
}

# ----- 十、核心函数：完整链路分析（断链检测+过旺检测）-----

功能 完整链路分析(得分) {
    """
    分析五行相生循环链路是否完整，检测断链和过旺。
    """
    相生顺序 = ["金", "水", "木", "火", "土"]
    断链预警 = []
    健康度 = 100

    循环 i in 范围(相生顺序.长度) {
        来源 = 相生顺序[i]
        目标 = 相生顺序[(i + 1) % 5]
        如果 得分[来源] > 0 且 得分[目标] == 0 {
            断链预警.追加("🔴 断链：" + 来源 + "(" + 得分[来源].转字符串() + ")有力但生不出" + 目标 + "(0分)")
            健康度 -= 15
        }
    }

    总分 = 得分.所有值().求和() + 0.001
    循环 五行名, 分值 in 得分.每一项() {
        如果 分值 / 总分 > 0.40 {
            疏导目标 = 五行相生[五行名]
            断链预警.追加("🟡 过旺：" + 五行名 + "占" + (分值/总分*100).转整数().转字符串() + "%·需疏导→引生" + 疏导目标)
            健康度 -= 10
        }
    }

    健康度 = 最大值(0, 健康度)
    状态 = "🟢 健康"
    如果 健康度 < 50 {
        状态 = "🔴 需干预"
    } 否则 如果 健康度 < 80 {
        状态 = "🟡 待关注"
    }

    返回 {
        "链路健康度": 健康度,
        "状态": 状态,
        "断链预警": 断链预警
    }
}

# ----- 十一、核心函数：生成补益建议 -----

五行补益表 = {
    "金": {"颜色": ["白", "金", "银"], "方位": "西", "数字": [4,9],
           "建议": "多用白色·朝西·练金属乐器·增肺活量",
           "龍魂映射": "L0规则层·需强化底线"},
    "木": {"颜色": ["绿", "青"], "方位": "东", "数字": [3,8],
           "建议": "多亲近植物·朝东·早起·护肝",
           "龍魂映射": "L4创新层·需增加生命力"},
    "水": {"颜色": ["黑", "深蓝"], "方位": "北", "数字": [1,6],
           "建议": "多喝水·朝北·冥想·保护肾",
           "龍魂映射": "L1记忆层·需强化DNA追溯"},
    "火": {"颜色": ["红", "橙", "紫"], "方位": "南", "数字": [2,7],
           "建议": "多晒太阳·朝南·保护心脏·增热情",
           "龍魂映射": "L2文明层·需强化价值观光明度"},
    "土": {"颜色": ["黄", "棕"], "方位": "中", "数字": [5,10],
           "建议": "规律饮食·接地气·多接触土地·护脾胃",
           "龍魂映射": "L3普惠层·需强化根基承载力"},
}

功能 生成补益建议(强度结果) {
    """
    根据五行强度生成补益建议列表。
    """
    建议列表 = []
    得分 = 强度结果["五行得分"]
    总分 = 得分.所有值().求和() + 0.001

    # 1. 缺失五行：紧急补
    循环 五行名 in 强度结果["缺失五行"] {
        补 = 五行补益表[五行名]
        建议列表.追加({
            "级别": "🔴 紧急补",
            "五行": 五行名,
            "颜色": 补["颜色"].用"·"连接,
            "方位": 补["方位"],
            "数字": 补["数字"].转字符串(),
            "行动": 补["建议"],
            "龍魂": 补["龍魂映射"]
        })
    }

    # 2. 最弱五行（非缺失）：建议补
    最弱 = 强度结果["最弱"]
    如果 最弱 不在 强度结果["缺失五行"] {
        补 = 五行补益表[最弱]
        建议列表.追加({
            "级别": "🟡 建议补",
            "五行": 最弱,
            "颜色": 补["颜色"].用"·"连接,
            "方位": 补["方位"],
            "数字": 补["数字"].转字符串(),
            "行动": 补["建议"],
            "龍魂": 补["龍魂映射"]
        })
    }

    # 3. 最强五行（超过40%）：疏导
    最强 = 强度结果["最强"]
    如果 得分[最强] / 总分 > 0.40 {
        疏导目标 = 五行相生[最强]
        补 = 五行补益表[疏导目标]
        建议列表.追加({
            "级别": "🟢 疏导",
            "五行": 最强 + "（过旺→引生" + 疏导目标 + "）",
            "颜色": 补["颜色"].用"·"连接,
            "方位": 补["方位"],
            "数字": 补["数字"].转字符串(),
            "行动": 最强 + "过旺·" + 补["建议"],
            "龍魂": 补["龍魂映射"]
        })
    }

    返回 建议列表
}

# ----- 十二、核心函数：五行对冲指数 H（v3.1）-----

功能 归一化比例(值) {
    """
    把 0–100 或 0–1 的输入统一压到 0–1
    """
    如果 值 == 空 { 返回 0.0 }
    如果 值 > 1 {
        返回 最大值(0.0, 最小值(1.0, 值 / 100))
    }
    返回 最大值(0.0, 最小值(1.0, 值))
}

功能 计算克制衡分(得分) {
    """
    克制衡分：看相克关系是否能压住过旺
    """
    总分 = 得分.所有值().求和() + 0.001
    过旺列表 = []
    循环 五行名, 分值 in 得分.每一项() {
        如果 分值 / 总分 > 0.40 {
            过旺列表.追加(五行名)
        }
    }
    如果 过旺列表.长度 == 0 {
        返回 1.0
    }

    命中 = 0
    循环 五行名 in 过旺列表 {
        克制方 = 空
        循环 源, 目标 in 五行相克.每一项() {
            如果 目标 == 五行名 {
                克制方 = 源
                跳出
            }
        }
        如果 克制方 != 空 且 得分[克制方] > 0 {
            命中 += 1
        }
    }
    返回 四舍五入(命中 / 过旺列表.长度, 3)
}

功能 计算疏导分(得分) {
    """
    疏导分：过旺五行能否顺着相生流出去
    """
    总分 = 得分.所有值().求和() + 0.001
    过旺列表 = []
    循环 五行名, 分值 in 得分.每一项() {
        如果 分值 / 总分 > 0.40 {
            过旺列表.追加(五行名)
        }
    }
    如果 过旺列表.长度 == 0 {
        返回 1.0
    }

    命中 = 0
    循环 五行名 in 过旺列表 {
        疏导目标 = 五行相生[五行名]
        如果 得分[疏导目标] > 0 {
            命中 += 1
        }
    }
    返回 四舍五入(命中 / 过旺列表.长度, 3)
}

功能 计算补益分(强度结果) {
    """
    补益分：缺失越少、最弱不为0，补益越稳
    """
    缺失数 = 强度结果["缺失五行"].长度
    如果 缺失数 == 0 {
        返回 1.0
    }
    返回 四舍五入(最大值(0.0, 1.0 - 缺失数 / 5), 3)
}

功能 计算五行对冲指数(强度结果, 链路结果) {
    """
    综合计算对冲指数 H，输出三色和动作
    """
    得分 = 强度结果["五行得分"]

    克制衡分 = 计算克制衡分(得分)
    疏导分 = 计算疏导分(得分)
    补益分 = 计算补益分(强度结果)
    均衡指数 = 归一化比例(强度结果["均衡指数"])
    链路健康度 = 归一化比例(链路结果["链路健康度"])

    H = 四舍五入(
        克制衡分 * 0.30
        + 疏导分 * 0.25
        + 补益分 * 0.20
        + 均衡指数 * 0.15
        + 链路健康度 * 0.10,
        3
    )

    三色 = "🟢 对冲充分"
    动作 = "enter"
    如果 H < 0.50 {
        三色 = "🔴 对冲失败，熔断或重算"
        动作 = "fuse"
    } 否则 如果 H < 0.80 {
        三色 = "🟡 对冲不足，需补"
        动作 = "hold"
    }

    返回 {
        "对冲指数H": H,
        "三色": 三色,
        "动作": 动作,
        "分项": {
            "克制衡分": 克制衡分,
            "疏导分": 疏导分,
            "补益分": 补益分,
            "均衡指数": 均衡指数,
            "链路健康度": 链路健康度
        }
    }
}

# ----- 十三、核心函数：生成流场节点（v3.0统一出口）-----

功能 生成DNA(标题) {
    """
    生成DNA追溯码
    """
    今天 = 系统.时间.当前日期().格式("%Y-%m-%d")
    安全标题 = 标题.替换(" ", "").截断(18)
    返回 "#龍芯⚡️" + 今天 + "-" + 安全标题 + "-v1.0"
}

功能 生成节点ID(文本) {
    """
    生成节点ID：FLOW-9622-YYYYMMDD-8位哈希
    """
    哈希 = 系统.哈希.SHA256(文本.转字符串()).截断(8).大写()
    今天 = 系统.时间.当前日期().格式("%Y%m%d")
    返回 "FLOW-9622-" + 今天 + "-" + 哈希
}

功能 生成流场节点(输入文本, 标题="未命名节点", 前节点五行=空, 输入类型="text") {
    """
    流场压缩核 v3.0 统一入口
    输入任意文本，输出完整 Node JSON
    """
    数字根 = 计算数字根(输入文本)
    五行 = 数字根五行[数字根]
    审计 = 三色审计(数字根)
    关系 = 判断五行关系(五行, 前节点五行) 如果 前节点五行 != 空 否则 "起点"

    如果 审计 == "🟢" {
        动作 = "enter"
    } 否则 如果 审计 == "🟡" {
        动作 = "hold"
    } 否则 {
        动作 = "fuse"
    }

    视觉 = 五行视觉[五行]

    返回 {
        "node_id": 生成节点ID(输入文本),
        "标题": 标题,
        "输入类型": 输入类型,
        "数字根": 数字根,
        "五行": 五行,
        "关系": 关系,
        "三才": {"天": 0.35, "地": 0.15, "人": 0.50},
        "审计": 审计,
        "DNA": 生成DNA(标题),
        "视觉": 视觉,
        "动作": 动作,
        "备注": "文化语义算法节点，不替代科学实验、法律程序、医学判断或金融判断。"
    }
}

# ----- 十四、统一主入口：龍魂五行计算器 v3.0 -----

功能 龍魂五行计算器(年天干, 年地支, 月天干, 月地支, 日天干, 日地支, 时天干, 时地支) {
    """
    完整入口函数，传入8个干支字符串，返回完整分析报告
    """
    四柱 = {
        "年柱": {"天干": 年天干, "地支": 年地支},
        "月柱": {"天干": 月天干, "地支": 月地支},
        "日柱": {"天干": 日天干, "地支": 日地支},
        "时柱": {"天干": 时天干, "地支": 时地支},
    }

    强度 = 计算五行强度(四柱)
    链路 = 完整链路分析(强度["五行得分"])
    补益 = 生成补益建议(强度)
    对冲 = 计算五行对冲指数(强度, 链路)

    # 生成流场节点（作为摘要）
    摘要文本 = 年天干 + 年地支 + 月天干 + 月地支 + 日天干 + 日地支 + 时天干 + 时地支
    节点 = 生成流场节点(摘要文本, "四柱八字摘要", 空, "bazi")

    返回 {
        "版本": "v3.0",
        "四柱": 四柱,
        "五行强度": 强度,
        "链路分析": 链路,
        "补益建议": 补益,
        "对冲指数": 对冲,
        "流场节点": 节点,
        "DNA追溯": "#龍芯⚡️2026-05-01-五行计算器-v3.0-流场压缩核-封板",
        "确认码": "#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z"
    }
}

# ----- 十五、测试入口（可直接运行）-----

功能 主() {
    # 测试用例：甲子年丙午月庚申日壬戌时
    结果 = 龍魂五行计算器("甲", "子", "丙", "午", "庚", "申", "壬", "戌")

    打印("=" * 60)
    打印("🐉 龍魂五行计算器 v3.0 测试结果")
    打印("=" * 60)
    打印("五行得分: ", 结果["五行强度"]["五行得分"])
    打印("最强: ", 结果["五行强度"]["最强"])
    打印("最弱: ", 结果["五行强度"]["最弱"])
    打印("均衡指数: ", 结果["五行强度"]["均衡指数"])
    打印("链路健康度: ", 结果["链路分析"]["链路健康度"])
    打印("对冲指数H: ", 结果["对冲指数"]["对冲指数H"])
    打印("三色: ", 结果["对冲指数"]["三色"])
    打印("补益建议: ", 结果["补益建议"])
    打印("=" * 60)
    打印("DNA: ", 结果["DNA追溯"])
    打印("确认码: ", 结果["确认码"])
    打印("=" * 60)
}

