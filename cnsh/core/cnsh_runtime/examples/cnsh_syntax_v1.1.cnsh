# 🐉 CNSH 语法覆盖综合测试 v1.0

# 1. 变量与运算符
计数 = 10
计数 加等于 5
打印(f"计数={计数}")

# 2. 条件
如果 计数 大于 10:
    打印("大于10")
否则如果 计数 等于 10:
    打印("等于10")
否则:
    打印("小于10")

# 3. 循环 + 列表推导式
平方 = [x * x 对于 x 在 范围(5) 如果 x > 1]
打印(f"平方={平方}")

# 4. while 循环
i = 0
当 i < 3:
    打印(f"while {i}")
    i 加等于 1

# 5. with 上下文管理器
使用 打开("/tmp/cnsh_test.txt", "w") 作为 f:
    f.写入("hello cnsh")

# 6. JSON
数据 = {"a": 1, "b": [1, 2, 3]}
文本 = JSON序列化(数据, ensure_ascii=False)
打印(f"json={文本}")
解析 = JSON解析(文本)
打印(f"解析={解析}")

# 7. 数学函数
打印(f"sqrt(2)={平方根(2)}")
打印(f"sin(pi/2)={正弦(圆周率 / 2)}")
打印(f"random={随机()}")

# 8. 字典方法
d = {"x": 1, "y": 2}
d.更新({"z": 3})
打印(f"keys={列表(d.键())}")

# 9. 字符串方法
s = "  Hello CNSH  "
打印(f"strip={s.去空白()}")
打印(f"upper={s.大写()}")
打印(f"startswith={s.去空白().开始于('Hello')}")

# 10. lambda
平方λ = 匿名函数 x: x * x
打印(f"lambda={平方λ(7)}")

# 11. match/case (Python 3.10+)
值 = 2
匹配 值:
    分支 1:
        打印("one")
    分支 2:
        打印("two")
    分支 _:
        打印("other")

# 12. 位运算
打印(f"位与={5 位与 3}")
打印(f"左移={1 左移 3}")

# 13. 异常处理
尝试:
    x = 1 / 0
捕获 Exception 作为 e:
    打印(f"捕获异常: {e}")
最终:
    打印("最终块执行")

打印("✅ CNSH 语法综合测试完成")
