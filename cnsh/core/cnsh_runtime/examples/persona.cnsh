# CNSH 示例：类与对象
# DNA:#龍芯⚡️2026-06-16-CNSH-EXAMPLE-PERSONA-v1.0

类 人格:
    定义 初始化(自己, 名称, 角色):
        自己.名称 = 名称
        自己.角色 = 角色

    定义 介绍(自己):
        打印(f"我是{自己.名称}，担任{自己.角色}")

诸葛 = 人格("诸葛亮", "军师")
诸葛.介绍()
