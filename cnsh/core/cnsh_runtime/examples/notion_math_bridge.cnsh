# 🐉 龍魂 CNSH 演示：数学公式 + Notion 数据库一体化
# DNA: #龍芯⚡️2026-07-05-CNSH-NOTION-MATH-BRIDGE-DEMO-v1.0

打印("=== 1. 数学公式核心 ===")
打印(f"数字根(369) = {数字根(369)}")
打印(f"五行(8) = {五行(8)}")
打印(f"六十四卦名(0,0) = {六十四卦名(0, 0)}")
打印(f"三才能量((0.5,0.3,0.2)) = {三才能量((0.5, 0.3, 0.2))}")

打印("\n=== 2. Notion 数据库 ===")
条目 = 查询数据库("3367125a9c9f808a9692f0c6752e92fa", 页大小=3, 最大条数=5)
打印(f"DB3367 查到 {长度(条目)} 条")
对于 e 在 条目:
    属性表 = e.get("properties", {})
    名称 = "无标题"
    对于 k, v 在 属性表.items():
        如果 v.get("type") == "title":
            名称 = v.get("title", [{}])[0].get("plain_text", "无标题")
    打印(f"  · {名称}")

打印("\n=== 3. 同步种子模块 ===")
结果 = 同步DB3367种子模块("3367125a9c9f808a9692f0c6752e92fa")
打印(f"生成 {结果['generated']} 个，更新 {结果['updated']} 个，跳过 {结果['skipped']} 个")

打印("\n✅ CNSH 与 Notion 数据库已一体化")
