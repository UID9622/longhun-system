# ═══════════════════════════════════════════════════════════
# 1. 基础类型注解
# ═══════════════════════════════════════════════════════════

定义 加和(a: 整数, b: 整数) -> 整数:
    返回 a + b

定义 打招呼(名字: 字符串 = "老大") -> 字符串:
    返回 f"你好，{名字}"

打印(f"加和={加和(3, 5)}")
打印(打招呼())
打印(打招呼("宝宝"))


# ═══════════════════════════════════════════════════════════
# 2. 泛型与类型变量
# ═══════════════════════════════════════════════════════════

T = 类型变量("T")
K = 类型变量("K")
V = 类型变量("V")

定义 首个(元素列表: 列表类型[T]) -> 可选[T]:
    如果 长度(元素列表) > 0:
        返回 元素列表[0]
    返回 无

打印(f"首个={首个([10, 20, 30])}")
打印(f"首个空={首个([])}")

类 盒子(泛型[T]):
    定义 初始化(自己, 值: T):
        自己.值 = 值

    定义 取出(自己) -> T:
        返回 自己.值

整型盒 = 盒子[整数](42)
字符串盒 = 盒子[字符串]("龍魂")
打印(f"盒子={整型盒.取出()}, {字符串盒.取出()}")


# ═══════════════════════════════════════════════════════════
# 3. 装饰器带参
# ═══════════════════════════════════════════════════════════

定义 计时(标签: 字符串 = ""):
    定义 装饰器(原函数):
        @包裹(原函数)
        定义 包装(*参数, **关键字参数):
            开始 = 现在时间()
            结果 = 原函数(*参数, **关键字参数)
            耗时 = (现在时间() - 开始).total_seconds()
            打印(f"[{标签}] {原函数.__name__} 耗时 {耗时:.4f}s")
            返回 结果
        返回 包装
    返回 装饰器

@计时("核心")
定义 慢函数():
    睡眠(0.05)
    返回 "完成"

慢函数()


# ═══════════════════════════════════════════════════════════
# 4. 内置参数化装饰器
# ═══════════════════════════════════════════════════════════

@最近最少使用缓存(maxsize=128)
定义 斐波那契(n: 整数) -> 整数:
    如果 n < 2:
        返回 n
    返回 斐波那契(n - 1) + 斐波那契(n - 2)

打印(f"fib(10)={斐波那契(10)}")


# ═══════════════════════════════════════════════════════════
# 5. 字典 / 联合 / 可调用类型
# ═══════════════════════════════════════════════════════════

定义 配置读取() -> 字典类型[字符串, 任意]:
    返回 {"模式": "生产", "版本": 1}

定义 执行器(回调: 可调用类型[[整数], 字符串], 值: 整数) -> 字符串:
    返回 回调(值)

结果 = 执行器(字符串, 123)
打印(f"执行器结果={结果}")


# ═══════════════════════════════════════════════════════════
# 6. 完整异常体系（全中文异常类名）
# ═══════════════════════════════════════════════════════════

定义 可能出错(模式: 整数):
    如果 模式 == 1:
        抛出 值错误("模式不能为 1")
    否则如果 模式 == 2:
        抛出 键错误("键不存在")
    否则如果 模式 == 3:
        抛出 文件未找到错误("文件丢了")
    否则:
        抛出 运行时错误("未知错误")

尝试:
    可能出错(2)
捕获 值错误 作为 e:
    打印(f"值错误: {e}")
捕获 键错误 作为 e:
    打印(f"键错误: {e}")
捕获 (类型错误, 属性错误) 作为 e:
    打印(f"类型/属性错误: {e}")
捕获 例外 作为 e:
    打印(f"其他错误: {e}")
最终:
    打印("清理完成")


# 7. 自定义异常类
类 验证错误(值错误):
    定义 初始化(自己, 字段名: 字符串, 信息: 字符串):
        超类().__初始化__(f"[{字段名}] {信息}")
        自己.字段名 = 字段名

尝试:
    抛出 验证错误("年龄", "必须大于 0")
捕获 验证错误 作为 e:
    打印(f"自定义异常: {e}")

打印("✅ CNSH 高级语法测试完成")
