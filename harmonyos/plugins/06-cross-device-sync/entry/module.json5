{
  "module": {
    "name": "longhun_cross_device_sync",
    "type": "entry",
    "srcEntry": "./ets/pages/SyncStatus.ets",
    "description": "龍魂跨设备同步·分布式记忆·Super Device监督分担·桌面组件",
    "mainElement": "SyncAbility",
    "deviceTypes": ["phone", "tablet", "2in1"],
    "pages": "$profile:main_pages",
    "abilities": [
      { "name": "SyncAbility", "srcEntry": "./ets/pages/SyncStatus.ets", "type": "page", "exported": true, "launchType": "singleton" },
      { "name": "SyncServiceAbility", "srcEntry": "./ets/service/SyncService.ets", "type": "service", "exported": false, "backgroundModes": ["dataTransfer", "multiDeviceConnection"] }
    ],
    "extensionAbilities": [
      { "name": "SyncWidget", "srcEntry": "./ets/form/SyncWidget.ets", "type": "form", "metadata": [{ "name": "ohos.extension.form", "resource": "$profile:form_config" }] }
    ],
    "requestPermissions": [
      { "name": "ohos.permission.DISTRIBUTED_DATASYNC" },
      { "name": "ohos.permission.GET_DISTRIBUTED_DEVICE_INFO" }
    ],
    "metadata": [
      { "name": "longhun_dna", "value": "#龍芯⚡️丙午·癸未·乙酉·坤卦-PLUGIN-CROSS-DEVICE-SYNC-UID9622" }
    ]
  }
}
