import { HexagramReading, Yao, TRIGRAM_NAMES } from './models/HexagramModels';
import { getPositionName } from './HexagramLoader';

export class HexagramInterpreter {
  /**
   * 综合解卦（主入口）
   */
  static interpret(reading: HexagramReading): string {
    const L: string[] = [];
    const h = reading.originalHexagram;

    // 卦名与卦辞
    L.push(`【${h.name}卦 ${h.symbol}】`);
    L.push(`卦辞：${h.description}`);
    L.push(`彖曰：${h.interpretation}`);
    L.push(`象曰：${h.image}`);
    L.push('');

    // 动爻信息
    if (reading.movingYaoIndices.length > 0) {
      const names = reading.movingYaoIndices.map(i => reading.originalYaos[i].name).join('、');
      L.push(`⚡ 动爻：${names}`);
      if (reading.changedHexagram) {
        L.push(`变卦：${reading.changedName} ${reading.changedHexagram.symbol}`);
      }
      if (reading.mutualHexagram) {
        L.push(`互卦：${reading.mutualName} ${reading.mutualHexagram.symbol}`);
      }
    } else {
      L.push('⚡ 静卦·无动爻');
    }
    L.push('');

    // 世应
    L.push(`世应：世在${getPositionName(reading.shiPosition)}位 · 应在${getPositionName(reading.yingPosition)}位`);

    // 六亲
    L.push(`六亲：${reading.sixRelations.map(r => `${getPositionName(r.position)}${r.relation}`).join('·')}`);

    // 六神
    L.push(`六神：${reading.sixSpirits.map(s => `${getPositionName(s.position)}${s.spirit}`).join('·')}`);
    L.push('');

    // 📜 综合卦象判断
    L.push('【卦象判断】');
    L.push(this.judgment(reading));
    L.push('');

    // 💡 建议
    L.push('【建议】');
    L.push(this.suggestion(reading));

    return L.join('\n');
  }

