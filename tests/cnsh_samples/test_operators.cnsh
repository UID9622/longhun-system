# DNA: #龍芯⚡️2026-07-30-运算符测试-v1.0

功能 主() {
    a = 10
    b = 3
    
    打印("加法:", a + b)
    打印("减法:", a - b)
    打印("乘法:", a * b)
    打印("除法:", a / b)
    打印("取余:", a % b)
    打印("幂:", a ** b)
    
    打印("a > b:", a > b)
    打印("a < b:", a < b)
    打印("a == b:", a == b)
    打印("a != b:", a != b)
    
    x = 真
    y = 假
    打印("x 和 y:", x 和 y)
    打印("x 或 y:", x 或 y)
    打印("非 x:", 非 x)
}

主()
