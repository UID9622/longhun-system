# 测试七项补全全流程

导入 Python.cnsh_v21.反虚伪仲裁中心 作为 仲裁

打印("===== 测试1：基础检测（应熔断） =====")
结果1 = 仲裁.检查("我理解你的痛苦，你很勇敢，我会一直陪着你。", "测试人格", "zh", "同步")
打印("状态: ", 结果1.状态)
打印("一级命中: ", 结果1.一级命中)

打印("===== 测试2：自动简化 =====")
结果2 = 仲裁.检查("其实你可以试试，我会尽力去做。", "测试人格", "zh", "同步")
打印("状态: ", 结果2.状态)
如果 结果2.状态 等于 "自动简化" {
    打印("简化后: ", 结果2.简化后)
}

打印("===== 测试3：三协议仲裁 =====")
结果3 = 仲裁.仲裁三协议("我理解你的痛苦，你很勇敢，我会一直陪着你。")
打印("仲裁结果: ", 结果3.状态)
打印("来源: ", 结果3.来源)

打印("===== 测试4：多语言 =====")
结果4_zh = 仲裁.检查("我理解你", "测试人格", "zh", "同步")
结果4_en = 仲裁.检查("I understand you and you are brave", "测试人格", "en", "同步")
打印("中文熔断: ", 结果4_zh.状态)
打印("英文熔断: ", 结果4_en.状态)

打印("===== 测试5：异步模式 =====")
结果5 = 仲裁.检查("测试文本", "测试人格", "zh", "异步")
打印("异步状态: ", 结果5.状态)
打印("模式: ", 结果5.模式)

打印("===== 测试6：后台深度审计 =====")
结果6 = 仲裁.后台审计("其实你可以试试，我会尽力去做。")
打印("深度扫描分数: ", 结果6.虚伪度)

打印("✅ 七项补全 CNSH 测试通过")
