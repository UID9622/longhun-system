  "part_1_core_formulas": {
    "description": "10条核心公式 · 世界标准×龍魂主权 双轨对照",

    "F01_digital_root": {
      "standard": "dr(n) = 1 + ((n-1) mod 9), n>0; dr(0)=0",
      "source": "数论标准，ISBN/Luhn校验码",
