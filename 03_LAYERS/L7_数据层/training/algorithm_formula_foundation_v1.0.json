      "alpha_belongs": "α_τ",
      "verifiable": true
    },

    "F02_shannon_entropy": {
      "standard": "H(X) = -Σ p·log₂ p",
      "source": "香农 1948 · 信息论",
      "longhun_twist": "压缩护城河: ρ = 1 - |压缩后|/|原文|, entropy_check验证压缩不超过香农下界",
      "module": "语义熵防火墙",
      "alpha_belongs": "无",
      "verifiable": true
    },

    "F03_cosine_similarity": {
      "standard": "cos(A,B) = A·B / (‖A‖ · ‖B‖)",
      "source": "信息检索/NLP标配",
      "longhun_twist": "cosine_dedup: ≥0.9→🔴水军拒绝, 0.7~0.9→🟡可能重复, <0.7→🟢通过",
      "module": "水军检测·去重路由",
      "alpha_belongs": "无",
      "verifiable": true
    },

    "F04_normalization_alpha_lock": {
      "standard_linear": "wᵢ = xᵢ / Σxⱼ",
      "standard_softmax": "softmax(xᵢ) = e^xᵢ / Σe^xⱼ",
      "longhun_alpha_a": "Σ|αᵢ|² = 1 量子归一，防α混用",
      "longhun_alpha_w": "wᵢ≥0 且 Σwᵢ=1 凸组合，防裸用α",
      "module": "权重归一化·α三义锁死",
      "alpha_belongs": "α_a + α_w (双锁)",
      "verifiable": true
    },

    "F05_truth_score_veto": {
      "standard": "T = 0.4·M + 0.3·V + 0.3·F",
      "explanation": "M=有意义, V=可验证, F=格式安全(1=通过, 0=被污染)",
      "longhun_twist": "一票否决: 任一F=0→总分=0→🔴拒绝; ≥0.85→🟢, ≥0.60→🟡, <0.60→🔴",
      "module": "真实度评分·签章污染红线",
      "alpha_belongs": "B-LOCK",
      "verifiable": true
    },

    "F06_seven_dim_SOUL": {
      "standard": "SOUL = Σ wᵢ·Eᵢ",
      "weights": {"技术": 0.20, "语言": 0.15, "文化": 0.20, "数据": 0.15, "决策": 0.15, "知识": 0.10, "身份": 0.05},
