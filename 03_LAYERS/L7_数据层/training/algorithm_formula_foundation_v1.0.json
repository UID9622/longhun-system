        "judgement": {"≥60": "平衡", "30-60": "轻偏", "<30": "🔴严重失衡"}
      },

      "grs": {
        "formula": "GRS = Σ(相生力度) - Σ(相克力度)",
        "explanation": "生克动态: 正值=生>克(和谐), 负值=克>生(冲突)",
        "judgement": {"<-0.5": "🔴克制过强"}
