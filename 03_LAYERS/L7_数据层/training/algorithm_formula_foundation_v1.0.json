  "part_3_wuxing_matrix_engine": {
    "description": "五行矩阵评分引擎 · 多维诊断+生克动态+三才平衡",

    "functions": {
      "compute_vector": "多维分数→五行向量W=[金,木,水,火,土]：每个维度名/值的数字根→五行映射→累加归一化",

      "wbi": {
