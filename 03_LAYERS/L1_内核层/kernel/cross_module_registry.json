  "cross_module_rules": [
    {
      "id": "RULE-001",
      "name": "新数据文件→portal消费检查",
      "trigger": "任何脚本写入 portal/data/ 新JSON文件",
      "action": "检查 portal/index.html 是否有对应的 loadJSON 引用和渲染section",
      "auto_fix": true,
      "auto_fix_desc": "在 index.html 补充 loadJSON + HTML section + init函数",
      "severity": "🔴 严重"
    },
    {
      "id": "RULE-002",
      "name": "新数据文件→统计栏更新检查",
      "trigger": "新增统计类数据（如人格数、节点数）",
      "action": "检查 portal/index.html stat-bar 是否有对应 stat-* 元素",
      "auto_fix": true,
      "auto_fix_desc": "在 stats div 内补充 stat 卡片，在 initStats 中补充加载逻辑",
      "severity": "🟡 中等"
    },
    {
      "id": "RULE-003",
      "name": "新增API端点→消费方注册检查",
      "trigger": "任何 Python 文件新增 @app.route/@app.get/@app.post",
      "action": "检查是否有消费方（portal/dashboard/飞书/控制台）引用了该API",
      "auto_fix": false,
      "auto_fix_desc": "列出未消费的新API端点，提示注册",
      "severity": "🟡 中等"
    },
    {
      "id": "RULE-004",
      "name": "新增CLI工具→调度/自动化注册检查",
      "trigger": "bin/ 下新增可执行脚本",
      "action": "检查是否有定时任务(automation/cron)调度它，是否有MASTER_REGISTRY注册",
      "auto_fix": false,
      "auto_fix_desc": "列出未注册到MASTER_REGISTRY的新脚本",
      "severity": "🟡 中等"
    },
    {
      "id": "RULE-005",
      "name": "新增Python模块→上游消费方检查",
      "trigger": "任何新 .py 文件写入",
      "action": "检查是否有 import/调用方，若新增API端点则触发RULE-003",
      "auto_fix": false,
      "auto_fix_desc": "若为独立API服务，检查是否有文档/portal引用",
      "severity": "🟢 低危"
    },
    {
      "id": "RULE-006",
      "name": "飞书服务→portal联动检查",
      "trigger": "飞书机器人新增查询能力",
      "action": "检查对应数据在portal是否有同步板块",
      "auto_fix": true,
      "auto_fix_desc": "若portal缺对应section则补充",
      "severity": "🟡 中等"
    },
    {
      "id": "RULE-007",
      "name": "portal新section→导航栏注册检查",
      "trigger": "portal/index.html 新增 <section id=\"...\">",
      "action": "检查顶部导航栏 <nav> 是否有对应 <a href=\"#...\"> 链接",
      "auto_fix": true,
      "auto_fix_desc": "在 nav 导航栏补充链接",
      "severity": "🔴 严重"
    },
    {
      "id": "RULE-008",
      "name": "portal新section→init函数执行检查",
      "trigger": "portal/index.html 新增 initXxx() 函数定义",
      "action": "检查页面初始化代码末尾是否调用了 initXxx()",
      "auto_fix": true,
      "auto_fix_desc": "在初始化调用链末尾补充 initXxx()",
      "severity": "🔴 严重"
    },
    {
      "id": "RULE-009",
      "name": "数据源变更→所有消费方一致性检查",
      "trigger": "修改 JSON 数据结构（字段增减/重命名）",
      "action": "检查所有消费方代码是否使用了旧字段名",
      "auto_fix": false,
      "auto_fix_desc": "列出所有引用旧字段的消费方位置",
      "severity": "🔴 严重"
    },
    {
      "id": "RULE-010",
      "name": "bin/脚本创建→执行权限检查",
      "trigger": "新建 bin/*.py 或 bin/*.sh",
      "action": "检查是否已 chmod +x",
      "auto_fix": true,
      "auto_fix_desc": "自动 chmod +x",
      "severity": "🟢 低危"
    }
  ],
