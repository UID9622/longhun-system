"""
粒子系统：每一颗粒子都按场规矩行走。
DNA: #龍芯⚡️2026-06-24-UID9622-FLOW-FIELD-PARTICLE-v1.0
"""

import random
import math
from typing import List, Tuple, Callable


class Particle:
    """单颗粒子，记录路径与生命周期。"""

    def __init__(self, x: float, y: float, color: Tuple[int, int, int], width: float):
        self.x = x
        self.y = y
        self.path: List[Tuple[float, float]] = [(x, y)]
        self.color = color
        self.width = width
        self.alive = True
        self.age = 0

    def step(self, field_fn: Callable, w: float, h: float, step_length: float, scale: float, seed: float):
        if not self.alive:
            return
        vx, vy = field_fn(self.x, self.y, w, h, scale, seed)
        self.x += vx * step_length
        self.y += vy * step_length
        self.age += 1
        if self.x < -50 or self.x > w + 50 or self.y < -50 or self.y > h + 50:
            self.alive = False
        else:
            self.path.append((self.x, self.y))


def spawn_particles(preset: dict, seed: int = 0) -> List[Particle]:
    """按预设规矩生成粒子初始状态。"""
    random.seed(seed)
    w, h = preset["宽度"], preset["高度"]
    count = preset["粒子数"]
    palette = preset["色彩谱"]
    base_width = preset.get("笔触宽度", 1)
    field_name = preset["场函数"]

    particles = []
    for i in range(count):
        if field_name == "magnetic_dipole":
            # 从磁极附近出生，形成磁力线
            if random.random() < 0.5:
                x = w * 0.35 + random.gauss(0, 30)
                y = h * 0.5 + random.gauss(0, 80)
            else:
                x = random.uniform(0, w)
                y = random.uniform(0, h)
        elif field_name == "turbulent_up":
            # 火焰从底部出生
            x = random.uniform(0, w)
            y = h - random.uniform(0, h * 0.15)
        elif field_name == "calligraphy_flow":
            # 墨迹从左侧或顶部洒落
            if random.random() < 0.5:
                x = random.uniform(0, w * 0.1)
                y = random.uniform(0, h)
            else:
                x = random.uniform(0, w)
                y = random.uniform(0, h * 0.1)
        else:
            x = random.uniform(0, w)
            y = random.uniform(0, h)

        color = palette[i % len(palette)]
        width = max(1, base_width + random.gauss(0, base_width * 0.3))
        particles.append(Particle(x, y, color, width))
    return particles


def simulate(preset: dict, seed: int = 0) -> List[Particle]:
    """运行完整模拟。"""
    from .vector_field import get_field
    field_fn = get_field(preset["场函数"])
    particles = spawn_particles(preset, seed)
    w, h = preset["宽度"], preset["高度"]
    step_length = preset["步长"]
    scale = preset["噪声缩放"]
    steps = preset["步数"]
    for _ in range(steps):
        for p in particles:
            p.step(field_fn, w, h, step_length, scale, seed)
    return particles
