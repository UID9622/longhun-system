#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂技能冲突扫描器 v1.0
扫描 ~/.kimi-code/skills/ 与 ~/.agents/skills/ 下的 SKILL.md，
提取触发关键词，计算重叠关系，输出审计报告。
DNA: #龍芯⚡️20260629212911-SKILL-CONFLICT-AUDIT-8C7F2E1A
"""
import os
import re
import json
from pathlib import Path
from collections import defaultdict, Counter
import yaml

HOME = Path.home()
SKILL_DIRS = [
    HOME / ".kimi-code" / "skills",
    HOME / ".agents" / "skills",
]
REGISTRY_PATHS = [
    HOME / ".kimi-code" / "skills" / "registry" / "registry.json",
    HOME / ".kimi-code" / "skills" / "registry" / "registry-v5.1.json",
    HOME / ".kimi-code" / "skills" / "registry" / "registry-v5.2.json",
]
OUTPUT_PATH = HOME / "_work" / "skill_conflict_audit_report.md"

def extract_frontmatter(text):
    """提取 YAML front matter 和正文。"""
    if text.startswith("---"):
        parts = text.split("---", 2)
        if len(parts) >= 3:
            try:
                return yaml.safe_load(parts[1]) or {}, parts[2]
            except Exception:
                return {}, text
    return {}, text

def extract_text_keywords(text, min_len=2):
    """从正文中提取中文、英文、数字混合的关键词。"""
    # 中文词汇（2-8字）
    zh = re.findall(r"[\u4e00-\u9fff]{2,8}", text)
    # CNSH / azure / longhun 等标识
    ids = re.findall(r"[A-Za-z][A-Za-z0-9_-]{1,15}", text)
    words = [w for w in zh if len(w) >= min_len] + ids
    # 去重并小写英文
    seen = set()
    out = []
    for w in words:
        key = w.lower() if w.isascii() else w
        if key not in seen and not key.isdigit():
            seen.add(key)
            out.append(w)
    return out

