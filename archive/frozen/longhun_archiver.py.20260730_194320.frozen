#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂待整理归档器
按 inventory 中的 category 把文件移入 9 个子目录，保留原相对结构。
DNA: #龍芯⚡️2026-06-28-LONGHUN-ARCHIVER-v1.0
"""
import json, shutil
from pathlib import Path
from datetime import datetime, timezone

ROOT = Path('/Users/zuimeidedeyihan/龍魂待整理')
INV = ROOT / 'longhun_inventory.json'
EXCLUDE_NAMES = {'.DS_Store', '__pycache__', 'longhun_inventory.json'}


def main():
    inv = json.loads(INV.read_text(encoding='utf-8'))
    log = []
    for it in inv['items']:
        src = Path(it['absolute'])
        if not src.exists():
            log.append({'path': str(src), 'status': 'missing'})
            continue
        if src.name in EXCLUDE_NAMES:
            continue
        rel = Path(it['path'])
        cat = it['category']
        # 如果已经在目标目录下，跳过
        if rel.parts[0] == cat:
            log.append({'path': str(rel), 'status': 'already_in_place'})
            continue
        dst = ROOT / cat / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        if dst.exists():
            # 冲突：保留两个，旧版加后缀
            suffix = 1
            while dst.with_suffix(f'.dup{suffix}{dst.suffix}').exists():
                suffix += 1
            dst = dst.with_suffix(f'.dup{suffix}{dst.suffix}')
        shutil.move(str(src), str(dst))
        log.append({'from': str(rel), 'to': str(dst.relative_to(ROOT)), 'status': 'moved'})

    # 清理空目录
    removed_dirs = []
    for p in sorted(ROOT.rglob('*'), reverse=True):
        if p.is_dir() and p != ROOT and p.name not in EXCLUDE_NAMES and not any(p.parts[0].startswith('0') for p_rel in [p.relative_to(ROOT)]):
            try:
                if not any(p.iterdir()):
                    p.rmdir()
                    removed_dirs.append(str(p.relative_to(ROOT)))
            except Exception:
                pass

    report = {
        'archived_at': datetime.now(timezone.utc).isoformat(),
        'dna': '#龍芯⚡️2026-06-28-LONGHUN-ARCHIVE-OPERATION-v1.0',
        'moved': len([x for x in log if x.get('status') == 'moved']),
        'already': len([x for x in log if x.get('status') == 'already_in_place']),
        'missing': len([x for x in log if x.get('status') == 'missing']),
        'removed_empty_dirs': removed_dirs,
        'log': log,
    }
    (ROOT / 'longhun_archive_log.json').write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding='utf-8')
    print(f"Archived: moved={report['moved']}, already={report['already']}, missing={report['missing']}")
    print(f"Empty dirs removed: {len(removed_dirs)}")


if __name__ == '__main__':
    main()
