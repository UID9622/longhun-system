###############################################
# 龙魂人格军团·配置文件
###############################################
#
# DNA追溯码：#ZHUGEXIN⚡️-2026-02-15-config-v1.0
# 创建者：宝宝｜UID9622
# 创建时间：北京时间 2026-02-15 02:00:00
#
# 大白话：这个文件里是所有的配置开关
# 哪个人格要开启，就改成1；关闭就改成0
#
###############################################

# =====================================================
# 人格开关（1=启用, 0=禁用）
# =====================================================

# 雯雯·技术整理师（整理和分类技术文件）
ENABLE_WENWEN=1

# 上帝之眼·守护者（监控和安全检查）
ENABLE_EYE=1

# 宝宝·构建师（项目构建和编译）
ENABLE_BAOBAO=0  # 需要手动指定项目目录时才启用

# 侦察兵·信息猎手（收集和分析信息）
ENABLE_SCOUT=1

# 文心·同步专家（文件同步和备份）
ENABLE_WENXIN=1

# =====================================================
# 目录路径配置
# =====================================================

# 基础目录
AUTOMATION_BASE_DIR="$HOME/UID9622_Automation"
SCRIPTS_DIR="${AUTOMATION_BASE_DIR}/scripts"
CENTER_PERSONA_DIR="${AUTOMATION_BASE_DIR}/center-persona"
LOGS_DIR="${AUTOMATION_BASE_DIR}/logs"
REPORTS_DIR="${AUTOMATION_BASE_DIR}/reports"
BACKUPS_DIR="${AUTOMATION_BASE_DIR}/backups"
TEMP_DIR="${AUTOMATION_BASE_DIR}/temp"
SYNC_DIR="${AUTOMATION_BASE_DIR}/sync"

# 核心系统目录
LONGHUN_CORE_DIR="$HOME/龍芯核心系統"
UID9622_DIR="$HOME/UID9622"
DESKTOP_DIR="$HOME/Desktop"

# 龍魂本地中枢
LONGHUN_LOCAL_HUB="$HOME/龍魂本地中枢"

# =====================================================
# 脚本文件路径
# =====================================================

WENWEN_SCRIPT="${CENTER_PERSONA_DIR}/wenwen.sh"
EYE_SCRIPT="${CENTER_PERSONA_DIR}/eye.sh"
BAOBAO_SCRIPT="${CENTER_PERSONA_DIR}/baobao.sh"
SCOUT_SCRIPT="${CENTER_PERSONA_DIR}/scout.sh"
WENXIN_SCRIPT="${CENTER_PERSONA_DIR}/wenxin.sh"

# =====================================================
# 磁盘和备份配置
# =====================================================

# 磁盘使用率警告阈值（百分比）
DISK_WARNING_THRESHOLD=80

# 磁盘使用率错误阈值（百分比）
DISK_ERROR_THRESHOLD=90

# 保留最近的备份文件数量
BACKUP_RETAIN_COUNT=5

# 备份文件大小限制（MB）- 如果单个备份超过此值会发出警告
BACKUP_SIZE_WARNING_MB=500

# 自动清理旧备份（1=是, 0=否）
AUTO_CLEANUP_BACKUPS=1

# =====================================================
# 日志配置
# =====================================================

# 日志级别（DEBUG, INFO, WARN, ERROR）
LOG_LEVEL="INFO"

# 保留日志天数
LOG_RETENTION_DAYS=30

# 日志文件最大大小（MB）
LOG_MAX_SIZE_MB=100

# =====================================================
# 报告配置
# =====================================================

# 生成执行报告（1=是, 0=否）
GENERATE_REPORT=1

# 报告格式
REPORT_FORMAT="markdown"  # 支持: markdown, json, html

# 在报告中包含详细日志（1=是, 0=否）
REPORT_INCLUDE_DETAILS=1

# =====================================================
# 并发和性能配置
# =====================================================

# 允许并发执行脚本（1=是, 0=否）
ALLOW_PARALLEL_EXECUTION=0

# 脚本间隔等待时间（秒）
SCRIPT_INTERVAL_SECONDS=5

# 脚本执行超时时间（秒），0表示无限制
SCRIPT_TIMEOUT_SECONDS=0

# =====================================================
# 通知配置
# =====================================================

# 执行完后显示摘要（1=是, 0=否）
SHOW_SUMMARY=1

# 执行失败时显示详细错误（1=是, 0=否）
SHOW_DETAILED_ERRORS=1

# =====================================================
# 安全配置
# =====================================================

# 需要确认才能执行（1=是, 0=否）
REQUIRE_CONFIRMATION=0

# 干运行模式（测试但不真正执行）（1=是, 0=否）
DRY_RUN=0

# 备份关键文件（1=是, 0=否）
BACKUP_CRITICAL_FILES=1

# =====================================================
# 调试配置
# =====================================================

# 启用调试模式（显示所有执行的命令）
DEBUG_MODE=0

# 保持临时文件用于调试（1=是, 0=否）
KEEP_TEMP_FILES=0

# 显示详细的性能信息（1=是, 0=否）
SHOW_PERFORMANCE_INFO=1

###############################################
# 文件末尾
###############################################
