# ═══════════════════════════════════════════════════════════════════════════════
# 铁律自审闸 / Iron Law Self-Audit Gate
# ═══════════════════════════════════════════════════════════════════════════════

class IronLawGate:
    """
    铁律自审闸 / Iron Law Self-Audit Gate
    检查核心规范，确保“龍”不得简化等神圣规则
    Checks sacred rules: traditional “龍”must not be simplified
    """

    SACRED_RULES = {
        "铁律一": {
            "描述": "繁体“龍”不得使用简体替代",
            "描述_en": "Traditional '龍' must NOT use simplified variant",
            "禁止模式": ["\u9f99"],  # Unicode for simplified dragon
            "严重级别": AuditColor.RED
        },
        "铁律二": {
            "描述": "DNA追溯码必须存在且格式正确",
            "描述_en": "DNA trace code must exist with correct format",
            "验证": "dna_format",
            "严重级别": AuditColor.RED
        },
        "铁律三": {
            "描述": "CNSH终端头不可删除",
            "描述_en": "CNSH terminal header must NOT be deleted",
            "验证": "cnsh_header",
            "严重级别": AuditColor.RED
        },
        "铁律四": {
            "描述": "君子协议许可必须存在",
            "描述_en": "Gentleman's Agreement license must exist",
            "验证": "license",
            "严重级别": AuditColor.YELLOW
        }
    }

    def __init__(self):
        self.violations: List[Dict[str, Any]] = []
        self.passed = True

    def audit(self, content: str, audit_system: ThreeColorAudit = None) -> Dict[str, Any]:
        """
        执行铁律自审 / Execute iron law self-audit
        检查内容是否违反任何铁律
        """
        self.violations = []
        self.passed = True

        # 铁律一: 检查简体龍字 (使用Unicode转义 \u9f99)
        if "\u9f99" in content:
            self.violations.append({
                "铁律": "铁律一",
                "问题": "发现简体龍字，必须使用繁体“龍”",
                "级别": AuditColor.RED.value
            })
            self.passed = False

        # 铁律二: DNA追溯码格式
        if "#龍芯⚡️" not in content and "#龍芯" not in content:
            self.violations.append({
                "铁律": "铁律二",
                "问题": "缺少DNA追溯码头部",
                "级别": AuditColor.RED.value
            })
            self.passed = False

        # 铁律三: CNSH终端头
        if "CNSH" not in content or "不可删除" not in content:
            self.violations.append({
                "铁律": "铁律三",
                "问题": "CNSH不可删除终端头缺失",
                "级别": AuditColor.RED.value
            })
            self.passed = False

        # 铁律四: 君子协议
        if "CC BY-NC-SA" not in content or "君子协议" not in content:
            self.violations.append({
                "铁律": "铁律四",
                "问题": "君子协议/CC BY-NC-SA 4.0许可缺失",
                "级别": AuditColor.YELLOW.value
            })

        result = {
            "通过": self.passed,
            "违规数": len(self.violations),
            "违规详情": self.violations,
            "检查时间": datetime.now().isoformat()
        }

        if audit_system:
            conf = 1.0 if self.passed else (0.3 if any(
                v["级别"] == AuditColor.RED.value for v in self.violations
            ) else 0.7)
            audit_system.record("IronLawGate", "铁律自审", conf,
                              f"发现 {len(self.violations)} 条违规" if self.violations else "所有铁律通过")

        return result


# ═══════════════════════════════════════════════════════════════════════════════
# CNSH不可删除终端头 / CNSH Indelible Terminal Header
# ═══════════════════════════════════════════════════════════════════════════════

class CNSHTerminalHeader:
    """
    CNSH不可删除终端头 / CNSH Indelible Terminal Header
    任何尝试删除或修改此头的行为都会触发🔴阻断
    ANY attempt to delete or modify this header triggers 🔴 BLOCK
    """

    TEMPLATE = """# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  CNSH · 中文原生脚本不可删除终端头                                          ║
# ║  DNA: #龍芯⚡️{date}-CNSH-TERMINAL-v{version}                               ║
# ║  创始人: UID9622 · 龍芯北辰 · 诸葛鑫                                        ║
# ║  GPG: A2D0092CEE2E5BA87035600924C3704A8CC26D5F                             ║
# ║  协议: CC BY-NC-SA 4.0 + 君子协议                                           ║
# ║  此头不可删除 · 不可修改 · 不可迁移                                          ║
# ║  ANY DELETION/MODIFICATION TRIGGERS 🔴 BLOCK AUDIT                          ║
# ╚══════════════════════════════════════════════════════════════════════════════╝"""

    @classmethod
    def 生成(cls, 版本: str = "2.0.0") -> str:
        """生成终端头 / Generate terminal header"""
        return cls.TEMPLATE.format(
            date=datetime.now().strftime('%Y-%m-%d'),
            version=版本
        )

    @classmethod
    def 验证完整性(cls, 文件内容: str, 版本: str = "2.0.0") -> Dict[str, Any]:
        """验证终端头完整性 / Verify terminal header integrity"""
        expected = cls.生成(版本)
        present = expected.split("\n")[1] in 文件内容
        return {
            "完整": present,
            "信息": "CNSH终端头存在且完整" if present else "⚠️ CNSH终端头缺失或被篡改！🔴阻断",
            "严重级别": AuditColor.GREEN.value if present else AuditColor.RED.value
        }


# ═══════════════════════════════════════════════════════════════════════════════
# DNA签名验证器 / DNA Signature Verifier
# ═══════════════════════════════════════════════════════════════════════════════

class DNASignatureVerifier:
    """
    DNA签名验证器 / DNA Signature Verifier
    验证DNA追溯码的格式和密码学签名
    Validates DNA trace code format and cryptographic signature
    """

    # DNA格式: #龍芯⚡️{YYYY-MM-DD}-{项目}-{模块}-{版本}
    DNA_PATTERN = re.compile(
        r'^#龍芯⚡️(\d{4}-\d{2}-\d{2})-([\w\u4e00-\u9fff]+)-([\w\u4e00-\u9fff]+)-v(\d+\.\d+\.?\d*)$'
    )

    # 有效GPG指纹列表
    VALID_GPG_FINGERPRINTS = [
        "A2D0092CEE2E5BA87035600924C3704A8CC26D5F"  # UID9622 · 龍芯北辰
    ]

    def __init__(self):
        self.logger = logging.getLogger("DNA验证器")

    def validate_format(self, dna_string: str) -> Dict[str, Any]:
        """
        验证DNA字符串格式 / Validate DNA string format
        检查是否符合 #龍芯⚡️{date}-{project}-{module}-{version} 格式
        """
        dna_string = dna_string.strip()

        if not dna_string.startswith("#龍芯"):
            return {
                "有效": False,
                "置信度": 0.0,
                "信息": "DNA必须以 #龍芯 开头",
                "解析": None
            }

        # 检查繁体“龍”/ Check traditional “龍”
        if "\u9f99" in dna_string:
            return {
                "有效": False,
                "置信度": 0.0,
                "信息": "🔴 发现简体龍字，必须使用繁体“龍”",
                "解析": None
            }

        match = self.DNA_PATTERN.match(dna_string)
        if not match:
            return {
                "有效": False,
                "置信度": 0.3,
                "信息": "DNA格式不匹配预期模式",
                "解析": None
            }

        date_str, project, module, version = match.groups()

        # 验证日期格式
        try:
            parsed_date = datetime.strptime(date_str, "%Y-%m-%d")
            if parsed_date > datetime.now():
                return {
                    "有效": False,
                    "置信度": 0.2,
                    "信息": f"🔴 DNA日期 {date_str} 在未来",
                    "解析": None
                }
        except ValueError:
            return {
                "有效": False,
                "置信度": 0.2,
                "信息": f"🔴 无效日期格式: {date_str}",
                "解析": None
            }

        return {
            "有效": True,
            "置信度": 0.95,
            "信息": f"✅ DNA格式有效: {project}-{module}-v{version}",
            "解析": {
                "日期": date_str,
                "项目": project,
                "模块": module,
                "版本": version,
                "原始": dna_string
            }
        }

    def verify_signature(self, dna_string: str, gpg_fingerprint: str) -> Dict[str, Any]:
        """
        验证DNA GPG签名 / Verify DNA GPG signature
        检查GPG指纹是否在有效列表中
        """
        if gpg_fingerprint not in self.VALID_GPG_FINGERPRINTS:
            return {
                "验证通过": False,
                "置信度": 0.1,
                "信息": f"🔴 未知GPG指纹: {gpg_fingerprint}",
                "认证身份": None
            }

        # 计算DNA内容哈希作为签名验证
        dna_hash = hashlib.sha256(dna_string.encode('utf-8')).hexdigest()[:32]

        return {
            "验证通过": True,
            "置信度": 0.95,
            "信息": f"✅ GPG签名验证通过 (UID9622 · 龍芯北辰)",
            "认证身份": "UID9622 · 龍芯北辰 · 诸葛鑫",
            "DNA哈希": dna_hash
        }

    def validate_dna_chain(self, dna_list: List[str]) -> Dict[str, Any]:
        """
        验证DNA链完整性 / Validate DNA chain integrity
        检查一系列DNA标记是否形成连续有效的链
        """
        results = []
        overall_valid = True

        for i, dna in enumerate(dna_list):
            format_result = self.validate_format(dna)
            results.append({
                "索引": i,
                "DNA": dna,
                "格式有效": format_result["有效"],
                "置信度": format_result["置信度"]
            })
            if not format_result["有效"]:
                overall_valid = False

        return {
            "链完整": overall_valid,
            "DNA数量": len(dna_list),
            "详情": results,
            "检查时间": datetime.now().isoformat()
        }


