# 六层来源链验证引擎 (核心类) / Six-Layer Lineage Verification Engine
# ═══════════════════════════════════════════════════════════════════════════════

class 来源链验证引擎:
    """
    六层来源链验证引擎 / Six-Layer Lineage Verification Engine
    ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
    从道统层到生命层的完整验证，每层生成独立报告
    Complete verification from Taoist Heritage to Life Layer,
    each layer generates an independent report.

    六层架构 / Six-Layer Architecture:
        L1 道统层 · Taoist Heritage  - 文化根源验证
        L2 精神层 · Spiritual       - 核心价值校准
        L3 设备层 · Device          - 硬件环境检查
        L4 技术层 · Technical       - 技术栈溯源
        L5 系统层 · System          - 系统完整性
        L6 生命层 · Life            - 创作者身份锚定
    """

    LAYERS = [
        "道统层",   # L1: Taoist Heritage - 文化根源
        "精神层",   # L2: Spiritual - 核心价值
        "设备层",   # L3: Device - 硬件环境
        "技术层",   # L4: Technical - 技术栈溯源
        "系统层",   # L5: System - 系统完整性
        "生命层"    # L6: Life - 创作者身份锚定
    ]

    def __init__(self):
        """构造函数 / Constructor"""
        self.审计系统 = ThreeColorAudit()
        self.DNA验证器 = DNASignatureVerifier()
        self.层级报告: Dict[str, Dict[str, Any]] = {}
        self.logger = logging.getLogger("来源链验证引擎")

        # 配置日志
        logging.basicConfig(
            level=logging.INFO,
            format='[%(asctime)s] %(name)s · %(levelname)s · %(message)s'
        )

    def 验证全部层(self, 来源链数据: Dict[str, Dict[str, Any]]) -> Dict[str, Any]:
        """
        验证全部六层 / Verify all six layers

        参数 / Parameters:
            来源链数据: 每层的来源链数据字典，键为层名，值为该层数据
                       Dict mapping layer name to layer verification data

        返回 / Returns:
            完整验证结果，包含每层的独立报告
            Complete verification results with per-layer independent reports
        """
        self.logger.info("🔍 开始六层来源链验证...")
        print("\n" + "=" * 70)
        print("  🔍 六层来源链验证引擎 · Six-Layer Lineage Verification")
        print("  " + "=" * 70)

        结果 = {}
        total_confidence = 0.0

        for i, 层 in enumerate(self.LAYERS, 1):
            print(f"\n  📋 L{i}: {层} 验证中...")
            层数据 = 来源链数据.get(层, {})
            层结果 = self._验证单层(层, 层数据)
            结果[层] = 层结果
            total_confidence += 层结果.get("置信度", 0.0)

            color = "🟢" if 层结果.get("置信度", 0) >= 0.85 else \
                    ("🟡" if 层结果.get("置信度", 0) >= 0.60 else "🔴")
            print(f"     {color} 结果: {层结果.get('状态', '未知')} "
                  f"(conf={层结果.get('置信度', 0):.2f})")

        # 计算整体置信度
        overall_conf = total_confidence / len(self.LAYERS) if self.LAYERS else 0.0

        # 记录到审计系统
        audit_color = self.审计系统.record(
            "来源链验证引擎", "六层完整验证",
            overall_conf,
            f"六层验证完成，平均置信度 {overall_conf:.4f}"
        )

        result = {
            "验证时间": datetime.now().isoformat(),
            "整体置信度": round(overall_conf, 4),
            "审计结果": audit_color,
            "层级结果": 结果,
            "完整报告": self._生成完整报告(结果)
        }

        print("\n" + "=" * 70)
        print(f"  验证完成 · 整体置信度: {overall_conf:.4f} · "
              f"状态: {audit_color}")
        print("  " + "=" * 70 + "\n")

        return result

    def _验证单层(self, 层名: str, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """
        验证单层 / Verify single layer
        每层有独立的验证逻辑和报告生成
        """
        验证函数 = {
            "道统层": self._验证道统层,
            "精神层": self._验证精神层,
            "设备层": self._验证设备层,
            "技术层": self._验证技术层,
            "系统层": self._验证系统层,
            "生命层": self._验证生命层
        }

        验证函数 = 验证函数.get(层名, lambda d: self._默认验证(层名, d))
        return 验证函数(数据)

    def _验证道统层(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """
        L1: 道统层验证 / Taoist Heritage Layer Verification
        验证文化根源和传承链的完整性
        """
        issues = []
        confidence = 0.95

        # 检查道统标记
        heritage = 数据.get("道统标记", "")
        if not heritage:
            issues.append("缺少道统标记")
            confidence -= 0.2

        # 检查传承链
        lineage = 数据.get("传承链", [])
        if not lineage:
            issues.append("传承链为空")
            confidence -= 0.1

        # 检查文化根源
        root = 数据.get("文化根源", "")
        if "龍" not in root:
            issues.append("文化根源缺少“龍”标记")
            confidence -= 0.3

        status = "✅ 通过" if confidence >= 0.85 else \
                 ("🟡 警告" if confidence >= 0.60 else "🔴 阻断")

        report = {
            "层级": "道统层 (L1)",
            "描述": "文化根源验证 / Cultural Heritage Verification",
            "描述_en": "Taoist Heritage Layer - Cultural root verification",
            "置信度": round(max(confidence, 0.0), 4),
            "状态": status,
            "问题": issues,
            "详情": {
                "道统标记": heritage or "未提供",
                "传承链长度": len(lineage),
                "文化根源": root or "未提供"
            },
            "验证时间": datetime.now().isoformat()
        }

        self.审计系统.record("来源链", f"道统层验证", confidence,
                            f"道统层验证{status}: {', '.join(issues) if issues else '无问题'}")

        self.层级报告["道统层"] = report
        return report

    def _验证精神层(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """
        L2: 精神层验证 / Spiritual Layer Verification
        验证核心价值观和精神导向
        """
        issues = []
        confidence = 0.95

        # 检查核心价值
        values = 数据.get("核心价值", [])
        if not values:
            issues.append("缺少核心价值定义")
            confidence -= 0.2

        # 检查精神标记
        spirit = 数据.get("精神标记", "")
        if not spirit:
            issues.append("缺少精神标记")
            confidence -= 0.15

        # 检查君子协议认同
        if not 数据.get("君子协议", False):
            issues.append("未确认君子协议")
            confidence -= 0.1

        status = "✅ 通过" if confidence >= 0.85 else \
                 ("🟡 警告" if confidence >= 0.60 else "🔴 阻断")

        report = {
            "层级": "精神层 (L2)",
            "描述": "核心价值校准 / Core Values Alignment",
            "描述_en": "Spiritual Layer - Core values calibration",
            "置信度": round(max(confidence, 0.0), 4),
            "状态": status,
            "问题": issues,
            "详情": {
                "核心价值": values or ["未提供"],
                "精神标记": spirit or "未提供",
                "君子协议": 数据.get("君子协议", False)
            },
            "验证时间": datetime.now().isoformat()
        }

        self.审计系统.record("来源链", f"精神层验证", confidence,
                            f"精神层验证{status}")
        self.层级报告["精神层"] = report
        return report

    def _验证设备层(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """
        L3: 设备层验证 / Device Layer Verification
        验证硬件环境和设备完整性
        """
        issues = []
        confidence = 0.90

        # 检查平台信息
        platform = 数据.get("平台", "")
        if not platform:
            issues.append("未识别平台")
            confidence -= 0.1

        # 检查Python版本
        py_version = 数据.get("Python版本", "")
        if not py_version:
            issues.append("Python版本未检测")
            confidence -= 0.1

        # 检查文件系统权限
        if not 数据.get("文件权限", False):
            issues.append("文件系统权限未确认")
            confidence -= 0.05

        status = "✅ 通过" if confidence >= 0.85 else \
                 ("🟡 警告" if confidence >= 0.60 else "🔴 阻断")

        report = {
            "层级": "设备层 (L3)",
            "描述": "硬件环境检查 / Hardware Environment Check",
            "描述_en": "Device Layer - Hardware environment verification",
            "置信度": round(max(confidence, 0.0), 4),
            "状态": status,
            "问题": issues,
            "详情": {
                "平台": platform or sys.platform,
                "Python版本": py_version or f"{sys.version_info.major}.{sys.version_info.minor}",
                "文件权限": 数据.get("文件权限", True)
            },
            "验证时间": datetime.now().isoformat()
        }

        self.审计系统.record("来源链", f"设备层验证", confidence,
                            f"设备层验证{status}")
        self.层级报告["设备层"] = report
        return report

    def _验证技术层(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """
        L4: 技术层验证 / Technical Layer Verification
        验证技术栈和依赖链
        """
        issues = []
        confidence = 0.92

        # 检查技术栈
        stack = 数据.get("技术栈", [])
        if not stack:
            issues.append("技术栈未定义")
            confidence -= 0.1

        # 检查编码
        encoding = 数据.get("编码", "")
        if encoding != "UTF-8":
            issues.append(f"编码建议使用UTF-8，当前: {encoding}")
            confidence -= 0.05

        # 检查依赖完整性
        dependencies = 数据.get("依赖", [])
        if not dependencies:
            issues.append("依赖列表为空")
            confidence -= 0.05

        status = "✅ 通过" if confidence >= 0.85 else \
                 ("🟡 警告" if confidence >= 0.60 else "🔴 阻断")

        report = {
            "层级": "技术层 (L4)",
            "描述": "技术栈溯源 / Tech Stack Traceability",
            "描述_en": "Technical Layer - Technology stack traceability",
            "置信度": round(max(confidence, 0.0), 4),
            "状态": status,
            "问题": issues,
            "详情": {
                "技术栈": stack or ["Python 3.8+"],
                "编码": encoding or "UTF-8",
                "依赖数量": len(dependencies)
            },
            "验证时间": datetime.now().isoformat()
        }

        self.审计系统.record("来源链", f"技术层验证", confidence,
                            f"技术层验证{status}")
        self.层级报告["技术层"] = report
        return report

    def _验证系统层(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """
        L5: 系统层验证 / System Layer Verification
        验证系统完整性和一致性
        """
        issues = []
        confidence = 0.88

        # 检查系统完整性哈希
        integrity = 数据.get("完整性哈希", "")
        if not integrity:
            issues.append("缺少完整性哈希")
            confidence -= 0.1

        # 检查系统状态
        status_flag = 数据.get("系统状态", "")
        if status_flag not in ["正常", "initialized", "ready"]:
            issues.append(f"系统状态异常: {status_flag}")
            confidence -= 0.15

        # 检查配置文件
        config = 数据.get("配置文件", {})
        if not config:
            issues.append("配置文件为空")
            confidence -= 0.05

        status = "✅ 通过" if confidence >= 0.85 else \
                 ("🟡 警告" if confidence >= 0.60 else "🔴 阻断")

        report = {
            "层级": "系统层 (L5)",
            "描述": "系统完整性 / System Integrity",
            "描述_en": "System Layer - System integrity verification",
            "置信度": round(max(confidence, 0.0), 4),
            "状态": status,
            "问题": issues,
            "详情": {
                "完整性哈希": integrity or "未计算",
                "系统状态": status_flag or "未知",
                "配置项数量": len(config)
            },
            "验证时间": datetime.now().isoformat()
        }

        self.审计系统.record("来源链", f"系统层验证", confidence,
                            f"系统层验证{status}")
        self.层级报告["系统层"] = report
        return report

    def _验证生命层(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """
        L6: 生命层验证 / Life Layer Verification
        验证创作者身份锚定
        """
        issues = []
        confidence = 0.95

        # 检查创作者身份
        creator = 数据.get("创作者", "")
        if not creator:
            issues.append("创作者身份未指定")
            confidence -= 0.3

        # 检查UID
        uid = 数据.get("UID", "")
        if not uid:
            issues.append("UID未指定")
            confidence -= 0.2

        # 检查GPG指纹
        gpg = 数据.get("GPG指纹", "")
        if not gpg:
            issues.append("GPG指纹缺失")
            confidence -= 0.15

        # 验证DNA签名
        dna = 数据.get("DNA", "")
        if dna:
            dna_result = self.DNA验证器.validate_format(dna)
            if not dna_result["有效"]:
                issues.append(f"DNA格式无效: {dna_result['信息']}")
                confidence -= 0.2
        else:
            issues.append("DNA追溯码缺失")
            confidence -= 0.25

        status = "✅ 通过" if confidence >= 0.85 else \
                 ("🟡 警告" if confidence >= 0.60 else "🔴 阻断")

        report = {
            "层级": "生命层 (L6)",
            "描述": "创作者身份锚定 / Creator Identity Anchoring",
            "描述_en": "Life Layer - Creator identity anchoring",
            "置信度": round(max(confidence, 0.0), 4),
            "状态": status,
            "问题": issues,
            "详情": {
                "创作者": creator or "未指定",
                "UID": uid or "未指定",
                "GPG指纹": (gpg[:16] + "...") if gpg else "未指定",
                "DNA验证": dna_result.get("信息", "未验证") if dna else "未提供"
            },
            "验证时间": datetime.now().isoformat()
        }

        self.审计系统.record("来源链", f"生命层验证", confidence,
                            f"生命层验证{status}")
        self.层级报告["生命层"] = report
        return report

    def _默认验证(self, 层名: str, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """默认验证处理 / Default verification handler"""
        return {
            "层级": f"{层名} (未知)",
            "描述": "未分类层验证",
            "描述_en": "Unclassified layer verification",
            "置信度": 0.50,
            "状态": "🟡 警告",
            "问题": ["使用默认验证，层级未定义"],
            "详情": 数据,
            "验证时间": datetime.now().isoformat()
        }

    def 验证DNA签名(self, DNA: str, GPG指纹: str = "") -> Dict[str, Any]:
        """
        验证DNA签名 / Verify DNA signature

        参数 / Parameters:
            DNA: DNA追溯码字符串 / DNA trace code string
            GPG指纹: GPG密钥指纹 / GPG key fingerprint

        返回 / Returns:
            DNA验证结果字典 / DNA verification result dictionary
        """
        print(f"\n  🔐 DNA签名验证 / DNA Signature Verification")
        print(f"     DNA: {DNA[:50]}..." if len(DNA) > 50 else f"     DNA: {DNA}")

        # 步骤1: 验证格式
        format_result = self.DNA验证器.validate_format(DNA)
        print(f"     格式验证: {'✅ 通过' if format_result['有效'] else '🔴 失败'}")
        print(f"     置信度: {format_result['置信度']:.4f}")

        if not format_result["有效"]:
            self.审计系统.record("DNA验证", "格式验证", format_result["置信度"],
                                format_result["信息"])
            return {
                "验证通过": False,
                "格式验证": format_result,
                "签名验证": None,
                "整体置信度": format_result["置信度"]
            }

        # 步骤2: 验证GPG签名
        gpg = GPG指纹 or "A2D0092CEE2E5BA87035600924C3704A8CC26D5F"
        sig_result = self.DNA验证器.verify_signature(DNA, gpg)
        print(f"     签名验证: {'✅ 通过' if sig_result['验证通过'] else '🔴 失败'}")
        print(f"     认证身份: {sig_result.get('认证身份', '未知')}")

        self.审计系统.record("DNA验证", "签名验证", sig_result["置信度"],
                            sig_result["信息"])

        overall_conf = (format_result["置信度"] + sig_result["置信度"]) / 2

        return {
            "验证通过": format_result["有效"] and sig_result["验证通过"],
            "格式验证": format_result,
            "签名验证": sig_result,
            "整体置信度": round(overall_conf, 4)
        }

    def _生成完整报告(self, 层级结果: Dict[str, Dict[str, Any]]) -> str:
        """生成完整报告 / Generate comprehensive report"""
        lines = [
            "=" * 70,
            "  六层来源链验证报告 · Six-Layer Lineage Verification Report",
            "=" * 70,
            f"  生成时间: {datetime.now().isoformat()}",
            f"  验证引擎版本: v1.0.0",
            f"  DNA:#龍芯⚡️2026-06-18-LINEAGE_VERIFICATION_ENGINE_V1-v1.0.0",
            "-" * 70
        ]

        for 层, 结果 in 层级结果.items():
            conf = 结果.get("置信度", 0)
            color = "🟢" if conf >= 0.85 else ("🟡" if conf >= 0.60 else "🔴")
            lines.extend([
                f"\n  [{color}] {层}",
                f"      置信度: {conf:.4f}",
                f"      状态: {结果.get('状态', '未知')}",
                f"      描述: {结果.get('描述', '无描述')}",
            ])
            if 结果.get("问题"):
                lines.append(f"      问题: {', '.join(结果['问题'])}")

        lines.extend([
            "-" * 70,
            f"  审计摘要: {json.dumps(self.审计系统.summary(), ensure_ascii=False)}",
            "=" * 70
        ])

        return "\n".join(lines)

    def 获取审计摘要(self) -> Dict[str, Any]:
        """获取审计摘要 / Get audit summary"""
        return self.审计系统.summary()


