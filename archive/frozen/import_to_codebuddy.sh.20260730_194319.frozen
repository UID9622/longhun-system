#!/bin/bash
# 龍魂系统 · CodeBuddy 快速导入脚本
# 功能：一键复制所有文件到 CodeBuddy 工作区

echo "🐉 龍魂系统 CodeBuddy 导入器"

# 假设 CodeBuddy 工作区在 ~/codebuddy-workspace/
# 根据实际情况修改
CODEBUDDY_DIR="${CODEBUDDY_WORKSPACE:-$HOME/codebuddy-workspace/longhun}"

mkdir -p "$CODEBUDDY_DIR"

cp -r config "$CODEBUDDY_DIR/"
cp -r engine "$CODEBUDDY_DIR/"
cp -r manager "$CODEBUDDY_DIR/"
cp -r cron "$CODEBUDDY_DIR/"
cp README.md "$CODEBUDDY_DIR/"
cp SUMMARY.txt "$CODEBUDDY_DIR/"

echo "✅ 已导入到: $CODEBUDDY_DIR"
echo ""
echo "📂 目录结构:"
find "$CODEBUDDY_DIR" -type f | head -20
