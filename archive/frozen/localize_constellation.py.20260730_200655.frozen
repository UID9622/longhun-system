    'verdictEl': '判决元素',
}

# 3. keyframes 名
css_anim_map = {
    'marquee': '跑马灯动画',
    'silverShimmer': '银色闪烁',
    'redPulse': '红色脉冲',
}

# 4. 注释中的英文术语
comment_map = {
    '/* Tooltip */': '/* 提示框 */',
    '/* HUD */': '/* 抬头显示 */',
    '// ================= 初始化 Three.js =================': '// ================= 初始化 Three.js 三维引擎 =================',
}

# 5. 本地库路径
path_map = {
    '../../静态库/three/three.min.js': '../../本地库/three/three.min.js',
    '../../静态库/three/OrbitControls.js': '../../本地库/three/OrbitControls.js',
}

# ==================== 分段处理 ====================
# 将文件拆分为 style 块、script 块、其余部分
style_match = re.search(r'(<style>)(.*?)(</style>)', text, re.DOTALL)
script_match = re.search(r'(<script>)(.*?)(</script>)', text, re.DOTALL)

style_start, style_body, style_end = style_match.groups()
script_start, script_body, script_end = script_match.groups()

# 其余部分（html body 等）
rest = text[:style_match.start()] + '{STYLE}' + text[style_match.end():script_match.start()] + '{SCRIPT}' + text[script_match.end():]

# ---- 处理 style 段 ----
style_new = style_body
# 先完整替换 id/class，避免后续 keyframes 名（如 marquee）破坏复合名
for k, v in sorted(html_css_map.items(), key=lambda x: -len(x[0])):
    style_new = re.sub(rf'#{re.escape(k)}\b', f'#{v}', style_new)
    style_new = re.sub(rf'\.{re.escape(k)}\b', f'.{v}', style_new)
# keyframes
for k, v in sorted(css_anim_map.items(), key=lambda x: -len(x[0])):
    style_new = re.sub(rf'\b{re.escape(k)}\b', v, style_new)
# 注释
for k, v in sorted(comment_map.items(), key=lambda x: -len(x[0])):
    style_new = style_new.replace(k, v)

# ---- 处理 script 段 ----
script_new = script_body
# 注释
for k, v in sorted(comment_map.items(), key=lambda x: -len(x[0])):
    script_new = script_new.replace(k, v)
# 先替换 JS 字符串中的 id/class，避免后续变量名替换破坏 id 字符串
for k, v in sorted(html_css_map.items(), key=lambda x: -len(x[0])):
    # 单引号或双引号包围的完整 token，支持连字符（如 '画布容器'）
    script_new = re.sub(rf"(?<=[\"']){re.escape(k)}(?=[\"'])", v, script_new)
    # querySelector 等 CSS 选择器字符串中的 .class / #id
    script_new = re.sub(rf"(?<=[\"'])\.{re.escape(k)}(?=[\"'])", f'.{v}', script_new)
    script_new = re.sub(rf"(?<=[\"'])#{re.escape(k)}(?=[\"'])", f'#{v}', script_new)
# JS 函数/变量名（词边界，避免破坏属性访问）
for k, v in sorted(js_map.items(), key=lambda x: -len(x[0])):
    script_new = re.sub(rf'\b{re.escape(k)}\b', v, script_new)

# ---- 处理 rest（HTML body + 脚本 src） ----
rest_new = rest
# onclick 函数调用
onclick_map = {
    'closeInfoPanel()': '关闭信息面板()',
    'openChapter()': '打开章节()',
    'resetView()': '复位视角()',
    'toggleAutoRotate()': '切换自动旋转()',
    'toggleFullscreen()': '切换全屏()',
}
for k, v in sorted(onclick_map.items(), key=lambda x: -len(x[0])):
    rest_new = rest_new.replace(k, v)
# id/class 属性
for k, v in sorted(html_css_map.items(), key=lambda x: -len(x[0])):
    rest_new = re.sub(rf'id="{k}"', f'id="{v}"', rest_new)
    rest_new = re.sub(rf'class="([^"]*)\b{k}\b([^"]*)"', lambda m: f'class="{m.group(1)}{v}{m.group(2)}"', rest_new)
# 本地库路径
for k, v in sorted(path_map.items(), key=lambda x: -len(x[0])):
    rest_new = rest_new.replace(k, v)

# 重新组装
final = rest_new.replace('{STYLE}', style_start + style_new + style_end).replace('{SCRIPT}', script_start + script_new + script_end)

# 写回
SRC.write_text(final, encoding='utf-8')

# ==================== 生成对照表 ====================
report_path = Path('/Users/zuimeidedeyihan/longhun-system/web/p0-controls/CNSH_龍魂星宿知识图_中英对照表_v3.0.md')
lines = [
    '# CNSH_龍魂星宿知识图 中英对照表 v3.0',
    '',
    f'- DNA 追溯码：`#龍芯⚡️2026-07-04-CNSH-FULL-LOCALIZE-UID9622`',
    f'- 确认码：`#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-777D`',
    f'- 执行时间：{datetime.now().isoformat()}',
    f'- 目标文件：`{SRC}`',
    '',
    '## 一、id / class / name 中英对照',
    '',
    '| 原英文名 | 新中文名 | 类型 |',
    '|---|---|---|',
]
for k, v in sorted(html_css_map.items()):
    lines.append(f'| `{k}` | `{v}` | id/class |')

lines.extend([
    '',
    '## 二、JS 函数/变量中英对照',
    '',
    '| 原英文名 | 新中文名 |',
    '|---|---|',
])
for k, v in sorted(js_map.items()):
    lines.append(f'| `{k}` | `{v}` |')

lines.extend([
    '',
    '## 三、CSS 动画名中英对照',
    '',
    '| 原英文名 | 新中文名 |',
    '|---|---|',
])
for k, v in sorted(css_anim_map.items()):
    lines.append(f'| `{k}` | `{v}` |')

lines.extend([
    '',
    '## 四、CDN / 本地库路径变更',
    '',
    '| 原路径 | 新路径 | 说明 |',
    '|---|---|---|',
])
for k, v in sorted(path_map.items()):
    lines.append(f'| `{k}` | `{v}` | 本地静态库迁移到 web/本地库 |')
lines.append('| 无外部 CDN | - | 文件中未引用 jsdelivr 等外部 CDN |')

lines.extend([
    '',
    '## 五、路径变更记录',
    '',
    f'- 源文件保持文件名不变：`{SRC.name}`',
    f'- 本地库资源复制到：`{LOCAL_LIB}`',
    f'- 原文件备份：`{BAK.name}`',
    '',
    '## 六、保留英文项说明',
    '',
    '以下英文项属于技术标准 / 库名 / API，予以保留并加中文解释：',
    '- `Three.js`：WebGL 三维引擎库名，保留原名。',
    '- `THREE.*` 系列类名、方法名、属性名（如 `Scene`、`Mesh`、`Vector3`、`sRGBEncoding`）：保留英文。',
    '- HTML 标签与属性名（如 `class`、`id`、`onclick`、`src`）：保留英文。',
    '- CSS 属性名与值（如 `position`、`display`、`rgba`）：保留英文。',
    '- JS 关键字（`const`、`let`、`function`、`if`、`return` 等）：保留英文。',
    '- 数据对象字段名（`name`、`code`、`label`、`color`、`risk`、`desc`、`chapter` 等）：保留英文，作为内部 schema。',
    '- 颜色代码（`0xFFD700`、`#00C853` 等）：保留。',
    '- DNA 码、CONFIRM 码、版本号：`#龍芯⚡️...`、`#CONFIRM🌌...`、v2.0/v3.0 保留。',
    '',
    '---',
    '本对照表由全量中文命名规范化任务自动生成。',
])

report_path.write_text('\n'.join(lines), encoding='utf-8')

print('替换完成')
print(f'备份：{BAK}')
print(f'对照表：{report_path}')
