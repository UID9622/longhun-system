import re
import json
import shutil
from pathlib import Path
from datetime import datetime

SRC = Path('/Users/zuimeidedeyihan/longhun-system/web/p0-controls/CNSH_龍魂星宿知识图.html')
BAK = SRC.with_suffix('.html.bak.20260704')
LOCAL_LIB = Path('/Users/zuimeidedeyihan/longhun-system/web/本地库/three')

# 备份
shutil.copy2(SRC, BAK)

text = SRC.read_text(encoding='utf-8')

# ==================== 映射表 ====================
# 1. HTML/CSS id/class 及可见文本
html_css_map = {
    # ids
    'canvas-container': '画布容器',
    'nebula': '星云背景',
    'sovereignty-marquee': '主权跑马灯',
