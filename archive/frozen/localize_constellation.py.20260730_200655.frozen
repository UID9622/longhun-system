}

# 2. JS 函数名/变量名（词边界，仅替换局部变量名，不破坏对象属性/API）
js_map = {
    'addLights': '添加灯光',
    'createStar': '创建星辰',
    'currentStar': '当前星辰',
    'centerLight': '中心光',
    'colors': '颜色列表',
    'positions': '位置列表',
    'l': '光',
    'chapterBtn': '章节按钮',
    'baseWidth': '基础宽度',
    'canvas': '画布',
    'centerMesh': '中心网格',
    'count': '数量',
    'ctx': '上下文',
    'displayColor': '显示颜色',
    'fontSize': '字号',
    'geom': '几何体',
    'geometry': '几何体',
    'glow': '光晕',
    'glowColor': '光晕颜色',
    'glowMat': '光晕材质',
    'glowTex': '光晕纹理',
    'grad': '渐变',
    'groupCenter': '组中心',
    'groupNodes': '组节点',
