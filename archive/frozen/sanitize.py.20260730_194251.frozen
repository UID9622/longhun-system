#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import json, re, os, glob

SYNC_DIR = "/Users/zuimeidedeyihan/longhun-system/csdn_sync"

# Drop any line that contains these keywords / values.
DROP_KEYWORDS = [
    "#龍芯",
    "#CONFIRM",
    "#SEAL",
    "#ZHUGEXIN",
    "#ROOT-SEAL",
    "A2D0092CEE2E5BA87035600924C3704A8CC26D5F",  # GPG fingerprint
    "123d1d92a4b91189",                          # device fingerprint
    "M4 Max 指纹",
    "M4 Max fingerprint",
    "/Users/",
    "img-home.csdnimg.cn",
    "外链图片转存失败",
    "确认码",
    "DNA 追溯码",
    "DNA追溯码",
    "DNA追溯保護",
    "君子協議",
    "GPG 指纹",
    "GPG指紋",
    "GPG指纹",
    "GPG fingerprint",
    "GPG anchoring",
    "GPG anchor",
    "GPG背书",
    "GPG 指紋",
    "GPG数字签名",
    "gpg_fingerprint",
    "CONFIRM·SEAL·GPG",
    "龍芯⚡️",
    "<!龍芯",
    "<! 龍芯",
    "龍芯北辰",
    "浙江瑞安",
    "湖岭镇",
    "贾岙村",
    "献礼：",
    "DNA追溯",
    "原作者",
    "📌 **转载",
]

SENSITIVE_PATTERNS = [
    re.compile(r"\b1[3-9]\d{9}\b"),              # Chinese mobile
    re.compile(r"\b\d{17}[\dXx]\b"),             # id card
    re.compile(r"\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Z|a-z]{2,}\b"),  # email
]

REPLACEMENTS = {
    "UID9622": "龍魂作者",
    "诸葛鑫": "龍魂作者",
    "寶寶": "助手",
    "龍芯 AI 验证系统": "AI 验证系统",
    "龍芯北辰": "龍魂作者",
    "龍魂北辰": "龍魂作者",
    "GPG 指纹": "数字签名",
    "GPG指纹": "数字签名",
    "DNA 追溯": "版本追溯",
    "DNA追溯": "版本追溯",
    "DNA 碱基对": "四碱基对",
    "DNA碱基对": "四碱基对",
}

def clean_title(title: str) -> str:
    title = title.strip()
    title = re.sub(r"^(\[特殊字符\]\s*)+", "", title)
    return title

def clean_md(md: str) -> str:
    # 1. Remove HTML comment blocks (often contain DNA/signatures)
    md = re.sub(r"<!--.*?-->", "", md, flags=re.DOTALL)
    # 2. Remove <aside>...</aside> metadata blocks
    md = re.sub(r"<aside>.*?</aside>", "", md, flags=re.DOTALL)
    # 3. Remove single-line <!...> tags (e.g. <!龍芯⚡️...>)
    md = re.sub(r"<![^>]*>", "", md)
    lines = md.splitlines()
    out = []
    for line in lines:
        # Drop lines with sensitive keywords
        if any(kw in line for kw in DROP_KEYWORDS):
            continue
        # Drop lines with sensitive patterns (phone/id/email)
        if any(p.search(line) for p in SENSITIVE_PATTERNS):
            continue
        # Generic identifier replacements
        for old, new in REPLACEMENTS.items():
            line = line.replace(old, new)
        # Restore CSDN article URLs so links don't break after UID replacement
        line = re.sub(r"https://blog\.csdn\.net/龍魂作者/", "https://blog.csdn.net/uid_9622/", line)
        out.append(line)
    cleaned = "\n".join(out)
    # Convert broken internal Notion/CSDN relative markdown links to plain text
    cleaned = re.sub(r"\[([^\]]+)\]\((?:\./)+[^)]+\.md\)", r"\1", cleaned)
    # Collapse excessive blank lines
    cleaned = re.sub(r"\n{4,}", "\n\n\n", cleaned)
    return cleaned

def main():
    files = sorted(
        glob.glob(os.path.join(SYNC_DIR, "*_raw.json")) +
        glob.glob(os.path.join(SYNC_DIR, "*_meta.json"))
    )
    manifest = []
    for path in files:
        base = os.path.basename(path)
        article_id = base.split("_")[0]
        if base.endswith("_raw.json"):
            with open(path, "r", encoding="utf-8") as f:
                raw = f.read()
            data = json.loads(raw)
            if isinstance(data, str):
                data = json.loads(data)
            title = data.get("title", "")
            md = data.get("md", "")
        else:
            md_path = os.path.join(SYNC_DIR, f"{article_id}.md")
            if not os.path.exists(md_path):
                print(f"Skipping {base}: no matching .md")
                continue
            with open(path, "r", encoding="utf-8") as f:
                meta = json.load(f)
            title = meta.get("title", "")
            with open(md_path, "r", encoding="utf-8") as f:
                raw_md = f.read().strip()
            if raw_md.startswith('"') and raw_md.endswith('"'):
                md = json.loads(raw_md)
            else:
                md = raw_md
        title = clean_title(title)
        md = clean_md(md)
        header = "<!-- 转载自 CSDN 同名账号，掘金同步发布 -->\n\n"
        publish_path = os.path.join(SYNC_DIR, f"{article_id}_publish.md")
        with open(publish_path, "w", encoding="utf-8") as f:
            f.write(header + md)
        manifest.append({
            "articleId": article_id,
            "title": title,
            "publishPath": publish_path,
            "chars": len(md),
        })
        print(f"Saved {publish_path} ({len(md)} chars)")
    manifest_path = os.path.join(SYNC_DIR, "publish_manifest.json")
    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(manifest, f, ensure_ascii=False, indent=2)
    print(f"Manifest saved to {manifest_path}")

if __name__ == "__main__":
    main()
