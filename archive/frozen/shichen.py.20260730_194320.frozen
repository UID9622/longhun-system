"""
十二时辰调度模块：把自然时间变成文化时间。
DNA: #龍芯⚡️2026-06-24-UID9622-BRAIN-SHICHEN-v1.0
"""

import datetime
from typing import Dict, Tuple

# 十二时辰：时辰 -> (开始小时, 结束小时开区间)
SHICHEN_TABLE = [
    ("子时", 23, 1),
    ("丑时", 1, 3),
    ("寅时", 3, 5),
    ("卯时", 5, 7),
    ("辰时", 7, 9),
    ("巳时", 9, 11),
    ("午时", 11, 13),
    ("未时", 13, 15),
    ("申时", 15, 17),
    ("酉时", 17, 19),
    ("戌时", 19, 21),
    ("亥时", 21, 23),
]

SHICHEN_WUXING = {
    "子时": "水", "丑时": "土", "寅时": "木", "卯时": "木",
    "辰时": "土", "巳时": "火", "午时": "火", "未时": "土",
    "申时": "金", "酉时": "金", "戌时": "土", "亥时": "水",
}

SHICHEN_YIJING = {
    "子时": "复卦·一阳来复", "丑时": "临卦·二阳渐长", "寅时": "泰卦·三阳开泰",
    "卯时": "大壮·四阳盛发", "辰时": "夬卦·五阳决阴", "巳时": "乾卦·六阳纯清",
    "午时": "姤卦·一阴初生", "未时": "遁卦·二阴渐长", "申时": "否卦·三阴闭塞",
    "酉时": "观卦·四阴肃杀", "戌时": "剥卦·五阴剥阳", "亥时": "坤卦·六阴纯浊",
}


def get_current_shichen(dt: datetime.datetime = None) -> Dict[str, str]:
    """根据本地时间返回当前时辰信息。"""
    dt = dt or datetime.datetime.now()
    hour = dt.hour
    for name, start, end in SHICHEN_TABLE:
        if start < end:
            if start <= hour < end:
                current = name
                break
        else:
            if hour >= start or hour < end:
                current = name
                break
    else:
        current = "子时"
    return {
        "时辰": current,
        "五行": SHICHEN_WUXING.get(current, "未知"),
        "卦象": SHICHEN_YIJING.get(current, "未知"),
        "北京时间": dt.strftime("%Y-%m-%d %H:%M:%S"),
    }


def get_shichen_by_name(name: str) -> Dict[str, str]:
    return {
        "时辰": name,
        "五行": SHICHEN_WUXING.get(name, "未知"),
        "卦象": SHICHEN_YIJING.get(name, "未知"),
    }


def suggest_action_by_shichen(shichen: str, health_score: int) -> str:
    """根据时辰和健康评分给出文化建议。"""
    wx = SHICHEN_WUXING.get(shichen, "土")
    if health_score >= 80:
        return f"{shichen}（{wx}）系统稳固，宜推进、宜发布、宜对外连接。"
    if health_score >= 60:
        return f"{shichen}（{wx}）系统微恙，宜整理、宜归档、宜小修小补。"
    if wx == "火":
        return f"{shichen}火旺之时，系统压力偏大，今日宜静修，忌对外发布。"
    return f"{shichen}（{wx}）系统需要关注，宜排查、宜备份、不宜做重大变更。"