#!/bin/bash
# 龍魂快捷命令 v4.0
# DNA: #龍芯⚡️20260529-aliases-v4.0

export LONGHUN_HOME="$HOME/龍魂系统"
export PYTHONPATH="$LONGHUN_HOME:$PYTHONPATH"

# 加账: 记录事件并执行规则判定
加账() {
    python3 << PYTHON_EOF
from 核心引擎.规则引擎 import 规则引擎, 事件
import sys
import os

引擎 = 规则引擎(账本路径=os.path.expanduser('~/.龍魂/规则账本.jsonl'))

# 交互输入
编号 = input("事件编号 (EVT-YYYYMMDD-NNN): ").strip() or "EVT-20260529-001"
人物 = input("人物名称: ").strip() or "测试"
行为 = input("行为描述: ").strip() or "测试行为"
犯错 = input("是否犯错? (y/n): ").lower() == 'y'
自扛 = input("是否自扛责任? (y/n): ").lower() == 'y' if 犯错 else False
立正 = input("批评时立正? (y/n): ").lower() == 'y' if 犯错 else False
威胁 = input("包含威胁? (y/n): ").lower() == 'y'
补救 = input("主动补救? (y/n): ").lower() == 'y'

记录 = 事件(
    编号=编号,
    人物=人物,
    行为=行为,
    犯错=犯错,
    自扛=自扛,
    立正=立正,
    威胁=威胁,
    补救=补救
)

结果 = 引擎.执行(记录)

print("\n" + "="*60)
print(f"DNA: {结果['DNA']}")
print(f"状态: {结果['状态']}")
print(f"分数: {结果['分数']}/100")
print(f"规则: {结果['判定结果']['规则匹配']}")
print("="*60)
PYTHON_EOF
}

# 查账: 查询账本
查账() {
    python3 << PYTHON_EOF
from 核心引擎.规则引擎 import 规则引擎
import os

引擎 = 规则引擎(账本路径=os.path.expanduser('~/.龍魂/规则账本.jsonl'))
记录 = 引擎.查询账本()

if not 记录:
    print("账本为空")
else:
    for 项 in 记录[-5:]:  # 只显示最后5条
        事件 = 项['事件']
        判定 = 项['判定']
        print(f"{事件['人物']} | {事件['行为'][:20]} | 分数{判定['分数']} | {判定['状态']}")
PYTHON_EOF
}

export -f 加账
export -f 查账
