#!/bin/bash
# -*- coding: utf-8 -*-
# DNA追溯码: #龍芯⚡️2026-06-23-184259-header-UID9622-B55AC960
# 创建者: UID9622
# 版本: 1.0.0
# 状态: 🟢 已规范

###############################################
# 龍魂系統·iCloud备份脚本（简化版）
###############################################
#
# DNA追溯码：#ZHUGEXIN⚡️-2026-02-15-icloud-backup-simple-v1.0
# 创建者：宝宝｜UID9622
# 创建时间：北京时间 2026-02-15 04:00:00
#
# 确认码：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z
#
###############################################

set -e

# =====================================================
# 配置（使用正确的路径处理）
# =====================================================

# 定义iCloud路径
ICLOUD_DRIVE="${HOME}/Library/Mobile Documents/com~apple~CloudDocs"
BACKUP_ROOT="${ICLOUD_DRIVE}/龍魂系統備份"

# 源位置
AUTOMATION_SOURCE="${HOME}/UID9622_Automation"
LONGHUN_SOURCE="${HOME}/龍芯核心系統"

# 时间戳
TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")
BACKUP_DATE=$(date "+%Y-%m-%d")
BACKUP_TIME=$(date "+%H%M%S")
DNA_CODE="#ZHUGEXIN⚡️-${BACKUP_DATE}-icloud备份-${BACKUP_TIME}"

# 日志文件（使用简单路径）
LOG_DIR="${BACKUP_ROOT}/logs"
LOG_FILE="${LOG_DIR}/backup_${BACKUP_DATE}_${BACKUP_TIME}.log"

# 颜色定义
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

# =====================================================
# 日志函数
# =====================================================

echo_info() {
    local msg="$1"
    echo -e "${BLUE}[$(date '+%H:%M:%S')]${NC} $msg"
}

echo_success() {
    local msg="$1"
    echo -e "${GREEN}[$(date '+%H:%M:%S')] ✅${NC} $msg"
}

echo_warn() {
    local msg="$1"
    echo -e "${YELLOW}[$(date '+%H:%M:%S')] ⚠️${NC} $msg"
}

echo_error() {
    local msg="$1"
    echo -e "${RED}[$(date '+%H:%M:%S')] ❌${NC} $msg"
}

# =====================================================
# 主函数
# =====================================================

main() {
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║    🐉 龍魂系統 - iCloud备份（云上贵州）【简化版】         ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo ""

    # 第1步：检查iCloud Drive
    echo_info "正在检查iCloud Drive..."

    if [ ! -d "$ICLOUD_DRIVE" ]; then
        echo_error "iCloud Drive 未找到"
        echo_error "路径：$ICLOUD_DRIVE"
        echo_error "请确保："
        echo_error "  1. Mac已登录iCloud账户"
        echo_error "  2. iCloud Drive已在系统设置中启用"
        exit 1
    fi

    echo_success "iCloud Drive 已找到"
    echo ""

    # 第2步：创建备份目录
    echo_info "准备备份目录..."

    mkdir -p "$BACKUP_ROOT/UID9622_Automation"
    mkdir -p "$BACKUP_ROOT/龍芯核心系統"
    mkdir -p "$LOG_DIR"
    mkdir -p "$BACKUP_ROOT/manifests"

    echo_success "备份目录已准备"
    echo ""

    # 第3步：备份UID9622_Automation
    echo_info "开始备份 UID9622_Automation..."

    if [ ! -d "$AUTOMATION_SOURCE" ]; then
        echo_warn "源目录不存在：$AUTOMATION_SOURCE，跳过"
    else
        local source_size=$(du -sh "$AUTOMATION_SOURCE" | awk '{print $1}')
        echo_info "源大小：$source_size"

        # 执行增量备份
        rsync -avh --progress --delete \
            --exclude=".DS_Store" \
            --exclude="logs/*" \
            "$AUTOMATION_SOURCE/" "$BACKUP_ROOT/UID9622_Automation/" >> "$LOG_FILE" 2>&1

        if [ $? -eq 0 ]; then
            local backup_size=$(du -sh "$BACKUP_ROOT/UID9622_Automation" | awk '{print $1}')
            echo_success "UID9622_Automation 备份完成（$backup_size）"
        else
            echo_error "UID9622_Automation 备份失败"
        fi
    fi

    echo ""

    # 第4步：备份龍芯核心系統
    echo_info "开始备份 龍芯核心系統..."

    if [ ! -d "$LONGHUN_SOURCE" ]; then
        echo_warn "源目录不存在：$LONGHUN_SOURCE，跳过"
    else
        local source_size=$(du -sh "$LONGHUN_SOURCE" | awk '{print $1}')
        echo_info "源大小：$source_size"

        rsync -avh --progress --delete \
            --exclude=".DS_Store" \
            "$LONGHUN_SOURCE/" "$BACKUP_ROOT/龍芯核心系統/" >> "$LOG_FILE" 2>&1

        if [ $? -eq 0 ]; then
            local backup_size=$(du -sh "$BACKUP_ROOT/龍芯核心系統" | awk '{print $1}')
            echo_success "龍芯核心系統 备份完成（$backup_size）"
        else
            echo_error "龍芯核心系統 备份失败"
        fi
    fi

    echo ""

    # 第5步：生成清单
    echo_info "生成备份清单..."

    cat > "$BACKUP_ROOT/manifests/manifest_${BACKUP_DATE}_${BACKUP_TIME}.md" << EOF
# 🐉 龍魂系統 - iCloud备份清单

## 备份信息
- 时间：$TIMESTAMP
- DNA码：$DNA_CODE
- 确认码：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z

## 备份位置
\`\`\`
~/Library/Mobile Documents/com~apple~CloudDocs/龍魂系統備份/
\`\`\`

## 备份内容

### UID9622_Automation
$([ -d "$AUTOMATION_SOURCE" ] && echo "✅ 已备份" || echo "⏭️ 跳过")
大小：$(du -sh "$BACKUP_ROOT/UID9622_Automation" 2>/dev/null | awk '{print $1}')

### 龍芯核心系統
$([ -d "$LONGHUN_SOURCE" ] && echo "✅ 已备份" || echo "⏭️ 跳过")
大小：$(du -sh "$BACKUP_ROOT/龍芯核心系統" 2>/dev/null | awk '{print $1}')

## 恢复命令

\`\`\`bash
# 恢复UID9622_Automation
rsync -avh ~/Library/Mobile\ Documents/com~apple~CloudDocs/龍魂系統備份/UID9622_Automation/ ~/UID9622_Automation/

# 恢复龍芯核心系統
rsync -avh ~/Library/Mobile\ Documents/com~apple~CloudDocs/龍魂系統備份/龍芯核心系統/ ~/龍芯核心系統/
\`\`\`

---
DNA追溯码：$DNA_CODE
确认码：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z
EOF

    echo_success "备份清单已生成"
    echo ""

    # 最终总结
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║         ✅ iCloud备份完成                                  ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo ""

    echo_success "备份位置：$BACKUP_ROOT"
    echo_success "DNA码：$DNA_CODE"
    echo_success "日志：$LOG_FILE"

    echo ""
    echo "总备份大小："
    du -sh "$BACKUP_ROOT" 2>/dev/null | awk -v col=2 '{print "  " $col}'
    echo ""

    echo_success "数据已安全备份到云上贵州（祖国）🚩"
}

# 执行主程序
main "$@"

###############################################
# 文件末尾
###############################################
# DNA追溯码：#ZHUGEXIN⚡️-2026-02-15-icloud-backup-simple-v1.0
