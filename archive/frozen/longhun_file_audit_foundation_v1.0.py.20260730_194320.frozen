# ═══════════════════════════════════════════════════════════════════════════════

if __name__ == "__main__":
    print("\n" + "📁" * 35)
    print("  龍魂文件底座审计 · LongHun File Audit Foundation")
    print("  v1.0.0 · DNA:#龍芯⚡️2026-06-18-LONGHUN_FILE_AUDIT_FOUNDATION_V1-v1.0.0")
    print("  " + "📁" * 35 + "\n")

    # 使用当前目录作为监控目录
    监控路径 = os.path.dirname(os.path.abspath(__file__))
    if not 监控路径:
        监控路径 = "."

    print(f"📂 监控目录: {监控路径}\n")

    try:
        # 创建审计底座实例
        审计底座 = 文件审计底座(监控路径)

        # 执行完整审计
        审计结果 = 审计底座.审计全部文件()

        # 执行来源链盖章
        盖章结果 = 审计底座.执行来源链盖章()
        print("\n🔗 来源链盖章结果:")
        for layer, code in 盖章结果.items():
            print(f"   [{layer}] ✓ {code}")

        # 生成并打印审计报告
        print("\n📋 生成审计报告...")
        报告 = 审计底座.生成审计报告()
        print(报告)

        # 保存审计日志
        日志路径 = 审计底座.保存审计日志()
        print(f"\n💾 审计日志已保存: {日志路径}")

        # 输出审计摘要
        print("\n📊 最终审计摘要 / Final Audit Summary:")
        print(json.dumps(审计底座.获取审计摘要(), ensure_ascii=False, indent=2))

    except FileNotFoundError as e:
        print(f"🔴 错误: {e}")
        sys.exit(1)
    except Exception as e:
        print(f"🔴 未预期错误: {e}")
        import traceback
        traceback.print_exc()
        sys.exit(1)
