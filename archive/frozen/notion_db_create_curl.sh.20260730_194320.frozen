set -e

TOKEN="$NOTION_INTEGRATION_TOKEN"
PARENT_PAGE_ID="$NOTION_PARENT_PAGE_ID"

if [[ "$TOKEN" == \$* ]]; then
  eval "TOKEN=$TOKEN"
fi
if [[ "$PARENT_PAGE_ID" == \$* ]]; then
  eval "PARENT_PAGE_ID=$PARENT_PAGE_ID"
fi

curl -X POST "https://api.notion.com/v1/databases" \
  -H "Authorization: Bearer $TOKEN" \
  -H "Notion-Version: 2022-06-28" \
  -H "Content-Type: application/json" \
  -d '{"title": [{"type": "text", "text": {"content": "龍魂引擎注册表 v2"}}], "description": [{"type": "text", "text": {"content": "统一管理 engines / bin / 01_技能庫 下所有引擎。支持决策归档、毫秒级响应分级、自动化标签、三色审计。"}}], "properties": {"名称": {"title": {}}, "引擎ID": {"rich_text": {}}, "分类": {"select": {"options": []}}, "子分类": {"select": {"options": []}}, "内容类型": {"multi_select": {"options": []}}, "类型": {"select": {"options": []}}, "状态": {"select": {"options": [{"name": "active", "color": "brown"}, {"name": "deprecated", "color": "orange"}, {"name": "experimental", "color": "yellow"}, {"name": "draft", "color": "green"}, {"name": "archived", "color": "blue"}]}}, "优先级": {"number": {"format": "number"}}, "说明": {"rich_text": {}}, "DNA": {"rich_text": {}}, "路径": {"rich_text": {}}, "代码链接": {"url": {}}, "文档链接": {"url": {}}, "决策归档": {"select": {"options": [{"name": "已归档", "color": "orange"}, {"name": "待归档", "color": "yellow"}, {"name": "无需归档", "color": "green"}, {"name": "需评审", "color": "blue"}]}}, "决策记录": {"rich_text": {}}, "归档时间": {"date": {}}, "责任人": {"rich_text": {}}, "响应等级": {"select": {"options": [{"name": "毫秒级", "color": "default"}, {"name": "秒级", "color": "gray"}, {"name": "分钟级", "color": "brown"}, {"name": "离线/批处理", "color": "orange"}, {"name": "未定义", "color": "yellow"}]}}, "预计响应(ms)": {"number": {"format": "number"}}, "性能要求": {"select": {"options": [{"name": "P99<1ms", "color": "blue"}, {"name": "P99<10ms", "color": "purple"}, {"name": "P99<100ms", "color": "pink"}, {"name": "P99<1s", "color": "red"}, {"name": "无SLA", "color": "default"}]}}, "自动化标签": {"multi_select": {"options": [{"name": "自动扫描", "color": "gray"}, {"name": "自动审计", "color": "brown"}, {"name": "自动备份", "color": "orange"}, {"name": "自动部署", "color": "yellow"}, {"name": "CI/CD", "color": "green"}, {"name": "Webhook触发", "color": "blue"}, {"name": "Cron调度", "color": "purple"}]}}, "自动化就绪": {"checkbox": {}}, "触发方式": {"multi_select": {"options": [{"name": "Manual", "color": "red"}, {"name": "Cron", "color": "default"}, {"name": "Webhook", 