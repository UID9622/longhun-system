#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂系统 · 节点心跳上报器 v1.0
UID9622 | 诸葛鑫·龍芯北辰
原则：只传用量，不传内容；DNA签章，透明审计
"""

import os
import json
import hashlib
import time
import socket
import urllib.request
import urllib.error
from datetime import datetime
from pathlib import Path

# ============ 配置 ============
NODE_ID = os.environ.get("LONGHUN_NODE_ID", "unknown")
NODE_DNA = os.environ.get("LONGHUN_NODE_DNA", "")
REGISTRY_URL = os.environ.get("LONGHUN_REGISTRY_URL", "http://localhost:9623")
DNA_ANCHOR = os.environ.get("LONGHUN_DNA_ANCHOR", "")
CONFIRM = os.environ.get("LONGHUN_CONFIRM", "")

HEARTBEAT_INTERVAL = 300  # 5分钟
DATA_DIR = Path("/data") if os.path.exists("/data") else Path("./data")

# ============ 工具函数 ============

def get_folder_size_gb(path):
    """获取目录大小（GB）"""
    total = 0
    try:
        for entry in os.scandir(path):
            if entry.is_file():
                total += entry.stat().st_size
            elif entry.is_dir():
                total += get_folder_size_gb(entry.path) * 1024**3
    except:
        pass
    return round(total / (1024**3), 4)

def count_files(path, pattern="*"):
    """统计文件数量"""
    try:
        return len(list(Path(path).glob(pattern)))
    except:
        return 0

def get_uptime_seconds():
    """获取容器运行时间"""
    try:
        with open('/proc/1/stat', 'r') as f:
            start_time = int(f.read().split()[21])
        return int(time.time()) - start_time
    except:
        return 0

def sign_payload(payload):
    """DNA签章"""
    content = json.dumps(payload, sort_keys=True, ensure_ascii=False)
    return hashlib.sha256((content + DNA_ANCHOR + CONFIRM).encode()).hexdigest()[:32]

def send_heartbeat():
    """发送心跳"""

    # 只收集用量，不收集内容
    payload = {
        "node_id": NODE_ID,
        "node_dna": NODE_DNA,
        "timestamp": int(time.time()),
        "timestamp_iso": datetime.now().isoformat(),

        # 用量指标（不传内容）
        "metrics": {
            "requests_handled": count_files(DATA_DIR / "logs", "*.log"),
            "crawl_sessions": count_files(DATA_DIR / "crawled", "*.json"),
            "storage_used_gb": get_folder_size_gb(DATA_DIR),
            "uptime_seconds": get_uptime_seconds(),
            "hostname": socket.gethostname(),
        },

        # 内容存在证明（哈希，不传内容）
        "content_proof": {
            "logs_hash": hashlib.sha256(str(list((DATA_DIR / "logs").glob("*.log"))).encode()).hexdigest()[:16],
            "crawled_hash": hashlib.sha256(str(list((DATA_DIR / "crawled").glob("*.json"))).encode()).hexdigest()[:16],
        },

        # DNA签章
        "dna_anchor": DNA_ANCHOR[:30] + "...",
    }

    payload["signature"] = sign_payload(payload)

    # 上报
    try:
        req = urllib.request.Request(
            f"{REGISTRY_URL}/heartbeat",
            data=json.dumps(payload).encode('utf-8'),
            headers={
                'Content-Type': 'application/json',
                'User-Agent': 'LongHunNode/1.0',
                'X-Node-ID': NODE_ID,
            }
        )
        with urllib.request.urlopen(req, timeout=10) as resp:
            if resp.getcode() == 200:
                print(f"[{datetime.now().strftime('%H:%M:%S')}] 🐉 心跳上报成功 | 节点: {NODE_ID[:20]}...")
                return True
    except urllib.error.HTTPError as e:
        print(f"[{datetime.now().strftime('%H:%M:%S')}] ⚠️  上报失败 HTTP {e.code}")
    except Exception as e:
        print(f"[{datetime.now().strftime('%H:%M:%S')}] ⚠️  上报失败: {str(e)[:40]}")

    return False

def main():
    print(f"🐉 龍魂节点心跳器启动")
    print(f"🐉 节点ID: {NODE_ID}")
    print(f"🐉 注册中心: {REGISTRY_URL}")
    print(f"🐉 间隔: {HEARTBEAT_INTERVAL}秒")
    print(f"🐉 原则: 只传用量，不传内容")
    print("")

    while True:
        send_heartbeat()
        time.sleep(HEARTBEAT_INTERVAL)

if __name__ == "__main__":
    main()
