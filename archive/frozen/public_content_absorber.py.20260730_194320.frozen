#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂公开内容吸收器
把 UID9622 公开的文档/协议/论文抓取并结构化写入 dragon_knowledge.db。
DNA: #龍芯⚡️2026-06-28-PUBLIC-CONTENT-ABSORBER-v1.0
"""
import sqlite3, json, hashlib, os, re, html
from datetime import datetime, timezone
from pathlib import Path

DB = "/Users/zuimeidedeyihan/_work/dragon_knowledge.db"
INDEX = "/Users/zuimeidedeyihan/_work/public_sources_index.json"
SUMMARY = "/Users/zuimeidedeyihan/_work/public_content_absorbed.json"

DNA_RE = re.compile(r"#[\u9f8d\u82af\u9f8d\u82af]?[\u9f8d\u82af\u9f8d\u82af]?[\u2600-\u27BF\u2B50\u26A1\u2728]|#[A-Za-z0-9\u4e00-\u9fff\u00A9-\u00FF\u2600-\u27BF\u2B50]+(?:\u2696\ufe0f?|\u26a1\ufe0f?|\u2728|\u2600|\u262f|\u2601|\u2605|\u2665|\u267e|\u2694|\u2708|\u2709|\u260e|\u2611|\u2615|\u2618|\u261d|\u2620|\u2622|\u2623|\u2626|\u262a|\u262e|\u263a|\u2648-\u2653|\u265f|\u2660|\u2663|\u2665|\u2666|\u2668|\u267b|\u267f|\u2692|\u2693|\u2696|\u2697|\u2699|\u269b|\u269c|\u26a0|\u26a1|\u26aa|\u26ab|\u26b0|\u26b1|\u26bd|\u26be|\u26c4|\u26c5|\u26c8|\u26ce|\u26cf|\u26d1|\u26d3|\u26d4|\u26e9|\u26ea|\u26f0-\u26f5|\u26f7-\u26fa|\u26fd|\u2702|\u2705|\u2708-\u270d|\u270f|\u2712|\u2714|\u2716|\u271d|\u2721|\u2728|\u2733|\u2734|\u2744|\u2747|\u274c|\u274e|\u2753-\u2755|\u2757|\u2763|\u2764|\u2795-\u2797|\u27a1|\u27b0|\u27bf|\u2934|\u2935|\u2b05-\u2b07|\u2b1b|\u2b1c|\u2b50|\u2b55|\u3030|\u303d|\u3297|\u3299|\u1f300-\u1f5ff|\u1f600-\u1f64f|\u1f680-\u1f6ff|\u1f700-\u1f77f|\u1f780-\u1f7ff|\u1f800-\u1f8ff|\u1f900-\u1f9ff|\u1fa00-\u1fa6f|\u1fa70-\u1faff)(?:[A-Za-z0-9_\-\u4e00-\u9fff\u00A9-\u00FF\u2600-\u27BF\u2B50\.\/\:]+)", re.UNICODE)
# Simpler robust DNA regex: match common DNA-like tokens.
DNA_RE = re.compile(
    r"(#[龍龙]芯[\u26a1\ufe0f]*\d{4}(?:[-_]\d{2}){0,2}[-_][A-Za-z0-9\u4e00-\u9fff\-_\/]+(?:[-_][vV]\d+(?:\.\d+)?)?|"
    r"#ZHUGEXIN[\u26a1\ufe0f]*\d{4}[-_][\u4e00-\u9fffA-Za-z0-9\-_\/]+(?:[-_][vV]\d+(?:\.\d+)?)?|"
    r"#CONFIRM[🌌🌀]?9622-ONLY-ONCE[🧬]?[A-Za-z0-9\-]+|"
    r"DNA::[A-Z]+-9622-\d{8}(?:-\d{6})?[-_][A-Za-z0-9\-_\/]+[-_][Vv]\d+(?:\.\d+)?)",
    re.UNICODE,
)


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def uid():
    return hashlib.sha256(os.urandom(32)).hexdigest()[:16]


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def strip_html(raw: str) -> str:
    # minimal HTML to text, keep headings/tables line breaks
    text = re.sub(r"<script[^>]*>.*?</script>", "", raw, flags=re.S | re.I)
    text = re.sub(r"<style[^>]*>.*?</style>", "", text, flags=re.S | re.I)
    text = re.sub(r"<br\s*/?>", "\n", text, flags=re.I)
    text = re.sub(r"</(p|div|h[1-6]|li|tr|table|section|article)>\s*", "\n", text, flags=re.I)
    text = re.sub(r"<[^>]+>", "", text)
    text = html.unescape(text)
    lines = [ln.strip() for ln in text.splitlines()]
    return "\n".join(ln for ln in lines if ln)


def read_text(local_path: str) -> str:
    with open(local_path, "r", encoding="utf-8", errors="ignore") as f:
        return f.read()


def parse_sections(text: str, ext: str):
    # split by markdown headings or HTML headings if html
    if ext == ".html":
        headings = re.finditer(r"<h([1-3])[^>]*>(.*?)</h\1>", text, re.S | re.I)
        positions = [(int(m.group(1)), re.sub(r"<[^>]+>", "", m.group(2)).strip(), m.start(), m.end()) for m in headings]
        plain = strip_html(text)
    else:
        # markdown headings
        headings = list(re.finditer(r"^(#{1,3})\s+(.+)$", text, re.M))
        positions = [(len(m.group(1)), m.group(2).strip(), m.start(), m.end()) for m in headings]
        plain = text

    sections = []
    if not positions:
        sections.append({"level": 1, "title": "全文", "body": plain[:10000]})
        return sections, plain

    for i, (level, title, start, end) in enumerate(positions):
        body_start = end
        body_end = positions[i + 1][2] if i + 1 < len(positions) else len(text)
        body = text[body_start:body_end]
        if ext == ".html":
            body = strip_html(body)
        else:
            body = re.sub(r"^\s*\n", "", body, flags=re.M)
            body = re.sub(r"\n+", "\n", body)
        sections.append({"level": level, "title": title, "body": body[:12000]})
    return sections, plain


def extract_dnas(text: str) -> list[Any]:
    return list(set(DNA_RE.findall(text)))


def ensure_tables(conn):
    cur = conn.cursor()
    cur.execute(
        """
        CREATE TABLE IF NOT EXISTS public_content_audit (
            source_id TEXT PRIMARY KEY,
            title TEXT,
            version TEXT,
            url TEXT,
            local_path TEXT,
            content_hash TEXT,
            dna_codes TEXT,
            entry_count INTEGER,
            absorbed_at TEXT
        )
        """
    )
    conn.commit()


def absorb():
    if not os.path.exists(INDEX):
        raise FileNotFoundError(INDEX)
    with open(INDEX, "r", encoding="utf-8") as f:
        sources = json.load(f)

    conn = sqlite3.connect(DB)
    ensure_tables(conn)
    cur = conn.cursor()
    audit_rows = []

    for src in sources:
        local = src["local"]
        text = read_text(local)
        ext = Path(local).suffix.lower()
        content_hash = sha256_text(text)
        plain = strip_html(text) if ext == ".html" else text
        sections, _ = parse_sections(text, ext)
        dnas = extract_dnas(plain)
        dna_main = dnas[0] if dnas else ""
        tags = [src["category"], "UID9622", "公开内容"]
        if src["category"] == "constitution":
            tags += ["北辰-母协议", "宪法"]
        elif src["category"] == "research":
            tags += ["洛书369", "论文"]
        elif src["category"] == "protocol":
            tags += ["CNSH"]

        # Insert harvested_code row for the whole public doc
        code_id = f"PUB-{src['id']}-{uid()}"
        cur.execute(
            """
            INSERT OR REPLACE INTO harvested_code
            (code_id, file_name, file_path, file_extension, source_language, content_raw, content_hash,
             theory_guide, source_url_or_path, author, timestamp, dna_code, processing_status, created_at, updated_at)
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
            """,
            (
                code_id,
                Path(local).name,
                local,
                ext,
                "html" if ext == ".html" else "markdown",
                plain[:50000],
                content_hash,
                src["category"],
                src["url"],
                "龍芯北辰 | UID9622",
                now_iso(),
                dna_main,
                "absorbed",
                now_iso(),
                now_iso(),
            ),
        )

        # Insert knowledge_modules row
        module_id = f"MOD-PUB-{src['id']}"
        summary = plain[:800].replace("\n", " ")
        cur.execute(
            """
            INSERT OR REPLACE INTO knowledge_modules
            (module_id, source, name, version, description, dna_code, triggers, license, author, extracted_at, entry_count, metadata_json)
            VALUES (?,?,?,?,?,?,?,?,?,?,?,?)
            """,
            (
                module_id,
                src["url"],
                src["title"],
                src["version"],
                summary,
                dna_main,
                ",".join(tags),
                "MulanPSL-2.0 / Public",
                "龍芯北辰 | UID9622",
                now_iso(),
                len(sections),
                json.dumps(
                    {
                        "local_path": local,
                        "content_hash": content_hash,
                        "category": src["category"],
                        "dna_codes": dnas,
                    },
                    ensure_ascii=False,
                ),
            ),
        )

        # Insert sections as knowledge_entries
        for sec in sections:
            entry_id = f"ENT-PUB-{src['id']}-{uid()}"
            cur.execute(
                """
                INSERT OR REPLACE INTO knowledge_entries
                (entry_id, module_id, entry_type, title, category, subcategory, status, priority, summary, content_json, tags, dna_code, source_path, created_at)
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)
                """,
                (
                    entry_id,
                    module_id,
                    "section",
                    sec["title"][:250],
                    src["category"],
                    f"level-{sec['level']}",
                    "absorbed",
                    "P0" if src["category"] == "constitution" else "P1",
                    sec["body"][:800].replace("\n", " "),
                    json.dumps({"level": sec["level"], "body": sec["body"]}, ensure_ascii=False),
                    ",".join(tags),
                    dna_main,
                    src["url"],
                    now_iso(),
                ),
            )

        # De-duplicate based on source URL or local path by deleting old audit rows? Just upsert.
        cur.execute(
            """
            INSERT OR REPLACE INTO public_content_audit
            (source_id, title, version, url, local_path, content_hash, dna_codes, entry_count, absorbed_at)
            VALUES (?,?,?,?,?,?,?,?,?)
            """,
            (
                src["id"],
                src["title"],
                src["version"],
                src["url"],
                local,
                content_hash,
                json.dumps(dnas, ensure_ascii=False),
                len(sections),
                now_iso(),
            ),
        )
        audit_rows.append(
            {
                "source_id": src["id"],
                "title": src["title"],
                "version": src["version"],
                "url": src["url"],
                "local_path": local,
                "content_hash": content_hash,
                "dna_codes": dnas,
                "entry_count": len(sections),
            }
        )

    conn.commit()
    conn.close()

    with open(SUMMARY, "w", encoding="utf-8") as f:
        json.dump(
            {
                "absorbed_at": now_iso(),
                "dna": "#龍芯⚡️2026-06-28-PUBLIC-CONTENT-ABSORBER-v1.0",
                "sources": audit_rows,
            },
            f,
            ensure_ascii=False,
            indent=2,
        )
    print(f"Absorbed {len(sources)} public sources into {DB}. Summary: {SUMMARY}")
    for r in audit_rows:
        print(f" - {r['source_id']}: {r['title']} ({r['entry_count']} sections)")


if __name__ == "__main__":
    absorb()
