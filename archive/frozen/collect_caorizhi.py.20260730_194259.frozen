#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
草日志全量归集脚本
- 搜索所有含「草日志」的路径
- 递归遍历目录
- 计算 SHA-256 去重
- 复制到 staging 目录
- 生成 manifest / summary / CSV
- 压缩为 tar.gz
- 每个阶段调用 observer_core.sh 留痕
- 写入 chain_hash.jsonl DNA
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from urllib.parse import quote

HOME = Path.home()
TARGET_KEYWORD = "草日志"
STAGING_ROOT = HOME / ".龍魂" / "archive" / "staging"
ARCHIVE_ROOT = HOME / ".龍魂" / "archive"
OBSERVER = HOME / ".龍魂" / "functions" / "observer_core.sh"
CHAIN_HASH = HOME / "chain_hash.jsonl"
COLLECTION_LOG = HOME / ".龍魂" / "logs" / "caorizhi_collection_trace.jsonl"

DNA_PREFIX = "#龍芯⚡️"


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def now_compact():
    return datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")


def md5_hex(s: str) -> str:
    return hashlib.md5(s.encode("utf-8")).hexdigest()[:12]


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def log_dna(action: str, detail: str):
    ts = now_iso()
    dna = f"{DNA_PREFIX}{ts.replace('-','').replace(':','').replace('+','')}-{action.upper()}-{md5_hex(action + detail + ts)}"
    entry = {
        "timestamp": ts,
        "action": action,
        "detail": detail,
        "dna": dna,
    }
    CHAIN_HASH.parent.mkdir(parents=True, exist_ok=True)
    with open(CHAIN_HASH, "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    return dna


def observer_log(trigger: str, scan_path: str, confidence: str = "high") -> dict[str, Any]:
    """调用 observer_core.sh 并返回批次信息"""
    try:
        result = subprocess.run(
            ["bash", str(OBSERVER), trigger, scan_path, confidence],
            capture_output=True,
            text=True,
            timeout=60,
        )
        output = result.stdout.strip() or result.stderr.strip()
    except Exception as e:
        output = f"observer调用失败: {e}"
    return {"trigger": trigger, "path": scan_path, "confidence": confidence, "output": output, "time": now_iso()}


def find_caorizhi_paths() -> list[Any]:
    """使用 mdfind 查找所有含「草日志」的路径"""
    try:
        result = subprocess.run(
            ["mdfind", "-name", TARGET_KEYWORD],
            capture_output=True,
            text=True,
            timeout=120,
        )
        paths = [Path(p.strip()) for p in result.stdout.strip().splitlines() if p.strip()]
    except Exception as e:
        print(f"mdfind 失败: {e}", file=sys.stderr)
        paths = []
    # 额外保底：常见已知路径
    known = [
        HOME / "longhun-system" / "操作草日志.log",
        HOME / "龍魂待整理" / "Export-6a2fd9c8-4e14-4110-8b5e-452cc1be5daa" / "私人与共享" / "📜 龍魂操作草日志｜每动作必记·精确到分钟·抹不掉的痕迹",
        HOME / "longhun-archive" / "2026-06-01" / "notion-exports" / "Export-6a2fd9c8-4e14-4110-8b5e-452cc1be5daa" / "私人与共享" / "📜 龍魂操作草日志｜每动作必记·精确到分钟·抹不掉的痕迹",
        HOME / "cnsh_l4_龍魂系统备份_20260601" / "_work" / "notion-sync" / "Export-6a2fd9c8-4e14-4110-8b5e-452cc1be5daa" / "私人与共享" / "📜 龍魂操作草日志｜每动作必记·精确到分钟·抹不掉的痕迹",
        HOME / "cnsh_l4_龍魂系统备份_20260601" / "_work" / "tools" / "工具" / "local-sync-monitor" / "snapshots" / "草日志",
    ]
    for p in known:
        if p.exists() and p not in paths:
            paths.append(p)
    # 去重并保持稳定顺序
    seen = set()
    unique = []
    for p in paths:
        rp = p.resolve()
        if rp not in seen:
            seen.add(rp)
            unique.append(p)
    return unique


def safe_name(name: str) -> str:
    """生成安全的文件名，保留中文/emoji，去除文件系统危险字符"""
    # 保留大部分字符，仅替换路径分隔符和空字符
    safe = name.replace("/", "∕").replace("\\", "＼").replace("\x00", "")
    # 控制字符也去掉
    safe = "".join(ch for ch in safe if ord(ch) >= 32 or ch in "\t\n")
    # 长度限制
    if len(safe.encode("utf-8")) > 200:
        safe = safe[:60] + "…"
    return safe or "unnamed"


def collect_files(paths: list[Any]) -> list[Any]:
    """遍历路径，收集所有文件元信息"""
    files = []
    for root in paths:
        if root.is_file():
            files.append({"src": root, "root_label": root.name})
        elif root.is_dir():
            for p in root.rglob("*"):
                if p.is_file():
                    files.append({"src": p, "root_label": root.name})
    return files


def main():
    COLLECTION_LOG.parent.mkdir(parents=True, exist_ok=True)
    STAGING_ROOT.mkdir(parents=True, exist_ok=True)
    ARCHIVE_ROOT.mkdir(parents=True, exist_ok=True)

    start_dna = log_dna("CAORIZHI-COLLECT-START", "开始草日志全量归集")
    trace_entries = []

    # 1. 搜索路径
    observer_log("草日志搜索开始", str(HOME), "high")
    source_paths = find_caorizhi_paths()
    search_dna = log_dna(
        "CAORIZHI-PATHS-FOUND",
        f"找到 {len(source_paths)} 个含「{TARGET_KEYWORD}」的路径",
    )
    trace_entries.append({
        "time": now_iso(),
        "phase": "search",
        "paths": [str(p) for p in source_paths],
        "dna": search_dna,
    })
    observer_log(f"草日志路径发现:{len(source_paths)}个", str(HOME), "high")

    # 2. 遍历文件
    observer_log("草日志遍历开始", str(HOME), "high")
    raw_files = collect_files(source_paths)
    trace_entries.append({
        "time": now_iso(),
        "phase": "traverse",
        "raw_file_count": len(raw_files),
    })
    observer_log(f"草日志原始文件:{len(raw_files)}个", str(HOME), "high")

    # 3. 计算哈希去重
    observer_log("草日志哈希计算开始", str(HOME), "high")
    hash_to_files = {}
    file_records = []
    total_raw_size = 0
    for idx, item in enumerate(raw_files, 1):
        src = item["src"]
        try:
            h = sha256_file(src)
            size = src.stat().st_size
            mtime = datetime.fromtimestamp(src.stat().st_mtime, tz=timezone.utc).isoformat()
            total_raw_size += size
            rec = {
                "index": idx,
                "src": str(src),
                "root_label": item["root_label"],
                "size": size,
                "mtime": mtime,
                "sha256": h,
            }
            file_records.append(rec)
            hash_to_files.setdefault(h, []).append(rec)
            trace_entries.append({
                "time": now_iso(),
                "phase": "hash",
                "index": idx,
                "src": str(src),
                "sha256": h,
                "size": size,
            })
        except Exception as e:
            trace_entries.append({
                "time": now_iso(),
                "phase": "hash_error",
                "src": str(src),
                "error": str(e),
            })

    unique_hashes = list(hash_to_files.keys())
    dedup_dna = log_dna(
        "CAORIZHI-HASH-DEDUP",
        f"原始{len(file_records)}个文件, 去重后{len(unique_hashes)}个, 总大小{total_raw_size}字节",
    )
    observer_log(
        f"草日志去重完成:原始{len(file_records)}唯一{len(unique_hashes)}",
        str(HOME),
        "high",
    )

    # 4. 复制唯一文件到 staging
    timestamp = now_compact()
    collection_name = f"草日志全量归集_{timestamp}"
    staging_dir = STAGING_ROOT / collection_name
    staging_dir.mkdir(parents=True, exist_ok=True)

    files_dir = staging_dir / "files"
    files_dir.mkdir(exist_ok=True)

    copy_records = []
    name_counter = {}
    for h in unique_hashes:
        # 取该 hash 下的第一个文件作为代表计算目标名
        representative = hash_to_files[h][0]
        src_path = Path(representative["src"])
        original_name = src_path.name
        safe = safe_name(original_name)
        # 处理重名：加序号前缀
        name_counter[safe] = name_counter.get(safe, 0) + 1
        if name_counter[safe] > 1:
            base, ext = os.path.splitext(safe)
            dst_name = f"{base}_{name_counter[safe]:03d}{ext}"
        else:
            dst_name = safe
        dst_path = files_dir / dst_name
        shutil.copy2(src_path, dst_path)
        copy_records.append({
            "sha256": h,
            "stored": str(dst_path.relative_to(staging_dir)),
            "original_name": original_name,
            "sources": [r["src"] for r in hash_to_files[h]],
            "size": representative["size"],
        })

    copy_dna = log_dna(
        "CAORIZHI-COPY-UNIQUE",
        f"复制 {len(copy_records)} 个唯一文件到 {staging_dir}",
    )
    observer_log(f"草日志复制完成:{len(copy_records)}个唯一文件", str(staging_dir), "high")

    # 5. 生成 manifest / summary / CSV
    manifest = {
        "collection_name": collection_name,
        "created_at": now_iso(),
        "keyword": TARGET_KEYWORD,
        "source_paths": [str(p) for p in source_paths],
        "raw_file_count": len(file_records),
        "unique_file_count": len(unique_hashes),
        "total_raw_bytes": total_raw_size,
        "archive_path": str(ARCHIVE_ROOT / f"{collection_name}.tar.gz"),
        "dna_start": start_dna,
        "dna_search": search_dna,
        "dna_dedup": dedup_dna,
        "dna_copy": copy_dna,
        "files": copy_records,
    }
    manifest_path = staging_dir / "manifest.json"
    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(manifest, f, ensure_ascii=False, indent=2)

    summary_lines = [
        f"# {collection_name}",
        "",
        f"- 创建时间: {manifest['created_at']}",
        f"- 关键词: {TARGET_KEYWORD}",
        f"- 来源路径数: {len(source_paths)}",
        f"- 原始文件数: {len(file_records)}",
        f"- 去重后文件数: {len(unique_hashes)}",
        f"- 原始总字节: {total_raw_size}",
        f"- 归档路径: {manifest['archive_path']}",
        "",
        "## DNA 链",
        f"- 开始: {start_dna}",
        f"- 搜索: {search_dna}",
        f"- 去重: {dedup_dna}",
        f"- 复制: {copy_dna}",
        "",
        "## 文件清单（去重后）",
        "",
        "| 序号 | 原始文件名 | 大小 | SHA-256 | 来源数 | 存储路径 |",
        "|------|-----------|------|---------|--------|----------|",
    ]
    for i, rec in enumerate(copy_records, 1):
        summary_lines.append(
            f"| {i} | {rec['original_name']} | {rec['size']} | `{rec['sha256'][:16]}` | {len(rec['sources'])} | {rec['stored']} |"
        )
    summary_path = staging_dir / "summary.md"
    with open(summary_path, "w", encoding="utf-8") as f:
        f.write("\n".join(summary_lines))

    csv_path = staging_dir / "manifest.csv"
    import csv
    with open(csv_path, "w", newline="", encoding="utf-8-sig") as f:
        writer = csv.writer(f)
        writer.writerow(["index", "sha256", "original_name", "size", "source_count", "stored_path", "sources"])
        for i, rec in enumerate(copy_records, 1):
            writer.writerow([i, rec["sha256"], rec["original_name"], rec["size"], len(rec["sources"]), rec["stored"], "; ".join(rec["sources"])])

    index_dna = log_dna("CAORIZHI-INDEX-GENERATED", f"生成 manifest.json / summary.md / manifest.csv")
    observer_log("草日志索引生成完成", str(staging_dir), "high")

    # 6. 压缩归档
    archive_path = ARCHIVE_ROOT / f"{collection_name}.tar.gz"
    try:
        subprocess.run(
            ["tar", "-czf", str(archive_path), "-C", str(staging_dir.parent), collection_name],
            check=True,
            timeout=120,
        )
        archive_size = archive_path.stat().st_size
    except Exception as e:
        archive_size = 0
        print(f"压缩失败: {e}", file=sys.stderr)

    archive_dna = log_dna("CAORIZHI-ARCHIVED", f"归档 {archive_path} ({archive_size} 字节)")
    observer_log(f"草日志归档完成:{archive_size}字节", str(archive_path), "high")

    # 7. 保存详细 trace
    trace_path = staging_dir / "collection_trace.jsonl"
    with open(trace_path, "w", encoding="utf-8") as f:
        for entry in trace_entries:
            f.write(json.dumps(entry, ensure_ascii=False) + "\n")

    # 8. 清理 staging（保留压缩包）
    shutil.rmtree(staging_dir, ignore_errors=True)

    # 9. 生成 Notion 待上传 payload
    notion_payload = {
        "parent": {"database_id": "cba73d49-cbe4-41e0-b4d3-6f52cb4e636f"},
        "properties": {
            "一句话DNA（压缩·任何AI都能问）": {
                "title": [{"text": {"content": f"#DNA-{timestamp[:8]}-收集-草日志全量归集·{len(unique_hashes)}文件·{len(source_paths)}来源"}}]
            },
            "操作类型": {"select": {"name": "入档"}},
            "状态": {"status": {"name": "通过"}},
            "对外公开": {"checkbox": True},
            "任务卡编号": {"rich_text": [{"text": {"content": f"草日志归档#{timestamp}"}}]},
            "DNA标签": {"multi_select": [{"name": "草日志"}, {"name": "三层归位"}]},
            "三层归位": {"multi_select": [{"name": "🅱️ 铁律（内部守岗）"}]},
            "谁说话谁签名": {"multi_select": [{"name": "🌙 Kimi"}]},
            "🌙 Kimi 怎么评": {"rich_text": [{"text": {"content": f"完成草日志全量归集：原始{len(file_records)}个文件，去重后{len(unique_hashes)}个，归档{archive_size}字节"}}]},
            "真实结果证据": {"rich_text": [{"text": {"content": f"本地归档：{archive_path}\n清单CSV：同包内 manifest.csv\nDNA链：{CHAIN_HASH}"}}]},
            "输出到哪": {"rich_text": [{"text": {"content": f"{archive_path} + Notion DB {manifest['dna_archive'] if 'dna_archive' in manifest else archive_dna}"}}]},
            "怎么算完成": {"rich_text": [{"text": {"content": f"1) 遍历{len(source_paths)}个来源路径 2) 计算SHA-256去重 3) 生成manifest 4) 压缩归档 5) Notion留痕"}}]},
            "用了什么本地资源": {"rich_text": [{"text": {"content": "; ".join(str(p) for p in source_paths)}}]},
            "🎨 风险等级": {"select": {"name": "🟢 安全稳定"}},
            "老大终判": {"select": {"name": "🕐 待复盘"}},
            "🌱 演化阶段": {"select": {"name": "本地化阶段"}},
            "🎯 本次按需分配 AI": {"multi_select": [{"name": "🌙 Kimi（长文/中文）"}]},
        },
        "children": [
            {
                "object": "block",
                "type": "paragraph",
                "paragraph": {
                    "rich_text": [
                        {"type": "text", "text": {"content": f"本次草日志全量归集由 Kimi 自动执行。"}},
                    ]
                },
            },
            {
                "object": "block",
                "type": "bulleted_list_item",
                "bulleted_list_item": {
                    "rich_text": [{"type": "text", "text": {"content": f"来源路径数：{len(source_paths)}"}}]
                },
            },
            {
                "object": "block",
                "type": "bulleted_list_item",
                "bulleted_list_item": {
                    "rich_text": [{"type": "text", "text": {"content": f"原始文件数：{len(file_records)}"}}]
                },
            },
            {
                "object": "block",
                "type": "bulleted_list_item",
                "bulleted_list_item": {
                    "rich_text": [{"type": "text", "text": {"content": f"去重后唯一文件：{len(unique_hashes)}"}}]
                },
            },
            {
                "object": "block",
                "type": "bulleted_list_item",
                "bulleted_list_item": {
                    "rich_text": [{"type": "text", "text": {"content": f"归档路径：{archive_path}"}}]
                },
            },
            {
                "object": "block",
                "type": "bulleted_list_item",
                "bulleted_list_item": {
                    "rich_text": [{"type": "text", "text": {"content": f"DNA：{archive_dna}"}}]
                },
            },
        ],
    }
    notion_payload_path = ARCHIVE_ROOT / f"{collection_name}_notion_payload.json"
    with open(notion_payload_path, "w", encoding="utf-8") as f:
        json.dump(notion_payload, f, ensure_ascii=False, indent=2)

    final_dna = log_dna("CAORIZHI-COLLECTION-DONE", f"归集完成 {archive_path}")
    observer_log("草日志归集任务完成", str(archive_path), "high")

    print(json.dumps({
        "collection_name": collection_name,
        "archive_path": str(archive_path),
        "archive_size": archive_size,
        "unique_files": len(unique_hashes),
        "raw_files": len(file_records),
        "source_paths": [str(p) for p in source_paths],
        "manifest_path": str(manifest_path) if manifest_path.exists() else None,
        "notion_payload_path": str(notion_payload_path),
        "final_dna": final_dna,
    }, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
