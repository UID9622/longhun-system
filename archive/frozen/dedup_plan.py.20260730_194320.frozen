#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂重复资产清理计划生成器 v1.1
DNA: #龍芯⚡️2026-06-26-LONGHUN-DEDUP-PLAN-v1.1

基于 _work/scan_assets/asset_index.json 生成重复文件清理方案。
规则：
1. 按内容 hash 分组，相同 hash 只保留一份“canonical”文件。
2. canonical 优先级（数字越小越优先）：
   0. longhun-system/_quarantine/ （敏感区，作为外部导入 canonical）
   1. longhun-system/01_技能库/ 官方 skill
   2. longhun-system/cnsh-core/、longhun-system/cnsh-terminal/（顶层）
   3. longhun-system/dev-env/chinese-editor/
   4. longhun-system/xpay/、multicurrency/、cnsh/reactor/、cnsh/platform_adapters/
   5. longhun-system/ 其他正式目录
   6. longhun-system/_backup/
   7. longhun-system/releases/
   8. longhun-system/cnsh-core.backup/
   9. longhun-system/cnsh-terminal/downloads-imports/、01_protocols/downloads-imports/
  10. Downloads/ 外部下载
  11. longhun-system/_archive/、其他归档
3. 同优先级内：避开备份文件名（.bak/.backup/时间戳），再选修改时间最新。
4. 非 canonical 的重复文件：与 canonical 内容一致则建议删除；否则记录为变体。

默认 dry-run，输出 plan.json / plan_report.md。加 --execute 真正执行删除。
"""
import json
import re
from collections import defaultdict
from datetime import datetime
from pathlib import Path

SCAN_DIR = Path("/Users/zuimeidedeyihan/_work/scan_assets")
OUT_DIR = SCAN_DIR
INDEX_FILE = SCAN_DIR / "asset_index.json"
PLAN_FILE = OUT_DIR / "dedup_plan.json"
REPORT_FILE = OUT_DIR / "dedup_plan_report.md"

BACKUP_RE = re.compile(r"(\.bak|\.backup|_backup_|_old|_副本|_old|_历史|_归档|" +
                       r"\d{8}_\d+|20\d{6}|202[5-9])", re.IGNORECASE)


def priority(path: str) -> int:
    if path.startswith("longhun-system/_quarantine/"):
        return 0
    if path.startswith("longhun-system/01_技能库/"):
        return 1
    if path.startswith(("longhun-system/cnsh-core/", "longhun-system/cnsh-terminal/")):
        # 但 downloads-imports 除外，后面单独判断
        if "downloads-imports" not in path:
            return 2
    if path.startswith("longhun-system/dev-env/chinese-editor/"):
        return 3
    if path.startswith(("longhun-system/xpay/", "longhun-system/multicurrency/",
                        "longhun-system/cnsh/reactor/", "longhun-system/cnsh/platform_adapters/")):
        return 4
    if path.startswith("longhun-system/_backup/"):
        return 6
    if path.startswith("longhun-system/releases/"):
        return 7
    if path.startswith("longhun-system/cnsh-core.backup/"):
        return 8
    if "longhun-system/cnsh-terminal/downloads-imports/" in path:
        return 9
    if path.startswith("longhun-system/01_protocols/downloads-imports/"):
        return 9
    if path.startswith("Downloads/"):
        return 10
    if path.startswith("longhun-system/_archive/"):
        return 11
    if path.startswith("longhun-system/"):
        return 5
    return 99


def filename_penalty(path: str) -> int:
    """备份/时间戳文件名惩罚，数值越小越优先"""
    name = Path(path).name
    if BACKUP_RE.search(name):
        return 10
    return 0


def path_depth(path: str) -> int:
    return len(Path(path).parts)


def is_noise(path: str) -> bool:
    noise_terms = ["venv", "site-packages", "node_modules", "/.venv", "/venv/",
                   "voice_env", "运行环境"]
    return any(t in path for t in noise_terms)


def generate_plan(execute: bool = False):
    with open(INDEX_FILE, "r", encoding="utf-8") as f:
        records = json.load(f)

    files = [r for r in records if r["type"] == "file" and not is_noise(r["path"]) and r["content_hash"]]

    by_hash = defaultdict(list)
    for r in files:
        by_hash[r["content_hash"]].append(r)

    to_delete = []
    variants = []
    kept = []
    space_saved = 0

    # 安全删除区：只有以下路径/文件名模式的重复文件才建议删除
    def is_safe_to_delete(path: str) -> bool:
        safe_patterns = [
            "downloads-imports/",
            "_backup/",
            "releases/v5.1/staging/",
            "cnsh-core.backup/",
            "Kimi_Agent_重复副本回收站_",
            "Kimi_Agent_终端升级与结构优化",
        ]
        if any(p in path for p in safe_patterns):
            return True
        # 备份文件名，且同 hash 组里有非备份文件存在
        if BACKUP_RE.search(Path(path).name):
            return True
        return False

    for h, group in by_hash.items():
        if len(group) <= 1:
            continue
        # 选择 canonical：优先级 -> 文件名惩罚 -> 路径深度 -> 修改时间最新
        group_sorted = sorted(
            group,
            key=lambda r: (priority(r["path"]), filename_penalty(r["path"]), path_depth(r["path"]), -r["mtime"]),
        )
        canonical = group_sorted[0]
        kept.append(canonical)
        for r in group_sorted[1:]:
            if is_safe_to_delete(r["path"]):
                to_delete.append(r)
                space_saved += r["size"]

    # basename 变体（同 basename 不同 hash，且出现次数较多）
    by_basename = defaultdict(list)
    for r in files:
        by_basename[Path(r["path"]).name].append(r)
    for name, group in by_basename.items():
        hashes = {r["content_hash"] for r in group}
        if len(hashes) > 1 and len(group) > 2:
            variants.append({
                "basename": name,
                "count": len(group),
                "paths": sorted([r["path"] for r in group]),
            })
    variants.sort(key=lambda x: -x["count"])

    plan = {
        "generated_at": datetime.now().isoformat(),
        "total_files": len(files),
        "duplicate_groups": len([g for g in by_hash.values() if len(g) > 1]),
        "files_to_delete": len(to_delete),
        "space_saved_bytes": space_saved,
        "space_saved_mb": round(space_saved / 1024 / 1024, 2),
        "canonical": [r["path"] for r in kept],
        "delete": [r["path"] for r in to_delete],
        "variants": variants[:200],
    }

    with open(PLAN_FILE, "w", encoding="utf-8") as f:
        json.dump(plan, f, ensure_ascii=False, indent=2)

    lines = []
    lines.append("# 龍魂重复资产清理计划\n")
    lines.append(f"**生成时间**: {plan['generated_at']}\n")
    lines.append(f"**扫描文件数**: {plan['total_files']}\n")
    lines.append(f"**重复组数**: {plan['duplicate_groups']}\n")
    lines.append(f"**可删除重复文件数**: {plan['files_to_delete']}\n")
    lines.append(f"**预计释放空间**: {plan['space_saved_mb']} MB ({plan['space_saved_bytes']} bytes)\n")

    lines.append("\n## 可删除重复文件示例（前 50）\n")
    for r in to_delete[:50]:
        lines.append(f"- `{r['path']}` (size={r['size']})\n")
    if len(to_delete) > 50:
        lines.append(f"- ... 还有 {len(to_delete)-50} 个\n")

    lines.append("\n## canonical 文件示例（前 30）\n")
    for r in kept[:30]:
        lines.append(f"- `{r['path']}`\n")

    lines.append(f"\n## 同名不同内容变体（前 100）\n")
    for v in variants[:100]:
        lines.append(f"### {v['basename']} ({v['count']} 个不同版本)\n")
        for p in v["paths"][:10]:
            lines.append(f"- `{p}`\n")
        if v["count"] > 10:
            lines.append(f"- ... 还有 {v['count']-10} 个\n")

    lines.append("\n---\n")
    lines.append(f"**DNA**: `#龍芯⚡️{datetime.now().strftime('%Y-%m-%d-%H%M%S')}-LONGHUN-DEDUP-PLAN-v1.1`\n")

    REPORT_FILE.write_text("".join(lines), encoding="utf-8")
    print(f"📝 计划已保存: {PLAN_FILE}")
    print(f"📝 报告已保存: {REPORT_FILE}")
    print(f"📊 可删除重复文件: {plan['files_to_delete']} 个，预计释放 {plan['space_saved_mb']} MB")

    if execute:
        print("\n🚨 开始执行删除...")
        deleted = 0
        failed = 0
        for r in to_delete:
            p = Path("/Users/zuimeidedeyihan") / r["path"]
            try:
                if p.exists():
                    p.unlink()
                    deleted += 1
            except Exception as e:
                print(f"❌ 删除失败 {p}: {e}")
                failed += 1
        print(f"✅ 已删除 {deleted} 个文件，失败 {failed} 个")


if __name__ == "__main__":
    import sys
    execute = "--execute" in sys.argv
    generate_plan(execute=execute)
