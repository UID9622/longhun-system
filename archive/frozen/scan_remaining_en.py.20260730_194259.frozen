#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
扫描 CNSH_龍魂星宿知识图.html 中残留的英文标识
"""
import re
from pathlib import Path
from html.parser import HTMLParser

SRC = Path('/Users/zuimeidedeyihan/longhun-system/web/p0-controls/CNSH_龍魂星宿知识图.html')
text = SRC.read_text(encoding='utf-8')

style_match = re.search(r'<style>(.*?)</style>', text, re.DOTALL)
script_match = re.search(r'<script>(.*?)</script>', text, re.DOTALL)
style_body = style_match.group(1) if style_match else ''
script_body = script_match.group(1) if script_match else ''
html_body = text
if style_match:
    html_body = html_body[:style_match.start()] + html_body[style_match.end():]
if script_match:
    html_body = html_body[:script_match.start()] + html_body[script_match.end():]

class Parser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = []
        self.classes = []
        self.visible_texts = []
        self.in_body = False
    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        if 'id' in d:
            self.ids.append(d['id'])
        if 'class' in d:
            self.classes.extend(d['class'].split())
        if tag == 'body':
            self.in_body = True
    def handle_endtag(self, tag):
        if tag == 'body':
            self.in_body = False
    def handle_data(self, data):
        if self.in_body:
            t = data.strip()
            if t:
                self.visible_texts.append(t)

parser = Parser()
parser.feed(html_body)

# 判断字符串是否含英文单词（超过2个连续字母）
def has_en(s):
    return bool(re.search(r'[a-zA-Z]{3,}', s))

remaining = {
    'html_ids': [x for x in parser.ids if has_en(x)],
    'html_classes': [x for x in parser.classes if has_en(x)],
    'visible_texts': [x for x in parser.visible_texts if has_en(x)],
    'css_ids': [],
    'css_classes': [],
    'js_funcs': [],
    'js_vars': [],
}

# CSS 选择器中的英文 id/class
for line in style_body.splitlines():
    line = line.strip()
    if line.endswith('{') and ';' not in line:
        selector_group = line[:-1].strip()
        for sel in selector_group.split(','):
            sel = sel.strip()
            for token in re.findall(r'#([\w\u4e00-\u9fa5\-]+)|\.([\w\u4e00-\u9fa5\-]+)', sel):
                name = token[0] or token[1]
                if has_en(name):
                    if token[0]:
                        remaining['css_ids'].append(name)
                    else:
                        remaining['css_classes'].append(name)

# JS 函数定义中的英文名
for name in re.findall(r'function\s+([\w\u4e00-\u9fa5_]+)\s*\(', script_body):
    if has_en(name):
        remaining['js_funcs'].append(name)

# JS 变量声明中的英文名（const/let/var）
for decl in re.findall(r'\b(?:const|let|var)\s+([\w\u4e00-\u9fa5_,\s]+)\s*=', script_body):
    for name in re.split(r'[,\s]+', decl):
        name = name.strip()
        if name and has_en(name):
            remaining['js_vars'].append(name)

# 去重
for k in remaining:
    remaining[k] = sorted(set(remaining[k]))

print('残留英文标识扫描结果：')
for k, v in remaining.items():
    print(f'\n{k}:')
    for item in v:
        print(f'  - {item}')

# 保存为 JSON 供报告使用
out = Path('/Users/zuimeidedeyihan/_work/remaining_en.json')
out.write_text(__import__('json').dumps(remaining, ensure_ascii=False, indent=2), encoding='utf-8')
print(f'\n已保存：{out}')
