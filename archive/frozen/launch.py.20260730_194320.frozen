#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂万年历 · 启动器
DNA: #龍芯⚡️2026-06-27-LONGHUN-CALENDAR-LAUNCHER-v2.0

启动本地 HTTP 服务并在浏览器中打开入口。
"""

import json
import os
import subprocess
import sys
import time
import urllib.request
import urllib.parse
from pathlib import Path

PORT = int(os.environ.get('LONGHUN_CALENDAR_PORT', '9527'))
ROOT = Path(__file__).resolve().parent
SERVER_PY = ROOT / 'server.py'
BASE_URL = f'http://127.0.0.1:{PORT}/'


def build_url(view=None, params=None):
    url = BASE_URL
    if view:
        payload = json.dumps({'view': view, 'params': params or {}}, ensure_ascii=False, separators=(',', ':'))
        url += '#' + urllib.parse.quote(payload, safe='')
    return url


def is_server_running():
    try:
        urllib.request.urlopen(BASE_URL, timeout=0.5)
        return True
    except Exception:
        return False


def start_server():
    env = os.environ.copy()
    env['LONGHUN_CALENDAR_PORT'] = str(PORT)
    subprocess.Popen(
        [sys.executable, str(SERVER_PY)],
        cwd=str(ROOT),
        env=env,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        start_new_session=True
    )


def open_browser(url):
    import webbrowser
    webbrowser.open(url)


def verify_chain():
    chain_file = ROOT / '.local_storage_chain.json'
    if not chain_file.exists():
        print('ℹ️  未找到本地链导出文件。请在浏览器中打开系统状态页导出。')
        print(f'   一键打开: lh 万年历校验')
        return 0
    data = json.loads(chain_file.read_text(encoding='utf-8'))
    print('🔒 龍魂万年历本地主权链校验')
    print(f'   记录数: {len(data)}')
    if data:
        print(f'   最新记录: {data[-1].get("time", "N/A")}')
        print(f'   最新哈希: {data[-1].get("hash", "N/A")[:24]}...')
    print('   ✅ 文件可读，请结合浏览器内系统状态页做完整校验。')
    return 0


def ensure_server():
    if not is_server_running():
        start_server()
        for _ in range(20):
            time.sleep(0.1)
            if is_server_running():
                break


COMMUNITY_SUBCOMMANDS = {'社区', '共享', '主题', '方向', '审核', '日志'}


def route_community_cli(argv):
    """把社区相关子命令路由到 community_cli.py"""
    if not argv:
        return None
    if argv[0] in COMMUNITY_SUBCOMMANDS:
        import subprocess
        cli = ROOT / 'community_cli.py'
        return subprocess.call([sys.executable, str(cli)] + argv)
    return None


def main():
    if '--verify' in sys.argv:
        return verify_chain()

    argv = sys.argv[1:]

    # 社区 CLI 优先路由
    community_exit = route_community_cli(argv)
    if community_exit is not None:
        return community_exit

    view = None
    params = {}
    if '--status' in sys.argv:
        view = 'system-status'
    elif '--settings' in sys.argv:
        view = 'settings'
    elif '--ai' in sys.argv:
        view = 'ai-access'
    elif '--audit' in sys.argv:
        view = 'audit-shame'
    elif '--auth' in sys.argv:
        view = 'authorization'
    elif '--community' in sys.argv:
        view = 'community'

    ensure_server()
    url = build_url(view, params)
    open_browser(url)
    print(f'🐉 龍魂万年历已打开: {url}')


if __name__ == '__main__':
    main()
