# 中文字符识别器 / Chinese Character Recognizer
# ═══════════════════════════════════════════════════════════════════════
class 中文字符识别器:
    """
    🟢 中文字符识别器 — 基于特征匹配的识别
    Chinese Character Recognizer — Feature matching based recognition
    
    使用笔画密度和结构特征进行简单字符匹配
    Simple character matching using stroke density and structure
    """
    
    def __init__(self):
        self.版本 = "1.0"
        self.特征提取 = 字符特征提取器()
        self.龍字检测 = 龍字检测器()
        self.甲骨文分类 = 甲骨文分类器()
        self.字符模板库 = self._建立模板库()
    
    def _建立模板库(self) -> Dict[str, Dict[str, Any]]:
        """建立基础字符特征模板库 / Build base character feature template library"""
        模板库 = {
            "龍": {
                "结构": "左右",
                "笔画数": 16,
                "上密度": 0.15,
                "下密度": 0.10,
                "左密度": 0.12,
                "右密度": 0.14,
                "龍字特征": True,
            },
            "一": {
                "结构": "独体",
                "笔画数": 1,
                "上密度": 0.3,
                "下密度": 0.0,
                "左密度": 0.0,
                "右密度": 0.3,
            },
            "二": {
                "结构": "上下",
                "笔画数": 2,
                "上密度": 0.2,
                "下密度": 0.2,
                "左密度": 0.0,
                "右密度": 0.2,
            },
            "三": {
                "结构": "上下",
                "笔画数": 3,
                "上密度": 0.15,
                "中密度": 0.15,
                "下密度": 0.15,
            },
            "十": {
                "结构": "独体",
                "笔画数": 2,
                "上密度": 0.1,
                "下密度": 0.1,
                "左密度": 0.1,
                "右密度": 0.1,
            },
            "大": {
                "结构": "独体",
                "笔画数": 3,
                "上密度": 0.15,
                "下密度": 0.1,
                "左密度": 0.1,
                "右密度": 0.1,
            },
            "中": {
                "结构": "包围",
                "笔画数": 4,
                "上密度": 0.1,
                "下密度": 0.1,
                "左密度": 0.1,
                "右密度": 0.1,
            },
            "文": {
                "结构": "独体",
                "笔画数": 4,
                "上密度": 0.1,
                "下密度": 0.1,
                "左密度": 0.1,
                "右密度": 0.1,
            },
            "人": {
                "结构": "独体",
                "笔画数": 2,
                "上密度": 0.1,
                "下密度": 0.2,
                "左密度": 0.1,
                "右密度": 0.1,
            },
            "日": {
                "结构": "包围",
                "笔画数": 4,
                "上密度": 0.15,
                "下密度": 0.15,
                "左密度": 0.15,
                "右密度": 0.15,
            },
            "月": {
                "结构": "包围",
                "笔画数": 4,
                "上密度": 0.12,
                "下密度": 0.12,
                "左密度": 0.15,
                "右密度": 0.05,
            },
            "山": {
                "结构": "独体",
                "笔画数": 3,
                "上密度": 0.1,
                "下密度": 0.2,
                "左密度": 0.1,
                "右密度": 0.1,
            },
            "水": {
                "结构": "独体",
                "笔画数": 4,
                "上密度": 0.1,
                "下密度": 0.2,
                "左密度": 0.1,
                "右密度": 0.1,
            },
            "火": {
                "结构": "独体",
                "笔画数": 4,
                "上密度": 0.15,
                "下密度": 0.15,
                "左密度": 0.1,
                "右密度": 0.1,
            },
            "木": {
                "结构": "独体",
                "笔画数": 4,
                "上密度": 0.1,
                "下密度": 0.15,
                "左密度": 0.1,
                "右密度": 0.1,
            },
            "土": {
                "结构": "独体",
                "笔画数": 3,
                "上密度": 0.1,
                "下密度": 0.2,
                "左密度": 0.1,
                "右密度": 0.1,
            },
            "金": {
                "结构": "上下",
                "笔画数": 8,
                "上密度": 0.12,
                "下密度": 0.12,
                "左密度": 0.1,
                "右密度": 0.1,
            },
        }
        return 模板库
    
    def 识别字符(self, 字符图: np.ndarray) -> 识别结果:
        """
        🟢 识别单个中文字符 / Recognize single Chinese character
        
        参数 Parameters:
            字符图: 单字符图像 / Single character image
        
        返回 Returns:
            识别结果 / Recognition result
        """
        特征 = self.特征提取.提取全部特征(字符图)
        
        # 尝试龍字检测 / Try 龍 detection
        龍结果 = self.龍字检测.检测(字符图)
        if 龍结果["是龍字"] and 龍结果["置信度"] > 0.6:
            return 识别结果(
                文本="龍",
                置信度=龍结果["置信度"],
                审计="🟢",
                结构="左右",
                备注=f"龍字专用检测器命中 / 龍 detector hit: {龍结果['置信度']:.2f}",
                引擎来源="龍瞳-龍字检测器"
            )
        
        # 模板匹配 / Template matching
        最佳匹配 = None
        最佳分数 = 0.0
        
        for 字符, 模板 in self.字符模板库.items():
            分数 = self._计算匹配分数(特征, 模板)
            if 分数 > 最佳分数:
                最佳分数 = 分数
                最佳匹配 = 字符
        
        if 最佳匹配 and 最佳分数 > 0.4:
            return 识别结果(
                文本=最佳匹配,
                置信度=min(1.0, 最佳分数),
                审计="🟢" if 最佳分数 > 0.6 else "🟡",
                结构=特征["结构"],
                备注=f"模板匹配 / Template match: {最佳分数:.2f}",
                引擎来源="龍瞳-模板匹配"
            )
        
        return 识别结果(
            文本="?",
            置信度=0.0,
            审计="🔴",
            结构=特征["结构"],
            备注="未能识别 / Unrecognized",
            引擎来源="龍瞳-模板匹配"
        )
    
    def _计算匹配分数(self, 特征: Dict[str, Any], 模板: Dict[str, Any]) -> float:
        """计算特征与模板的匹配分数 / Calculate feature-template match score"""
        分数 = 0.0
        权重 = 0.0
        
        if "结构" in 模板:
            if 特征.get("结构") == 模板["结构"]:
                分数 += 0.3
            权重 += 0.3
        
        密度特征 = 特征.get("密度特征", {})
        for 密度名 in ["上密度", "中密度", "下密度", "左密度", "右密度"]:
            if 密度名 in 模板:
                差异 = abs(密度特征.get(密度名, 0) - 模板[密度名])
                分数 += max(0, 0.1 - 差异)
                权重 += 0.1
        
        if "笔画数" in 模板:
            估计笔画 = 特征.get("笔画特征", {}).get("估计笔画数", 0)
            笔画差异 = abs(估计笔画 - 模板["笔画数"])
            分数 += max(0, 0.2 - 笔画差异 * 0.05)
            权重 += 0.2
        
        return 分数 / max(权重, 1e-6)


# ═══════════════════════════════════════════════════════════════════════
# 图像生成辅助函数 / Image Generation Helper
# ═══════════════════════════════════════════════════════════════════════
class 图像生成器:
    """
    🟢 测试用图像生成器 / Test image generator
    
    生成简单的测试字符图像用于验证
    Generate simple test character images for validation
    """
    
    @staticmethod
    def _查找中文字体() -> Optional[str]:
        """查找系统中文字体 / Find system Chinese fonts"""
        字体路径列表 = [
            "/System/Library/Fonts/PingFang.ttc",
            "/System/Library/Fonts/STHeiti Light.ttc",
            "/Library/Fonts/Arial Unicode.ttf",
            "/usr/share/fonts/truetype/wqy/wqy-zenhei.ttc",
            "/usr/share/fonts/truetype/wqy/wqy-microhei.ttc",
            "/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc",
            "/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc",
            "/usr/share/fonts/truetype/droid/DroidSansFallbackFull.ttf",
            "C:\\Windows\\Fonts\\msyh.ttc",
            "C:\\Windows\\Fonts\\simhei.ttf",
            "C:\\Windows\\Fonts\\simsun.ttc",
            "C:\\Windows\\Fonts\\msyhbd.ttc",
        ]
        for 路径 in 字体路径列表:
            if os.path.exists(路径):
                return 路径
        return None
    
    @staticmethod
    def _绘制替代文字(图像: np.ndarray, 内容: str, 宽: int, 高: int) -> np.ndarray:
        """
        绘制替代文字（不用字体库）/ Draw alternative text (no font library)
        
        绘制简单的几何图案来模拟文字 / Draw simple geometric patterns
        """
        边距 = 40
        中心横 = 宽 // 2
        中心纵 = 高 // 2
        
        if "龍" in 内容:
            for i in range(3):
                图像[边距 + i*15, 边距:中心横, :] = 0
            for i in range(2):
                图像[边距:中心纵, 边距 + i*20, :] = 0
            for i in range(5):
                图像[边距 + i*20, 中心横:宽-边距, :] = 0
            for i in range(3):
                图像[高-边距-30+i*10, 中心横-20:宽-边距, :] = 0
        elif "一" in 内容:
            图像[中心纵, 边距:宽-边距, :] = 0
        elif "二" in 内容:
            图像[中心纵-20, 边距:宽-边距, :] = 0
            图像[中心纵+20, 边距:宽-边距, :] = 0
        elif "十" in 内容:
            图像[边距:高-边距, 中心横, :] = 0
            图像[中心纵, 边距:宽-边距, :] = 0
        else:
            图像[边距, 边距:宽-边距, :] = 0
            图像[高-边距, 边距:宽-边距, :] = 0
            图像[边距:高-边距, 边距, :] = 0
            图像[边距:高-边距, 宽-边距, :] = 0
        
        return 图像
    
    @staticmethod
    def 生成测试图像(内容: str = "龍", 尺寸: Tuple[int, int] = (200, 200),
                    字号: int = 64, 输出路径: str = None) -> np.ndarray:
        """
        生成测试图像 / Generate test image
        
        参数 Parameters:
            内容: 图像内容文字 / Content text
            尺寸: (宽, 高) / (width, height)
            字号: 字体大小 / Font size
            输出路径: 保存路径（可选）/ Save path (optional)
        
        返回 Returns:
            图像数组 / Image array
        """
        宽, 高 = 尺寸
        
        # 创建白色背景 / Create white background
        图像 = np.ones((高, 宽, 3), dtype=np.uint8) * 255
        
        if PIL可用 and 内容:
            try:
                PIL图 = Image.fromarray(图像)
                画笔 = ImageDraw.Draw(PIL图)
                
                字体路径 = 图像生成器._查找中文字体()
                if 字体路径:
                    字体 = ImageFont.truetype(字体路径, 字号)
                else:
                    字体 = ImageFont.load_default()
                
                边界框 = 画笔.textbbox((0, 0), 内容, font=字体)
                文字宽 = 边界框[2] - 边界框[0]
                文字高 = 边界框[3] - 边界框[1]
                位置横 = (宽 - 文字宽) // 2
                位置纵 = (高 - 文字高) // 2
                
                画笔.text((位置横, 位置纵), 内容, fill=0, font=字体)
                图像 = np.array(PIL图)
            except Exception as 错误:
                日志.warning(f"🟡 文字渲染失败，使用替代方案 / Text render failed: {错误}")
                图像 = 图像生成器._绘制替代文字(图像, 内容, 宽, 高)
        else:
            图像 = 图像生成器._绘制替代文字(图像, 内容, 宽, 高)
        
        if 输出路径:
            os.makedirs(os.path.dirname(输出路径), exist_ok=True)
            if CV2可用:
                cv2.imwrite(输出路径, cv2.cvtColor(图像, cv2.COLOR_RGB2BGR))
            elif PIL可用:
                Image.fromarray(图像).save(输出路径)
            日志.info(f"🟢 测试图像已保存 / Test image saved: {输出路径}")
        
        return 图像


# ═══════════════════════════════════════════════════════════════════════
# 主引擎：龍瞳OCR引擎 / Main Engine: Dragon Pupil OCR Engine
# ═══════════════════════════════════════════════════════════════════════
class 龍瞳OCR引擎:
    """
    ╔═══════════════════════════════════════════════════════════════╗
    ║  🐉 龍瞳OCR引擎 — 中文优先图像识别引擎                        ║
    ║  Dragon Pupil OCR Engine — Chinese-First Image Recognition    ║
    ║                                                               ║
    ║  DNA: #龍芯⚡️2026-06-18-LONGTENG-OCR-v1.0                   ║
    ║  核心策略：能中文替代的中文实现，不能的用国际标准库兜底          ║
    ║  Core Strategy: Chinese-first, international fallback         ║
    ╚═══════════════════════════════════════════════════════════════╝
    
    🟢 已实现功能 / Implemented:
        - OTSU二值化（自己实现）/ OTSU binarization (self-implemented)
        - 中值滤波（自己实现）/ Median filter (self-implemented)
        - 倾斜校正（自己实现）/ Skew correction (self-implemented)
        - 文本区域检测（基于笔画密度）/ Text region detection (stroke-density based)
        - 中文字符特征提取 / Chinese character feature extraction
        - 繁体龍字专用检测器 / Traditional 龍 character detector
        - 甲骨文字符分类器 / Oracle bone character classifier
        - CNSH术语识别 / CNSH terminology recognition
    
    🟡 国际兜底 / International Fallback:
        - Tesseract OCR（当置信度 < 0.7 时）/ Tesseract when confidence < 0.7
        - OpenCV（基础I/O）/ OpenCV (basic I/O)
    """
    
    def __init__(self, 模式: str = "中文优先", 置信度阈值: float = 0.7):
        """
        初始化龍瞳OCR引擎 / Initialize Dragon Pupil OCR Engine
        
        参数 Parameters:
            模式: 识别模式（"中文优先"|"国际兜底"|"混合模式"）/ Recognition mode
            置信度阈值: 降级阈值 0.0-1.0 / Fallback threshold
        """
        日志.info("🐉 龍瞳OCR引擎启动中 / Initializing Dragon Pupil OCR...")
        
        # DNA追溯 / DNA Trace
        self.DNA = "#龍芯⚡️2026-06-18-LONGTENG-OCR-v1.0"
        
        # 模式设置 / Mode setting
        self.模式 = 模式
        self.置信度阈值 = 置信度阈值
        
        # 🟢 初始化中文核心模块 / Initialize Chinese core modules
        self.预处理器 = 图像预处理器()
        self.区域检测器 = 文本区域检测器()
        self.特征提取器 = 字符特征提取器()
        self.龍字检测器 = 龍字检测器()
        self.甲骨文分类器 = 甲骨文分类器()
        self.字符识别器 = 中文字符识别器()
        self.CNSH词典 = CNSH词典()
        
        # 🟡 初始化国际兜底引擎 / Initialize international fallback
        self.兜底引擎 = 国际兜底引擎()
        
        # 版本信息 / Version info
        self.版本 = "1.0"
        self.引擎名 = "龍瞳OCR"
        
        # 统计信息 / Statistics
        self.统计 = {
            "总识别次数": 0,
            "中文识别次数": 0,
            "兜底次数": 0,
            "龍字检测次数": 0,
            "甲骨文分类次数": 0,
        }
        
        日志.info(f"🐉 龍瞳OCR引擎已就绪 / Engine ready — 模式/Mode: {模式}")
        日志.info(f"   DNA: {self.DNA}")
        日志.info(f"   置信度阈值/Threshold: {置信度阈值}")
    
    def 识别图像(self, 图像路径: Union[str, np.ndarray]) -> 识别结果:
        """
        🟢 主识别函数：识别图像中的文本
        Main recognition function: recognize text in image
        
        流程 / Pipeline:
            1. 加载图像 / Load image
            2. 预处理（OTSU+中值滤波+倾斜校正）/ Preprocess
            3. 检测文本区域 / Detect text regions
            4. 识别每个区域 / Recognize each region
            5. 必要时降级到Tesseract / Fallback to Tesseract if needed
        
        参数 Parameters:
            图像路径: 图像文件路径或numpy数组 / Image path or numpy array
        
        返回 Returns:
            识别结果 / Recognition result
        """
        self.统计["总识别次数"] += 1
        
        日志.info(f"🐉 开始识别 / Starting recognition: {图像路径 if isinstance(图像路径, str) else 'numpy数组'}")
        
        try:
            # Step 1: 加载图像 / Load image
            图像数组 = self._加载图像(图像路径)
            if 图像数组 is None:
                return 识别结果(
                    文本="",
                    置信度=0.0,
                    审计="🔴",
                    备注="图像加载失败 / Image load failed"
                )
            
            # Step 2: 预处理 / Preprocess
            日志.info("  [1/4] 图像预处理 / Preprocessing...")
            预处理图 = self.预处理器.预处理(图像数组)
            
            # Step 3: 检测文本区域 / Detect text regions
            日志.info("  [2/4] 检测文本区域 / Detecting text regions...")
            文本区域 = self.区域检测器.检测文本区域(预处理图)
            
            if not 文本区域:
                日志.info("  未检测到文本区域，尝试整图识别 / No regions, trying whole image")
                return self._识别整图(图像数组, 预处理图)
            
            # Step 4: 识别每个区域 / Recognize each region
            日志.info(f"  [3/4] 识别 {len(文本区域)} 个文本区域 / Recognizing {len(文本区域)} regions...")
            识别文本列表 = []
            所有区域 = []
            总置信度 = []
            
            for 索引, 区域 in enumerate(文本区域):
                区域图 = 预处理图[区域.左上纵:区域.右下纵, 区域.左上横:区域.右下横]
                
                if 区域图.size == 0:
                    continue
                
                # 使用中文核心识别 / Use Chinese core
                结果 = self.字符识别器.识别字符(区域图)
                
                # 检查是否需要降级 / Check if fallback needed
                if 结果.置信度 < self.置信度阈值 and self.模式 != "中文优先":
                    结果 = self._国际兜底识别(区域图)
                
                识别文本列表.append(结果.文本)
                总置信度.append(结果.置信度)
                
                区域字典 = 区域.转字典()
                区域字典["识别文本"] = 结果.文本
                区域字典["识别置信度"] = round(结果.置信度, 4)
                所有区域.append(区域字典)
            
            # Step 5: 组合结果 / Combine results
            日志.info("  [4/4] 组合识别结果 / Combining results...")
            合并文本 = "".join(识别文本列表)
            平均置信度 = float(np.mean(总置信度)) if 总置信度 else 0.0
            
            # 检查CNSH术语 / Check CNSH terminology
            CNSH匹配 = self.CNSH词典.匹配命名模式(合并文本)
            
            审计 = "🟢" if 平均置信度 > 0.7 else "🟡" if 平均置信度 > 0.4 else "🔴"
            
            结果 = 识别结果(
                文本=合并文本,
                置信度=round(平均置信度, 4),
                区域=所有区域,
                审计=审计,
                备注=f"识别 {len(文本区域)} 个区域 / Recognized {len(文本区域)} regions",
                引擎来源="龍瞳OCR-中文核心"
            )
            
            # 最终兜底检查 / Final fallback check
            if 平均置信度 < self.置信度阈值 and self.模式 in ["混合模式", "国际兜底"]:
                兜底结果 = self._国际兜底识别(图像数组)
                if 兜底结果.置信度 > 平均置信度:
                    self.统计["兜底次数"] += 1
                    兜底结果.备注 = f"已降级到国际引擎 / Fallback: {结果.置信度:.2f} -> {兜底结果.置信度:.2f}"
                    return 兜底结果
            
            self.统计["中文识别次数"] += 1
            日志.info(f"🐉 识别完成 / Done: 文本/Text=[{合并文本}], 置信度/Conf={平均置信度:.3f}")
            return 结果
        
        except Exception as 错误:
            日志.error(f"🔴 识别过程出错 / Recognition error: {错误}")
            traceback.print_exc()
            return 识别结果(
                文本="",
                置信度=0.0,
                审计="🔴",
                备注=f"识别错误 / Error: {str(错误)}"
            )
    
    def 识别中文字符(self, 图像数组: np.ndarray) -> 识别结果:
        """
        🟢 识别单个中文字符 / Recognize single Chinese character
        
        参数 Parameters:
            图像数组: 字符图像数组 / Character image array
        
        返回 Returns:
            识别结果 / Recognition result
        """
        return self.字符识别器.识别字符(图像数组)
    
    def 检测龍字(self, 图像数组: np.ndarray) -> Dict[str, Any]:
        """
        🟢 检测图像中是否包含繁体“龍”字
        Detect if image contains traditional "龍" character
        
        参数 Parameters:
            图像数组: 输入图像 / Input image
        
        返回 Returns:
            检测结果字典 / Detection result
        """
        self.统计["龍字检测次数"] += 1
        
        try:
            预处理图 = self.预处理器.预处理(图像数组)
            
            区域列表 = self.区域检测器.检测文本区域(预处理图)
            
            龍字结果 = []
            for 区域 in 区域列表:
                区域图 = 预处理图[区域.左上纵:区域.右下纵, 区域.左上横:区域.右下横]
                if 区域图.size == 0:
                    continue
                
                结果 = self.龍字检测器.检测(区域图)
                if 结果["是龍字"]:
                    龍字结果.append({
                        "区域": 区域.转字典(),
                        "置信度": 结果["置信度"],
                        "详细分析": 结果["详细分析"]
                    })
            
            return {
                "包含龍字": len(龍字结果) > 0,
                "龍字数量": len(龍字结果),
                "龍字位置": 龍字结果,
                "DNA": self.DNA,
            }
        
        except Exception as 错误:
            日志.error(f"🔴 龍字检测失败 / 龍 detection failed: {错误}")
            return {"包含龍字": False, "错误": str(错误)}
    
    def 检测甲骨文(self, 图像数组: np.ndarray) -> Dict[str, Any]:
        """
        🟢 检测图像中的甲骨文字符特征
        Detect oracle bone character features in image
        
        参数 Parameters:
            图像数组: 输入图像 / Input image
        
        返回 Returns:
            分类结果 / Classification result
        """
        self.统计["甲骨文分类次数"] += 1
        
        try:
            预处理图 = self.预处理器.预处理(图像数组)
            
            区域列表 = self.区域检测器.检测文本区域(预处理图)
            
            甲骨文结果 = []
            for 区域 in 区域列表:
                区域图 = 预处理图[区域.左上纵:区域.右下纵, 区域.左上横:区域.右下横]
                if 区域图.size == 0:
                    continue
                
                结果 = self.甲骨文分类器.分类(区域图)
                结果["区域"] = 区域.转字典()
                甲骨文结果.append(结果)
            
            return {
                "字符总数": len(甲骨文结果),
                "甲骨文特征字符数": sum(1 for r in 甲骨文结果 if r.get("是甲骨文", False)),
                "字符详情": 甲骨文结果,
                "DNA": self.DNA,
            }
        
        except Exception as 错误:
            日志.error(f"🔴 甲骨文检测失败 / Oracle bone detection failed: {错误}")
            return {"字符总数": 0, "错误": str(错误)}
    
    def 提取文本区域(self, 图像数组: np.ndarray) -> List[区域框]:
        """
        🟢 提取图像中的文本区域（自己实现）
        Extract text regions from image (self-implemented)
        
        参数 Parameters:
            图像数组: 输入图像 / Input image
        
        返回 Returns:
            文本区域框列表 / List of text region boxes
        """
        预处理图 = self.预处理器.预处理(图像数组)
        return self.区域检测器.检测文本区域(预处理图)
    
    def 预处理(self, 图像数组: np.ndarray) -> np.ndarray:
        """
        🟢 图像预处理（OTSU二值化+中值滤波+倾斜校正）
        Image preprocessing (OTSU + median filter + skew correction)
        
        参数 Parameters:
            图像数组: 输入图像 / Input image
        
        返回 Returns:
            预处理后二值图像 / Preprocessed binary image
        """
        return self.预处理器.预处理(图像数组)
    
    def 安装依赖(self) -> Dict[str, Any]:
        """
        🟡 自动检测并提示安装依赖包
        Auto-detect and prompt for dependency installation
        
        检测项 / Checks:
            - opencv-python / OpenCV
            - pytesseract / Tesseract
            - Pillow / PIL
            - numpy / NumPy
        
        返回 Returns:
            依赖状态字典 / Dependency status dictionary
        """
        日志.info("🔍 检测依赖状态 / Checking dependencies...")
        
        依赖状态 = {
            "numpy": {"已安装": True, "版本": np.__version__},
            "opencv-python": {"已安装": CV2可用, "版本": getattr(cv2, "__version__", "N/A") if CV2可用 else "未安装"},
            "Pillow": {"已安装": PIL可用, "版本": getattr(Image, "__version__", "N/A") if PIL可用 else "未安装"},
            "pytesseract": {"已安装": TESSERACT可用, "版本": str(getattr(pytesseract, "get_tesseract_version", lambda: "N/A")()) if TESSERACT可用 else "未安装"},
        }
        
        待安装 = []
        for 包名, 状态 in 依赖状态.items():
            if not 状态["已安装"]:
                待安装.append(包名)
        
        if 待安装:
            日志.info("⚠️ 以下依赖未安装 / Missing dependencies:")
            for 包 in 待安装:
                日志.info(f"   pip install {包}")
        else:
            日志.info("🟢 所有依赖已安装 / All dependencies installed")
        
        return 依赖状态
    
    def 识别CNSH代码(self, 图像路径: Union[str, np.ndarray]) -> Dict[str, Any]:
        """
        🟢 识别CNSH代码截图中的中文标识符
        Recognize Chinese identifiers in CNSH code screenshots
        
        参数 Parameters:
            图像路径: 图像路径或数组 / Image path or array
        
        返回 Returns:
            CNSH识别结果 / CNSH recognition result
        """
        # 先进行常规OCR / Perform regular OCR first
        OCR结果 = self.识别图像(图像路径)
        
        文本 = OCR结果.文本
        
        # 匹配CNSH术语 / Match CNSH terminology
        术语匹配 = []
        for 术语 in self.CNSH词典.编程术语:
            if 术语 in 文本:
                术语匹配.append({
                    "术语": 术语,
                    "位置": 文本.index(术语),
                    "长度": len(术语)
                })
        
        # 匹配命名模式 / Match naming patterns
        命名匹配 = self.CNSH词典.匹配命名模式(文本)
        
        return {
            "原始文本": 文本,
            "置信度": OCR结果.置信度,
            "CNSH术语": 术语匹配,
            "命名模式": 命名匹配,
            "术语数量": len(术语匹配),
            "引擎来源": "龍瞳OCR-CNSH专用",
            "DNA": self.DNA,
        }
    
    def 导出JSON(self, 结果: 识别结果, 文件路径: str) -> str:
        """
        导出识别结果为JSON / Export recognition result to JSON
        
        参数 Parameters:
            结果: 识别结果对象 / Recognition result
            文件路径: 输出JSON路径 / Output JSON path
        
        返回 Returns:
            JSON字符串 / JSON string
        """
        return 结果.转JSON(文件路径=文件路径, 确保中文=True)
    
    def 获取统计(self) -> Dict[str, int]:
        """
        获取引擎统计信息 / Get engine statistics
        
        返回 Returns:
            统计字典 / Statistics dictionary
        """
        return self.统计.copy()
    
    def _加载图像(self, 图像路径: Union[str, np.ndarray]) -> Optional[np.ndarray]:
        """
        加载图像为numpy数组 / Load image as numpy array
        
        参数 Parameters:
            图像路径: 文件路径或numpy数组 / File path or numpy array
        
        返回 Returns:
            图像数组或None / Image array or None
        """
        if isinstance(图像路径, np.ndarray):
            return 图像路径
        
        if not os.path.exists(图像路径):
            日志.error(f"🔴 图像不存在 / Image not found: {图像路径}")
            return None
        
        try:
            if CV2可用:
                图像 = cv2.imread(图像路径)
                if 图像 is None:
                    raise ValueError("OpenCV无法读取图像")
                return cv2.cvtColor(图像, cv2.COLOR_BGR2RGB)
            elif PIL可用:
                PIL图像 = Image.open(图像路径).convert('RGB')
                return np.array(PIL图像)
            else:
                raise RuntimeError("🔴 无图像库可用 / No image library available")
        
        except Exception as 错误:
            日志.error(f"🔴 图像加载失败 / Image load failed: {错误}")
            return None
    
    def _识别整图(self, 原始图: np.ndarray, 预处理图: np.ndarray) -> 识别结果:
        """
        整图识别（无区域分割时）/ Whole image recognition
        
        参数 Parameters:
            原始图: 原始图像 / Original image
            预处理图: 预处理后图像 / Preprocessed image
        
        返回 Returns:
            识别结果 / Recognition result
        """
        结果 = self.字符识别器.识别字符(预处理图)
        
        if 结果.置信度 < self.置信度阈值:
            兜底结果 = self._国际兜底识别(原始图)
            if 兜底结果.置信度 > 结果.置信度:
                self.统计["兜底次数"] += 1
                return 兜底结果
        
        return 结果
    
    def _国际兜底识别(self, 图像: np.ndarray) -> 识别结果:
        """
        🟡 调用国际兜底引擎 / Call international fallback engine
        
        参数 Parameters:
            图像: 输入图像 / Input image
        
        返回 Returns:
            识别结果 / Recognition result
        """
        if self.模式 == "中文优先":
            return 识别结果(
                文本="",
                置信度=0.0,
                审计="🔴",
                备注="中文优先模式下禁用兜底 / Fallback disabled in Chinese-first mode"
            )
        
        日志.info("🟡 降级到国际兜底引擎 / Falling back to international engine...")
        self.统计["兜底次数"] += 1
        return self.兜底引擎.识别(图像)


