class 识别模式(Enum):
    """识别模式枚举 / Recognition mode enumeration"""
    中文优先 = "中文优先"      # Chinese-first: native algos first
    国际兜底 = "国际兜底"      # International fallback only
    混合模式 = "混合模式"      # Hybrid: combine both approaches


class 字符结构(Enum):
    """中文字符结构分类 / Chinese character structure classification"""
    独体 = "独体"            # Single component (e.g., 日, 月)
    左右 = "左右"            # Left-right (e.g., 明, 龍)
    上下 = "上下"            # Top-bottom (e.g., 思, 字)
    包围 = "包围"            # Enclosure (e.g., 国, 回)
    半包围 = "半包围"        # Semi-enclosure (e.g., 匡, 凶)
    未知 = "未知"            # Unknown structure


# ═══════════════════════════════════════════════════════════════════════
# 数据类定义 / Data Class Definitions
# ═══════════════════════════════════════════════════════════════════════
@dataclass
class 识别结果:
    """识别结果数据类 / Recognition result data class"""
    文本: str = ""                           # 识别文本 / Recognized text
    置信度: float = 0.0                       # 置信度 0.0-1.0 / Confidence score
    区域: List[Dict[str, Any]] = field(default_factory=list)   # 文本区域 / Text regions
    审计: str = "🟢"                         # 三色审计标注 / Audit marker
    结构: str = ""                           # 字符结构 / Character structure
    备注: str = ""                           # 附加备注 / Additional notes
    引擎来源: str = "龍瞳核心"                  # Engine source / Engine source

    def 转字典(self) -> Dict[str, Any]:
        """转换为字典 / Convert to dictionary"""
        return asdict(self)

    def 转JSON(self, 文件路径: Optional[str] = None, 确保中文: bool = True) -> str:
        """转换为JSON字符串 / Convert to JSON string
        
        参数 Parameters:
            文件路径: 若指定则保存到文件 / Save to file if specified
            确保中文: 确保中文字符正确编码 / Ensure Chinese encoding
        """
        选项 = 4 if 确保中文 else None
        json字符串 = json.dumps(self.转字典(), ensure_ascii=False, indent=选项)
        if 文件路径:
            os.makedirs(os.path.dirname(文件路径), exist_ok=True)
            with open(文件路径, 'w', encoding='utf-8') as f:
                f.write(json字符串)
            日志.info(f"🟢 JSON已保存 | JSON saved: {文件路径}")
        return json字符串


@dataclass
class 区域框:
    """文本区域框 / Text region bounding box"""
    左上横: int = 0       # x1 / Left
    左上纵: int = 0       # y1 / Top
    右下横: int = 0       # x2 / Right
    右下纵: int = 0       # y2 / Bottom
    置信度: float = 0.0    # Confidence
    文本: str = ""        # Recognized text

    def 转字典(self) -> Dict[str, Union[int, float, str]]:
        return {
            "x1": self.左上横, "y1": self.左上纵,
            "x2": self.右下横, "y2": self.右下纵,
            "宽": self.右下横 - self.左上横,
            "高": self.右下纵 - self.左上纵,
            "置信度": round(self.置信度, 4),
            "文本": self.文本
        }


