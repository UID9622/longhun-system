# CNSH术语词典 / CNSH Terminology Dictionary
# ═══════════════════════════════════════════════════════════════════════
class CNSH词典:
    """CNSH中文编程术语词典 / CNSH Chinese programming terminology"""
    
    # 🟢 常见中文变量名模式 / Common Chinese variable name patterns
    编程术语 = {
        # 控制流程 / Control flow
        "函数", "变量", "常量", "参数", "返回", "循环", "条件", "分支",
        "遍历", "迭代", "递归", "调用", "定义", "声明", "初始化",
        # 数据类型 / Data types
        "字符串", "整数", "浮点", "列表", "字典", "元组", "集合", "对象",
        "数组", "矩阵", "向量", "布尔", "空值", "字节",
        # 面向对象 / OOP
        "类", "实例", "方法", "属性", "继承", "多态", "封装", "构造",
        "析构", "抽象", "接口", "重写", "重载",
        # 异常处理 / Exception handling
        "异常", "错误", "捕获", "抛出", "尝试", "终止", "断言",
        # 模块系统 / Module system
        "模块", "导入", "导出", "包", "库", "命名空间", "作用域",
        # I/O操作 / I/O operations
        "文件", "读取", "写入", "打开", "关闭", "路径", "流",
        # 并发 / Concurrency
        "线程", "进程", "异步", "同步", "锁", "信号", "队列",
        # 网络 / Network
        "请求", "响应", "连接", "服务器", "客户端", "协议", "套接字",
        # 数据库 / Database
        "查询", "插入", "更新", "删除", "事务", "索引", "表", "记录",
        # 龍魂体系专用 / Dragon Soul system specific
        "龍魂", "龍芯", "龍瞳", "龍骨", "龍鳞", "龍息", "龍脉",
        "通心译", "CNSH", "君子协议", "三色审计", "DNA追溯",
        "觉醒", "开光", "入定", "调息", "运气", "周天", "筑基",
    }
    
    # 🟢 中文前缀后缀模式 / Chinese prefix/suffix patterns
    命名模式 = [
        ("动词", ["获取", "设置", "计算", "解析", "转换", "验证", 
                  "加载", "保存", "创建", "删除", "更新", "查找",
                  "提取", "过滤", "排序", "合并", "分割", "处理",
                  "检测", "识别", "分析", "生成", "导入", "导出"]),
        ("名词", ["数组", "列表", "字典", "字符串", "数值", "对象",
                  "计数器", "索引", "缓存", "配置", "状态", "结果",
                  "引擎", "管理器", "处理器", "控制器", "服务", "客户端"]),
        ("形容词", ["最大", "最小", "平均", "总和", "当前", "临时",
                    "全局", "局部", "有效", "无效", "激活", "静态"]),
    ]
    
    @classmethod
    def 是编程术语(cls, 词: str) -> bool:
        """检查是否为编程术语 / Check if term is programming terminology"""
        return 词 in cls.编程术语
    
    @classmethod
    def 匹配命名模式(cls, 文本: str) -> List[Dict[str, str]]:
        """匹配中文编程命名模式 / Match Chinese naming patterns
        
        返回 Returns:
            匹配结果列表 / List of matched patterns
        """
        结果 = []
        for 类型, 词列表 in cls.命名模式:
            for 词 in 词列表:
                if 词 in 文本:
                    结果.append({"类型": 类型, "词": 词, "位置": str(文本.index(词))})
        return 结果


# ═══════════════════════════════════════════════════════════════════════
# 图像预处理器（中文算法实现）/ Image Preprocessor (Chinese Algorithm Implementation)
# ═══════════════════════════════════════════════════════════════════════
class 图像预处理器:
    """
    图像预处理器 — 纯中文算法实现
    Image Preprocessor — Pure Chinese algorithm implementation
    
    🟢 Otsu二值化 — 自己实现 / Self-implemented
    🟢 中值滤波 — 自己实现 / Self-implemented
    🟢 倾斜校正 — 基于投影自己实现 / Projection-based self-implemented
    """
    
    def __init__(self):
        self.版本 = "1.0"
        self.审计状态 = "🟢"
    
    def 转灰度(self, 图像: np.ndarray) -> np.ndarray:
        """
        转换为灰度图像 / Convert to grayscale
        
        参数 Parameters:
            图像: 输入图像数组 (H, W, C) 或 (H, W) / Input image array
        
        返回 Returns:
            灰度图像 (H, W) / Grayscale image
        """
        if len(图像.shape) == 3:
            if 图像.shape[2] == 3:
                灰度 = (0.299 * 图像[:, :, 0] + 
                       0.587 * 图像[:, :, 1] + 
                       0.114 * 图像[:, :, 2]).astype(np.uint8)
                return 灰度
            elif 图像.shape[2] == 4:
                灰度 = (0.299 * 图像[:, :, 0] + 
                       0.587 * 图像[:, :, 1] + 
                       0.114 * 图像[:, :, 2]).astype(np.uint8)
                return 灰度
        elif len(图像.shape) == 2:
            return 图像.astype(np.uint8)
        else:
            raise ValueError(f"🔴 不支持的图像维度 / Unsupported image dims: {图像.shape}")
    
    def OTSU二值化(self, 灰度图: np.ndarray) -> np.ndarray:
        """
        🟢 OTSU自动阈值二值化 — 自己实现
        OTSU Automatic Threshold Binarization — Self-implemented
        
        基于最大类间方差法 / Based on maximum between-class variance method
        
        参数 Parameters:
            灰度图: 灰度图像数组 (H, W) / Grayscale image
        
        返回 Returns:
            二值图像 (H, W) / Binary image
        """
        if 灰度图.max() <= 1.0:
            灰度图 = (灰度图 * 255).astype(np.uint8)
        
        # 计算直方图 / Calculate histogram
        直方图 = np.zeros(256, dtype=np.float64)
        for 值 in 灰度图.flatten():
            直方图[int(值)] += 1
        
        总像素数 = 灰度图.size
        正规化直方图 = 直方图 / 总像素数
        
        # OTSU算法核心 / OTSU core algorithm
        最大方差 = 0.0
        最佳阈值 = 127
        
        for 阈值 in range(256):
            前景概率 = np.sum(正规化直方图[:阈值 + 1])
            背景概率 = np.sum(正规化直方图[阈值 + 1:])
            
            if 前景概率 == 0 or 背景概率 == 0:
                continue
            
            前景均值 = np.sum(np.arange(阈值 + 1) * 正规化直方图[:阈值 + 1]) / 前景概率
            背景均值 = np.sum(np.arange(阈值 + 1, 256) * 正规化直方图[阈值 + 1:]) / 背景概率
            
            类间方差 = 前景概率 * 背景概率 * (前景均值 - 背景均值) ** 2
            
            if 类间方差 > 最大方差:
                最大方差 = 类间方差
                最佳阈值 = 阈值
        
        二值图 = np.where(灰度图 > 最佳阈值, 255, 0).astype(np.uint8)
        
        日志.debug(f"🟢 OTSU阈值 / Threshold: {最佳阈值}, 方差 / Variance: {最大方差:.2f}")
        return 二值图
    
    def 中值滤波(self, 图像: np.ndarray, 核大小: int = 3) -> np.ndarray:
        """
        🟢 中值滤波去噪 — 自己实现（不使用OpenCV）
        Median Filter Denoising — Self-implemented (no OpenCV)
        
        参数 Parameters:
            图像: 输入图像 / Input image
            核大小: 滤波核大小（奇数）/ Kernel size (odd)
        
        返回 Returns:
            滤波后图像 / Filtered image
        """
        if 核大小 % 2 == 0:
            raise ValueError("🔴 核大小必须为奇数 / Kernel size must be odd")
        
        高, 宽 = 图像.shape[:2]
        边距 = 核大小 // 2
        
        if len(图像.shape) == 3:
            填充图 = np.pad(图像, ((边距, 边距), (边距, 边距), (0, 0)), mode='edge')
            结果 = np.zeros_like(图像)
            for 纵 in range(高):
                for 横 in range(宽):
                    for 通道 in range(图像.shape[2]):
                        区域 = 填充图[纵:纵+核大小, 横:横+核大小, 通道]
                        结果[纵, 横, 通道] = np.median(区域)
        else:
            填充图 = np.pad(图像, 边距, mode='edge')
            结果 = np.zeros_like(图像)
            for 纵 in range(高):
                for 横 in range(宽):
                    区域 = 填充图[纵:纵+核大小, 横:横+核大小]
                    结果[纵, 横] = np.median(区域)
        
        日志.debug(f"🟢 中值滤波完成 / Median filter done, kernel={核大小}")
        return 结果.astype(图像.dtype)
    
    def 旋转图像(self, 图像: np.ndarray, 角度: float) -> np.ndarray:
        """
        🟢 图像旋转 — 自己实现（不使用OpenCV）
        Image Rotation — Self-implemented (no OpenCV)
        
        参数 Parameters:
            图像: 输入图像 / Input image
            角度: 旋转角度（度）/ Rotation angle (degrees)
        
        返回 Returns:
            旋转后图像 / Rotated image
        """
        弧度 = math.radians(角度)
        余弦 = math.cos(弧度)
        正弦 = math.sin(弧度)
        
        高, 宽 = 图像.shape[:2]
        
        新宽 = int(abs(宽 * 余弦) + abs(高 * 正弦))
        新高 = int(abs(宽 * 正弦) + abs(高 * 余弦))
        
        原中心横, 原中心纵 = 宽 / 2, 高 / 2
        新中心横, 新中心纵 = 新宽 / 2, 新高 / 2
        
        if len(图像.shape) == 3:
            结果 = np.full((新高, 新宽, 图像.shape[2]), 255, dtype=图像.dtype)
        else:
            结果 = np.full((新高, 新宽), 255, dtype=图像.dtype)
        
        for 新纵 in range(新高):
            for 新横 in range(新宽):
                原横 = int((新横 - 新中心横) * 余弦 + (新纵 - 新中心纵) * 正弦 + 原中心横)
                原纵 = int(-(新横 - 新中心横) * 正弦 + (新纵 - 新中心纵) * 余弦 + 原中心纵)
                
                if 0 <= 原横 < 宽 and 0 <= 原纵 < 高:
                    结果[新纵, 新横] = 图像[原纵, 原横]
        
        return 结果
    
    def 倾斜校正(self, 二值图: np.ndarray) -> np.ndarray:
        """
        🟢 倾斜校正 — 基于投影的自己实现
        Skew Correction — Self-implemented projection-based method
        
        通过旋转投影寻找最佳角度 / Find optimal angle by rotating projection
        
        参数 Parameters:
            二值图: 二值图像 / Binary image
        
        返回 Returns:
            校正后图像 / Corrected image
        """
        最佳角度 = 0
        最大投影差 = 0
        
        for 角度 in range(-15, 16):
            旋转图 = self.旋转图像(二值图, 角度)
            投影 = np.sum(旋转图 < 128, axis=1)
            差分 = np.diff(投影)
            方差 = np.var(差分)
            
            if 方差 > 最大投影差:
                最大投影差 = 方差
                最佳角度 = 角度
        
        if 最佳角度 != 0:
            校正图 = self.旋转图像(二值图, 最佳角度)
            日志.info(f"🟢 倾斜校正 / Skew corrected: {最佳角度}°")
            return 校正图
        
        return 二值图
    
    def 预处理(self, 图像: np.ndarray) -> np.ndarray:
        """
        🟢 完整预处理流程 / Complete preprocessing pipeline
        
        步骤 Steps:
            1. 灰度转换 / Grayscale conversion
            2. 中值滤波去噪 / Median filter denoising
            3. OTSU二值化 / OTSU binarization
            4. 倾斜校正 / Skew correction
        
        参数 Parameters:
            图像: 输入图像 / Input image
        
        返回 Returns:
            预处理后二值图像 / Preprocessed binary image
        """
        日志.info("🟢 开始图像预处理 / Starting image preprocessing...")
        
        灰度 = self.转灰度(图像)
        日志.debug("  Step 1/4: 灰度转换完成 / Grayscale done")
        
        去噪 = self.中值滤波(灰度, 核大小=3)
        日志.debug("  Step 2/4: 中值滤波完成 / Median filter done")
        
        二值 = self.OTSU二值化(去噪)
        日志.debug("  Step 3/4: OTSU二值化完成 / OTSU done")
        
        校正 = self.倾斜校正(二值)
        日志.debug("  Step 4/4: 倾斜校正完成 / Skew correction done")
        
        日志.info("🟢 预处理完成 / Preprocessing complete")
        return 校正


# ═══════════════════════════════════════════════════════════════════════
# 中文文本区域检测器 / Chinese Text Region Detector
# ═══════════════════════════════════════════════════════════════════════
class 文本区域检测器:
    """
    🟢 中文文本区域检测器 — 基于笔画密度的自己实现
    Chinese Text Region Detector — Self-implemented stroke-density based
    
    不依赖OpenCV高级API，使用基于笔画密度的投影分析
    No OpenCV advanced APIs; uses stroke-density projection analysis
    """
    
    def __init__(self, 最小区域宽: int = 8, 最小区域高: int = 8, 
                 最小笔画密度: float = 0.05):
        """
        参数 Parameters:
            最小区域宽: 最小文本区域宽度 / Min region width
            最小区域高: 最小文本区域高度 / Min region height
            最小笔画密度: 最小笔画密度阈值 / Min stroke density threshold
        """
        self.最小区域宽 = 最小区域宽
        self.最小区域高 = 最小区域高
        self.最小笔画密度 = 最小笔画密度
        self.审计状态 = "🟢"
    
    def 计算笔画密度图(self, 二值图: np.ndarray, 窗口大小: int = 5) -> np.ndarray:
        """
        🟢 计算笔画密度图 / Calculate stroke density map
        
        通过局部窗口内黑色像素密度估算笔画密度
        Estimate stroke density via local black pixel density
        
        参数 Parameters:
            二值图: 二值图像（黑=文字，白=背景）/ Binary image
            窗口大小: 局部密度估计窗口 / Local density window
        
        返回 Returns:
            笔画密度图 [0,1] / Stroke density map
        """
        高, 宽 = 二值图.shape
        密度图 = np.zeros((高, 宽), dtype=np.float32)
        
        文字掩码 = (二值图 < 128).astype(np.float32)
        
        边距 = 窗口大小 // 2
        
        for 纵 in range(边距, 高 - 边距):
            for 横 in range(边距, 宽 - 边距):
                窗口 = 文字掩码[纵-边距:纵+边距+1, 横-边距:横+边距+1]
                密度图[纵, 横] = np.mean(窗口)
        
        return 密度图
    
    def 水平投影分割(self, 二值图: np.ndarray) -> List[Tuple[int, int]]:
        """
        🟢 基于水平投影的行分割 / Row segmentation via horizontal projection
        
        参数 Parameters:
            二值图: 二值图像 / Binary image
        
        返回 Returns:
            行区域列表 [(起始纵, 结束纵), ...] / Row regions
        """
        高 = 二值图.shape[0]
        文字掩码 = (二值图 < 128).astype(np.int32)
        
        水平投影 = np.sum(文字掩码, axis=1)
        
        行列表 = []
        在行中 = False
        行起始 = 0
        
        for 纵 in range(高):
            if 水平投影[纵] > 0 and not 在行中:
                在行中 = True
                行起始 = 纵
            elif 水平投影[纵] == 0 and 在行中:
                在行中 = False
                if 纵 - 行起始 >= self.最小区域高:
                    行列表.append((行起始, 纵))
        
        if 在行中 and 高 - 行起始 >= self.最小区域高:
            行列表.append((行起始, 高))
        
        return 行列表
    
    def 垂直投影分割(self, 行图像: np.ndarray) -> List[Tuple[int, int]]:
        """
        🟢 基于垂直投影的字符分割 / Character segmentation via vertical projection
        
        参数 Parameters:
            行图像: 单行图像 / Single line image
        
        返回 Returns:
            字符区域列表 [(起始横, 结束横), ...] / Character regions
        """
        宽 = 行图像.shape[1]
        文字掩码 = (行图像 < 128).astype(np.int32)
        
        垂直投影 = np.sum(文字掩码, axis=0)
        
        字符列表 = []
        在字符中 = False
        字符起始 = 0
        
        for 横 in range(宽):
            if 垂直投影[横] > 0 and not 在字符中:
                在字符中 = True
                字符起始 = 横
            elif 垂直投影[横] == 0 and 在字符中:
                在字符中 = False
                if 横 - 字符起始 >= self.最小区域宽:
                    字符列表.append((字符起始, 横))
        
        if 在字符中 and 宽 - 字符起始 >= self.最小区域宽:
            字符列表.append((字符起始, 宽))
        
        return 字符列表
    
    def 检测文本区域(self, 二值图: np.ndarray) -> List[区域框]:
        """
        🟢 主检测函数：检测所有文本区域
        Main detection function: detect all text regions
        
        算法步骤 / Algorithm:
            1. 计算笔画密度图 / Calculate stroke density
            2. 水平投影分割行 / Horizontal projection for rows
            3. 垂直投影分割字符 / Vertical projection for characters
            4. 过滤噪声区域 / Filter noise regions
        
        参数 Parameters:
            二值图: 二值图像 / Binary image
        
        返回 Returns:
            文本区域框列表 / List of text region boxes
        """
        日志.info("🟢 开始文本区域检测 / Starting text region detection...")
        
        密度图 = self.计算笔画密度图(二值图)
        
        行区域 = self.水平投影分割(二值图)
        日志.info(f"  检测到 {len(行区域)} 个文本行 / {len(行区域)} text rows detected")
        
        所有区域 = []
        for 行索引, (行起始, 行结束) in enumerate(行区域):
            行图像 = 二值图[行起始:行结束, :]
            字符区域 = self.垂直投影分割(行图像)
            
            for 字符起始, 字符结束 in 字符区域:
                区域密度图 = 密度图[行起始:行结束, 字符起始:字符结束]
                平均密度 = np.mean(区域密度图)
                
                if 平均密度 >= self.最小笔画密度:
                    区域 = 区域框(
                        左上横=字符起始,
                        左上纵=行起始,
                        右下横=字符结束,
                        右下纵=行结束,
                        置信度=min(1.0, 平均密度 * 2),
                        文本=""
                    )
                    所有区域.append(区域)
        
        日志.info(f"🟢 文本区域检测完成：{len(所有区域)} 个区域 / Text detection done: {len(所有区域)} regions")
        return 所有区域


# ═══════════════════════════════════════════════════════════════════════
# 中文字符特征提取器 / Chinese Character Feature Extractor
# ═══════════════════════════════════════════════════════════════════════
class 字符特征提取器:
    """
    🟢 中文字符特征提取器 — 核心中文算法
    Chinese Character Feature Extractor — Core Chinese Algorithm
    
    提取笔画密度、结构特征、字形特征
    Extract stroke density, structure features, glyph features
    """
    
    def __init__(self):
        self.版本 = "1.0"
        self.审计状态 = "🟢"
        self.部首模板 = self._初始化部首模板()
    
    def _初始化部首模板(self) -> Dict[str, Dict[str, Any]]:
        """初始化常见部首特征模板 / Initialize radical feature templates"""
        return {
            "氵": {"点数": 3, "位置": "左", "类型": "偏旁"},
            "艹": {"横数": 2, "位置": "上", "类型": "偏旁"},
            "扌": {"横竖交": True, "位置": "左", "类型": "偏旁"},
            "口": {"包围度": 0.8, "位置": "变", "类型": "偏旁"},
            "亻": {"竖为主": True, "位置": "左", "类型": "偏旁"},
            "木": {"交叉": True, "位置": "变", "类型": "偏旁"},
            "纟": {"折线": True, "位置": "左", "类型": "偏旁"},
            "讠": {"点横": True, "位置": "左", "类型": "偏旁"},
        }
    
    def 提取笔画密度(self, 字符图: np.ndarray) -> Dict[str, float]:
        """
        🟢 提取笔画密度特征 / Extract stroke density features
        
        分析字符图像中笔画的分布密度
        Analyze stroke distribution density in character image
        
        参数 Parameters:
            字符图: 单字符二值图像 / Single character binary image
        
        返回 Returns:
            密度特征字典 / Density feature dictionary
        """
        高, 宽 = 字符图.shape[:2]
        文字像素 = (字符图 < 128)
        总文字像素 = np.sum(文字像素)
        总像素 = 高 * 宽
        
        if 总文字像素 == 0:
            return {"总密度": 0.0, "上密度": 0.0, "中密度": 0.0, "下密度": 0.0,
                    "左密度": 0.0, "中密度横": 0.0, "右密度": 0.0, "均匀度": 0.0}
        
        总密度 = 总文字像素 / 总像素
        
        上密度 = np.sum(文字像素[:高//3, :]) / (总像素 // 3) if 高 >= 3 else 0
        中密度 = np.sum(文字像素[高//3:2*高//3, :]) / (总像素 // 3) if 高 >= 3 else 0
        下密度 = np.sum(文字像素[2*高//3:, :]) / (总像素 // 3) if 高 >= 3 else 0
        
        左密度 = np.sum(文字像素[:, :宽//3]) / (总像素 // 3) if 宽 >= 3 else 0
        中密度横 = np.sum(文字像素[:, 宽//3:2*宽//3]) / (总像素 // 3) if 宽 >= 3 else 0
        右密度 = np.sum(文字像素[:, 2*宽//3:]) / (总像素 // 3) if 宽 >= 3 else 0
        
        水平差异 = abs(上密度 - 中密度) + abs(中密度 - 下密度) + abs(上密度 - 下密度)
        垂直差异 = abs(左密度 - 中密度横) + abs(中密度横 - 右密度) + abs(左密度 - 右密度)
        均匀度 = max(0.0, 1.0 - (水平差异 + 垂直差异) / 6.0)
        
        return {
            "总密度": round(总密度, 4),
            "上密度": round(上密度, 4),
            "中密度": round(中密度, 4),
            "下密度": round(下密度, 4),
            "左密度": round(左密度, 4),
            "中密度横": round(中密度横, 4),
            "右密度": round(右密度, 4),
            "均匀度": round(均匀度, 4),
        }
    
    def 分析结构(self, 字符图: np.ndarray) -> 字符结构:
        """
        🟢 分析字符结构（左右/上下/包围/独体）
        Analyze character structure (left-right/top-bottom/enclosure/single)
        
        基于笔画密度分布的结构分类 / Structure classification based on density distribution
        
        参数 Parameters:
            字符图: 单字符二值图像 / Single character binary image
        
        返回 Returns:
            字符结构枚举 / Character structure enum
        """
        高, 宽 = 字符图.shape[:2]
        if 高 < 3 or 宽 < 3:
            return 字符结构.未知
        
        文字像素 = (字符图 < 128).astype(np.float32)
        
        左密度 = np.mean(文字像素[:, :宽//2])
        右密度 = np.mean(文字像素[:, 宽//2:])
        
        上密度 = np.mean(文字像素[:高//2, :])
        下密度 = np.mean(文字像素[高//2:, :])
        
        中密度 = np.mean(文字像素[高//4:3*高//4, 宽//4:3*宽//4])
        
        上边密度 = np.mean(文字像素[0:高//4, :])
        下边密度 = np.mean(文字像素[3*高//4:, :])
        左边密度 = np.mean(文字像素[:, 0:宽//4])
        右边密度 = np.mean(文字像素[:, 3*宽//4:])
        
        左右差异 = abs(左密度 - 右密度) / max(左密度 + 右密度, 1e-6)
        上下差异 = abs(上密度 - 下密度) / max(上密度 + 下密度, 1e-6)
        
        边缘密度 = (上边密度 + 下边密度 + 左边密度 + 右边密度) / 4
        包围度 = 边缘密度 / max(中密度, 1e-6) if 中密度 > 1e-6 else 0
        
        if 包围度 > 1.5 and 边缘密度 > 0.05:
            if min(上边密度, 左边密度) > max(下边密度, 右边密度) * 2:
                return 字符结构.半包围
            return 字符结构.包围
        
        if 左右差异 > 0.3 and 左右差异 > 上下差异:
            return 字符结构.左右
        
        if 上下差异 > 0.3:
            return 字符结构.上下
        
        if max(左右差异, 上下差异) < 0.15:
            return 字符结构.独体
        
        return 字符结构.未知
    
    def 简易骨架化(self, 二值图: np.ndarray) -> np.ndarray:
        """
        🟢 简易骨架化算法 / Simplified skeletonization
        
        使用距离变换近似骨架 / Use distance transform approximation
        
        参数 Parameters:
            二值图: 二值图像 / Binary image
        
        返回 Returns:
            骨架图像 / Skeleton image
        """
        if SCIPY可用:
            距离 = ndimage.distance_transform_edt(二值图)
            局部极大 = ndimage.maximum_filter(距离, size=3) == 距离
            骨架 = (局部极大 & (二值图 > 0)).astype(np.uint8)
            return 骨架
        else:
            # 替代方案：迭代腐蚀 / Alternative: iterative erosion
            骨架 = 二值图.copy()
            return骨架
    
    def 检测端点(self, 骨架: np.ndarray) -> List[Tuple[int, int]]:
        """
        🟢 检测骨架端点 / Detect skeleton endpoints
        
        端点 = 只有一个邻居的像素
        Endpoint = pixel with only one neighbor
        
        参数 Parameters:
            骨架: 骨架图像 / Skeleton image
        
        返回 Returns:
            端点坐标列表 / Endpoint coordinates
        """
        高, 宽 = 骨架.shape
        端点 = []
        
        for 纵 in range(1, 高 - 1):
            for 横 in range(1, 宽 - 1):
                if 骨架[纵, 横] > 0:
                    邻居 = np.sum(骨架[纵-1:纵+2, 横-1:横+2]) - 1
                    if 邻居 == 1:
                        端点.append((横, 纵))
        
        return 端点
    
    def 检测交叉点(self, 骨架: np.ndarray) -> List[Tuple[int, int]]:
        """
        🟢 检测骨架交叉点 / Detect skeleton crossing points
        
        交叉点 = 有3个或以上邻居的像素
        Crossing = pixel with 3+ neighbors
        
        参数 Parameters:
            骨架: 骨架图像 / Skeleton image
        
        返回 Returns:
            交叉点坐标列表 / Crossing coordinates
        """
        高, 宽 = 骨架.shape
        交叉点 = []
        
        for 纵 in range(1, 高 - 1):
            for 横 in range(1, 宽 - 1):
                if 骨架[纵, 横] > 0:
                    邻居 = np.sum(骨架[纵-1:纵+2, 横-1:横+2]) - 1
                    if 邻居 >= 3:
                        交叉点.append((横, 纵))
        
        return 交叉点
    
    def 提取笔画特征(self, 字符图: np.ndarray) -> Dict[str, Any]:
        """
        🟢 提取笔画级特征（端点、交叉点、转折点）
        Extract stroke-level features (endpoints, crossings, turning points)
        
        参数 Parameters:
            字符图: 单字符二值图像 / Single character binary image
        
        返回 Returns:
            笔画特征字典 / Stroke feature dictionary
        """
        文字像素 = (字符图 < 128).astype(np.uint8)
        
        骨架 = self.简易骨架化(文字像素)
        
        端点 = self.检测端点(骨架)
        
        交叉点 = self.检测交叉点(骨架)
        
        笔画数 = len(端点) // 2 + len(交叉点)
        
        return {
            "端点数": len(端点),
            "交叉点数": len(交叉点),
            "估计笔画数": max(笔画数, 1),
            "端点位置": 端点[:10],  # 只保留前10个
            "交叉位置": 交叉点[:10],
        }
    
    def 提取全部特征(self, 字符图: np.ndarray) -> Dict[str, Any]:
        """
        🟢 提取字符全部特征 / Extract all character features
        
        参数 Parameters:
            字符图: 单字符图像 / Single character image
        
        返回 Returns:
            完整特征字典 / Complete feature dictionary
        """
        日志.debug("  提取字符特征... / Extracting character features...")
        
        密度特征 = self.提取笔画密度(字符图)
        结构 = self.分析结构(字符图)
        笔画特征 = self.提取笔画特征(字符图)
        
        return {
            "密度特征": 密度特征,
            "结构": 结构.value,
            "笔画特征": 笔画特征,
            "尺寸": {"高": 字符图.shape[0], "宽": 字符图.shape[1]},
        }


# ═══════════════════════════════════════════════════════════════════════
# 龍字专用检测器 / Dragon Character (龍) Specialized Detector
# ═══════════════════════════════════════════════════════════════════════
class 龍字检测器:
    """
    🟢 繁体“龍”字专用检测器
    Traditional "龍" (Dragon) Character Specialized Detector
    
    基于龍字独特结构特征的模式识别：
    - 左上角“立”部 / Top-left "立" radical
    - 右侧弯曲龍身 / Right-side curved body
    - 底部三点或弯钩 / Bottom dots or hook
    - 整体左右结构 / Overall left-right structure
    
    Pattern recognition based on 龍's unique structural features
    """
    
    def __init__(self):
        self.版本 = "1.0"
        self.审计状态 = "🟢"
        self.标准笔画数 = 16
        self.标准密度模式 = {
            "左上高": True,
            "右下弯": True,
            "中间空": True,
        }
    
    def 检测(self, 字符图: np.ndarray) -> Dict[str, Any]:
        """
        🟢 检测是否为龍字 / Detect if character is 龍
        
        参数 Parameters:
            字符图: 单字符图像 / Single character image
        
        返回 Returns:
            检测结果字典 / Detection result dictionary
        """
        高, 宽 = 字符图.shape[:2]
        if 高 < 8 or 宽 < 8:
            return {"是龍字": False, "置信度": 0.0, "原因": "图像太小 / Image too small"}
        
        文字像素 = (字符图 < 128).astype(np.float32)
        
        结构 = self._分析结构(文字像素, 高, 宽)
        密度匹配 = self._匹配密度模式(文字像素, 高, 宽)
        端点模式 = self._分析端点模式(文字像素, 高, 宽)
        
        综合置信度 = (
            结构 * 0.35 +
            密度匹配 * 0.35 +
            端点模式 * 0.30
        )
        
        结果 = {
            "是龍字": 综合置信度 > 0.6,
            "置信度": round(min(1.0, 综合置信度), 4),
            "结构分数": round(结构, 4),
            "密度分数": round(密度匹配, 4),
            "端点分数": round(端点模式, 4),
            "详细分析": self._生成详细分析(结构, 密度匹配, 端点模式)
        }
        
        return 结果
    
    def _分析结构(self, 文字像素: np.ndarray, 高: int, 宽: int) -> float:
        """分析龍字结构特征 / Analyze 龍 character structure"""
        左密度 = np.mean(文字像素[:, :宽//2])
        右密度 = np.mean(文字像素[:, 宽//2:])
        
        上密度 = np.mean(文字像素[:高//2, :])
        下密度 = np.mean(文字像素[高//2:, :])
        
        上下比 = 上密度 / max(下密度, 1e-6)
        左右比 = 右密度 / max(左密度, 1e-6)
        
        结构分 = 0.0
        if 1.0 <= 上下比 <= 2.0:
            结构分 += 0.5
        if 0.8 <= 左右比 <= 1.8:
            结构分 += 0.5
        
        return 结构分
    
    def _匹配密度模式(self, 文字像素: np.ndarray, 高: int, 宽: int) -> float:
        """匹配龍字密度模式 / Match 龍 density pattern"""
        左上 = np.mean(文字像素[:高//2, :宽//2])
        右上 = np.mean(文字像素[:高//2, 宽//2:])
        左下 = np.mean(文字像素[高//2:, :宽//2])
        右下 = np.mean(文字像素[高//2:, 宽//2:])
        
        分数 = 0.0
        
        if 左上 > 0.1:
            分数 += 0.25
        if 右下 > 0.05:
            分数 += 0.25
        
        中密度 = np.mean(文字像素[高//3:2*高//3, 宽//3:2*宽//3])
        if 中密度 < (左上 + 右上) / 2:
            分数 += 0.25
        
        总密度 = np.mean(文字像素)
        if 0.05 <= 总密度 <= 0.35:
            分数 += 0.25
        
        return 分数
    
    def _分析端点模式(self, 文字像素: np.ndarray, 高: int, 宽: int) -> float:
        """分析端点分布模式 / Analyze endpoint distribution"""
        if SCIPY可用:
            距离 = ndimage.distance_transform_edt(文字像素)
            局部极大 = ndimage.maximum_filter(距离, size=3) == 距离
            骨架 = (局部极大 & (文字像素 > 0)).astype(np.uint8)
        else:
            骨架 = 文字像素.astype(np.uint8)
        
        提取器 = 字符特征提取器()
        端点 = 提取器.检测端点(骨架)
        
        端点数 = len(端点)
        if 8 <= 端点数 <= 14:
            return 1.0
        elif 6 <= 端点数 <= 16:
            return 0.7
        elif 4 <= 端点数 <= 18:
            return 0.4
        else:
            return 0.1
    
    def _生成详细分析(self, 结构: float, 密度: float, 端点: float) -> str:
        """生成详细分析文本 / Generate detailed analysis text"""
        分析 = []
        if 结构 > 0.5:
            分析.append("结构匹配 / Structure match")
        else:
            分析.append("结构不匹配 / Structure mismatch")
        
        if 密度 > 0.5:
            分析.append("密度模式匹配 / Density match")
        else:
            分析.append("密度模式不匹配 / Density mismatch")
        
        if 端点 > 0.5:
            分析.append("端点模式匹配 / Endpoint match")
        else:
            分析.append("端点模式不匹配 / Endpoint mismatch")
        
        return "; ".join(分析)


# ═══════════════════════════════════════════════════════════════════════
# 甲骨文字符分类器 / Oracle Bone Character Classifier
# ═══════════════════════════════════════════════════════════════════════
class 甲骨文分类器:
    """
    🟢 甲骨文字符分类器 — 基于笔画数的特征分类
    Oracle Bone Character Classifier — Stroke-count based feature classification
    
    甲骨文特征：
    - 笔画细长、角度分明 / Thin strokes, distinct angles
    - 多直线、少曲线 / More straight lines, fewer curves
    - 结构不对称 / Asymmetric structure
    - 笔画数一般较少 / Generally fewer strokes
    """
    
    def __init__(self):
        self.版本 = "1.0"
        self.审计状态 = "🟢"
        
        self.分类阈值 = {
            "极简": (1, 3),
            "简单": (4, 6),
            "中等": (7, 10),
            "复杂": (11, 15),
            "极复杂": (16, 25),
        }
    
    def 分类(self, 字符图: np.ndarray) -> Dict[str, Any]:
        """
        🟢 对字符进行甲骨文特征分类 / Classify character with oracle bone features
        
        参数 Parameters:
            字符图: 单字符图像 / Single character image
        
        返回 Returns:
            分类结果字典 / Classification result
        """
        高, 宽 = 字符图.shape[:2]
        if 高 < 4 or 宽 < 4:
            return {"类别": "未知", "置信度": 0.0, "原因": "图像太小"}
        
        文字像素 = (字符图 < 128).astype(np.float32)
        
        笔画数 = self._估算笔画数(文字像素, 高, 宽)
        直线度 = self._分析直线度(文字像素, 高, 宽)
        对称度 = self._分析对称度(文字像素, 高, 宽)
        密度特征 = self._分析密度特征(文字像素, 高, 宽)
        
        甲骨文分数 = (
            self._笔画分数(笔画数) * 0.30 +
            直线度 * 0.25 +
            (1.0 - 对称度) * 0.25 +
            密度特征 * 0.20
        )
        
        类别 = self._笔画数分类(笔画数)
        
        return {
            "类别": 类别,
            "甲骨文相似度": round(min(1.0, 甲骨文分数), 4),
            "笔画数": 笔画数,
            "直线度": round(直线度, 4),
            "不对称度": round(1.0 - 对称度, 4),
            "是甲骨文": 甲骨文分数 > 0.55,
            "置信度": round(min(1.0, 甲骨文分数), 4),
        }
    
    def _估算笔画数(self, 文字像素: np.ndarray, 高: int, 宽: int) -> int:
        """估算字符笔画数 / Estimate character stroke count"""
        if SCIPY可用:
            距离 = ndimage.distance_transform_edt(文字像素)
            局部极大 = ndimage.maximum_filter(距离, size=3) == 距离
            骨架 = (局部极大 & (文字像素 > 0)).astype(np.uint8)
        else:
            骨架 = 文字像素.astype(np.uint8)
        
        提取器 = 字符特征提取器()
        端点 = 提取器.检测端点(骨架)
        交叉 = 提取器.检测交叉点(骨架)
        
        笔画 = max(1, len(端点) // 2 + len(交叉) + 1)
        return min(笔画, 25)
    
    def _分析直线度(self, 文字像素: np.ndarray, 高: int, 宽: int) -> float:
        """分析笔画直线程度 / Analyze stroke straightness"""
        if SCIPY可用:
            距离 = ndimage.distance_transform_edt(文字像素)
            局部极大 = ndimage.maximum_filter(距离, size=3) == 距离
            骨架 = (局部极大 & (文字像素 > 0)).astype(np.uint8)
        else:
            骨架 = 文字像素.astype(np.uint8)
        
        骨架点 = np.argwhere(骨架 > 0)
        if len(骨架点) < 10:
            return 0.5
        
        方向变化 = 0
        总方向 = 0
        
        for 纵, 横 in 骨架点[:100]:
            if 纵 <= 0 or 纵 >= 高 - 1 or 横 <= 0 or 横 >= 宽 - 1:
                continue
            邻居 = 骨架[纵-1:纵+2, 横-1:横+2]
            邻居点 = np.argwhere(邻居 > 0)
            if len(邻居点) >= 2:
                方向差 = np.std(邻居点[:, 0]) + np.std(邻居点[:, 1])
                方向变化 += 方向差
                总方向 += 1
        
        if 总方向 == 0:
            return 0.5
        
        平均变化 = 方向变化 / 总方向
        直线度 = max(0.0, 1.0 - 平均变化 / 3.0)
        return 直线度
    
    def _分析对称度(self, 文字像素: np.ndarray, 高: int, 宽: int) -> float:
        """分析字符对称程度 / Analyze character symmetry"""
        左半 = 文字像素[:, :宽//2]
        右半 = np.fliplr(文字像素[:, 宽//2 + 宽 % 2:])
        
        if 左半.shape[1] != 右半.shape[1]:
            最小宽 = min(左半.shape[1], 右半.shape[1])
            左半 = 左半[:, :最小宽]
            右半 = 右半[:, :最小宽]
        
        水平对称 = 1.0 - np.mean(np.abs(左半 - 右半))
        
        上半 = 文字像素[:高//2, :]
        下半 = np.flipud(文字像素[高//2 + 高 % 2:, :])
        
        if 上半.shape[0] != 下半.shape[0]:
            最小高 = min(上半.shape[0], 下半.shape[0])
            上半 = 上半[:最小高, :]
            下半 = 下半[:最小高, :]
        
        垂直对称 = 1.0 - np.mean(np.abs(上半 - 下半))
        
        return (水平对称 + 垂直对称) / 2.0
    
    def _分析密度特征(self, 文字像素: np.ndarray, 高: int, 宽: int) -> float:
        """分析密度特征 / Analyze density features"""
        总密度 = np.mean(文字像素)
        
        密度分 = 0.0
        if 0.03 <= 总密度 <= 0.25:
            密度分 = 1.0
        elif 0.01 <= 总密度 <= 0.35:
            密度分 = 0.6
        else:
            密度分 = 0.2
        
        四分区 = [
            np.mean(文字像素[:高//2, :宽//2]),
            np.mean(文字像素[:高//2, 宽//2:]),
            np.mean(文字像素[高//2:, :宽//2]),
            np.mean(文字像素[高//2:, 宽//2:]),
        ]
        不均匀度 = np.std(四分区)
        不均分 = min(1.0, 不均匀度 * 5.0)
        
        return 密度分 * 0.6 + 不均分 * 0.4
    
    def _笔画分数(self, 笔画数: int) -> float:
        """根据笔画数计算甲骨文相似分数 / Score based on stroke count"""
        if 1 <= 笔画数 <= 6:
            return 1.0
        elif 7 <= 笔画数 <= 10:
            return 0.7
        elif 11 <= 笔画数 <= 15:
            return 0.4
        else:
            return 0.2
    
    def _笔画数分类(self, 笔画数: int) -> str:
        """根据笔画数分类 / Classify by stroke count"""
        for 类别, (最小, 最大) in self.分类阈值.items():
            if 最小 <= 笔画数 <= 最大:
                return 类别
        return "未知"


# ═══════════════════════════════════════════════════════════════════════
# Tesseract国际兜底引擎 / Tesseract International Fallback Engine
# ═══════════════════════════════════════════════════════════════════════
class 国际兜底引擎:
    """
    🟡 Tesseract OCR国际兜底引擎
    Tesseract OCR International Fallback Engine
    
    当中文算法置信度 < 0.7 时自动降级
    Auto-fallback when Chinese algorithm confidence < 0.7
    """
    
    def __init__(self):
        self.版本 = "1.0"
        self.可用 = TESSERACT可用
        self.审计状态 = "🟢" if self.可用 else "🔴"
        
        if self.可用:
            self.语言配置 = 'chi_sim+chi_tra+eng'
            self._配置Tesseract()
    
    def _配置Tesseract(self):
        """配置Tesseract参数 / Configure Tesseract parameters"""
        可能路径 = [
            '/usr/bin/tesseract',
            '/usr/local/bin/tesseract',
            '/opt/homebrew/bin/tesseract',
            'C:\\Program Files\\Tesseract-OCR\\tesseract.exe',
        ]
        for 路径 in 可能路径:
            if os.path.exists(路径):
                pytesseract.pytesseract.tesseract_cmd = 路径
                日志.info(f"🟢 Tesseract路径 / Path: {路径}")
                break
    
    def 识别(self, 图像数组: np.ndarray, 语言: str | None = None) -> 识别结果:
        """
        🟡 使用Tesseract进行OCR识别 / OCR recognition using Tesseract
        
        参数 Parameters:
            图像数组: 输入图像数组 / Input image array
            语言: 语言配置 / Language config
        
        返回 Returns:
            识别结果 / Recognition result
        """
        if not self.可用:
            return 识别结果(
                文本="",
                置信度=0.0,
                审计="🔴",
                备注="Tesseract未安装 / Tesseract not installed",
                引擎来源="Tesseract(不可用)"
            )
        
        try:
            if len(图像数组.shape) == 2:
                PIL图像 = Image.fromarray(图像数组)
            else:
                PIL图像 = Image.fromarray(图像数组.astype(np.uint8))
            
            语言配置 = 语言 or self.语言配置
            
            配置 = f'--oem 3 --psm 6 -l {语言配置}'
            文本 = pytesseract.image_to_string(PIL图像, config=配置)
            
            数据 = pytesseract.image_to_data(PIL图像, config=配置, output_type=pytesseract.Output.DICT)
            
            置信度列表 = [c for c in 数据.get('conf', []) if isinstance(c, (int, float)) and c > 0]
            平均置信度 = np.mean(置信度列表) / 100.0 if 置信度列表 else 0.5
            
            区域列表 = []
            for i in range(len(数据.get('text', []))):
                if 数据['text'][i].strip():
                    区域 = {
                        'x': 数据['left'][i],
                        'y': 数据['top'][i],
                        '宽': 数据['width'][i],
                        '高': 数据['height'][i],
                        '文本': 数据['text'][i],
                        '置信度': 数据['conf'][i] / 100.0 if isinstance(数据['conf'][i], (int, float)) else 0.0
                    }
                    区域列表.append(区域)
            
            日志.info(f"🟡 Tesseract识别完成 / Recognition done: conf={平均置信度:.3f}")
            
            return 识别结果(
                文本=文本.strip(),
                置信度=min(1.0, 平均置信度),
                区域=区域列表,
                审计="🟡",
                备注="Tesseract国际兜底 / Tesseract fallback",
                引擎来源="Tesseract"
            )
        
        except Exception as 错误:
            日志.error(f"🔴 Tesseract识别失败 / Recognition failed: {错误}")
            return 识别结果(
                文本="",
                置信度=0.0,
                审计="🔴",
                备注=f"Tesseract错误: {str(错误)}",
                引擎来源="Tesseract(错误)"
            )


