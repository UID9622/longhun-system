#!/usr/bin/env bash
# 自动等待 updater 完成，然后运行 index 和 git commit
set -euo pipefail
BASE=/Users/zuimeidedeyihan/longhun-system/notion_absorb
LOG="$BASE/logs/auto_finish.log"
log() { echo "[$(date -u +%Y-%m-%dT%H:%M:%SZ)] $1" | tee -a "$LOG"; }

log "等待 updater 完成..."
while pgrep -f "core/updater.py" >/dev/null; do
  sleep 30
done

# 再检查一下是否还有 skipped
remaining=$(python3 -c "import json; d=json.load(open('$BASE/data/progress/update_progress.json')); print(len(d['skipped']))")
log "updater 结束，剩余 skipped: $remaining"

if [ "$remaining" -gt 0 ]; then
  log "还有未处理页面，重新启动 updater"
  nohup python3 "$BASE/core/updater.py" >> "$BASE/logs/updater.log" 2>&1 &
  exit 0
fi

log "启动 index builder"
python3 "$BASE/build_notion_knowledge_index.py" >> "$BASE/logs/index.log" 2>&1

log "全部完成"
echo "DONE" > "$BASE/data/ALL_DONE"
