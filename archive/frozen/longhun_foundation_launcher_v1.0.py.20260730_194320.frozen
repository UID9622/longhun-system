# ═══════════════════════════════════════════════════════════════════════════════
# 三色审计系统 / Three-Color Audit System
# ═══════════════════════════════════════════════════════════════════════════════

class AuditColor(Enum):
    """三色审计标记 / Tricolor Audit Markers"""
    GREEN = "🟢通过"    # conf ≥ 0.85 - Passed
    YELLOW = "🟡警告"   # 0.60 ≤ conf < 0.85 - Warning
    RED = "🔴阻断"      # conf < 0.60 - Blocked


class AuditRecord:
    """审计记录 / Audit Record - 单条审计记录"""

    def __init__(self, module: str, check: str, color: AuditColor,
                 confidence: float, message: str, timestamp: str = None):
        self.module = module        # 被审计模块 / Audited module
        self.check = check          # 检查项 / Check item
        self.color = color          # 审计颜色 / Audit color
        self.confidence = confidence  # 置信度 / Confidence score
        self.message = message      # 审计信息 / Audit message
        self.timestamp = timestamp or datetime.now().isoformat()

    def to_dict(self) -> Dict[str, Any]:
        return {
            "模块": self.module,
            "检查项": self.check,
            "结果": self.color.value,
            "置信度": round(self.confidence, 4),
            "信息": self.message,
            "时间戳": self.timestamp
        }


class ThreeColorAudit:
    """
    三色审计系统 / Three-Color Audit System
    🟢 通过(conf≥0.85) · 🟡 警告(0.60≤conf<0.85) · 🔴 阻断(conf<0.60)
    Three-Color Audit: Green(pass) · Yellow(warn) · Red(block)
    """

    def __init__(self):
        self.records: List[AuditRecord] = []
        self.stats = {AuditColor.GREEN: 0, AuditColor.YELLOW: 0, AuditColor.RED: 0}

    def record(self, module: str, check: str, confidence: float,
               message: str) -> AuditColor:
        """记录审计结果 / Record audit result"""
        if confidence >= 0.85:
            color = AuditColor.GREEN
        elif confidence >= 0.60:
            color = AuditColor.YELLOW
        else:
            color = AuditColor.RED

        record = AuditRecord(module, check, color, confidence, message)
        self.records.append(record)
        self.stats[color] += 1
        return color

    def summary(self) -> Dict[str, Any]:
        """生成审计摘要 / Generate audit summary"""
        total = len(self.records)
        if total == 0:
            return {"总数": 0, "状态": "未执行审计"}

        # 如果有任何🔴阻断，整体状态为阻断
        # If any RED, overall status is blocked
        if self.stats[AuditColor.RED] > 0:
            overall = AuditColor.RED
        elif self.stats[AuditColor.YELLOW] > 0:
            overall = AuditColor.YELLOW
        else:
            overall = AuditColor.GREEN

        return {
            "总数": total,
            "🟢通过": self.stats[AuditColor.GREEN],
            "🟡警告": self.stats[AuditColor.YELLOW],
            "🔴阻断": self.stats[AuditColor.RED],
            "整体状态": overall.value,
            "记录": [r.to_dict() for r in self.records]
        }


# ═══════════════════════════════════════════════════════════════════════════════
# 六层来源链 / Six-Layer Source Chain
# ═══════════════════════════════════════════════════════════════════════════════

class SourceChain:
    """
    六层来源链盖章 / Six-Layer Source Chain Stamp
    道统层→精神层→设备层→技术层→系统层→生命层
    Taoist→Spiritual→Device→Technical→System→Life
    """

    LAYERS = [
        "道统层",   # L1: Taoist Heritage - 文化根源
        "精神层",   # L2: Spiritual - 核心价值
        "设备层",   # L3: Device - 硬件环境
        "技术层",   # L4: Technical - 技术栈溯源
        "系统层",   # L5: System - 系统完整性
        "生命层"    # L6: Life - 创作者身份锚定
    ]

    def __init__(self):
        self.stamps: Dict[str, Dict[str, Any]] = {}
        self.dna_signature = ""

    def stamp(self, layer: str, data: Dict[str, Any]) -> str:
        """
        盖章 / Stamp a layer with verification data
        为指定层级盖上来源验证章
        """
        if layer not in self.LAYERS:
            raise ValueError(f"无效的来源链层级: {layer} (有效: {self.LAYERS})")

        timestamp = datetime.now().isoformat()
        stamp_data = {
            "层级": layer,
            "时间戳": timestamp,
            "数据": data,
            "验证码": self._compute_stamp_hash(layer, data, timestamp),
            "状态": "✓ 已盖章"
        }
        self.stamps[layer] = stamp_data
        return stamp_data["验证码"]

    def stamp_all(self, data_map: Dict[str, Dict[str, Any]]) -> Dict[str, str]:
        """为所有六层盖章 / Stamp all six layers"""
        results = {}
        for layer in self.LAYERS:
            layer_data = data_map.get(layer, {})
            results[layer] = self.stamp(layer, layer_data)
        return results

    def _compute_stamp_hash(self, layer: str, data: Dict[str, Any], timestamp: str) -> str:
        """计算盖章验证码 / Compute stamp verification hash"""
        payload = json.dumps({"layer": layer, "data": data, "ts": timestamp}, sort_keys=True)
        return hashlib.sha256(payload.encode('utf-8')).hexdigest()[:16]

    def verify_chain(self) -> Dict[str, Any]:
        """验证完整来源链 / Verify complete source chain"""
        results = {}
        all_valid = True
        for layer in self.LAYERS:
            if layer in self.stamps:
                stamp = self.stamps[layer]
                # 重新计算验证
                recalculated = self._compute_stamp_hash(
                    layer, stamp["数据"], stamp["时间戳"]
                )
                valid = recalculated == stamp["验证码"]
                results[layer] = {
                    "有效": valid,
                    "时间戳": stamp["时间戳"],
                    "验证码": stamp["验证码"]
                }
                if not valid:
                    all_valid = False
            else:
                results[layer] = {"有效": False, "原因": "未盖章"}
                all_valid = False

        return {"完整链有效": all_valid, "层级详情": results}


# ═══════════════════════════════════════════════════════════════════════════════
# 铁律自审闸 / Iron Law Self-Audit Gate
# ═══════════════════════════════════════════════════════════════════════════════

class IronLawGate:
    """
    铁律自审闸 / Iron Law Self-Audit Gate
    检查“龍”不得简化为简体字等核心规范
    Ensures sacred rules: “龍”must NOT be simplified
    """

    SACRED_RULES = {
        "铁律一": {
            "描述": "繁体“龍”不得使用简体替代",
            "描述_en": "Traditional '龍' must NOT use simplified variant",
            "禁止模式": ["\u9f99"],
            "严重级别": AuditColor.RED
        },
        "铁律二": {
            "描述": "DNA追溯码必须存在且格式正确",
            "描述_en": "DNA trace code must exist with correct format",
            "验证": "dna_format",
            "严重级别": AuditColor.RED
        },
        "铁律三": {
            "描述": "CNSH终端头不可删除",
            "描述_en": "CNSH terminal header must NOT be deleted",
            "验证": "cnsh_header",
            "严重级别": AuditColor.RED
        },
        "铁律四": {
            "描述": "君子协议许可必须存在",
            "描述_en": "Gentleman's Agreement license must exist",
            "验证": "license",
            "严重级别": AuditColor.YELLOW
        }
    }

    def __init__(self):
        self.violations: List[Dict[str, Any]] = []
        self.passed = True

    def audit(self, content: str, audit_system: ThreeColorAudit = None) -> Dict[str, Any]:
        """
        执行铁律自审 / Execute iron law self-audit
        检查内容是否违反任何铁律
        Check if content violates any sacred rules
        """
        self.violations = []
        self.passed = True

        # 铁律一: 检查简体龍字
        if "\u9f99" in content:
            self.violations.append({
                "铁律": "铁律一",
                "问题": "发现简体龍字，必须使用繁体“龍”",
                "位置": [i for i, ch in enumerate(content) if ch == "\u9f99"],
                "级别": AuditColor.RED.value
            })
            self.passed = False

        # 铁律二: DNA追溯码格式
        if "#龍芯⚡️" not in content and "#龍芯" not in content:
            self.violations.append({
                "铁律": "铁律二",
                "问题": "缺少DNA追溯码头部",
                "级别": AuditColor.RED.value
            })
            self.passed = False

        # 铁律三: CNSH终端头
        if "CNSH" not in content or "不可删除" not in content:
            self.violations.append({
                "铁律": "铁律三",
                "问题": "CNSH不可删除终端头缺失",
                "级别": AuditColor.RED.value
            })
            self.passed = False

        # 铁律四: 君子协议
        if "CC BY-NC-SA" not in content or "君子协议" not in content:
            self.violations.append({
                "铁律": "铁律四",
                "问题": "君子协议/CC BY-NC-SA 4.0许可缺失",
                "级别": AuditColor.YELLOW.value
            })

        result = {
            "通过": self.passed,
            "违规数": len(self.violations),
            "违规详情": self.violations,
            "检查时间": datetime.now().isoformat()
        }

        # 记录到审计系统
        if audit_system:
            conf = 1.0 if self.passed else (0.3 if any(
                v["级别"] == AuditColor.RED.value for v in self.violations
            ) else 0.7)
            audit_system.record("IronLawGate", "铁律自审", conf,
                              f"发现 {len(self.violations)} 条违规" if self.violations else "所有铁律通过")

        return result


# ═══════════════════════════════════════════════════════════════════════════════
# CNSH对齐器 / CNSH Aligner
# ═══════════════════════════════════════════════════════════════════════════════

class CNSHAligner:
    """
    CNSH四层对齐检查器 / CNSH Four-Layer Alignment Checker
    CNSH = Content Sovereignty & Native Script Header
    四层: 语法层→语义层→文化层→主权层
    Four layers: Syntax→Semantics→Culture→Sovereignty
    """

    ALIGNMENT_LAYERS = [
        "语法层",   # Syntax: Code validity
        "语义层",   # Semantics: Meaning correctness
        "文化层",   # Culture: Cultural alignment
        "主权层"    # Sovereignty: Content ownership
    ]

    def __init__(self):
        self.checks: Dict[str, Dict[str, Any]] = {}

    def check_all(self, content: str, audit_system: ThreeColorAudit = None) -> Dict[str, Any]:
        """执行四层对齐检查 / Execute four-layer alignment checks"""
        results = {}

        # L1: 语法层检查
        results["语法层"] = self._check_syntax(content)

        # L2: 语义层检查
        results["语义层"] = self._check_semantics(content)

        # L3: 文化层检查
        results["文化层"] = self._check_culture(content)

        # L4: 主权层检查
        results["主权层"] = self._check_sovereignty(content)

        # 计算整体对齐度
        scores = [r["得分"] for r in results.values()]
        overall = sum(scores) / len(scores) if scores else 0.0

        result = {
            "整体对齐度": round(overall, 4),
            "层级详情": results,
            "检查时间": datetime.now().isoformat()
        }

        if audit_system:
            for layer, detail in results.items():
                audit_system.record(
                    "CNSHAligner", f"{layer}对齐",
                    detail["得分"], detail["信息"]
                )

        return result

    def _check_syntax(self, content: str) -> Dict[str, Any]:
        """语法层检查 / Syntax layer check"""
        issues = []
        # 检查常见语法问题
        if "def init(" in content and "def __init__(" not in content:
            issues.append("发现 def init，应为 def __init__")

        score = 0.95 if not issues else 0.6
        return {
            "得分": score,
            "信息": f"语法检查: {len(issues)} 个问题" + (f" - {', '.join(issues)}" if issues else ""),
            "问题": issues
        }

    def _check_semantics(self, content: str) -> Dict[str, Any]:
        """语义层检查 / Semantics layer check"""
        issues = []
        # 检查语义一致性
        if "龍魂" in content and "\u9f99" in content:
            issues.append("语义冲突: 同时存在“龍魂”和简体龍字")

        score = 0.95 if not issues else 0.5
        return {
            "得分": score,
            "信息": f"语义检查: {'通过' if not issues else ', '.join(issues)}",
            "问题": issues
        }

    def _check_culture(self, content: str) -> Dict[str, Any]:
        """文化层检查 / Culture layer check"""
        issues = []
        # 检查文化正确性
        sacred_terms = ["龍魂", "龍芯", "道统"]
        for term in sacred_terms:
            if term not in content:
                issues.append(f"缺少文化术语: {term}")

        score = 0.95 if not issues else 0.7
        return {
            "得分": score,
            "信息": f"文化检查: {len(issues)} 个缺失" + (f" - {', '.join(issues)}" if issues else ""),
            "问题": issues
        }

    def _check_sovereignty(self, content: str) -> Dict[str, Any]:
        """主权层检查 / Sovereignty layer check"""
        issues = []
        required = ["DNA追溯", "来源链", "审计", "君子协议"]
        for req in required:
            if req not in content:
                issues.append(f"缺少主权标记: {req}")

        score = 0.95 if not issues else 0.65
        return {
            "得分": score,
            "信息": f"主权检查: {len(issues)} 个缺失" + (f" - {', '.join(issues)}" if issues else ""),
            "问题": issues
        }


