        "主权评分": {"用户付费占比": 0.0, "数据可携": 0.2, "推荐透明": 0.1, "错误责任": 0.3, "退出自由": 0.5},
        "代价评分": {"注意力税": 8, "隐私税": 7, "试错代价": 6, "环境代价": 5, "就业冲击": 5},
        "普惠评分": {"语言包容": 0.5, "学历包容": 0.6, "经济包容": 0.5, "地域包容": 0.7, "年龄包容": 0.4, "残障包容": 0.3},
