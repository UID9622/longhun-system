# ═══════════════════════════════════════════════════════════
# §1 资源稀释公平系数 · IPA-DICT-008
# ═══════════════════════════════════════════════════════════

def 算资源稀释(各方占比: Dict[str, float]) -> Dict[str, Any]:
    """
    公平系数 = 1 - (最大占比 - 平均) / 平均
    ≥0.7 🟢 · 0.5-0.7 🟡 · <0.5 🔴
    """
    if not 各方占比:
        return {"公平系数": 0, "判定": "🔴 无数据", "说明": "请输入各方资源占比"}
    
    占比值 = list(各方占比.values())
    平均 = sum(占比值) / len(占比值)
    最大 = max(占比值)
    
    if 平均 == 0:
        return {"公平系数": 0, "判定": "🔴 异常", "说明": "平均占比为零"}
    
    公平系数 = 1 - (最大 - 平均) / 平均
    公平系数 = max(0, min(1, 公平系数))
    
    if 公平系数 >= 0.7:
        判定 = "🟢 资源分布较公平"
    elif 公平系数 >= 0.5:
        判定 = "🟡 存在一定资源集中·需关注"
    else:
        判定 = "🔴 资源严重垄断·老百姓被稀释"
    
    垄断方 = max(各方占比, key=各方占比.get)
    
    return {
        "公平系数": round(公平系数, 4),
        "判定": 判定,
        "最大占比方": f"{垄断方}({最大*100:.1f}%)",
        "平均占比": f"{平均*100:.1f}%",
        "各详情": {k: f"{v*100:.1f}%" for k, v in 各方占比.items()},
        "建议": "单方占比>40%需预警" if 最大 > 0.4 else "当前分布可接受",
    }


# ═══════════════════════════════════════════════════════════
# §2 六维公平评估 · IPA-DICT-027
# ═══════════════════════════════════════════════════════════

# 六维因子 + 默认权重
FACTORS = {
    "背景压力": 0.25,  # F1: 出身/环境/起点限制
    "资源可得": 0.20,  # F2: 可获取的资源与工具
    "时间窗口": 0.15,  # F3: 决策允许的时间
    "信息完整": 0.15,  # F4: 手头信息充足度
    "底线触达": 0.15,  # F5: 底线是否被触碰（触底→直接熔断）
    "外部干扰": 0.10,  # F6: 外部干扰因素
}

def 算六维公平(评分: Dict[str, float], 权重: Optional[Dict[str, float]] = None) -> Dict[str, Any]:
    """
    SCORE = Σ(Fi × Wi)
    底线触达→直接熔断
    """
    w = 权重 or FACTORS
    
    # 底线熔断检查
    底线分 = 评分.get("底线触达", 1.0)
    if 底线分 <= 0.3:
        return {
            "综合分": 0,
            "判定": "🔴 底线熔断·不参与权重计算",
            "详情": {},
            "说明": f"底线触达分={底线分}·触及红线·立即熔断",
        }
    
    total = 0.0
    详情 = {}
    total_weight = 0.0
    
    for 因子, weight in w.items():
        score = 评分.get(因子, 0.5)
        actual_weight = weight
        # 底线因素加权
        if 因子 == "底线触达" and score <= 0.5:
            actual_weight = weight * 2.0  # 底线加倍
        
        total += score * actual_weight
        total_weight += actual_weight
        详情[因子] = {
            "得分": round(score, 2),
            "权重": round(actual_weight, 2),
            "贡献": round(score * actual_weight, 3),
        }
    
    # 归一化
    if total_weight > 0:
        total = total / total_weight
    
    差距 = max(w.values()) - min(w.values())
    
    if total >= 0.7:
        判定 = "🟢 公平"
    elif total >= 0.4:
        判定 = "🟡 部分不公·需关注"
    else:
        判定 = "🔴 严重不公·建议行动"
    
    return {
        "综合分": round(total, 4),
        "判定": 判定,
        "详情": 详情,
        "说明": f"六维加权综合={total:.2f}·权重极差={差距:.2f}",
        "最弱项": min(详情, key=lambda k: 详情[k]["贡献"]),
        "最强项": max(详情, key=lambda k: 详情[k]["贡献"]),
    }


# ═══════════════════════════════════════════════════════════
# §3 白皮书真实性指数 WAI · IPA-DICT-035
# ═══════════════════════════════════════════════════════════

WAI_WEIGHTS = {
    "服务对象": 0.20,   # 为谁服务
    "数据主权": 0.20,   # 数据归属
    "算法透明": 0.15,   # 可审计性
    "文化主权": 0.15,   # 文化自主
    "成本转嫁": 0.10,   # 代价分担
    "纠错机制": 0.10,   # 出错怎么办
    "普惠落地": 0.10,   # 老百姓能用吗
}

def 算WAI(七维评分: Dict[str, float]) -> Dict[str, Any]:
    """
    WAI = Σ(维度·权重)
    ≥0.8→真为民 · 0.5-0.8→部分为民 · <0.5→装饰品 · <0.2→反人民
    """
    total = 0.0
    详情 = {}
    for 维度, weight in WAI_WEIGHTS.items():
        score = 七维评分.get(维度, 0.0)
        total += score * weight
        详情[维度] = {
            "得分": round(score, 2),
            "权重": weight,
            "贡献": round(score * weight, 3),
        }
    
    if total >= 0.8:
        判定 = "🟢 真为人民"
        等级 = "真白皮书"
    elif total >= 0.5:
        判定 = "🟡 部分为民"
        等级 = "半张白皮书"
    elif total >= 0.2:
        判定 = "🔴 装饰品"
        等级 = "假白皮书·装饰品"
    else:
        判定 = "🔴 反人民文件"
        等级 = "反人民·立即预警"
    
    return {
        "WAI": round(total, 4),
        "判定": 判定,
        "等级": 等级,
        "详情": 详情,
        "最弱项": min(详情, key=lambda k: 详情[k]["贡献"]),
    }


# ═══════════════════════════════════════════════════════════
# §4 用户主权检验 · IPA-DICT-019
# ═══════════════════════════════════════════════════════════

def 算主权检验(
    用户付费占比: float = 0.0,
    数据可携: float = 0.0,
    推荐透明: float = 0.0,
    错误责任: float = 0.0,
    退出自由: float = 0.0,
) -> Dict[str, Any]:
    """
    SERVICE_TRUTH = 0.3·付费 + 0.25·可携 + 0.2·透明 + 0.15·责任 + 0.1·退出
    ≥0.7→真为民 · 0.4-0.7→骑墙 · <0.4→为资本
    """
    score = (
        0.30 * 用户付费占比 +
        0.25 * 数据可携 +
        0.20 * 推荐透明 +
        0.15 * 错误责任 +
        0.10 * 退出自由
    )
    
    详情 = {
        "用户付费占比": {"得分": 用户付费占比, "权重": 0.30, "含义": "用户直接付费占总收入比例"},
        "数据可携": {"得分": 数据可携, "权重": 0.25, "含义": "能否一键导出/删除数据"},
        "推荐透明": {"得分": 推荐透明, "权重": 0.20, "含义": "推荐算法可解释可审计"},
        "错误责任": {"得分": 错误责任, "权重": 0.15, "含义": "AI犯错谁负责·赔偿机制"},
        "退出自由": {"得分": 退出自由, "权重": 0.10, "含义": "用户能轻松离开吗"},
    }
    
    if score >= 0.7:
        判定 = "🟢 真为用户服务（用户是客户）"
        枪口 = "对准资本·保护用户"
    elif score >= 0.4:
        判定 = "🟡 骑墙状态（部分为用户·部分为资本）"
        枪口 = "两边都瞄·看情况"
    else:
        判定 = "🔴 为资本服务（用户是产品/燃料）"
        枪口 = "对准用户·服务资本"
    
    return {
        "主权分": round(score, 4),
        "判定": 判定,
        "枪口方向": 枪口,
        "详情": 详情,
    }


# ═══════════════════════════════════════════════════════════
# §5 成本转嫁分析 · IPA-DICT-023
# ═══════════════════════════════════════════════════════════

COST_TYPES = {
    "注意力税": "你每天花多少时间在这个产品上（小时）",
    "隐私税": "你交出了多少个人信息（0-10，10=完全透明）",
    "试错代价": "用错了/被骗了谁兜底（0-10，10=完全兜底）",
    "环境代价": "训练/运行一次排多少碳（0-10，10=零碳）",
    "就业冲击": "替代了多少岗位（0-10，10=不替代）",
}

def 算免费代价(评分: Dict[str, float], 每月使用小时: float = 0) -> Dict[str, Any]:
    """
    免费的真实价格 = 注意力税 + 隐私税 + 试错代价 + 环境代价 + 就业冲击
    输出：如果你不是付费用户，你付出的真实"价格"
    """
    详情 = {}
    total_cost = 0.0
    
    for 税种, _ in COST_TYPES.items():
        raw = 评分.get(税种, 5.0)
        # 逆向：分越高表示代价越大
        normalized = min(raw / 10.0, 1.0)
        详情[税种] = {
            "原始分": raw,
            "代价度": round(normalized, 2),
            "判断": "🔴 高代价" if normalized > 0.7 else ("🟡 中等" if normalized > 0.4 else "🟢 低代价"),
        }
        total_cost += normalized
    
    avg_cost = total_cost / len(COST_TYPES)
    
    # 时间换算
    if 每月使用小时 > 0:
        注意税 = 评分.get("注意力税", 5.0) / 10.0
        折算月薪 = 每月使用小时 * 注意税 * 50  # 假设时薪50元
        年代价金额 = 折算月薪 * 12
    else:
        折算月薪 = 0
        年代价金额 = 0
    
    if avg_cost >= 0.7:
        判定 = "🔴 免费比付费更贵·你在付命"
    elif avg_cost >= 0.4:
        判定 = "🟡 有代价·需警觉"
    else:
        判定 = "🟢 代价可接受"
    
    result = {
        "综合代价度": round(avg_cost, 4),
        "判定": 判定,
        "详情": 详情,
    }
    
    if 每月使用小时 > 0:
        result["时间代价"] = {
            "每月使用小时": 每月使用小时,
            "估算月代价(元)": round(折算月薪, 0),
            "估算年代价(元)": round(年代价金额, 0),
            "说明": f"按注意税折算·你每年大约付出了{年代价金额:.0f}元的时间成本",
        }
    
    return result


# ═══════════════════════════════════════════════════════════
# §6 普惠落地检测 · IPA-DICT-025
# ═══════════════════════════════════════════════════════════

INCLUSION_DIMS = {
    "语言包容": "支持方言/土话/错别字识别",
    "学历包容": "初中文化能独立使用",
    "经济包容": "农村和城市同产品同价",
    "地域包容": "不因地理位置降级服务",
    "年龄包容": "高龄用户可独立使用",
    "残障包容": "视障/听障用户可用",
}

def 算普惠度(评分: Dict[str, float]) -> Dict[str, Any]:
    """高门槛检测：分数越低 = 门槛越高 = 越不普惠"""
    total = 0.0
    详情 = {}
    for 维度, 说明 in INCLUSION_DIMS.items():
        score = 评分.get(维度, 0.5)
        total += score
        详情[维度] = {
            "得分": round(score, 2),
            "说明": 说明,
            "门槛": "🔴 高门槛" if score < 0.3 else ("🟡 中门槛" if score < 0.6 else "🟢 低门槛"),
        }
    
    avg = total / len(INCLUSION_DIMS)
    
    if avg >= 0.7:
        判定 = "🟢 普惠·老百姓都能用"
    elif avg >= 0.4:
        判定 = "🟡 部分普惠·有门槛"
    else:
        判定 = "🔴 高门槛·把老百姓拦在外面"
    
    return {
        "普惠度": round(avg, 4),
        "判定": 判定,
        "详情": 详情,
        "被拦人群": [k for k, v in 详情.items() if v["得分"] < 0.3],
    }


# ═══════════════════════════════════════════════════════════
# §7 综合权益报告
# ═══════════════════════════════════════════════════════════

@dataclass
class 权益综合报告:
    资源稀释: Dict[str, Any]
    六维公平: Dict[str, Any]
    WAI: Dict[str, Any]
    主权检验: Dict[str, Any]
    成本转嫁: Dict[str, Any]
    普惠度: Dict[str, Any]
    
    def 总体评分(self) -> float:
        """六公式加权汇总"""
        scores = []
        if self.资源稀释.get("公平系数", 0) > 0:
            scores.append(self.资源稀释["公平系数"])
        if self.六维公平.get("综合分", 0) > 0:
            scores.append(self.六维公平["综合分"])
        if self.WAI.get("WAI", 0) > 0:
            scores.append(self.WAI["WAI"])
        if self.主权检验.get("主权分", 0) > 0:
            scores.append(self.主权检验["主权分"])
        if self.成本转嫁.get("综合代价度", 0) > 0:
            scores.append(1 - self.成本转嫁["综合代价度"])
        if self.普惠度.get("普惠度", 0) > 0:
            scores.append(self.普惠度["普惠度"])
        return round(sum(scores) / len(scores), 4) if scores else 0
    
    def 总判定(self) -> str:
        score = self.总体评分()
        if score >= 0.7:
            return "🟢 权益保障较好"
        elif score >= 0.4:
            return "🟡 有权益风险·需关注"
        else:
            return "🔴 权益严重受损·建议行动"


class 老百姓权益计算器:
    """六公式合体计算引擎"""
    
    def 全面评估(self, 场景: Dict[str, Any]) -> 权益综合报告:
        """输入场景数据·输出六维度综合报告"""
        
        # 1. 资源稀释
        资源稀释结果 = {}
        if "资源占比" in 场景:
            资源稀释结果 = 算资源稀释(场景["资源占比"])
        
        # 2. 六维公平
        六维公平结果 = {}
        if "六维评分" in 场景:
            六维公平结果 = 算六维公平(场景["六维评分"], 场景.get("六维权重"))
        
        # 3. WAI
        wai结果 = {}
        if "七维评分" in 场景:
            wai结果 = 算WAI(场景["七维评分"])
        
        # 4. 主权检验
        主权结果 = {}
        if "主权评分" in 场景:
            s = 场景["主权评分"]
            主权结果 = 算主权检验(
                用户付费占比=s.get("用户付费占比", 0),
                数据可携=s.get("数据可携", 0),
                推荐透明=s.get("推荐透明", 0),
                错误责任=s.get("错误责任", 0),
                退出自由=s.get("退出自由", 0),
            )
        
        # 5. 成本转嫁
        代价结果 = {}
        if "代价评分" in 场景:
            代价结果 = 算免费代价(
                场景["代价评分"],
                场景.get("每月使用小时", 0),
            )
        
        # 6. 普惠度
        普惠结果 = {}
        if "普惠评分" in 场景:
            普惠结果 = 算普惠度(场景["普惠评分"])
        
        return 权益综合报告(
            资源稀释=资源稀释结果,
            六维公平=六维公平结果,
            WAI=wai结果,
            主权检验=主权结果,
            成本转嫁=代价结果,
            普惠度=普惠结果,
        )


