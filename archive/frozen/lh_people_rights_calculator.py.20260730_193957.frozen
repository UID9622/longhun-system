# ═══════════════════════════════════════════════════════════
# §9 格式化输出
# ═══════════════════════════════════════════════════════════

def 打印报告(报告: 权益综合报告, 场景名: str = ""):
    print("\n" + "=" * 64)
    print(f"  🐉 龍魂·老百姓权益计算器 v1.0")
    if 场景名:
        print(f"  场景: {场景名}")
    print(f"  总评分: {报告.总体评分():.4f}  {报告.总判定()}")
    print("=" * 64)
    
    各模块 = [
        ("📊 资源稀释公平系数 (IPA-DICT-008)", 报告.资源稀释),
        ("⚖️ 六维公平评估 (IPA-DICT-027)", 报告.六维公平),
        ("📜 白皮书真实性指数 WAI (IPA-DICT-035)", 报告.WAI),
        ("🎯 用户主权检验 (IPA-DICT-019)", 报告.主权检验),
        ("💸 免费代价计算 (IPA-DICT-023)", 报告.成本转嫁),
        ("🚪 普惠落地检测 (IPA-DICT-025)", 报告.普惠度),
    ]
    
    for 标题, 结果 in 各模块:
        if not 结果:
            continue
        print(f"\n  {标题}")
        print("  " + "-" * 60)
        
        if 标题.startswith("📊"):
            print(f"    公平系数: {结果.get('公平系数', 'N/A')}  {结果.get('判定', '')}")
            print(f"    最大占比: {结果.get('最大占比方', 'N/A')}")
            if "各详情" in 结果:
                for k, v in 结果["各详情"].items():
                    print(f"      {k}: {v}")
        
        elif 标题.startswith("⚖️"):
            print(f"    综合分: {结果.get('综合分', 'N/A')}  {结果.get('判定', '')}")
            if "最弱项" in 结果:
                print(f"    最弱项: {结果['最弱项']}  最强项: {结果['最强项']}")
            if "详情" in 结果:
                for k, v in 结果["详情"].items():
                    print(f"      {k}: 得分{v['得分']} 权重{v['权重']} 贡献{v['贡献']}")
        
        elif 标题.startswith("📜"):
            print(f"    WAI: {结果.get('WAI', 'N/A')}  {结果.get('判定', '')}")
            print(f"    等级: {结果.get('等级', 'N/A')}")
            if "最弱项" in 结果:
                print(f"    最弱维度: {结果['最弱项']}")
        
        elif 标题.startswith("🎯"):
            print(f"    主权分: {结果.get('主权分', 'N/A')}  {结果.get('判定', '')}")
            print(f"    枪口方向: {结果.get('枪口方向', 'N/A')}")
        
        elif 标题.startswith("💸"):
            print(f"    综合代价度: {结果.get('综合代价度', 'N/A')}  {结果.get('判定', '')}")
            if "时间代价" in 结果:
                t = 结果["时间代价"]
                print(f"    每月使用: {t['每月使用小时']}小时")
                print(f"    估算月代价: ¥{t['估算月代价(元)']}  年代价: ¥{t['估算年代价(元)']}")
        
        elif 标题.startswith("🚪"):
            print(f"    普惠度: {结果.get('普惠度', 'N/A')}  {结果.get('判定', '')}")
            被拦 = 结果.get("被拦人群", [])
            if 被拦:
                print(f"    被拦在门外的人群: {', '.join(被拦)}")
    
    print("\n" + "=" * 64)
    print("  本报告由本地计算生成，不上传任何数据。")
    print("  公式来源: 龍魂IPA字典·L0-L1底座层·公开可验")
    print("  DNA: #龍芯⚡️2026-07-11-RIGHTS-CALC-v1.0")
    print("=" * 64 + "\n")


# ═══════════════════════════════════════════════════════════
# §10 交互式问卷
# ═══════════════════════════════════════════════════════════

def 交互式问卷():
    """一步步引导用户输入·自动计算权益报告"""
    print("\n" + "=" * 64)
    print("  🐉 龍魂·老百姓权益计算器 · 交互模式")
    print("  回答以下问题，AI帮你算清这六笔账")
    print("=" * 64)
    
    场景 = {}
    
    # 选择场景类型
    print("\n  📋 你遇到的是什么情况？")
    print("    1. 互联网平台/App问题（电商、社交、AI助手等）")
    print("    2. 公共服务问题（政务App、公共设施等）")
    print("    3. 自定义输入各项评分")
    选择 = input("  请输入 1/2/3: ").strip()
    
    if 选择 == "1":
        print("\n  选择具体场景:")
        print("    a. 电商平台")
        print("    b. 社交媒体")
        print("    c. AI助手")
        print("    d. 自定义")
        sub = input("  请输入 a/b/c/d: ").strip()
        映射 = {"a": "电商平台", "b": "社交媒体", "c": "AI助手"}
        if sub in 映射:
            return 映射[sub], 预置场景[映射[sub]]
        else:
            print("\n  ⚠️ 进入自定义模式")
    
    elif 选择 == "2":
        print("\n  使用公共服务App预置模板")
        return "公共服务App", 预置场景["公共服务App"]
    
    # === 自定义模式 ===
    print("\n  📝 自定义评估模式")
    print("  （直接回车跳过某模块）\n")
    
    # 模块1: 主权检验
    print("  ── 主权检验 ──")
    if input("  是否评估用户主权？(y/n): ").strip().lower() == "y":
        场景["主权评分"] = {}
        场景["主权评分"]["用户付费占比"] = float(input("    用户付费占总收入比例(0-1): ") or 0)
        场景["主权评分"]["数据可携"] = float(input("    数据可导出可删除程度(0-1): ") or 0)
        场景["主权评分"]["推荐透明"] = float(input("    推荐算法透明度(0-1): ") or 0)
        场景["主权评分"]["错误责任"] = float(input("    AI出错谁负责(0-1,1=全兜底): ") or 0)
        场景["主权评分"]["退出自由"] = float(input("    用户离开难度(0-1,1=随时可走): ") or 0)
    
    # 模块2: WAI白皮书
    print("\n  ── 白皮书真实性 ──")
    if input("  是否评估白皮书真实性？(y/n): ").strip().lower() == "y":
        场景["七维评分"] = {}
        for 维度 in ["服务对象", "数据主权", "算法透明", "文化主权", "成本转嫁", "纠错机制", "普惠落地"]:
            场景["七维评分"][维度] = float(input(f"    {维度}(0-1): ") or 0.5)
    
    # 模块3: 免费代价
    print("\n  ── 免费代价 ──")
    if input("  是否计算免费代价？(y/n): ").strip().lower() == "y":
        场景["代价评分"] = {}
        场景["代价评分"]["注意力税"] = float(input("    每天花几小时在上面？(0-24): ") or 2)
        场景["代价评分"]["隐私税"] = float(input("    个人信息暴露程度(0-10,10=完全透明): ") or 5)
        场景["代价评分"]["试错代价"] = float(input("    用错了谁兜底(0-10,10=全兜底): ") or 3)
        场景["代价评分"]["环境代价"] = float(input("    环保程度(0-10,10=零碳): ") or 5)
        场景["代价评分"]["就业冲击"] = float(input("    替代岗位程度(0-10,10=不替代): ") or 5)
        场景["每月使用小时"] = float(input("    每月使用时长(小时): ") or 30)
    
    # 模块4: 普惠度
    print("\n  ── 普惠落地 ──")
    if input("  是否评估普惠度？(y/n): ").strip().lower() == "y":
        场景["普惠评分"] = {}
        for 维度 in ["语言包容", "学历包容", "经济包容", "地域包容", "年龄包容", "残障包容"]:
            场景["普惠评分"][维度] = float(input(f"    {维度}(0-1,1=完全包容): ") or 0.5)
    
    return "自定义评估", 场景


# ═══════════════════════════════════════════════════════════
# §11 CLI入口
# ═══════════════════════════════════════════════════════════

def 主函数():
    parser = argparse.ArgumentParser(
        description="龍魂·老百姓权益计算器 — 六公式合体·一键算清老百姓的账",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例:
  python3 bin/lh_people_rights_calculator.py --interactive
  python3 bin/lh_people_rights_calculator.py --preset 电商平台
  python3 bin/lh_people_rights_calculator.py --preset 社交媒体 --save report.json
  python3 bin/lh_people_rights_calculator.py --list-presets
        """,
    )
    parser.add_argument("--interactive", "-i", action="store_true", help="交互式问卷模式")
    parser.add_argument("--preset", "-p", choices=list(预置场景.keys()), help="使用预置场景")
    parser.add_argument("--list-presets", action="store_true", help="列出所有预置场景")
    parser.add_argument("--save", "-s", help="保存报告到 JSON 文件")
    parser.add_argument("--json", "-j", action="store_true", help="输出纯JSON（不打印格式化报告）")
    args = parser.parse_args()
    
    if args.list_presets:
        print("\n📋 预置场景列表:\n")
        for name in 预置场景:
            print(f"  • {name}")
        print()
        return
    
    计算器 = 老百姓权益计算器()
    
    if args.interactive:
        场景名, 场景数据 = 交互式问卷()
    elif args.preset:
        场景名 = args.preset
        场景数据 = 预置场景[args.preset]
    else:
        parser.print_help()
        return
    
    报告 = 计算器.全面评估(场景数据)
    
    if args.json:
        from dataclasses import asdict
        print(json.dumps(asdict(报告), ensure_ascii=False, indent=2, default=str))
    else:
        打印报告(报告, 场景名)
    
    if args.save:
        from dataclasses import asdict
        with open(args.save, "w", encoding="utf-8") as f:
            json.dump(asdict(报告), f, ensure_ascii=False, indent=2, default=str)
        print(f"✅ 报告已保存: {args.save}")


if __name__ == "__main__":
    主函数()
