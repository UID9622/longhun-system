    "韩非": "HANFEI",
    "王阳明": "WANGYANGMING",
    "孙子": "SUNZI",
    "墨子": "MOZI",
    "孔子": "KONGZI",
    "老子": "LAOZI",
    "佳琪": "JIAQI",
    "影匠": "YINGJIANG",
    "图匠": "TUJIANG",
    "字匠": "ZIJIANG",
    "音匠": "YINJIANG",
