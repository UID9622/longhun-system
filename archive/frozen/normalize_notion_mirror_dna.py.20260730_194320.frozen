    "编辑器终端": "EDITOR-TERMINAL",
    "终端": "TERMINAL",
    "传承者": "INHERITOR",
    "北辰": "BEICHEN",
    "母协议": "MOTHER-PROTOCOL",
    "CNSH编辑器": "CNSH-EDITOR",
