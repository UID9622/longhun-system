#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Notion Mirror DNA 规范化工具
- 保留原始 DNA
- 新增 normalized_dna 字段
- 统一为 #龍芯⚡️YYYY-MM-DD-MODULE-vVERSION
"""

import json
import re

# 中文关键词 → 英文映射
