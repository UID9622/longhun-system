#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂待整理目录索引生成器
扫描 /Users/zuimeidedeyihan/龍魂待整理，提取元数据、DNA、标题、分类。
DNA: #龍芯⚡️2026-06-28-LONGHUN-INVENTORY-BUILDER-v1.0
"""
import json, hashlib, os, re, mimetypes
from pathlib import Path
from datetime import datetime, timezone

ROOT = Path('/Users/zuimeidedeyihan/龍魂待整理')
OUT = ROOT / 'longhun_inventory.json'

DNA_RE = re.compile(
    r"#[龍龙]芯[\u26a1\ufe0f]*\d{4}(?:[-_]\d{2}){0,2}[-_][A-Za-z0-9\u4e00-\u9fff\-_\/]+(?:[-_][vV]\d+(?:\.\d+)?)?|"
    r"#ZHUGEXIN[\u26a1\ufe0f]*\d{4}[-_][\u4e00-\u9fffA-Za-z0-9\-_\/]+(?:[-_][vV]\d+(?:\.\d+)?)?|"
    r"#CONFIRM[🌌🌀]?9622-ONLY-ONCE[🧬]?[A-Za-z0-9\-]+",
    re.UNICODE,
)

VERSION_RE = re.compile(r'v\d+(?:\.\d+)*', re.I)

EXCLUDE_NAMES = {'.DS_Store', '__pycache__', '.git', '.gitignore', 'node_modules'}


def sha256_file(p: Path) -> str:
    h = hashlib.sha256()
    with open(p, 'rb') as f:
        for chunk in iter(lambda: f.read(8192), b''):
            h.update(chunk)
    return h.hexdigest()


def read_text_sample(p: Path, limit=20000) -> str:
    try:
        return p.read_text(encoding='utf-8', errors='ignore')[:limit]
    except Exception:
        return ''


def extract_title(p: Path, text: str) -> str:
    # HTML
    if p.suffix.lower() in {'.html', '.htm'}:
        m = re.search(r'<title[^>]*>(.*?)</title>', text, re.S | re.I)
        if m:
            return re.sub(r'<[^>]+>', '', m.group(1)).strip()
    # Markdown
    if p.suffix.lower() in {'.md', '.txt'}:
        lines = [ln.strip() for ln in text.splitlines() if ln.strip()]
        for ln in lines[:5]:
            if ln.startswith('#'):
                return ln.lstrip('#').strip()
    # Python first docstring/comment
    if p.suffix.lower() == '.py':
        m = re.search(r'"""(.*?)"""', text, re.S)
        if m:
            first = m.group(1).strip().splitlines()[0]
            if first:
                return first[:120]
    # Default: stem
    return p.stem


def guess_category(p: Path, text: str, title: str) -> str:
    name = (p.name + title).lower()
    cats = []
    if any(k in name for k in ['cns', 'cnsh', '通心译', '语义', '协议', '语法', '编译器', '终端', '签名']):
        cats.append('01-CNSH-协议规范')
    if any(k in name for k in ['流场', '三才', '洛书', '二十八宿', '流场总控', 'vortex', 'flow-field']):
        cats.append('02-流场可视化')
    if any(k in name for k in ['dna', '身份', '安全', 'gpg', '归因', 'attribution', '户口本', '宪法', '铁律']):
        cats.append('03-身份安全-DNA')
    if any(k in name for k in ['审计', '审核', 'truth', 'report', 'review', 'filter', 'shield']):
        cats.append('04-审计治理')
    if any(k in name for k in ['ipa', '人格', 'agent', '智能体', 'ai', '中枢', 'persona']):
        cats.append('05-AI人格-Agent')
    if p.suffix.lower() in {'.py', '.sh', '.js', '.json'} and not any(k in name for k in ['spec', '规格书', '指南', '报告']):
        cats.append('06-工具脚本')
    if p.suffix.lower() == '.pdf':
        cats.append('07-论文PDF')
    if any(k in name for k in ['widget', 'webbridge', '浏览器插件', 'extension']):
        cats.append('08-浏览器插件桥接')
    if not cats:
        cats.append('09-杂项备忘')
    # If multiple, pick most specific: prefer first that is not 09
    return cats[0]


def build():
    items = []
    for p in sorted(ROOT.rglob('*')):
        if not p.is_file():
            continue
        if any(part in EXCLUDE_NAMES for part in p.parts):
            continue
        rel = p.relative_to(ROOT)
        text = read_text_sample(p)
        title = extract_title(p, text)
        dnas = list(set(DNA_RE.findall(text)))
        versions = list(set(VERSION_RE.findall(p.name + ' ' + title)))
        items.append({
            'path': str(rel),
            'absolute': str(p),
            'title': title,
            'size': p.stat().st_size,
            'mtime': datetime.fromtimestamp(p.stat().st_mtime, tz=timezone.utc).isoformat(),
            'mime': mimetypes.guess_type(str(p))[0] or 'application/octet-stream',
            'sha256': sha256_file(p),
            'category': guess_category(p, text, title),
            'dna_codes': dnas,
            'versions': versions,
        })

    inventory = {
        'generated_at': datetime.now(timezone.utc).isoformat(),
        'root': str(ROOT),
        'count': len(items),
        'dna': '#龍芯⚡️2026-06-28-LONGHUN-INVENTORY-v1.0',
        'items': items,
        'category_summary': {},
    }
    for it in items:
        inventory['category_summary'][it['category']] = inventory['category_summary'].get(it['category'], 0) + 1

    OUT.write_text(json.dumps(inventory, ensure_ascii=False, indent=2), encoding='utf-8')
    print(f'Inventory built: {len(items)} items -> {OUT}')
    for cat, cnt in sorted(inventory['category_summary'].items()):
        print(f'  {cat}: {cnt}')


if __name__ == '__main__':
    build()
