#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂万年历 · 本地 HTTP 服务 + 私有API主权层
DNA: #龍芯⚡️2026-06-27-LONGHUN-CALENDAR-LOCAL-SERVER-v2.1

仅用于本地浏览器加载模块、config.json、主题包，以及提供私有API。
不依赖云端，不监听公网，随用随启。
"""

import http.server
import json
import os
import socketserver
import sys
import urllib.parse
from pathlib import Path

PORT = int(os.environ.get('LONGHUN_CALENDAR_PORT', '9527'))
ROOT = Path(__file__).resolve().parent

# 把当前目录加入 sys.path，确保能 import api-core
sys.path.insert(0, str(ROOT))
from api_core import PrivateAPI, DEFAULT_ACTOR
from community_core import CommunityCore

api = PrivateAPI()
community = CommunityCore()


def json_response(code, data):
    body = json.dumps(data, ensure_ascii=False).encode('utf-8')
    return code, body, 'application/json; charset=utf-8'


class LonghunTCPServer(socketserver.TCPServer):
    allow_reuse_address = True


class LonghunHandler(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(ROOT), **kwargs)

    def log_message(self, fmt, *args):
        pass

    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        qs = urllib.parse.parse_qs(parsed.query)

        if path == '/api/directions':
            return self._serve_directions()
        if path == '/api/policy':
            return self._serve_policy()
        if path == '/api/audit':
            return self._serve_audit(qs)
        if path == '/api/shame':
            return self._serve_shame(qs)
        if path == '/api/authorizations':
            return self._serve_authorizations()
        if path == '/api/access/read':
            return self._handle_read(qs)

        # 社区 API
        if path == '/api/community/shared':
            return self._serve_community_shared(qs)
        if path == '/api/community/directions':
            return self._serve_community_directions()
        if path == '/api/community/reviews':
            return self._serve_community_reviews(qs)
        if path == '/api/community/logs':
            return self._serve_community_logs(qs)
        if path == '/api/community/view':
            return self._serve_community_view(qs)
        if path == '/api/community/history':
            return self._serve_community_history(qs)

        return super().do_GET()

    def do_POST(self):
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        length = int(self.headers.get('Content-Length', 0))
        body = self.rfile.read(length).decode('utf-8')
        try:
            payload = json.loads(body) if body else {}
        except json.JSONDecodeError:
            payload = {}

        if path == '/api/access/read':
            return self._handle_read(payload)
        if path == '/api/access/grant':
            return self._handle_grant(payload)
        if path == '/api/access/revoke':
            return self._handle_revoke(payload)

        # 社区 API
        if path == '/api/community/theme/upload':
            return self._handle_theme_upload(payload)
        if path == '/api/community/theme/download':
            return self._handle_theme_download(payload)
        if path == '/api/community/theme/apply':
            return self._handle_theme_apply(payload)
        if path == '/api/community/theme/delete-local':
            return self._handle_theme_delete_local(payload)
        if path == '/api/community/theme/rollback':
            return self._handle_theme_rollback(payload)
        if path == '/api/community/review/approve':
            return self._handle_review_approve(payload)
        if path == '/api/community/review/reject':
            return self._handle_review_reject(payload)
        if path == '/api/community/direction/add':
            return self._handle_direction_add(payload)
        if path == '/api/community/direction/remove':
            return self._handle_direction_remove(payload)
        if path == '/api/community/direction/authorize':
            return self._handle_direction_authorize(payload)

        self.send_response(404)
        self.end_headers()

    def _serve_directions(self):
        code, body, ctype = json_response(200, {'ok': True, 'directions': api.directions})
        self._send_json(code, body, ctype)

    def _serve_policy(self):
        code, body, ctype = json_response(200, {'ok': True, 'policy': api.policy})
        self._send_json(code, body, ctype)

    def _serve_audit(self, qs):
        limit = int(qs.get('limit', [100])[0])
        code, body, ctype = json_response(200, {'ok': True, 'logs': api.get_audit_log(limit)})
        self._send_json(code, body, ctype)

    def _serve_shame(self, qs):
        limit = int(qs.get('limit', [100])[0])
        code, body, ctype = json_response(200, {'ok': True, 'records': api.get_shame_wall(limit)})
        self._send_json(code, body, ctype)

    def _serve_authorizations(self):
        code, body, ctype = json_response(200, {'ok': True, 'records': api.authz.get('records', [])})
        self._send_json(code, body, ctype)

    def _handle_read(self, params):
        data_id = params.get('data_id') if isinstance(params, dict) else params.get('data_id', [None])[0]
        actor = (params.get('actor') if isinstance(params, dict) else params.get('actor', [DEFAULT_ACTOR])[0]) or DEFAULT_ACTOR
        actor_type = (params.get('actor_type') if isinstance(params, dict) else params.get('actor_type', ['human'])[0]) or 'human'
        direction = (params.get('direction') if isinstance(params, dict) else params.get('direction', ['consult'])[0]) or 'consult'

        if not data_id:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 data_id'})
            return self._send_json(code, body, ctype)

        result = api.read_data(data_id, actor, actor_type, direction)
        code, body, ctype = json_response(200 if result['ok'] else 401, result)
        self._send_json(code, body, ctype)

    def _handle_grant(self, payload):
        data_id = payload.get('data_id')
        grantee = payload.get('grantee')
        grantee_type = payload.get('grantee_type', 'user')
        directions = payload.get('directions', [])
        ttl_days = int(payload.get('ttl_days', 365))
        reason = payload.get('reason', '')
        granter = payload.get('granter', DEFAULT_ACTOR)

        if not data_id or not grantee or not directions:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少必要字段'})
            return self._send_json(code, body, ctype)

        rec = api.grant(data_id, grantee, grantee_type, directions, ttl_days, reason, granter)
        code, body, ctype = json_response(200, {'ok': True, 'record': rec})
        self._send_json(code, body, ctype)

    def _handle_revoke(self, payload):
        auth_id = payload.get('auth_id')
        actor = payload.get('actor', DEFAULT_ACTOR)
        if not auth_id:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 auth_id'})
            return self._send_json(code, body, ctype)
        result = api.revoke(auth_id, actor)
        code, body, ctype = json_response(200, {'ok': True, 'result': result})
        self._send_json(code, body, ctype)

    # ---------- 社区 API 处理器 ----------
    def _serve_community_shared(self, qs):
        status = qs.get('status', [None])[0]
        code, body, ctype = json_response(200, community.list_shared(status_filter=status))
        self._send_json(code, body, ctype)

    def _serve_community_directions(self):
        code, body, ctype = json_response(200, community.list_directions())
        self._send_json(code, body, ctype)

    def _serve_community_reviews(self, qs):
        status = qs.get('status', [None])[0]
        code, body, ctype = json_response(200, community.list_reviews(status=status))
        self._send_json(code, body, ctype)

    def _serve_community_logs(self, qs):
        kind = qs.get('kind', ['upload'])[0]
        limit = int(qs.get('limit', [100])[0])
        logs = community.get_upload_logs(limit) if kind == 'upload' else community.get_download_logs(limit)
        code, body, ctype = json_response(200, {'ok': True, 'logs': logs})
        self._send_json(code, body, ctype)

    def _serve_community_view(self, qs):
        name = qs.get('name', [None])[0]
        if not name:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 name'})
        else:
            code, body, ctype = json_response(200, community.view_shared(name))
        self._send_json(code, body, ctype)

    def _serve_community_history(self, qs):
        name = qs.get('name', [None])[0]
        if not name:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 name'})
        else:
            code, body, ctype = json_response(200, community.view_history(name))
        self._send_json(code, body, ctype)

    def _handle_theme_upload(self, payload):
        name = payload.get('name')
        direction = payload.get('direction', '研发')
        description = payload.get('description', '')
        source_dna = payload.get('source_dna')
        source_author = payload.get('source_author')
        actor = payload.get('actor', DEFAULT_ACTOR)
        if not name:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 name'})
        else:
            result = community.upload_theme(name, source_dna=source_dna, source_author=source_author,
                                            direction=direction, description=description, actor=actor)
            code, body, ctype = json_response(200 if result['ok'] else 400, result)
        self._send_json(code, body, ctype)

    def _handle_theme_download(self, payload):
        name = payload.get('name')
        actor = payload.get('actor', DEFAULT_ACTOR)
        if not name:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 name'})
        else:
            result = community.download_theme(name, actor=actor)
            code, body, ctype = json_response(200 if result['ok'] else 400, result)
        self._send_json(code, body, ctype)

    def _handle_theme_apply(self, payload):
        name = payload.get('name')
        if not name:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 name'})
        else:
            result = community.apply_theme(name)
            code, body, ctype = json_response(200 if result['ok'] else 400, result)
        self._send_json(code, body, ctype)

    def _handle_theme_delete_local(self, payload):
        name = payload.get('name')
        if not name:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 name'})
        else:
            result = community.delete_local_theme(name)
            code, body, ctype = json_response(200 if result['ok'] else 400, result)
        self._send_json(code, body, ctype)

    def _handle_theme_rollback(self, payload):
        name = payload.get('name')
        version = payload.get('version')
        if not name or not version:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 name 或 version'})
        else:
            result = community.rollback_theme(name, version)
            code, body, ctype = json_response(200 if result['ok'] else 400, result)
        self._send_json(code, body, ctype)

    def _handle_review_approve(self, payload):
        shared_id = payload.get('shared_id')
        actor = payload.get('actor', DEFAULT_ACTOR)
        if not shared_id:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 shared_id'})
        else:
            result = community.approve(shared_id, actor=actor)
            code, body, ctype = json_response(200 if result['ok'] else 400, result)
        self._send_json(code, body, ctype)

    def _handle_review_reject(self, payload):
        shared_id = payload.get('shared_id')
        reason = payload.get('reason', '')
        actor = payload.get('actor', DEFAULT_ACTOR)
        if not shared_id:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 shared_id'})
        else:
            result = community.reject(shared_id, reason, actor=actor)
            code, body, ctype = json_response(200 if result['ok'] else 400, result)
        self._send_json(code, body, ctype)

    def _handle_direction_add(self, payload):
        name = payload.get('name')
        actor = payload.get('actor', DEFAULT_ACTOR)
        if not name:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 name'})
        else:
            result = community.add_direction(name, actor=actor)
            code, body, ctype = json_response(200 if result['ok'] else 400, result)
        self._send_json(code, body, ctype)

    def _handle_direction_remove(self, payload):
        name = payload.get('name')
        actor = payload.get('actor', DEFAULT_ACTOR)
        if not name:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 name'})
        else:
            result = community.remove_direction(name, actor=actor)
            code, body, ctype = json_response(200 if result['ok'] else 400, result)
        self._send_json(code, body, ctype)

    def _handle_direction_authorize(self, payload):
        direction_id = payload.get('direction_id')
        user = payload.get('user')
        actor = payload.get('actor', DEFAULT_ACTOR)
        if not direction_id or not user:
            code, body, ctype = json_response(400, {'ok': False, 'error': '缺少 direction_id 或 user'})
        else:
            result = community.authorize_direction_reviewer(direction_id, user, actor=actor)
            code, body, ctype = json_response(200 if result['ok'] else 400, result)
        self._send_json(code, body, ctype)

    def _send_json(self, code, body, ctype):
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type')
        self.end_headers()
        self.wfile.write(body)

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header('Access-Control-Allow-Origin', '*')
        self.send_header('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
        self.send_header('Access-Control-Allow-Headers', 'Content-Type')
        self.end_headers()


def start():
    with LonghunTCPServer(("127.0.0.1", PORT), LonghunHandler) as httpd:
        print(f"🐉 龍魂万年历本地服务已启动: http://127.0.0.1:{PORT}/")
        print("   私有API路径: /api/*")
        print("   按 Ctrl+C 停止")
        try:
            httpd.serve_forever()
        except KeyboardInterrupt:
            print("\n👋 服务已停止")


if __name__ == '__main__':
    start()
