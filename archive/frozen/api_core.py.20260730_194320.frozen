#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂万年历 · 私有API主权核心
DNA: #龍芯⚡️2026-06-27-LONGHUN-PRIVATE-API-CORE-v1.0

四级权限：公开 / 半公开（指定方向） / 私有 / 继承
AI自动审计、越权熔断、耻辱墙
"""

import json
import os
import uuid
from datetime import datetime, timezone
from pathlib import Path

ROOT = Path(__file__).resolve().parent
PRIVATE = ROOT / 'private'
ACCESS = PRIVATE / 'access'
CONFIG = PRIVATE / 'config'
DATA = PRIVATE / 'data'
SHAME = PRIVATE / 'shame'

DEFAULT_ACTOR = 'UID9622'


def _now():
    return datetime.now(timezone.utc).isoformat()


def _load_json(path):
    if not path.exists():
        return {}
    return json.loads(path.read_text(encoding='utf-8'))


def _save_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding='utf-8')


def _append_jsonl(path, record):
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, 'a', encoding='utf-8') as f:
        f.write(json.dumps(record, ensure_ascii=False) + '\n')


class PrivateAPI:
    def __init__(self):
        self.directions = _load_json(CONFIG / 'directions.json').get('directions', [])
        self.policy = _load_json(CONFIG / 'api_policy.json')
        self.authz = _load_json(ACCESS / 'authorizations.json')
        self.inheritance = _load_json(ACCESS / 'inheritance_rules.json')

    # ---------- 公开API ----------
    def public_calendar(self, year, month, day):
        """公开：返回公历、农历、节气、干支、卦象、三色"""
        # 这里复用 calendar-core.js 的能力；Python 端只做轻量包装
        return {
            'solar': {'year': year, 'month': month, 'day': day},
            'notice': '完整农历/节气/干支/卦象由前端 calendar-core.js 计算，此接口仅做主权层声明'
        }

    # ---------- 权限校验 ----------
    def get_directions(self):
        return [d['id'] for d in self.directions]

    def _is_authorized(self, data_id, actor, actor_type, direction):
        """四级权限：公开→半公开→私有→继承"""
        # 1) 显式授权匹配
        for rec in self.authz.get('records', []):
            if rec.get('data_id') != data_id:
                continue
            if rec.get('expires_at') and rec['expires_at'] < _now():
                continue
            if direction not in rec.get('directions', []):
                continue
            grantee = rec.get('grantee')
            grantee_type = rec.get('grantee_type')
            if grantee_type == 'user' and grantee == actor:
                return True, 'explicit_user'
            if grantee_type == 'team' and grantee in self._actor_teams(actor):
                return True, 'explicit_team'
            if grantee_type == 'direction_any':
                return True, 'explicit_direction'
        # 2) 创建者本人
        owner = self._get_owner(data_id)
        if owner and owner == actor:
            return True, 'owner'
        # 3) 继承链：创建者 → 团队 → 项目
        return self._check_inheritance(data_id, actor)

    def _actor_teams(self, actor):
        return self.inheritance.get('users', {}).get(actor, {}).get('teams', [])

    def _get_owner(self, data_id):
        # 简单规则：user-{uid}-* 属于 uid；team-{name}-* 属于 team 的 owner
        if data_id.startswith('user-'):
            parts = data_id.split('-')
            return parts[1] if len(parts) > 1 else None
        if data_id.startswith('team-'):
            team = data_id.split('-')[1]
            admins = self.inheritance.get('team_admins', {}).get(team, [])
            return admins[0] if admins else None
        return None

    def _check_inheritance(self, data_id, actor):
        chain = self.inheritance.get('default_chain', ['creator', 'team', 'project'])
        for step in chain:
            if step == 'creator':
                owner = self._get_owner(data_id)
                if owner and owner == actor:
                    return True, 'inherit_creator'
            elif step == 'team':
                owner = self._get_owner(data_id)
                owner_teams = self._actor_teams(owner) if owner else []
                actor_teams = self._actor_teams(actor)
                if set(owner_teams) & set(actor_teams):
                    return True, 'inherit_team'
            elif step == 'project':
                # 项目继承暂未启用
                pass
        return False, 'denied'

    # ---------- 半公开/私有数据访问 ----------
    def read_data(self, data_id, actor=DEFAULT_ACTOR, actor_type='human', direction='consult'):
        ok, reason = self._is_authorized(data_id, actor, actor_type, direction)
        result = 'success' if ok else 'unauthorized'
        self._audit(actor, actor_type, direction, data_id, 'read', result, reason)
        if not ok:
            self._trip_fuse(actor, actor_type, direction, data_id, reason)
            return {'ok': False, 'error': '未授权访问', 'reason': reason}
        return {'ok': True, 'data_id': data_id, 'access_path': reason}

    def read_note(self, note_id, actor=DEFAULT_ACTOR, actor_type='human', direction='consult'):
        data_id = f'user-{actor}-note-{note_id}'
        return self.read_data(data_id, actor, actor_type, direction)

    def read_team_calendar(self, team, actor=DEFAULT_ACTOR, actor_type='human', direction='audit'):
        data_id = f'team-{team}-calendar'
        return self.read_data(data_id, actor, actor_type, direction)

    # ---------- 授权管理 ----------
    def grant(self, data_id, grantee, grantee_type, directions, ttl_days=365, reason='', granter=DEFAULT_ACTOR):
        from datetime import timedelta
        rec = {
            'id': f'auth-{uuid.uuid4().hex[:8]}',
            'data_id': data_id,
            'granter': granter,
            'grantee': grantee,
            'grantee_type': grantee_type,
            'directions': directions if isinstance(directions, list) else [directions],
            'created_at': _now(),
            'expires_at': (datetime.now(timezone.utc) + timedelta(days=ttl_days)).isoformat(),
            'reason': reason
        }
        self.authz.setdefault('records', []).append(rec)
        _save_json(ACCESS / 'authorizations.json', self.authz)
        self._audit(granter, 'human', 'maintenance', data_id, 'grant', 'success', f'grant_to_{grantee}')
        return rec

    def revoke(self, auth_id, actor=DEFAULT_ACTOR):
        before = len(self.authz.get('records', []))
        self.authz['records'] = [r for r in self.authz.get('records', []) if r.get('id') != auth_id]
        _save_json(ACCESS / 'authorizations.json', self.authz)
        removed = before - len(self.authz['records'])
        self._audit(actor, 'human', 'maintenance', auth_id, 'revoke', 'success' if removed else 'not_found', '')
        return {'removed': removed}

    # ---------- 审计 ----------
    def _audit(self, actor, actor_type, direction, data_id, action, result, detail):
        record = {
            'time': _now(),
            'actor': actor,
            'actor_type': actor_type,
            'direction': direction,
            'data_id': data_id,
            'action': action,
            'result': result,
            'detail': detail
        }
        _append_jsonl(ACCESS / 'audit_log.jsonl', record)

    def get_audit_log(self, limit=100):
        path = ACCESS / 'audit_log.jsonl'
        if not path.exists():
            return []
        lines = path.read_text(encoding='utf-8').strip().split('\n')
        records = [json.loads(l) for l in lines if l.strip()]
        return records[-limit:]

    # ---------- 越权熔断 ----------
    def _trip_fuse(self, actor, actor_type, direction, data_id, reason):
        record = {
            'time': _now(),
            'actor': actor,
            'actor_type': actor_type,
            'direction': direction,
            'data_id': data_id,
            'reason': reason,
            'level': '🔴',
            'action': '越权访问已熔断'
        }
        _append_jsonl(SHAME / 'shame_wall.jsonl', record)

    def get_shame_wall(self, limit=100):
        path = SHAME / 'shame_wall.jsonl'
        if not path.exists():
            return []
        lines = path.read_text(encoding='utf-8').strip().split('\n')
        records = [json.loads(l) for l in lines if l.strip()]
        return records[-limit:]


if __name__ == '__main__':
    api = PrivateAPI()
    # 简单自检
    print('Directions:', api.get_directions())
    print('Read own note:', api.read_note('note-001'))
    print('Read team calendar:', api.read_team_calendar('龍魂核心', direction='audit'))
    print('Unauthorized read:', api.read_team_calendar('龍魂核心', actor='hacker', direction='training'))
    print('Audit log:', api.get_audit_log(3))
    print('Shame wall:', api.get_shame_wall(3))
