# -*- coding: utf-8 -*-
"""#龍芯⚡️2026-06-29-SECOND-BRAIN-EMBED-BACKFILL-v1.0
为已入库的 chunks 补全本地 TF-IDF+SVD 向量索引
"""
import json
from typing import Dict, Any

from . import config
from .indexer import SecondBrainIndex


def backfill() -> Dict, Any:
    index = SecondBrainIndex(skip_embeddings=False)
    status = index.fit_tfidf()

    result = {
        "ts": config.now_iso(),
        "embed_status": status,
        "dna": f"{config.DNA_PREFIX}{config.now_iso().replace('-','').replace(':','').replace('T','')}-SECOND-BRAIN-EMBED-BACKFILL-v1.0",
    }

    audit_path = config.AUDIT_LOG.with_name("second_brain_embed.jsonl")
    audit_path.parent.mkdir(parents=True, exist_ok=True)
    with open(audit_path, "a", encoding="utf-8") as f:
        f.write(json.dumps(result, ensure_ascii=False) + "\n")

    return result
