#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
服務器到貨前本地準備驗證腳本
DNA: #龍芯⚡️2026-07-01-SERVER-PREP-VALIDATOR-v1.0
"""
import json
import os
import re
import sys
from pathlib import Path

ROOT = Path.home()
CONFIG_PATH = ROOT / ".longhun" / "notion" / "config.json"
MIRROR_PATH = ROOT / ".longhun" / "roster" / "notion_mirror_aligned.json"
TAGS_PATH = ROOT / ".kimi-code" / "skills" / "longhun-tongxinyi" / "scripts" / "longhun_tags.py"
ENV_EXAMPLE_PATH = ROOT / ".longhun" / "notion" / ".env.example"

CHECKS = []

def ok(name, detail=""):
    CHECKS.append(("🟢", name, detail))

def warn(name, detail=""):
    CHECKS.append(("🟡", name, detail))

def fail(name, detail=""):
    CHECKS.append(("🔴", name, detail))

def main():
    # 1. 配置文件
    if CONFIG_PATH.exists():
        try:
            cfg = json.loads(CONFIG_PATH.read_text(encoding="utf-8"))
            ok("Notion 配置文件存在且可解析", str(CONFIG_PATH))
            if "第二大腦映射" in cfg and "分類體系" in cfg["第二大腦映射"]:
                ok("第二大腦映射配置完整")
            else:
                warn("第二大腦映射欄位不完整")
        except Exception as e:
            fail("Notion 配置文件解析失敗", str(e))
    else:
        fail("Notion 配置文件不存在", str(CONFIG_PATH))

    # 2. 鏡像索引
    if MIRROR_PATH.exists():
        try:
            data = json.loads(MIRROR_PATH.read_text(encoding="utf-8"))
            entries = data.get("entries", [])
            ok(f"Notion Mirror 索引存在，條目數 {len(entries)}")
            # 分類檢查
            cats = {e.get("aligned_category") for e in entries}
            if None in cats or "其他" in cats:
                warn("仍有未分類或“其他”條目")
            else:
                ok("所有條目已歸入 8 大類，無“其他”")
            # DNA 規範檢查
            std_re = re.compile(r"^#龍芯⚡️\d{4}-\d{2}-\d{2}-[A-Z0-9\-_]+-v\d+\.?\d*$")
            eternal_re = re.compile(r"^#ZHUGEXIN⚡️")
            bad = [e for e in entries
                   if not std_re.match(e.get("normalized_dna", ""))
                   and not eternal_re.match(e.get("normalized_dna", ""))]
            if bad:
                fail(f"normalized_dna 格式異常 {len(bad)} 條")
            else:
                ok("所有 normalized_dna 格式符合標準（含永恆簽章）")
        except Exception as e:
            fail("Mirror 索引解析失敗", str(e))
    else:
        fail("Mirror 索引不存在", str(MIRROR_PATH))

    # 3. 環境變量
    api_key = os.environ.get("LONGHUN_NOTION_API_KEY") or os.environ.get("NOTION_TOKEN")
    if api_key:
        ok("Notion API Key 已設置（LONGHUN_NOTION_API_KEY 或 NOTION_TOKEN）")
    else:
        fail("缺少 Notion API Key")
    optional = ["LONGHUN_NOTION_MIRROR_DB_ID", "LONGHUN_NOTION_INBOX_DB_ID",
                "NOTION_SNAPSHOT_DB", "NOTION_ASSETS_DB"]
    for k in optional:
        if os.environ.get(k):
            ok(f"可選環境變量已設置: {k}")
        else:
            warn(f"可選環境變量未設置: {k}")

    # 4. 標籤代碼 DNA
    if TAGS_PATH.exists():
        text = TAGS_PATH.read_text(encoding="utf-8")
        if "#龍芯⚡️2026-07-01-LONGHUN-TAG-SYSTEM-v1.0" in text:
            ok("標籤體系代碼 DNA 已與公開文章對齊")
        else:
            warn("標籤體系代碼 DNA 未對齊")
    else:
        warn("標籤體系代碼文件不存在")

    # 5. env 模板
    if ENV_EXAMPLE_PATH.exists():
        ok("Notion .env.example 模板存在")
    else:
        warn("Notion .env.example 模板不存在")

    # 輸出報告
    print("\n=== 龍魂服務器到貨前準備驗證報告 ===\n")
    for status, name, detail in CHECKS:
        line = f"{status} {name}"
        if detail:
            line += f" — {detail}"
        print(line)

    reds = sum(1 for s, _, _ in CHECKS if s == "🔴")
    yellows = sum(1 for s, _, _ in CHECKS if s == "🟡")
    greens = sum(1 for s, _, _ in CHECKS if s == "🟢")
    print(f"\n統計: 🟢{greens} 🟡{yellows} 🔴{reds}")
    print(f"DNA: #龍芯⚡️2026-07-01-SERVER-PREP-VALIDATOR-v1.0")

    return 1 if reds else 0

if __name__ == "__main__":
    sys.exit(main())
