BINARY_EXTENSIONS = {
    ".otf", ".ttf", ".woff", ".woff2", ".png", ".jpg", ".jpeg", ".gif", ".bmp",
    ".ico", ".mp3", ".mp4", ".m4a", ".wav", ".avi", ".mov", ".zip", ".tar",
    ".gz", ".bz2", ".xz", ".7z", ".rar", ".db", ".sqlite", ".sqlite3", ".bin",
    ".exe", ".dll", ".so", ".dylib", ".pdf", ".doc", ".docx", ".xls", ".xlsx",
    ".ppt", ".pptx", ".pyc", ".pyo", ".class", ".jar", ".war", ".ear",
}

KEYWORDS = {
    "chinese_editor": [
        "中文编辑", "chinese-editor", "cnsh_editor", "龍碼編輯器", "编辑器",
        "editor_ui", "local_chinese_editor", "cnsh_runtime", "中文原生", "中文编程",
