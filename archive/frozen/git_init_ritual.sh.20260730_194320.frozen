set -e

ROOT="/Users/zuimeidedeyihan/Downloads/UID9622乱七八糟的脑子"
cd "$ROOT"

CURRENT_SHICHEN=$(python3 - <<'PY'
from datetime import datetime, timedelta
now = datetime.now(timedelta(hours=8))
h = now.hour
for name, s, e in [
    ("子时",23,1),("丑时",1,3),("寅时",3,5),("卯时",5,7),("辰时",7,9),
    ("巳时",9,11),("午时",11,13),("未时",13,15),("申时",15,17),("酉时",17,19),
    ("戌时",19,21),("亥时",21,23)
]:
    if (s < e and s <= h < e) or (s > e and (h >= s or h < e)):
        print(name)
        break
PY
)

echo "🐉 龍魂初现，主权归位"
echo "DNA: #龍芯⚡️2026-06-24-UID9622-GIT-INIT-RITUAL-v1.0"
echo "当前时辰：$CURRENT_SHICHEN"
echo ""

if [ -d ".git" ]; then
    echo "⚠️ Git 仓库已存在，跳过初始化。"
    exit 0
fi

git init
git add .
git commit -m "龍魂初现，主权归位 | $CURRENT_SHICHEN | DNA:#龍芯⚡️2026-06-24-UID9622-GIT-INIT-RITUAL-v1.0"

echo ""
echo "✅ Git 初始化仪式完成。"
echo "第一次提交已打上文化锚点：$CURRENT_SHICHEN"
