#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
🐉 龍魂公民画像引擎 · Notion 同步桥
把亮灯功能产生的六大维度分数、行为记录同步到 Notion 数据库，
方便在 Notion 中做排行榜、仪表盘与长期趋势观察。

环境变量：
  export NOTION_TOKEN="your_integration_token"
  export BEHAVIOR_DB_ID="your_notion_database_id"

用法：
  python3 behavior_notion_sync.py            # 单次同步
  python3 behavior_notion_sync.py --watch    # 每 5 分钟轮询
  python3 behavior_notion_sync.py --status   # 查看本地数据状态
"""

import argparse
import json
import os
import sys
import time
from datetime import datetime
from pathlib import Path
from typing import Dict, List, Optional, Any

import requests

# ═══════════════════════════════════════
# 配置
# ═══════════════════════════════════════

CONFIG = {
    "NOTION_TOKEN": os.getenv("NOTION_TOKEN", ""),
    "DATABASE_ID": os.getenv("BEHAVIOR_DB_ID", "3877125a-9c9f-8136-8e74-c2add2b1d522"),
    "DATA_DIR": Path.home() / "longhun-system" / ".longhun" / "behavior",
    "INTERVAL": 300,          # 5 分钟
    "MAX_RETRIES": 3,
    "RETRY_BACKOFF": 2,
    "API_RATE_LIMIT": 3,      # Notion 3 req/s
    "NOTION_VERSION": "2022-06-28",
}

# ═══════════════════════════════════════
# 速率限制 & 重试
# ═══════════════════════════════════════

class RateLimiter:
    def __init__(self, calls_per_second: float = 3):
        self.min_interval = 1.0 / calls_per_second
        self.last_call_time = 0

    def wait(self):
        now = time.time()
        elapsed = now - self.last_call_time
        if elapsed < self.min_interval:
            time.sleep(self.min_interval - elapsed)
        self.last_call_time = time.time()


rate_limiter = RateLimiter(CONFIG["API_RATE_LIMIT"])


def retry_with_backoff(func, *args, max_retries=3, backoff_base=2, **kwargs):
    last_exception = None
    for attempt in range(max_retries):
        try:
            return func(*args, **kwargs)
        except Exception as e:
            last_exception = e
            if attempt < max_retries - 1:
                wait_time = backoff_base ** attempt
                print(f"  ⚠️  尝试 {attempt+1} 失败: {str(e)[:60]}，{wait_time}s 后重试")
                time.sleep(wait_time)
    raise last_exception


# ═══════════════════════════════════════
# Notion API 封装
# ═══════════════════════════════════════

def notion_headers() -> Dict[str, str]:
    return {
        "Authorization": f"Bearer {CONFIG['NOTION_TOKEN']}",
        "Content-Type": "application/json",
        "Notion-Version": CONFIG["NOTION_VERSION"],
    }


def notion_request(method: str, url: str, json_payload: Optional[Dict] = None) -> Dict[str, Any]:
    rate_limiter.wait()
    response = requests.request(
        method,
        url,
        headers=notion_headers(),
        json=json_payload,
        timeout=20,
    )
    response.raise_for_status()
    return response.json()


def query_database_for_user(uid: str) -> Optional[str]:
    """在 Notion 数据库中查询是否已有该用户的页面，返回 page_id。"""
    url = f"https://api.notion.com/v1/databases/{CONFIG['DATABASE_ID']}/query"
    payload = {
        "filter": {
            "property": "用户ID",
            "title": {"equals": uid},
        }
    }
    data = retry_with_backoff(notion_request, "POST", url, payload)
    results = data.get("results", [])
    if results:
        return results[0]["id"]
    return None


def build_page_properties(uid: str, profile: Dict[str, Any]) -> Dict[str, Any]:
    """把画像转换成 Notion 页面属性。"""
    dimensions = profile.get("六大维度", {})
    lights = [name for name, info in dimensions.items() if info.get("亮灯")]

    return {
        "用户ID": {"title": [{"text": {"content": uid}}]},
        "环保贡献": {"number": dimensions.get("环保贡献", {}).get("分", 0)},
        "信誉分": {"number": dimensions.get("信誉分", {}).get("分", 0)},
        "互动质量": {"number": dimensions.get("互动质量", {}).get("分", 0)},
        "服务分": {"number": dimensions.get("服务分", {}).get("分", 0)},
        "习惯分": {"number": dimensions.get("习惯分", {}).get("分", 0)},
        "真实度加权总分": {"number": profile.get("真实度加权总分", 0)},
        "行为总数": {"number": profile.get("行为总数", 0)},
        "亮灯维度": {"multi_select": [{"name": n} for n in lights]},
        "同步时间": {"date": {"start": datetime.now().isoformat()}},
    }


def sync_user_to_notion(uid: str, profile: Dict[str, Any]) -> Dict[str, Any]:
    """同步单个用户到 Notion，更新或新建页面。"""
    if not CONFIG["NOTION_TOKEN"] or not CONFIG["DATABASE_ID"]:
        raise RuntimeError("缺少 NOTION_TOKEN 或 BEHAVIOR_DB_ID 环境变量")

    page_id = query_database_for_user(uid)
    props = build_page_properties(uid, profile)

    if page_id:
        url = f"https://api.notion.com/v1/pages/{page_id}"
        data = retry_with_backoff(notion_request, "PATCH", url, {"properties": props})
        return {"action": "updated", "page_id": data["id"], "uid": uid}
    else:
        url = "https://api.notion.com/v1/pages"
        payload = {
            "parent": {"database_id": CONFIG["DATABASE_ID"]},
            "properties": props,
        }
        data = retry_with_backoff(notion_request, "POST", url, payload)
        return {"action": "created", "page_id": data["id"], "uid": uid}


# ═══════════════════════════════════════
# 本地数据读取
# ═══════════════════════════════════════

sys.path.insert(0, str(Path.home() / ".kimi-code" / "skills" / "longhun-behavior-engine" / "scripts"))
from 公民画像引擎 import 公民画像引擎


def load_all_profiles() -> Dict[str, Dict]:
    """读取本地所有行为数据，返回 {uid: profile}。"""
    profiles = {}
    if not CONFIG["DATA_DIR"].exists():
        return profiles
    for path in CONFIG["DATA_DIR"].glob("longhun_behavior_*.json"):
        uid = path.stem.replace("longhun_behavior_", "")
        try:
            engine = 公民画像引擎(uid)
            profiles[uid] = engine.计算六大维度()
        except Exception as e:
            print(f"  ❌ 读取 {uid} 失败: {e}")
    return profiles


def run_sync():
    profiles = load_all_profiles()
    if not profiles:
        print("🟡 本地没有行为数据，无需同步")
        return

    if not CONFIG["NOTION_TOKEN"] or not CONFIG["DATABASE_ID"]:
        print("❌ 缺少环境变量 NOTION_TOKEN 或 BEHAVIOR_DB_ID，仅展示本地状态：")
        for uid, profile in profiles.items():
            print(f"  {uid}: 真实度加权总分={profile['真实度加权总分']}, 行为总数={profile['行为总数']}")
        return

    print(f"🔄 开始同步 {len(profiles)} 个用户到 Notion...")
    for uid, profile in profiles.items():
        try:
            result = sync_user_to_notion(uid, profile)
            print(f"  ✅ {uid}: {result['action']} page_id={result['page_id']}")
        except Exception as e:
            print(f"  ❌ {uid} 同步失败: {e}")
    print("🔄 同步完成")


def show_status():
    profiles = load_all_profiles()
    print(f"📊 本地行为数据 ({len(profiles)} 个用户):")
    for uid, profile in profiles.items():
        dims = profile.get("六大维度", {})
        lights = [n for n, i in dims.items() if i.get("亮灯")]
        print(f"  {uid}: 总分={profile['真实度加权总分']} 行为数={profile['行为总数']} 亮灯={','.join(lights) or '无'}")


def main():
    parser = argparse.ArgumentParser(description="龍魂公民画像引擎 Notion 同步")
    parser.add_argument("--watch", action="store_true", help="持续轮询同步")
    parser.add_argument("--status", action="store_true", help="查看本地状态")
    args = parser.parse_args()

    if args.status:
        show_status()
        return

    if args.watch:
        print(f"👁️  进入监听模式，每 {CONFIG['INTERVAL']} 秒同步一次")
        while True:
            run_sync()
            time.sleep(CONFIG["INTERVAL"])
    else:
        run_sync()


if __name__ == "__main__":
    main()
