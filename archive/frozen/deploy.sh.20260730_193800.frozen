#!/bin/bash
# 🌌 龍魂量子存证系统 - 一键部署脚本
# 确认码: #CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z
# UID9622 | 龍芯北辰 | 2026-07-17

set -e

echo "🌌 龍魂量子存证系统 v2.0 部署中..."
echo "确认码: #CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z"
echo ""

# 检查Python3
if ! command -v python3 &> /dev/null; then
    echo "❌ 错误: 需要 Python3 环境"
    exit 1
fi

echo "✅ Python3 已检测到: $(python3 --version)"

# 创建目录
mkdir -p ~/.longhun/storage
echo "✅ 存储目录已创建: ~/.longhun/storage"

# 下载主程序 (用户需替换为实际路径或curl/wget下载)
# curl -o ~/.longhun/longhun_evidence.py [URL]
# 或者手动复制 longhun_evidence.py 到 ~/.longhun/

# 创建快捷命令
if [ -f ~/.longhun/longhun_evidence.py ]; then
    chmod +x ~/.longhun/longhun_evidence.py
    echo "✅ 主程序已就绪"
else
    echo "⚠️  请将 longhun_evidence.py 复制到 ~/.longhun/ 目录"
fi

# 添加到 PATH (可选)
if ! grep -q "longhun" ~/.zshrc 2>/dev/null && ! grep -q "longhun" ~/.bashrc 2>/dev/null; then
    echo 'alias longhun="python3 ~/.longhun/longhun_evidence.py"' >> ~/.bashrc
    echo 'alias longhun="python3 ~/.longhun/longhun_evidence.py"' >> ~/.zshrc 2>/dev/null || true
    echo "✅ 快捷命令 'longhun' 已添加 (重启终端生效)"
fi

echo ""
echo "🎯 部署完成!"
echo ""
echo "用法示例:"
echo "  python3 ~/.longhun/longhun_evidence.py store "要存证的内容""
echo "  python3 ~/.longhun/longhun_evidence.py verify "#龍芯⚡️...""
echo "  python3 ~/.longhun/longhun_evidence.py reconstruct "#龍芯⚡️...""
echo ""
echo "或使用快捷命令 (重启终端后):"
echo "  longhun store "要存证的内容""
echo ""
