#!/bin/bash
# 龍魂系统 · 统一启动器 v4.0
# DNA: #龍芯⚡️丙午·辛未·乙酉·申时·豫-LAUNCHER-v4.0
# 融合: 数据引擎(v2.0) + 节点管理 + 注册中心 + 训练桥接 + 全能登记(v1.0)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

case "$1" in
    # ============ 数据源引擎 ============
    stats|status)
        cd "$SCRIPT_DIR"
        python3 lh_source_manager.py --stats
        ;;
    list)
        cd "$SCRIPT_DIR"
        python3 lh_source_manager.py --list
        ;;
    plan)
        cd "$SCRIPT_DIR"
        python3 lh_source_manager.py --plan
        ;;
    test)
        cd "$SCRIPT_DIR"
        if [ -z "$2" ]; then
            echo "用法: ./lh_launch.sh test <源ID>  如 CN-001"
            exit 1
        fi
        python3 lh_source_manager.py --test "$2"
        ;;
    test-all)
        cd "$SCRIPT_DIR"
        python3 lh_source_manager.py --test-all
        ;;
    fetch)
        cd "$SCRIPT_DIR"
        python3 lh_fetch_engine.py --priority P0
        ;;
    fetch-all)
        cd "$SCRIPT_DIR"
        python3 lh_fetch_engine.py --all
        ;;
    clean)
        cd "$SCRIPT_DIR"
        python3 lh_data_cleaner.py
        ;;
    pipeline)
        cd "$SCRIPT_DIR"
        PRIORITY="${2:-P0}"
        python3 lh_source_manager.py --pipeline "$PRIORITY"
        ;;
    bridge)
        cd "$PROJECT_ROOT"
        if [ "$2" = "train" ]; then
            python3 bin/lh_data_to_train_bridge.py --train
        elif [ "$2" = "full" ]; then
            python3 bin/lh_data_to_train_bridge.py --full-pipeline
        else
            python3 bin/lh_data_to_train_bridge.py --stats
        fi
        ;;

    # ============ 节点管理 (v3.0 新增) ============
    node-install)
        # 一键部署节点 (Docker/本地)
        echo "🐉 节点一键部署..."
        cd "$PROJECT_ROOT"
        bash deploy/longhun-node/longhun-node-install.sh
        ;;
    node-start)
        # 启动本地节点（心跳+审计）
        echo "🐉 启动本地节点..."
        cd "$PROJECT_ROOT"
        REGISTRY="${2:-http://localhost:9623}"
        NODE_ID="LH-Mac-$(hostname)-$(date +%s)"
        echo "📡 注册中心: $REGISTRY"
        echo "🆔 节点ID: $NODE_ID"
        echo ""
        python3 deploy/longhun-node/node_heartbeat.py \
            --registry "$REGISTRY" \
            --node-id "$NODE_ID" \
            --interval 300 &
        HEARTBEAT_PID=$!
        echo "✅ 心跳已启动 (PID: $HEARTBEAT_PID)"
        echo "📋 停止: kill $HEARTBEAT_PID"
        ;;
    node-audit)
        # 运行节点质量审计
        echo "🐉 节点质量审计..."
        cd "$PROJECT_ROOT"
        python3 deploy/longhun-node/node_audit.py
        ;;
    node-audit-daemon)
        # 守护模式审计
        cd "$PROJECT_ROOT"
        python3 deploy/longhun-node/node_audit.py --daemon --interval 3600
        ;;
    node-heartbeat)
        # 单次心跳测试
        cd "$PROJECT_ROOT"
        REGISTRY="${2:-http://localhost:9623}"
        python3 deploy/longhun-node/node_heartbeat.py \
            --registry "$REGISTRY" \
            --once
        ;;

    # ============ 注册中心 (v3.0 新增) ============
    registry-start)
        # 启动注册中心
        PORT="${2:-9623}"
        echo "🐉 启动注册中心 (端口: $PORT)..."
        cd "$PROJECT_ROOT"
        bash deploy/longhun-registry/start_registry.sh "$PORT"
        ;;
    registry-stop)
        # 停止注册中心
        echo "🐉 停止注册中心..."
        PID=$(lsof -ti:9623 2>/dev/null)
        if [ -n "$PID" ]; then
            kill "$PID" 2>/dev/null
            echo "✅ 已停止 (PID: $PID)"
        else
            echo "⚠️  注册中心未运行"
        fi
        ;;
    registry-status)
        # 注册中心状态
        echo "🔍 注册中心状态..."
        if curl -s http://localhost:9623/health > /dev/null 2>&1; then
            echo "🟢 注册中心运行中"
            curl -s http://localhost:9623/health | python3 -m json.tool 2>/dev/null || true
        else
            echo "🔴 注册中心未运行"
        fi
        ;;
    registry-stats)
        # 全局统计
        curl -s http://localhost:9623/stats | python3 -m json.tool 2>/dev/null || \
            echo "⚠️  注册中心不可达，请先执行 registry-start"
        ;;
    registry-nodes)
        # 节点列表
        curl -s http://localhost:9623/nodes | python3 -m json.tool 2>/dev/null || \
            echo "⚠️  注册中心不可达"
        ;;

    # ============ 定时任务 ============
    cron)
        cd "$SCRIPT_DIR"
        bash lh_cron_daily.sh
        ;;
    install-cron)
        cd "$SCRIPT_DIR"
        bash install_cron.sh
        ;;
    full-fetch)
        # 全量抓取: 登记→国内→国际→清洗→入库
        cd "$SCRIPT_DIR"
        bash lh_cron_full_fetch.sh
        ;;
    install-full-cron)
        # 安装全量定时 (crontab + launchd)
        cd "$SCRIPT_DIR"
        bash install_full_cron.sh
        ;;

    # ============ 登记注册 (v4.0 新增) ============
    register)
        # 登记全部145源 + 生成索引
        cd "$SCRIPT_DIR"
        python3 lh_register_all.py --markdown --json
        echo "📝 索引: $SCRIPT_DIR/index-for-codebuddy.md"
        echo "📦 注册表: $SCRIPT_DIR/registry/full_registry.json"
        ;;
    register-stats)
        cd "$SCRIPT_DIR"
        python3 lh_register_all.py --stats
        ;;
    register-subpages)
        # 探测所有源的子页面
        cd "$SCRIPT_DIR"
        python3 lh_register_all.py --subpages
        ;;
    register-full)
        # 全流程: 登记→子页→抓取→索引
        cd "$SCRIPT_DIR"
        python3 lh_register_all.py --full
        ;;

    # ============ 全链路 ============
    all)
        echo "🐉 全链路执行: 登记 → 爬取 → 清洗 → 桥接"
        echo ""
        cd "$SCRIPT_DIR"
        echo "--- Step 0: 登记全部145源 ---"
        python3 lh_register_all.py --markdown --json
        echo ""
        echo "--- Step 1: 爬取 P0 优先级 ---"
        python3 lh_fetch_engine.py --priority P0
        echo ""
        echo "--- Step 2: 爬取 P1 优先级 ---"
        python3 lh_fetch_engine.py --priority P1
        echo ""
        echo "--- Step 3: 国际抓取 ---"
        cd intl && python3 lh_intl_fetch_engine.py; cd "$SCRIPT_DIR"
        echo ""
        echo "--- Step 4: 数据清洗 ---"
        python3 lh_data_cleaner.py
        echo ""
        echo "--- Step 5: 桥接训练数据 ---"
        cd "$PROJECT_ROOT"
        python3 bin/lh_data_to_train_bridge.py --stats
        echo ""
        echo "✅ 全链路完成"
        echo "下一步: ./lh_launch.sh bridge train"
        ;;

    # ============ 帮助 ============
    help|*)
        echo "🐉 龍魂统一启动器 v4.0"
        echo "DNA: #龍芯⚡️丙午·辛未·乙酉·申时·豫-LAUNCHER-v4.0"
        echo ""
        echo "用法: ./lh_launch.sh <命令> [参数]"
        echo ""
        echo "━━━ 数据源引擎 ━━━"
        echo "  stats            增强统计报告"
        echo "  list             列出所有80个源"
        echo "  plan             生成抓取计划"
        echo "  test <ID>        测试单个源连通性"
        echo "  test-all         批量连通性测试"
        echo "  fetch            抓取 P0 优先级"
        echo "  fetch-all        抓取全部已启用源"
        echo "  clean            清洗已拉取数据"
        echo "  pipeline         全流程(抓取→清洗→训练)"
        echo ""
        echo "━━━ 登记注册 (v4.0 新增) ━━━"
        echo "  register         登记全部145源 + 生成索引"
        echo "  register-stats   查看145源统计分布"
        echo "  register-subpages 探测所有源的子页面"
        echo "  register-full    全流程: 登记→子页→抓取→索引"
        echo ""
        echo "━━━ 训练桥接 ━━━"
        echo "  bridge           训练数据统计"
        echo "  bridge train     桥接数据 → 触发LoRA训练"
        echo "  bridge full      全链路: 数据→训练→部署"
        echo ""
        echo "━━━ 节点管理 (v3.0 新增) ━━━"
        echo "  node-install     一键部署节点 (Docker/本地)"
        echo "  node-start [URL] 启动本地节点心跳"
        echo "  node-audit       运行节点质量审计"
        echo "  node-audit-daemon 审计守护模式 (每小时)"
        echo "  node-heartbeat   单次心跳测试"
        echo ""
        echo "━━━ 注册中心 (v3.0 新增) ━━━"
        echo "  registry-start [PORT]   启动注册中心"
        echo "  registry-stop           停止注册中心"
        echo "  registry-status         注册中心状态"
        echo "  registry-stats          全局统计"
        echo "  registry-nodes          节点列表"
        echo ""
        echo "━━━ 定时任务 ━━━"
        echo "  cron             手动执行每日任务 (旧版)"
        echo "  install-cron     安装旧版 crontab"
        echo "  full-fetch       全量抓取: 登记→国内→国际→清洗→入库"
        echo "  install-full-cron 安装全量定时 (crontab+launchd)"
        echo ""
        echo "━━━ 一键全流程 ━━━"
        echo "  all              登记→爬取→清洗→桥接训练数据"
        echo ""
        echo "🐉 快速起步:"
        echo "   1. ./lh_launch.sh register          # 登记全部145源"
        echo "   2. ./lh_launch.sh full-fetch        # 全量抓取"
        echo "   3. ./lh_launch.sh install-full-cron # 安装定时"
        echo ""
        ;;
esac
