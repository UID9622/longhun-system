#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Build 龍魂-daodejing-v4.1.html from source markdowns + ethics anchor.
"""
import re
import os
from collections import Counter
from html import escape

SRC = {
    "v1": "/Users/zuimeidedeyihan/Downloads/道德经81章_龍魂系统解读_v1.0.md",
    "v3": "/Users/zuimeidedeyihan/Downloads/道德经81章_龍魂系统大白话解读_v3.0_完整版.md",
    "v4": "/Users/zuimeidedeyihan/Downloads/道德经81章_龍魂系统大白话解读_完整版_v4.0.md",
    "ethics_py": "/Users/zuimeidedeyihan/Downloads/dao_ethics_anchor.py",
}
OUT = "/Users/zuimeidedeyihan/longhun-system/web/p0-controls/龍魂-daodejing-v4.1.html"

# ---------- helpers ----------
def read_text(path):
    with open(path, "r", encoding="utf-8") as f:
        return f.read()


def md_cell(txt):
    return escape(txt.strip()).replace("\n", "<br>")


def extract_dna(block):
    m = re.search(r"\*\*DNA[追溯码:：]*\*\*\s*(`?)(#[^\s`]+)\1", block)
    return m.group(2) if m else ""


# ---------- v4 parser ----------
def parse_v4(text):
    chapters = {}
    # split by chapter headings
    pattern = re.compile(r"^## 第(\d+)章 · (.+)$", re.M)
    matches = list(pattern.finditer(text))
    for i, m in enumerate(matches):
        num = cn_to_int(m.group(1))
        title = m.group(2).strip()
        start = m.end()
        end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
        block = text[start:end]
        dna = extract_dna(block) or f"#龍芯⚡️2026-07-04-DAODEJING-{num:02d}-{title}-v4.0"
        data = {
            "num": num,
            "title": title,
            "dna": dna,
            "source": "v4.0",
        }
        # table fields
        def field(name):
            r = re.search(rf"^\|\s*\*\*{re.escape(name)}\*\*\s*\|\s*(.+?)\s*\|$", block, re.M)
            return r.group(1).strip() if r else ""
        data["original"] = field("原文")
        data["expert"] = field("專家怎麼翻譯的<錯的>")
        data["correct"] = field("老子實際想說什麼<對的>")
        data["iching"] = field("易經卦象")
        data["sanjiuliu"] = field("三六九")
        data["zodiac"] = field("生肖")
        data["when_use"] = field("什麼時候用")
        data["plain"] = field("大白話")
        # core judgments
        judges = []
        jm = re.search(r"### 核心判斷.*?\n(.*?)\n\*\*DNA追溯:\*\*", block, re.S)
        if jm:
            for line in jm.group(1).strip().splitlines():
                mm = re.match(r"^\d+\.\s*(.+)$", line.strip())
                if mm:
                    judges.append(mm.group(1).strip())
        data["judges"] = judges
        chapters[num] = data
    return chapters


# ---------- v3 parser ----------
CN_NUM = {'一':1,'二':2,'三':3,'四':4,'五':5,'六':6,'七':7,'八':8,'九':9,'十':10,'零':0}
def cn_to_int(s):
    # simple conversion for 一 to 八十一 (no complex compounds beyond 20 needed here)
    if re.match(r"^\d+$", s):
        return int(s)
    total = 0
    cur = 0
    for ch in s:
        n = CN_NUM.get(ch, None)
        if n is None:
            continue
        if n >= 10:
            if cur == 0:
                cur = 1
            total += cur * n
            cur = 0
        else:
            cur = cur * 10 + n
    return total + cur

def parse_v3(text):
    chapters = {}
    pattern = re.compile(r"^### 第([一二三四五六七八九十百零]+)章 · (.+)$", re.M)
    matches = list(pattern.finditer(text))
    for i, m in enumerate(matches):
        num = cn_to_int(m.group(1))
        title = m.group(2).strip()
        start = m.end()
        end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
        block = text[start:end]
        dna = extract_dna(block) or f"#龍芯⚡️2026-07-04-DAO-CH{num:02d}-V3.0"
        data = {"num": num, "title": title, "dna": dna, "source": "v3.0"}
        # original
        om = re.search(r"\*\*原文\*\*:\s*(.+)$", block, re.M)
        data["original"] = om.group(1).strip() if om else ""
        # first table row after header
        rows = re.findall(r"^\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|$", block, re.M)
        # skip header row that contains 易经卦象
        body_rows = [r for r in rows if not re.match(r"^[-:\s]+$", r[0]) and "易经" not in r[3] and "卦象" not in r[3]]
        if body_rows:
            first = body_rows[0]
            data["phrase"] = first[0].strip()
            data["expert"] = first[1].strip().lstrip("").strip()
            data["correct"] = first[2].strip()
            data["iching"] = first[3].strip()
            data["sanjiuliu"] = first[4].strip()
            data["zodiac"] = first[5].strip()
            data["when_use"] = first[6].strip()
            data["plain"] = first[7].strip()
            # extra candidates for filling judgments
            data["extra_candidates"] = [r[2].strip().lstrip("*").strip() for r in body_rows[1:]] + [r[7].strip().lstrip("*").strip() for r in body_rows]
        else:
            data.update({"phrase": "", "expert": "", "correct": "", "iching": "", "sanjiuliu": "", "zodiac": "", "when_use": "", "plain": "", "extra_candidates": []})
        # core judgments
        judges = []
        jm = re.search(r"\*\*核心判断.*?\n(.*?)\n---", block, re.S)
        if jm:
            for line in jm.group(1).strip().splitlines():
                mm = re.match(r"^\d+\.\s*(.+)$", line.strip())
                if mm:
                    judges.append(mm.group(1).strip())
        data["judges"] = judges
        chapters[num] = data
    return chapters


# ---------- v1 parser ----------
def parse_v1(text):
    chapters = {}
    pattern = re.compile(r"^### 第([一二三四五六七八九十百零]+)章 · (.+)$", re.M)
    matches = list(pattern.finditer(text))
    for i, m in enumerate(matches):
        num = cn_to_int(m.group(1))
        title = m.group(2).strip()
        start = m.end()
        end = matches[i + 1].start() if i + 1 < len(matches) else len(text)
        block = text[start:end]
        dna = extract_dna(block) or f"#龍芯⚡️2026-07-04-DAO-CH{num:02d}"
        data = {"num": num, "title": title, "dna": dna, "source": "v1.0"}
        om = re.search(r"\*\*原文\*\*:\s*(.+)$", block, re.M)
        data["original"] = om.group(1).strip() if om else ""
        # rows: | 原文 | 常规翻译 | 龍魂解读 | 易经卦象 | 三六九 | 生肖 |
        rows = re.findall(r"^\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|\s*([^|]+?)\s*\|$", block, re.M)
        body_rows = [r for r in rows if not re.match(r"^[-:\s]+$", r[0]) and "易经" not in r[3] and "卦象" not in r[3]]
        if body_rows:
            first = body_rows[0]
            data["phrase"] = first[0].strip()
            data["expert"] = first[1].strip()
            data["correct"] = first[2].strip()
            data["iching"] = first[3].strip()
            data["sanjiuliu"] = first[4].strip()
            data["zodiac"] = first[5].strip()
            data["extra_candidates"] = [r[2].strip().lstrip("*").strip() for r in body_rows]
        else:
            data.update({"phrase": "", "expert": "", "correct": "", "iching": "", "sanjiuliu": "", "zodiac": "", "extra_candidates": []})
        # plain summary = correct of first phrase if available
        data["plain"] = data.get("correct", "")
        # core judgments: bullet list after **核心判断**:
        judges = []
        jm = re.search(r"\*\*核心判断\*\*:\s*\n(.*?)(?:\n---|\n###|\n##|$)", block, re.S)
        if jm:
            for line in jm.group(1).strip().splitlines():
                line = line.strip()
                if line.startswith("-"):
                    judges.append(line.lstrip("- ").strip())
                elif re.match(r"^\d+\.\s", line):
                    judges.append(re.sub(r"^\d+\.\s*", "", line).strip())
        data["judges"] = judges
        chapters[num] = data
    return chapters


# ---------- ethics rules parser ----------
def parse_ethics(text):
    rules = []
    # find DaoRule("...", int, "...", "...", EthicsLevel.XXX, "...", [...])
    pat = re.compile(
        r'DaoRule\("([^"]+)",\s*(\d+),\s*"([^"]*)",\s*"([^"]*)",\s*EthicsLevel\.([A-Z_]+),\s*"([^"]*)"(?:,\s*(\[[^\]]*\]))?\)',
        re.S
    )
    for m in pat.finditer(text):
        rules.append({
            "id": m.group(1),
            "chapter": int(m.group(2)),
            "title": m.group(3),
            "content": m.group(4),
            "level": m.group(5),
            "plain": m.group(6),
        })
    return rules


# ---------- merge ----------
def normalize_sanjiuliu(val):
    v = val.strip()
    if not v:
        return ""
    # keep numeric or text
    if re.search(r"[369]", v):
        # extract number and append label
        n = re.search(r"([369])", v).group(1)
        labels = {"3": "变点", "6": "稳点", "9": "极点"}
        return f"{n}（{labels[n]}）" if "(" not in v else v
    return v


def fill_judges(judges, correct_text="", extra_candidates=None):
    # ensure 5
    out = [j for j in judges if j]
    sources = []
    if correct_text:
        sources.append(correct_text)
    if extra_candidates:
        sources.extend(extra_candidates)
    for src in sources:
        if len(out) >= 5:
            break
        # split by sentence punctuation or list bullets
        parts = [p.strip().lstrip("-* ").strip() for p in re.split(r"[。；;\n]", src) if p.strip()]
        for p in parts:
            if len(p) < 6:
                continue
            # avoid duplicates (ignore markdown bold)
            plain_p = re.sub(r"\*\*", "", p)
            if not any(plain_p in re.sub(r"\*\*", "", o) or re.sub(r"\*\*", "", o) in plain_p for o in out):
                out.append(p)
            if len(out) >= 5:
                break
    while len(out) < 5:
        out.append("待補")
    return out[:5]


def fill_plain(data):
    if data.get("plain"):
        return data["plain"]
    if data.get("correct"):
        # take first sentence
        for s in re.split(r"[。；]", data["correct"]):
            if s.strip():
                return s.strip()
    if data.get("when_use"):
        return data["when_use"]
    return "待補"


def fill_iching(data):
    return data.get("iching") or "待補"


def fill_zodiac(data):
    return data.get("zodiac") or "龍"


def fill_sanjiuliu(data):
    v = data.get("sanjiuliu", "")
    return normalize_sanjiuliu(v) if v else "6（稳点）"


def build_merged():
    v4 = parse_v4(read_text(SRC["v4"]))
    v3 = parse_v3(read_text(SRC["v3"]))
    v1 = parse_v1(read_text(SRC["v1"]))
    rules = parse_ethics(read_text(SRC["ethics_py"]))

    merged = {}
    # 21-81 from v4
    for n in range(21, 82):
        if n in v4:
            merged[n] = dict(v4[n])
        else:
            merged[n] = {"num": n, "title": "待補", "source": "missing", "original": "", "judges": []}
    # 14-20 from v3, v1 fallback
    for n in range(14, 21):
        if n in v3:
            merged[n] = dict(v3[n])
        elif n in v1:
            merged[n] = dict(v1[n])
        else:
            merged[n] = {"num": n, "title": "待補", "source": "missing", "original": "", "judges": []}
    # 1-13 from v1
    for n in range(1, 14):
        if n in v1:
            merged[n] = dict(v1[n])
        else:
            merged[n] = {"num": n, "title": "待補", "source": "missing", "original": "", "judges": []}

    # enrich / normalize
    stats = {"original_missing": 0, "field_missing": 0, "judge_missing": 0}
    for n in range(1, 82):
        d = merged[n]
        if not d.get("original"):
            stats["original_missing"] += 1
        for field in ["iching", "sanjiuliu", "zodiac"]:
            if not d.get(field):
                stats["field_missing"] += 1
        d["plain"] = fill_plain(d)
        d["iching"] = fill_iching(d)
        d["zodiac"] = fill_zodiac(d)
        d["sanjiuliu"] = fill_sanjiuliu(d)
        d["when_use"] = d.get("when_use") or d.get("plain") or "待補"
        d["expert"] = d.get("expert") or "待補"
        d["correct"] = d.get("correct") or d.get("plain") or "待補"
        before = len([j for j in d.get("judges", []) if j])
        d["judges"] = fill_judges(d.get("judges", []), d.get("correct", ""), d.get("extra_candidates", []))
        if before < 5:
            stats["judge_missing"] += 1
        # per-chapter DNA
        title_clean = re.sub(r"[·\s]+", "-", d["title"]).strip("-") or "章"
        d["chapter_dna"] = f"#龍芯⚡️2026-07-05-DAODEJING-{n:02d}-{title_clean}-v4.1"
        # related rules
        d["rules"] = [r for r in rules if r["chapter"] == n]

    return merged, rules, stats


# ---------- HTML generation ----------
LEVEL_INFO = {
    "DAO": {"name": "道級", "color": "#4ade80", "icon": "🟢"},
    "DE": {"name": "德級", "color": "#60a5fa", "icon": "🟢"},
    "REN": {"name": "仁級", "color": "#facc15", "icon": "🟡"},
    "YI": {"name": "義級", "color": "#fb923c", "icon": "🟡"},
    "LI": {"name": "禮級", "color": "#f87171", "icon": "🔴"},
    "WUDAO": {"name": "無道", "color": "#ef4444", "icon": "🔴"},
}


def render_html(merged, rules, stats):
    chapters_html = []
    index_items = []
    for n in range(1, 82):
        d = merged[n]
        index_items.append(f'<a href="#ch{n}" class="idx-link" data-title="{escape(d["title"])}">第{n}章 · {escape(d["title"])}</a>')
        prev = f'<a href="#ch{n-1}" class="nav-link">← 上一章</a>' if n > 1 else '<span class="nav-link disabled">← 上一章</span>'
        next_ = f'<a href="#ch{n+1}" class="nav-link">下一章 →</a>' if n < 81 else '<span class="nav-link disabled">下一章 →</span>'
        rules_html = ""
        if d["rules"]:
            rules_html = '<div class="ethics-box"><h3>⚓ 本章倫理錨點</h3><ul>'
            for r in d["rules"]:
                info = LEVEL_INFO.get(r["level"], LEVEL_INFO["DAO"])
                rules_html += f'<li><span class="level-badge" style="color:{info["color"]}">{info["icon"]} {info["name"]}</span> <strong>{escape(r["id"])} · {escape(r["title"])}</strong>：{escape(r["plain"])}</li>'
            rules_html += "</ul></div>"
        else:
            rules_html = '<div class="ethics-box"><h3>⚓ 本章倫理錨點</h3><p class="muted">本章無直接映射規則（可參考上位章節）。</p></div>'

        judges_html = "".join(f"<li>{escape(j)}</li>" for j in d["judges"])

        chapters_html.append(f'''
<section id="ch{n}" class="chapter">
  <div class="ch-header">
    <div class="ch-num">第 {n} 章</div>
    <h2>{escape(d["title"])}</h2>
    <div class="ch-meta">
      <span class="pill">{escape(d["iching"])}</span>
      <span class="pill">{escape(d["sanjiuliu"])}</span>
      <span class="pill">生肖 · {escape(d["zodiac"])}</span>
    </div>
    <div class="dna">{escape(d["chapter_dna"])}</div>
  </div>
  <div class="ch-body">
    <div class="card original">
      <h3>📜 原文</h3>
      <p>{escape(d["original"])}</p>
    </div>
    <div class="card">
      <h3>💡 大白話翻譯</h3>
      <p>{escape(d["plain"])}</p>
    </div>
    <div class="grid2">
      <div class="card"><h4>專家怎麼翻譯的（錯的）</h4><p>{escape(d["expert"])}</p></div>
      <div class="card"><h4>老子實際想說什麼（對的）</h4><p>{escape(d["correct"])}</p></div>
    </div>
    <div class="card">
      <h3>🎯 什麼時候用</h3>
      <p>{escape(d["when_use"])}</p>
    </div>
    <div class="card judges">
      <h3>⚡ 核心判斷（5條戰場經驗）</h3>
      <ol>{judges_html}</ol>
    </div>
    {rules_html}
  </div>
  <div class="ch-footer">
    {prev}
    <a href="#index" class="nav-link">章節索引 ↑</a>
    {next_}
  </div>
</section>
''')

    index_grid = "\n".join(index_items)
    core_rules = [r for r in rules if r["level"] != "WUDAO"]
    total_rules = len(core_rules)

    html = f'''<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>龍魂 · 道德經81章 · v4.1 全量版 · UID9622</title>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E🐉%3C/text%3E%3C/svg%3E">
<style>
:root{{
  --bg:#0a0a0f;
  --panel:#12121a;
  --panel2:#1a1a24;
  --text:#e2e2ea;
  --muted:#9ca3af;
  --accent:#a78bfa;
  --accent2:#22d3ee;
  --border:#2a2a3a;
  --green:#4ade80;
  --red:#f87171;
  --yellow:#facc15;
}}
*{{box-sizing:border-box;margin:0;padding:0}}
html{{scroll-behavior:smooth}}
body{{
  font-family:"Noto Sans SC","PingFang SC","Microsoft YaHei",sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.7;
}}
a{{color:var(--accent);text-decoration:none}}
a:hover{{text-decoration:underline}}
.container{{max-width:920px;margin:0 auto;padding:24px}}
.topbar{{
  display:flex;justify-content:space-between;align-items:center;
  padding:16px 0;border-bottom:1px solid var(--border);margin-bottom:24px;
  flex-wrap:wrap;gap:12px;
}}
.topbar .brand{{font-size:18px;font-weight:700;color:var(--accent)}}
.topbar .dna{{font-family:monospace;font-size:12px;color:var(--muted)}}
.hero{{
  text-align:center;padding:40px 20px;border:1px solid var(--border);
  border-radius:16px;background:linear-gradient(180deg,var(--panel),rgba(18,18,26,0));
  margin-bottom:30px;
}}
