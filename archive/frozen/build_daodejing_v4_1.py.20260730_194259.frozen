  background:var(--panel);border:1px solid var(--border);border-radius:14px;padding:22px;margin-bottom:30px;
}}
.ethics-layer h2{{font-size:20px;color:var(--accent);margin-bottom:14px}}
.decay-bar{{
  display:flex;height:28px;border-radius:8px;overflow:hidden;margin:14px 0;border:1px solid var(--border);
}}
