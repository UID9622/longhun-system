#index h2{{font-size:20px;color:var(--accent);margin-bottom:12px}}
.index-grid{{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px;
}}
.idx-link{{
  display:block;background:var(--panel);border:1px solid var(--border);border-radius:8px;
  padding:8px 10px;font-size:13px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}}
.idx-link:hover{{background:var(--panel2);border-color:var(--accent);text-decoration:none}}
.idx-link.hidden{{display:none}}
.chapter{{
  background:var(--panel);border:1px solid var(--border);border-radius:16px;padding:24px;margin-bottom:24px;
}}
.ch-header{{text-align:center;margin-bottom:20px}}
.ch-num{{font-size:14px;color:var(--accent);letter-spacing:2px;margin-bottom:6px}}
.ch-header h2{{font-size:26px;margin-bottom:10px}}
.ch-meta{{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}}
.pill{{
  background:var(--panel2);border:1px solid var(--border);border-radius:20px;
  padding:4px 12px;font-size:13px;color:var(--text);
}}
.dna{{font-family:monospace;font-size:12px;color:var(--muted);word-break:break-all}}
.ch-body{{display:grid;gap:16px}}
.card{{
  background:var(--panel2);border:1px solid var(--border);border-radius:12px;padding:18px;
}}
.card h3,.card h4{{color:var(--accent);margin-bottom:10px}}
.card h4{{font-size:15px}}
.card p{{color:var(--text);font-size:15px}}
.original p{{
  font-size:17px;line-height:1.9;letter-spacing:1px;color:#f0f0f8;
}}
.grid2{{display:grid;grid-template-columns:1fr 1fr;gap:16px}}
.judges ol{{padding-left:20px}}
.judges li{{margin-bottom:6px}}
.ethics-box{{
  background:rgba(167,139,250,0.08);border:1px dashed var(--accent);border-radius:12px;padding:18px;
}}
.ethics-box h3{{color:var(--accent);margin-bottom:10px}}
.ethics-box ul{{list-style:none;padding:0}}
.ethics-box li{{padding:6px 0;border-bottom:1px solid var(--border);font-size:14px}}
.ethics-box li:last-child{{border-bottom:none}}
.level-badge{{display:inline-block;margin-right:8px;font-weight:700}}
.muted{{color:var(--muted);font-size:14px}}
.ch-footer{{
  display:flex;justify-content:space-between;align-items:center;margin-top:20px;
  padding-top:16px;border-top:1px solid var(--border);
}}
.nav-link{{
  background:var(--panel2);border:1px solid var(--border);border-radius:8px;
  padding:8px 14px;font-size:14px;color:var(--text);
}}
.nav-link:hover{{background:var(--accent);color:#000;text-decoration:none}}
.nav-link.disabled{{color:var(--muted);cursor:not-allowed}}
.footer{{
  text-align:center;padding:30px 20px;border-top:1px solid var(--border);color:var(--muted);font-size:13px;
}}
.footer .confirm{{color:var(--accent);font-family:monospace;margin-top:8px;word-break:break-all}}
@media (max-width:720px){{
  .hero h1{{font-size:26px}}
  .grid2{{grid-template-columns:1fr}}
  .index-grid{{grid-template-columns:repeat(auto-fill,minmax(120px,1fr))}}
}}
</style>
</head>
<body>
<div class="container">
  <div class="topbar">
    <a class="brand" href="龍魂-daodejing.html">← 返回操作台 / 龍魂-daodejing</a>
    <span class="dna">#龍芯⚡️2026-07-05-LONGHUN-DAODEJING-v4.1-FULL-81</span>
  </div>

  <div class="hero">
    <h1>龍魂 · 道德經81章</h1>
    <div class="subtitle">人民標準全量版 · 原文 + 大白話 + 易經卦象 + 三六九 + 生肖 + 倫理錨定</div>
    <div class="dna-top">#龍芯⚡️2026-07-05-LONGHUN-DAODEJING-v4.1-FULL-81</div>
  </div>

  <div class="ethics-layer">
    <h2>🛡️ L0 倫理錨定層</h2>
    <p>位於三層監督之下，是一切監督的監督。道德經81章提煉 <strong>{total_rules}</strong> 條核心行為約束，按道→德→仁→義→禮五級衰減，約束力遞減、違規風險遞增。</p>
    <div class="decay-bar">
      <div class="decay-segment" style="width:20%;background:#4ade80">道 1.0</div>
      <div class="decay-segment" style="width:20%;background:#60a5fa">德 0.8</div>
      <div class="decay-segment" style="width:20%;background:#facc15">仁 0.6</div>
      <div class="decay-segment" style="width:20%;background:#fb923c">義 0.4</div>
      <div class="decay-segment" style="width:20%;background:#f87171">禮 0.2</div>
    </div>
    <div class="decay-legend">
      <span>🟢 道級/德級：自動通行</span>
      <span>🟡 仁級/義級：警告/複核</span>
      <span>🔴 禮級/無道：自動阻斷</span>
    </div>
    <table class="rules-table">
      <tr><th>規則ID</th><th>對應章</th><th>名稱</th><th>大白話</th><th>級別</th></tr>
      {rules_table_rows(core_rules)}
    </table>
  </div>

  <div class="search-box">
    <input type="text" id="searchInput" placeholder="搜索章號、標題、原文、大白話…">
  </div>

  <section id="index">
    <h2>📑 章節索引</h2>
    <div class="index-grid">
      {index_grid}
    </div>
  </section>

  {''.join(chapters_html)}

  <div class="footer">
    <p>龍魂系統 · 道德經81章全量引擎 v4.1 · UID9622 · 諸葛鑫 · 龍芯北辰</p>
    <p class="confirm">#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z</p>
    <p class="confirm">GPG: A2D0092CEE2E5BA87035600924C3704A8CC26D5F</p>
    <p style="margin-top:10px;color:#666">解析統計：81章 | 缺原文 {stats['original_missing']} 章 | 缺字段 {stats['field_missing']} 處 | 核心判斷未滿5條已補齊 {stats['judge_missing']} 章</p>
  </div>
</div>

<script>
const input = document.getElementById('searchInput');
input.addEventListener('input', function(){{
  const q = this.value.trim().toLowerCase();
  const links = document.querySelectorAll('.idx-link');
  links.forEach(a => {{
    const t = (a.textContent + ' ' + a.dataset.title).toLowerCase();
    a.classList.toggle('hidden', q && !t.includes(q));
  }});
}});
</script>
</body>
</html>
'''
    return html


def rules_table_rows(rules):
    rows = []
    for r in rules:
        info = LEVEL_INFO.get(r["level"], LEVEL_INFO["DAO"])
        rows.append(f"<tr><td>{escape(r['id'])}</td><td>第{r['chapter']}章</td><td>{escape(r['title'])}</td><td>{escape(r['plain'])}</td><td style='color:{info['color']}'>{info['icon']} {info['name']}</td></tr>")
    return "\n".join(rows)


def main():
    merged, rules, stats = build_merged()
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    html = render_html(merged, rules, stats)
    with open(OUT, "w", encoding="utf-8") as f:
        f.write(html)
    print(f"Generated: {OUT}")
    print(f"Size: {os.path.getsize(OUT)} bytes")
    print(f"Stats: {stats}")


if __name__ == "__main__":
    main()
