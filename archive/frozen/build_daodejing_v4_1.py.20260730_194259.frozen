.search-box{{
  position:sticky;top:10px;z-index:50;background:rgba(10,10,15,0.92);
  border:1px solid var(--border);border-radius:10px;padding:12px 16px;margin-bottom:20px;
  backdrop-filter:blur(6px);
}}
.search-box input{{
  width:100%;background:var(--bg);border:1px solid var(--border);border-radius:8px;
  padding:10px 14px;color:var(--text);font-size:15px;outline:none;
}}
