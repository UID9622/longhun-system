"""
离火运指数：把系统压力翻译成文化建议。
DNA: #龍芯⚡️2026-06-24-UID9622-BRAIN-LIHUO-v1.0
"""

from typing import Dict


def calculate_lihuo_index(error_count: int, warning_count: int, health_score: int) -> Dict[str, object]:
    """
    计算离火运指数。
    指数越高，代表系统越"燥"，越需要降温、静修、不对外。
    """
    raw = error_count * 1.5 + warning_count * 0.5 + (100 - health_score) * 0.3
    index = min(100, max(0, int(raw)))
    if index >= 80:
        level = "🔥 离火大盛"
        advice = "今日宜静修，忌对外发布；优先排查日志、备份、清理缓存。"
    elif index >= 50:
        level = "🌡️ 火气偏旺"
        advice = "系统压力可见，宜做小修小补，不宜做架构大改。"
    elif index >= 20:
        level = "🍃 温润"
        advice = "状态尚可，可稳步推进日常任务。"
    else:
        level = "❄️ 清凉"
        advice = "系统清静，是发布、对外连接的好时机。"
    return {
        "离火运指数": index,
        "等级": level,
        "建议": advice,
        "输入": {
            "日志错误数": error_count,
            "日志警告数": warning_count,
            "健康评分": health_score,
        },
    }