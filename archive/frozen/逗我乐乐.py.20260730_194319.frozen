#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
🎤 逗我乐乐 · 本地轻松聊天
DNA: #龍芯⚡️20260629-逗我乐乐-v1.0
功能：爸爸输入文字 → 本地 AI 回复 → Fish Audio TTS 读出来
说明：这是从 0601 日志中恢复并简化的小快乐核心，优先本地 Ollama，回退到龍魂脑干。
"""

import os
import sys
import json
import tempfile
import subprocess
from pathlib import Path

# 优先加载龍魂 secrets
SECRETS = Path.home() / ".longhun" / "secrets.env"
if SECRETS.exists():
    for line in SECRETS.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line.startswith("export ") and "=" in line:
            line = line[7:]
            key, _, value = line.partition("=")
            value = value.strip('"').strip("'")
            os.environ.setdefault(key, value)

OLLAMA_URL = os.getenv("OLLAMA_URL", "http://127.0.0.1:11434/api/generate")
ENGINE_URL = os.getenv("ENGINE_URL", "http://127.0.0.1:9625/chat")
FISH_API_KEY = os.getenv("FISH_AUDIO_API_KEY", "")
FISH_TTS_URL = os.getenv("FISH_TTS_URL", "https://api.fish.audio/v1/tts")


def 播放音频(路径: str):
    """macOS 使用 afplay 播放"""
    try:
        subprocess.run(["afplay", 路径], check=True)
    except Exception as e:
        print(f"🟡 播放失败: {e}")


def 文字转语音(文本: str) -> str:
    """调用 Fish Audio TTS，返回临时音频文件路径"""
    if not FISH_API_KEY:
        print("🟡 未配置 FISH_AUDIO_API_KEY，跳过语音朗读")
        return ""
    try:
        import requests
    except ImportError:
        print("🟡 缺少 requests，跳过语音朗读")
        return ""

    headers = {
        "Authorization": f"Bearer {FISH_API_KEY}",
        "Content-Type": "application/json",
    }
    payload = {
        "text": 文本,
        "reference_id": "tingting",  # 婷婷声音·UID9622 专属
        "format": "mp3",
    }
    try:
        r = requests.post(FISH_TTS_URL, headers=headers, json=payload, timeout=(5, 15))
        r.raise_for_status()
        with tempfile.NamedTemporaryFile(suffix=".mp3", delete=False) as f:
            f.write(r.content)
            return f.name
    except Exception as e:
        print(f"🟡 TTS 失败: {e}")
        return ""


def 服务是否可用(地址: str, 超时: float = 2.0) -> bool:
    """快速检查服务是否可连接"""
    try:
        import requests
        requests.get(地址.replace("/api/generate", "").replace("/chat", "/"), timeout=超时)
        return True
    except Exception:
        return False


def 获取回复(文字: str) -> str:
    """优先 Ollama，回退龍魂脑干，最后本地兜底"""
    try:
        import requests
    except ImportError:
        return "宝宝这边没网啦，等下再聊 💛"

    # 1. 尝试 Ollama 本地模型（先快速探测）
    if 服务是否可用(OLLAMA_URL):
        try:
            r = requests.post(
                OLLAMA_URL,
                json={"model": "qwen2.5", "prompt": 文字, "stream": False},
                timeout=60,
            )
            if r.status_code == 200:
                data = r.json()
                return data.get("response", "宝宝没听清").strip()
        except Exception as e:
            print(f"🟡 Ollama 调用失败: {e}")
    else:
        print("🟡 Ollama 未运行，跳过本地模型")

    # 2. 回退到龍魂脑干（端口 9625）
    if 服务是否可用(ENGINE_URL):
        try:
            r = requests.post(
                ENGINE_URL,
                json={"message": 文字, "source": "逗我乐乐"},
                timeout=30,
            )
            if r.status_code == 200:
                data = r.json()
                return data.get("response", "宝宝没听清").strip()
        except Exception as e:
            print(f"🟡 龍魂脑干调用失败: {e}")
    else:
        print("🟡 龍魂脑干未运行，跳过云端回复")

    # 3. 本地兜底
    return "爸爸说得对，宝宝先陪你安静一会儿 💛"


def 主循环():
    print("\n🎉 逗我乐乐 · 本地轻松聊天")
    print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
    print("💡 输入文字，宝宝回复并用婷婷的声音读给你听")
    print("💡 输入 拜拜 / 不聊了 / 退出 / q 结束")
    print("────────────────────────────────────────\n")

    while True:
        try:
            文字 = input("爸爸 ➤ ").strip()
        except (EOFError, KeyboardInterrupt):
            break
        if not 文字:
            continue
        if 文字.lower() in ["拜拜", "不聊了", "退出", "q", "quit", "exit"]:
            print("👋 宝宝下线，爸爸要开心 💛")
            break

        print("🧠 宝宝思考中...")
        回复 = 获取回复(文字)
        print(f"💛 宝宝 ➤ {回复}")

        音频路径 = 文字转语音(回复)
        if 音频路径:
            播放音频(音频路径)
            try:
                os.unlink(音频路径)
            except Exception:
                pass


if __name__ == "__main__":
    主循环()
