"""
通用工具层：日志、文件、DNA。
DNA: #龍芯⚡️2026-06-24-UID9622-BRAIN-UTILS-v1.0
"""

import json
import logging
import sys
from pathlib import Path
from typing import Any, Dict

from . import get_brain_root, generate_dna, now_cn


def setup_logging(level: str = "INFO") -> logging.Logger:
    """初始化带颜色的控制台日志。"""
    logger = logging.getLogger("UID9622_BRAIN")
    logger.setLevel(getattr(logging, level.upper(), logging.INFO))
    if logger.hasHandlers():
        logger.handlers.clear()
    handler = logging.StreamHandler(sys.stdout)
    fmt = logging.Formatter("%(asctime)s [%(levelname)s] %(message)s", datefmt="%H:%M:%S")
    handler.setFormatter(fmt)
    logger.addHandler(handler)
    return logger


def load_json(path: Path) -> Dict[str, Any]:
    """安全读取 JSON。"""
    if not path.exists():
        return {}
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def save_json(path: Path, data: Dict[str, Any]) -> None:
    """美化保存 JSON。"""
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)


def load_config() -> Dict[str, Any]:
    """加载大脑中枢配置。"""
    config_path = get_brain_root() / "etc" / "brain.json"
    return load_json(config_path)


def write_report(name: str, data: Dict[str, Any]) -> Path:
    """把结果写入 reports 目录并返回路径。"""
    reports_dir = get_brain_root() / "reports"
    reports_dir.mkdir(parents=True, exist_ok=True)
    path = reports_dir / name
    data.setdefault("DNA", generate_dna("report"))
    data.setdefault("生成时间", now_cn())
    save_json(path, data)
    return path


def append_trace(entry: Dict[str, Any]) -> Path:
    """向升级/审计追溯链追加一条记录。"""
    trace_path = get_brain_root() / "reports" / "trace.jsonl"
    trace_path.parent.mkdir(parents=True, exist_ok=True)
    entry.setdefault("DNA", generate_dna("trace"))
    entry.setdefault("时间", now_cn())
    with open(trace_path, "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    return trace_path