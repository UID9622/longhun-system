#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂自审闭环模块 · 左右互搏审计
对系统对齐性、主权边界、公开内容吸收、官网展示、DNA追溯进行自检，
并生成 Audit Report + 对抗性复核记录。
DNA: #龍芯⚡️2026-06-28-LONGHUN-SELF-AUDIT-LOOP-v1.0
"""
import json, os, re, sqlite3, stat, subprocess, sys, urllib.error, urllib.request
from datetime import datetime, timezone
from pathlib import Path

DB = "/Users/zuimeidedeyihan/_work/dragon_knowledge.db"
REPORT = "/Users/zuimeidedeyihan/_work/self_audit_report.json"
APP_DIR = "/Users/zuimeidedeyihan/Downloads/app"
CORE_PATHS = [
    ("~/longhun-system/core", 0o555),
    ("~/.龍魂/铁律", 0o555),
    ("~/.龍魂/宪法", 0o444),
]
KEY_FILES = [
    (APP_DIR + "/src/App.tsx", r"#龍芯⚡️"),
    (APP_DIR + "/src/sections/CommandCenter.tsx", r"#龍芯⚡️"),
    (APP_DIR + "/src/sections/PublicDocuments.tsx", r"#龍芯⚡️"),
    (APP_DIR + "/server.py", r"#龍芯⚡️"),
    ("/Users/zuimeidedeyihan/_work/public_content_absorber.py", r"#龍芯⚡️"),
    (os.path.expanduser("~/.龍魂/指挥调度中心/model_registry.json"), r"#龍芯⚡️"),
]
DNA_RE = re.compile(
    r"#[龍龙]芯[\u26a1\ufe0f]*\d{4}(?:[-_]\d{2}){0,2}[-_][A-Za-z0-9\u4e00-\u9fff\-_\/]+(?:[-_][vV]\d+(?:\.\d+)?)?|"
    r"#ZHUGEXIN[\u26a1\ufe0f]*\d{4}[-_][\u4e00-\u9fffA-Za-z0-9\-_\/]+(?:[-_][vV]\d+(?:\.\d+)?)?|"
    r"#CONFIRM[🌌🌀]?9622-ONLY-ONCE[🧬]?[A-Za-z0-9\-]+|"
    r"DNA::[A-Z]+-9622-\d{8}(?:-\d{6})?[-_][A-Za-z0-9\-_\/]+[-_][Vv]\d+(?:\.\d+)?",
    re.UNICODE,
)


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def check_core_locks():
    findings = []
    for raw, expected_mode in CORE_PATHS:
        p = Path(raw).expanduser()
        if not p.exists():
            findings.append({"item": f"核心边界 {raw}", "status": "🔴", "detail": "路径不存在"})
            continue
        mode = stat.S_IMODE(p.stat().st_mode)
        if mode == expected_mode:
            findings.append({"item": f"核心边界 {raw}", "status": "🟢", "detail": f"权限 {oct(mode)}"})
        else:
            findings.append({"item": f"核心边界 {raw}", "status": "🟡", "detail": f"当前权限 {oct(mode)}，建议 {oct(expected_mode)}"})
    return findings


def check_dna_in_files():
    findings = []
    for path, pattern in KEY_FILES:
        p = Path(path)
        if not p.exists():
            findings.append({"item": f"DNA追溯 {path}", "status": "🔴", "detail": "文件不存在"})
            continue
        text = p.read_text(encoding="utf-8", errors="ignore")
        has_dna = DNA_RE.search(text) is not None
        if has_dna:
            findings.append({"item": f"DNA追溯 {p.name}", "status": "🟢", "detail": "已检测到 DNA 标记"})
        else:
            findings.append({"item": f"DNA追溯 {p.name}", "status": "🔴", "detail": "未检测到 DNA 标记"})
    return findings


def check_public_absorption():
    findings = []
    index = Path("/Users/zuimeidedeyihan/_work/public_sources_index.json")
    if not index.exists():
        findings.append({"item": "公开内容索引", "status": "🔴", "detail": "索引文件不存在"})
        return findings
    sources = json.loads(index.read_text(encoding="utf-8"))
    conn = sqlite3.connect(DB)
    cur = conn.cursor()
    cur.execute("SELECT COUNT(*) FROM knowledge_modules WHERE source LIKE '%gitcode%' OR source LIKE '%github%' OR source LIKE '%csdn%'")
    db_count = cur.fetchone()[0]
    conn.close()
    if db_count >= len(sources):
        findings.append({"item": "公开内容吸收", "status": "🟢", "detail": f"索引 {len(sources)} 条，数据库 {db_count} 条模块"})
    else:
        findings.append({"item": "公开内容吸收", "status": "🟡", "detail": f"索引 {len(sources)} 条，数据库仅 {db_count} 条模块"})
    # Check constitution present
    titles = [s["title"] for s in sources]
    if "北辰-母协议" in titles:
        findings.append({"item": "宪法文档收录", "status": "🟢", "detail": "北辰-母协议已在公开索引中"})
    else:
        findings.append({"item": "宪法文档收录", "status": "🔴", "detail": "北辰-母协议缺失"})
    return findings


def check_website_alignment():
    findings = []
    app_tsx = Path(APP_DIR) / "src/App.tsx"
    text = app_tsx.read_text(encoding="utf-8", errors="ignore") if app_tsx.exists() else ""
    if "'docs'" in text and "PublicDocuments" in text and "BookOpen" in text:
        findings.append({"item": "官网公开文档路由", "status": "🟢", "detail": "App.tsx 已接入 PublicDocuments"})
    else:
        findings.append({"item": "官网公开文档路由", "status": "🔴", "detail": "App.tsx 未完整接入 PublicDocuments"})

    server = Path(APP_DIR) / "server.py"
    server_text = server.read_text(encoding="utf-8", errors="ignore") if server.exists() else ""
    if "/api/public-docs" in server_text and "load_public_docs" in server_text:
        findings.append({"item": "后端公开文档接口", "status": "🟢", "detail": "server.py 已暴露 /api/public-docs"})
    else:
        findings.append({"item": "后端公开文档接口", "status": "🔴", "detail": "server.py 缺少 /api/public-docs"})

    dist = Path(APP_DIR) / "dist"
    if dist.exists() and (dist / "index.html").exists():
        findings.append({"item": "生产构建产物", "status": "🟢", "detail": "dist/ 已生成"})
    else:
        findings.append({"item": "生产构建产物", "status": "🟡", "detail": "dist/ 缺失，需运行 npm run build"})
    return findings


def check_model_registry():
    findings = []
    reg = Path.home() / ".龍魂" / "指挥调度中心" / "model_registry.json"
    if not reg.exists():
        findings.append({"item": "模型注册表", "status": "🔴", "detail": "model_registry.json 不存在"})
        return findings
    try:
        data = json.loads(reg.read_text(encoding="utf-8"))
        layers = data.get("layers", {})
        units = data.get("units", [])
        required = {"L0", "L1", "L2", "L3", "L4", "L5"}
        missing = required - set(layers.keys())
        if not missing and len(units) >= 20:
            findings.append({"item": "模型注册表", "status": "🟢", "detail": f"L0-L5 完整，共 {len(units)} 个单元"})
        else:
            findings.append({"item": "模型注册表", "status": "🟡", "detail": f"缺失层级 {missing} 或单元不足 ({len(units)})"})
    except Exception as e:
        findings.append({"item": "模型注册表", "status": "🔴", "detail": f"解析失败: {e}"})
    return findings


def check_simplified_dragon():
    findings = []
    pub_dir = Path("/Users/zuimeidedeyihan/_work/public_content")
    hits = []
    for f in pub_dir.glob("*"):
        text = f.read_text(encoding="utf-8", errors="ignore")
        if "龙芯" in text or "龙魂" in text:
            hits.append(f.name)
    if hits:
        findings.append({"item": "简体「龙」字检查", "status": "🟡", "detail": f"以下公开文件含简体龙字: {', '.join(hits[:5])}"})
    else:
        findings.append({"item": "简体「龙」字检查", "status": "🟢", "detail": "未在本地公开文件中发现简体龙字"})
    return findings


def check_archive_integration():
    findings = []
    archive_dir = Path("/Users/zuimeidedeyihan/龍魂待整理")
    inv_file = archive_dir / "longhun_inventory.json"
    if inv_file.exists():
        inv = json.loads(inv_file.read_text(encoding="utf-8"))
        findings.append({"item": "龍魂待整理索引", "status": "🟢", "detail": f"longhun_inventory.json 存在，共 {inv.get('count', 0)} 项"})
    else:
        findings.append({"item": "龍魂待整理索引", "status": "🔴", "detail": "longhun_inventory.json 缺失"})

    # Check categories exist
    cats = [f"0{i}-" for i in range(1, 10)]
    missing_cats = [c for c in cats if not any(d.name.startswith(c) for d in archive_dir.iterdir() if d.is_dir())]
    if not missing_cats:
        findings.append({"item": "归档目录结构", "status": "🟢", "detail": "9 大分类目录齐全"})
    else:
        findings.append({"item": "归档目录结构", "status": "🟡", "detail": f"缺失分类: {missing_cats}"})

    # Check DB ingestion
    try:
        conn = sqlite3.connect(DB)
        cur = conn.cursor()
        cur.execute("SELECT COUNT(*) FROM longhun_archive_audit")
        cnt = cur.fetchone()[0]
        conn.close()
        if cnt >= 190:
            findings.append({"item": "归档知识库入库", "status": "🟢", "detail": f"longhun_archive_audit 表有 {cnt} 条记录"})
        else:
            findings.append({"item": "归档知识库入库", "status": "🟡", "detail": f"仅 {cnt} 条归档审计记录"})
    except Exception as e:
        findings.append({"item": "归档知识库入库", "status": "🔴", "detail": f"查询失败: {e}"})

    # Check HTTP endpoints
    for endpoint, name in [('/archive/', '龍魂藏经阁'), ('/flow-field/', '流场总控')]:
        try:
            req = urllib.request.Request(f"http://127.0.0.1:8888{endpoint}", method='GET')
            with urllib.request.urlopen(req, timeout=5) as resp:
                body = resp.read().decode('utf-8', errors='ignore')
                if resp.status == 200 and ('龍魂' in body or '流场' in body or 'archive' in body.lower()):
                    findings.append({"item": f"官网路由 {name}", "status": "🟢", "detail": f"{endpoint} 返回 200"})
                else:
                    findings.append({"item": f"官网路由 {name}", "status": "🟡", "detail": f"{endpoint} 返回异常内容"})
        except Exception as e:
            findings.append({"item": f"官网路由 {name}", "status": "🔴", "detail": f"{endpoint} 访问失败: {e}"})
    return findings


def _server_running() -> bool:
    checks = [
        ["pgrep", "-f", "server.py"],
        ["lsof", "-iTCP:8000", "-sTCP:LISTEN", "-t"],
    ]
    for cmd in checks:
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
            if result.returncode == 0 and result.stdout.strip():
                return True
        except Exception:
            continue
    return False


def check_services():
    findings = []
    if _server_running():
        findings.append({"item": "后端服务进程", "status": "🟢", "detail": "server.py / 8000 端口正在运行"})
    else:
        findings.append({"item": "后端服务进程", "status": "🟡", "detail": "未检测到 server.py / 8000 端口运行"})
    return findings


def adversarial_review(findings):
    """左右互搏：挑战者提出质疑，防守方给出回应。"""
    dialogue = []
    for f in findings:
        if f["status"] == "🟢":
            challenge = f"挑战者：{f['item']} 判定为绿，是否过于乐观？"
            response = f"防守方：该检查项有明确可验证证据——{f['detail']}，符合龍魂主权与公开透明原则。"
        elif f["status"] == "🟡":
            challenge = f"挑战者：{f['item']} 为何只是黄？是否存在潜在风险？"
            response = f"防守方：{f['detail']}。当前不影响核心主权闭环，建议纳入下次迭代清单持续观察。"
        else:
            challenge = f"挑战者：{f['item']} 出现红色，是否应触发熔断？"
            response = f"防守方：{f['detail']}。需立即修复或补充证据，并写入 L4 不动点证据链。"
        dialogue.append({"item": f["item"], "challenge": challenge, "response": response})
    return dialogue


def overall_color(findings):
    reds = sum(1 for f in findings if f["status"] == "🔴")
    yellows = sum(1 for f in findings if f["status"] == "🟡")
    if reds:
        return "🔴"
    if yellows:
        return "🟡"
    return "🟢"


def run():
    findings = []
    findings.extend(check_core_locks())
    findings.extend(check_dna_in_files())
    findings.extend(check_public_absorption())
    findings.extend(check_website_alignment())
    findings.extend(check_model_registry())
    findings.extend(check_simplified_dragon())
    findings.extend(check_archive_integration())
    findings.extend(check_services())

    color = overall_color(findings)
    dialogue = adversarial_review(findings)
    report = {
        "audit_time": now_iso(),
        "dna": "#龍芯⚡️2026-06-28-LONGHUN-SELF-AUDIT-LOOP-v1.0",
        "overall": color,
        "summary": {
            "total": len(findings),
            "green": sum(1 for f in findings if f["status"] == "🟢"),
            "yellow": sum(1 for f in findings if f["status"] == "🟡"),
            "red": sum(1 for f in findings if f["status"] == "🔴"),
        },
        "findings": findings,
        "adversarial_review": dialogue,
    }
    Path(REPORT).write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
    return report


if __name__ == "__main__":
    report = run()
    print(json.dumps(report, ensure_ascii=False, indent=2))
