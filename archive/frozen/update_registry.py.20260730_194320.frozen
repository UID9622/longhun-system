# 已登记的 28 个技能（保留）
# 这里我们从原文件读取，然后补充

def clean_name(name):
    return re.sub(r"[^a-zA-Z0-9_\u4e00-\u9fff-]", "", str(name))[:40]

def make_dna(skill_id, version="5.2"):
    base = skill_id.upper().replace("-", "_").replace("/", "_")
    return f"#龍芯⚡️2026-06-29-{base}-v{version}"

def load_registry():
    text = REGISTRY_PATH.read_text(encoding="utf-8")
    return json.loads(text)

def skill_entry(skill_id, name, version="5.2", endpoint=None):
    entry = {
        "id": skill_id,
        "名称": name,
        "版本": f"v{version}",
        "DNA": make_dna(skill_id, version),
    }
    if endpoint:
        entry["端点"] = endpoint
    return entry

