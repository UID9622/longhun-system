#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
CNSH_龍魂星宿知识图.html 一致性验证
"""
import re
from pathlib import Path
from html.parser import HTMLParser

SRC = Path('/Users/zuimeidedeyihan/longhun-system/web/p0-controls/CNSH_龍魂星宿知识图.html')
text = SRC.read_text(encoding='utf-8')

# 提取 style / script / body
style_match = re.search(r'<style>(.*?)</style>', text, re.DOTALL)
script_match = re.search(r'<script>(.*?)</script>', text, re.DOTALL)
style_body = style_match.group(1) if style_match else ''
script_body = script_match.group(1) if script_match else ''
html_body = text
if style_match:
    html_body = html_body[:style_match.start()] + html_body[style_match.end():]
if script_match:
    html_body = html_body[:script_match.start()] + html_body[script_match.end():]

class IdClassParser(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = set()
        self.classes = set()
    def handle_starttag(self, tag, attrs):
        d = dict(attrs)
        if 'id' in d:
            self.ids.add(d['id'])
        if 'class' in d:
            for c in d['class'].split():
                self.classes.add(c)

parser = IdClassParser()
parser.feed(html_body)
html_ids = parser.ids
html_classes = parser.classes

# 提取 CSS 规则中的选择器：取以 { 结尾且不含 ; 的行
css_ids = set()
css_classes = set()
for line in style_body.splitlines():
    line = line.strip()
    if line.endswith('{') and ';' not in line:
        # 去掉末尾 {，逗号分隔
        selector_group = line[:-1].strip()
        for sel in selector_group.split(','):
            sel = sel.strip()
            for token in re.findall(r'#[\w\u4e00-\u9fa5\-]+|\.[\w\u4e00-\u9fa5\-]+', sel):
                name = token[1:]
                if token.startswith('#'):
                    css_ids.add(name)
                else:
                    css_classes.add(name)
# 移除 CSS 伪类/伪元素（若被误捕）
pseudo = {'hover', 'active', 'focus', 'before', 'after', 'nth', 'nth-child', 'not'}
css_classes -= pseudo

# 提取 JS 中 getElementById / querySelector 引用的 id/class
js_id_refs = set(re.findall(r"document\.getElementById\(['\"]([^'\"]+)['\"]\)", script_body))
js_qs_refs = set(re.findall(r"querySelector(?:All)?\(['\"]([^'\"]+)['\"]\)", script_body))
# JS 中通过 classList 动态添加/切换/移除的 class
js_dynamic_classes = set(re.findall(r"classList\.(?:add|toggle|remove)\(['\"]([^'\"]+)['\"]", script_body))

# 验证报告
report = []
all_ok = True

# 1. HTML 定义的 id 与 CSS 引用的 id
missing_css_ids = css_ids - html_ids
if missing_css_ids:
    all_ok = False
    report.append(f'[FAIL] CSS 引用了未在 HTML 中定义的 id: {missing_css_ids}')
else:
    report.append('[PASS] CSS 引用的所有 id 均在 HTML 中定义')

# 2. HTML 定义的 class（含 JS 动态添加）与 CSS 引用的 class
all_classes = html_classes | js_dynamic_classes
missing_css_classes = css_classes - all_classes
if missing_css_classes:
    all_ok = False
    report.append(f'[FAIL] CSS 引用了未在 HTML/JS 中定义的 class: {missing_css_classes}')
else:
    report.append('[PASS] CSS 引用的所有 class 均在 HTML 或 JS 动态操作中有定义')

# 3. JS getElementById 引用的 id
missing_js_ids = js_id_refs - html_ids
if missing_js_ids:
    all_ok = False
    report.append(f'[FAIL] JS getElementById 引用了未定义的 id: {missing_js_ids}')
else:
    report.append('[PASS] JS getElementById 引用的所有 id 均在 HTML 中定义')

# 4. JS querySelector 引用的选择器
qs_fail = []
for qs in js_qs_refs:
    if qs.startswith('#'):
        name = qs[1:]
        if name not in html_ids:
            qs_fail.append(qs)
    elif qs.startswith('.'):
        name = qs[1:]
        if name not in html_classes:
            qs_fail.append(qs)
    # 其他复杂选择器暂不校验
if qs_fail:
    all_ok = False
    report.append(f'[FAIL] JS querySelector 引用了未定义的选择器: {set(qs_fail)}')
else:
    report.append('[PASS] JS querySelector 引用的简单选择器均有效')

# 5. JS 中文函数定义与调用检查（避免英文 API 误报）
func_defs = set(re.findall(r'function\s+([\w\u4e00-\u9fa5_]+)\s*\(', script_body))
# 只检查中文字符开头的调用
func_calls = set(re.findall(r'\b([\u4e00-\u9fa5][\w\u4e00-\u9fa5_]*)\s*\(', script_body))
reserved = {'如果', '对于', '当', '返回'}  # 若存在
undefined_calls = func_calls - func_defs - reserved
if undefined_calls:
    all_ok = False
    report.append(f'[FAIL] 存在未定义的中文函数调用: {undefined_calls}')
else:
    report.append('[PASS] JS 中文函数调用均有定义（英文 API 调用已排除）')

# 6. HTML 标签闭合简单检查（忽略自闭合）
self_closing = {'meta', 'link', 'br', 'hr', 'img', 'input', 'div', 'span', 'i', 'kbd', 'button', 'h1', 'h2', 'h3', 'p', 'script', 'style'}
# 不深入

print('\n'.join(report))
print(f'\n总体验证: {"通过" if all_ok else "存在失败项"}')
