def digital_root(s: str) -> int:
    """对字符串中所有数字字符求和并递归到个位。"""
    total = sum(int(c) for c in s if c.isdigit())
    while total >= 10:
        total = sum(int(c) for c in str(total))
    return total if total > 0 else 9


def extract_title_numbers(title: str) -> list[int]:
    """提取标题中的整数/小数中的数字。"""
    nums = []
    for m in re.finditer(r"\d+(?:\.\d+)?", title):
        for ch in m.group():
            if ch.isdigit():
                nums.append(int(ch))
    return nums


def title_digital_root(title: str) -> int | None:
    nums = extract_title_numbers(title)
    if not nums:
        return None
    return digital_root("".join(str(n) for n in nums))


