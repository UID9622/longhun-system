def ensure_summary(summary: str, fallback: str) -> str:
    """确保掘金摘要不少于 50 字。"""
    if len(summary) >= 50:
        return summary
    ext = fallback
    while len(summary) < 50 and ext:
        summary += ext[:50 - len(summary)]
    return summary


def build_header(article_id: str, title: str, cfg: dict[str, Any]) -> str:
    dr = digital_root(article_id)
    tdr = title_digital_root(title)
    tdr_text = str(tdr) if tdr is not None else "（标题无数字，以 articleId 数字根为准）"
    tdr_status = "🟢 通行" if tdr is not None else "🟡 无数字"
    return f"""<!-- 龍魂发布检测头 -->
> **龍魂发布检测 · 数字根 `dr={dr}`**
>
> | 检测项 | 状态 | 说明 |
> |---|---|---|
> | 脱敏检查 | 🟢 通过 | 已移除 DNA 码、密钥、本地路径、身份证/手机号 |
> | 数字根 | 🟢 通行 | dr(articleId `{article_id}`) = `{dr}` |
> | 标题数字根 | {tdr_status} | dr(title) = `{tdr_text}` |
> | 逻辑闭环 | 🟢 自洽 | {cfg['logic_summary']} |
> | 有用性 | 🟢 可用 | {cfg['usefulness']} |
> | 系统分支 | {cfg['branch']} |
>
> **一句话摘要**：{cfg['one_sentence_summary']}
>
> **君子协议**：本文遵循 CC BY-NC-SA 4.0 + 非对抗·非欺瞞·非竊取原则。

"""


def build_footer(cfg: dict[str, Any]) -> str:
    steps = "\n".join(f"{i}. {s}" for i, s in enumerate(cfg["steps"], 1))
    return f"""

<!-- 龍魂发布检测尾 -->
## 逻辑闭环与使用建议

{cfg['conclusion']}

**推荐使用路径**：
{steps}

## 维护日志

| 版本 | 时间 | 说明 |
|---|---|---|
| v1.0 | 2026-06-22 | 龍魂发布检测增强版：补充数字根、摘要、逻辑闭环与维护日志 |
"""


def insert_header_footer(content: str, header: str, footer: str) -> str:
    """在转载声明后插入检测头，在文末追加检测尾。"""
    # 找到原文第一个 Markdown 标题的位置，将 header 插入其前
    first_heading = re.search(r"\n#{1,6} ", content)
    if first_heading:
        pos = first_heading.start()
        content = content[:pos] + "\n" + header + content[pos:]
    else:
        content = header + "\n" + content
    content = content.rstrip() + "\n" + footer
    return content


def update_draft(draft_id: str, title: str, brief: str, content: str, category_id: str, tag_id: str) -> dict[str, Any]:
    payload = {
        "id": draft_id,
        "category_id": category_id,
        "tag_ids": [tag_id],
        "title": title,
        "brief_content": brief,
        "html_content": content,
        "mark_content": content,
        "cover_image": "",
        "is_english": 0,
        "is_gfw": 0,
        "is_original": 1,
        "edit_summary": "龍魂发布检测增强：补充数字根、摘要、逻辑闭环与维护日志",
    }
    r = requests.post(UPDATE_URL, headers=HEADERS, json=payload, timeout=30)
    return r.json()


def append_audit_log(record: dict[str, Any]):
    with AUDIT_LOG.open("a", encoding="utf-8") as f:
        f.write(json.dumps(record, ensure_ascii=False) + "\n")


def process_article(article_id: str, title: str, draft_id: str | None, meta: dict | None) -> bool:
    """处理单篇文章。有 draft_id 时更新线上草稿；否则仅生成本地增强版。"""
    cfg = ENHANCE_CONFIG.get(article_id)
    if not cfg:
        print(f"跳过：缺少配置 {article_id}")
        return False

    publish_path = BASE / f"{article_id}_publish.md"
    if not publish_path.exists():
        print(f"跳过：文件不存在 {publish_path}")
        return False

    raw_content = publish_path.read_text(encoding="utf-8")
    header = build_header(article_id, title, cfg)
    footer = build_footer(cfg)
    enhanced = insert_header_footer(raw_content, header, footer)

    v2_path = BASE / f"{article_id}_publish_v2.md"
    v2_path.write_text(enhanced, encoding="utf-8")

    inject_path = BASE / f"_inject_{article_id}_v2.js"
    escaped = enhanced.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n")
    inject_js = f"window.editor.setValue(\"{escaped}\");"
    inject_path.write_text(inject_js, encoding="utf-8")

    summary = ensure_summary(
        meta.get("summary", cfg["one_sentence_summary"]) if meta else cfg["one_sentence_summary"],
        cfg["one_sentence_summary"],
    )

    if draft_id:
        category_id = CATEGORY_MAP.get(meta.get("category", "人工智能"), CATEGORY_MAP["人工智能"]) if meta else CATEGORY_MAP["人工智能"]
        result = update_draft(draft_id, title, summary, enhanced, category_id, TAG_AI)
        ok = result.get("err_no") == 0
        status = "✅ 更新成功" if ok else "❌ 更新失败"
        print(f"{status}: {title}")
        append_audit_log({
            "articleId": article_id,
            "title": title,
            "draft_id": draft_id,
            "digital_root": digital_root(article_id),
            "title_digital_root": title_digital_root(title),
            "v2_path": str(v2_path),
            "api_response": result,
            "ok": ok,
            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        })
        return ok
    else:
        print(f"📄 本地增强版已生成（已发布/未上线）: {title}")
        append_audit_log({
            "articleId": article_id,
            "title": title,
            "draft_id": None,
            "digital_root": digital_root(article_id),
            "title_digital_root": title_digital_root(title),
            "v2_path": str(v2_path),
            "api_response": None,
            "ok": True,
            "offline_only": True,
            "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        })
        return True


def main():
    if not PUBLISH_META.exists():
        print("publish_meta.json 不存在")
        return
    if not DRAFT_FILE.exists():
        print("draft_results.json 不存在")
        return

    meta_list = json.loads(PUBLISH_META.read_text(encoding="utf-8"))
    meta_by_id = {m["articleId"]: m for m in meta_list}
    drafts = json.loads(DRAFT_FILE.read_text(encoding="utf-8"))

    # 已发布列表
    published_by_id = {}
    if PUBLISHED_FILE.exists():
        for item in json.loads(PUBLISHED_FILE.read_text(encoding="utf-8")):
            aid = item.get("articleId")
            if aid:
                published_by_id[aid] = item

    success_count = 0
    fail_count = 0
    processed = set()

    # 1. 先处理未发布的草稿（需要线上更新）
    for draft in drafts:
        if draft.get("status") != "draft_saved":
            continue
        article_id = draft["articleId"]
        title = draft["title"]
        draft_id = draft["draft_id"]
        processed.add(article_id)
        ok = process_article(article_id, title, draft_id, meta_by_id.get(article_id))
        if ok:
            success_count += 1
        else:
            fail_count += 1
        time.sleep(1)

    # 2. 再为已发布文章生成增强版本地文件（不调用 API）
    for article_id, item in published_by_id.items():
        if article_id in processed:
            continue
        if article_id not in ENHANCE_CONFIG:
            continue
        title = item.get("title") or meta_by_id.get(article_id, {}).get("title", "")
        process_article(article_id, title, None, meta_by_id.get(article_id))
        processed.add(article_id)
        time.sleep(0.2)

    print(f"\n完成：线上草稿更新成功 {success_count} 篇，失败 {fail_count} 篇；本地增强版共 {len(processed)} 篇")


if __name__ == "__main__":
    main()
