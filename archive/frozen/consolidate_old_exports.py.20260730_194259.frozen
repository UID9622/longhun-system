#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
旧 Notion 导出/备份整理压缩脚本
- 把 ~/龍魂待整理/Export-... 按顶层文件夹逐个归档
- 把旧备份/重复导出整个压缩到 ~/longhun-archive/_compressed-old-versions/
- 生成清单、Notion 汇总页、DNA 链、observer 留痕
- 删除原文件夹释放空间
"""
import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tarfile
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
PRIMARY_EXPORT = HOME / "龍魂待整理" / "Export-6a2fd9c8-4e14-4110-8b5e-452cc1be5daa"
OLD_DIRS = [
    HOME / "longhun-archive" / "2026-06-01" / "notion-exports" / "Export-6a2fd9c8-4e14-4110-8b5e-452cc1be5daa",
    HOME / "cnsh_l4_龍魂系统备份_20260601" / "_work" / "notion-sync" / "Export-6a2fd9c8-4e14-4110-8b5e-452cc1be5daa",
    HOME / "longhun-archive" / "2026-06-01",
    HOME / "cnsh_l4_龍魂系统备份_20260601",
]
DEST_PACKS = HOME / "longhun-archive" / "_notion-export-packs"
DEST_OLD = HOME / "longhun-archive" / "_compressed-old-versions"
NOTION_DB = "cba73d49-cbe4-41e0-b4d3-6f52cb4e636f"
DNA_PREFIX = "#龍芯⚡️"


def now_iso():
    return datetime.now(timezone.utc).isoformat()


def now_compact():
    return datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S")


def md5_hex(s: str) -> str:
    return hashlib.md5(s.encode("utf-8")).hexdigest()[:12]


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            chunk = f.read(1024 * 1024)
            if not chunk:
                break
            h.update(chunk)
    return h.hexdigest()


def log_dna(action: str, detail: str):
    chain = HOME / "chain_hash.jsonl"
    ts = now_iso()
    compact = ts.replace("-", "").replace(":", "").replace("+", "")
    dna = f"{DNA_PREFIX}{compact}-{action.upper()}-{md5_hex(action + detail + ts)}"
    entry = {"timestamp": ts, "action": action, "detail": detail, "dna": dna}
    chain.parent.mkdir(parents=True, exist_ok=True)
    with open(chain, "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")
    return dna


def observer(trigger: str, path: str = str(HOME), confidence: str = "high"):
    obs = HOME / ".龍魂" / "functions" / "observer_core.sh"
    try:
        subprocess.run(
            ["bash", str(obs), trigger, path, confidence],
            capture_output=True,
            text=True,
            timeout=60,
        )
    except Exception:
        pass


def safe_name(name: str) -> str:
    safe = name.replace("/", "∕").replace("\\", "＼").replace("\x00", "")
    safe = "".join(ch for ch in safe if ord(ch) >= 32 or ch in "\t\n")
    if len(safe.encode("utf-8")) > 180:
        safe = safe[:55] + "…"
    return safe or "unnamed"


def archive_entry(src: Path, dest_dir: Path) -> dict[str, Any]:
    """归档单个顶层条目（文件或目录），生成清单"""
    dest_dir.mkdir(parents=True, exist_ok=True)
    base = safe_name(src.name)
    archive_name = f"{base}.tar.gz"
    archive_path = dest_dir / archive_name

    files = []
    total_size = 0
    if src.is_file():
        files.append({"path": src.name, "sha256": sha256_file(src), "size": src.stat().st_size})
        total_size = src.stat().st_size
    else:
        for p in src.rglob("*"):
            if p.is_file():
                rel = p.relative_to(src).as_posix()
                size = p.stat().st_size
                total_size += size
                files.append({"path": rel, "sha256": sha256_file(p), "size": size})

    manifest = {
        "archive_type": "notion-export-top-entry",
        "source": str(src),
        "archive_path": str(archive_path),
        "archived_at": now_iso(),
        "entry_name": src.name,
        "file_count": len(files),
        "total_bytes": total_size,
        "files": files,
    }

    # 写入临时 manifest 再打包
    staging = dest_dir / ".staging"
    staging.mkdir(exist_ok=True)
    manifest_path = staging / "manifest.json"
    manifest_path.write_text(json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8")

    with tarfile.open(archive_path, "w:gz") as tar:
        tar.add(manifest_path, arcname="manifest.json")
        if src.is_file():
            tar.add(src, arcname=src.name)
        else:
            tar.add(src, arcname=src.name)

    shutil.rmtree(staging, ignore_errors=True)

    archive_size = archive_path.stat().st_size
    dna = log_dna("EXPORT-ENTRY-ARCHIVED", f"{src.name} -> {archive_path} ({archive_size} 字节)")
    observer(f"导出项归档:{src.name}:{len(files)}文件", str(archive_path), "high")

    return {
        "type": "entry",
        "name": src.name,
        "archive_path": str(archive_path),
        "archive_size": archive_size,
        "original_size": total_size,
        "file_count": len(files),
        "dna": dna,
    }


def archive_whole(src: Path, dest_dir: Path, archive_name: str) -> dict[str, Any]:
    """整个目录压缩为一个 tar.gz"""
    dest_dir.mkdir(parents=True, exist_ok=True)
    archive_path = dest_dir / archive_name
    original_size = sum(f.stat().st_size for f in src.rglob("*") if f.is_file())
    file_count = sum(1 for _ in src.rglob("*") if _.is_file())

    manifest = {
        "archive_type": "whole-directory-backup",
        "source": str(src),
        "archive_path": str(archive_path),
        "archived_at": now_iso(),
        "file_count": file_count,
        "total_bytes": original_size,
    }
    staging = dest_dir / ".staging"
    staging.mkdir(exist_ok=True)
    manifest_path = staging / "manifest.json"
    manifest_path.write_text(json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8")

    with tarfile.open(archive_path, "w:gz") as tar:
        tar.add(manifest_path, arcname="manifest.json")
        tar.add(src, arcname=src.name)

    shutil.rmtree(staging, ignore_errors=True)

    archive_size = archive_path.stat().st_size
    dna = log_dna("OLD-BACKUP-ARCHIVED", f"{src} -> {archive_path} ({archive_size} 字节)")
    observer(f"旧备份压缩:{archive_name}:{file_count}文件", str(archive_path), "high")

    return {
        "type": "whole",
        "name": src.name,
        "archive_name": archive_name,
        "archive_path": str(archive_path),
        "archive_size": archive_size,
        "original_size": original_size,
        "file_count": file_count,
        "dna": dna,
    }


def verify_archive(archive_path: Path) -> bool:
    try:
        with tarfile.open(archive_path, "r:gz") as tar:
            names = tar.getnames()
            return len(names) > 0
    except Exception as e:
        print(f"校验失败 {archive_path}: {e}", file=sys.stderr)
        return False


def delete_original(src: Path):
    if src.is_file():
        src.unlink()
    elif src.is_dir():
        shutil.rmtree(src, ignore_errors=True)
    log_dna("ORIGINAL-DELETED", f"删除原文件/夹 {src}")
    observer(f"原数据已删除:{src.name}", str(src.parent), "high")


def notion_summary(records: list[Any], freed_bytes: int):
    total_archives = len(records)
    total_files = sum(r["file_count"] for r in records)
    total_archive_size = sum(r["archive_size"] for r in records)
    total_original = sum(r["original_size"] for r in records)

    def rich(text):
        return {"rich_text": [{"text": {"content": text}}]}

    children = [
        {"object":"block","type":"paragraph","paragraph":{"rich_text":[{"type":"text","text":{"content":"本次整理由 Kimi 自动执行：把旧 Notion 导出和备份压缩归档，并删除原文件夹释放空间。"}}]}},
        {"object":"block","type":"heading_2","heading_2":{"rich_text":[{"type":"text","text":{"content":"总览"}}]}},
        {"object":"block","type":"bulleted_list_item","bulleted_list_item":{"rich_text":[{"type":"text","text":{"content":f"归档数量：{total_archives}"}}]}},
        {"object":"block","type":"bulleted_list_item","bulleted_list_item":{"rich_text":[{"type":"text","text":{"content":f"原文件总数：{total_files}"}}]}},
        {"object":"block","type":"bulleted_list_item","bulleted_list_item":{"rich_text":[{"type":"text","text":{"content":f"原占用：{total_original} 字节"}}]}},
        {"object":"block","type":"bulleted_list_item","bulleted_list_item":{"rich_text":[{"type":"text","text":{"content":f"归档后占用：{total_archive_size} 字节"}}]}},
        {"object":"block","type":"bulleted_list_item","bulleted_list_item":{"rich_text":[{"type":"text","text":{"content":f"释放空间（估算）：{freed_bytes} 字节"}}]}},
        {"object":"block","type":"heading_2","heading_2":{"rich_text":[{"type":"text","text":{"content":"归档清单"}}]}},
    ]
    for r in records:
        txt = f"[{r['type']}] {r['name']}: {r['file_count']} 文件, 原{r['original_size']} -> 归档{r['archive_size']} 字节 | {r['archive_path']}"
        parts = [txt[i:i+1900] for i in range(0, len(txt), 1900)]
        rt = [{"type":"text","text":{"content": p}} for p in parts]
        children.append({"object":"block","type":"bulleted_list_item","bulleted_list_item":{"rich_text": rt}})

    payload = {
        "parent": {"database_id": NOTION_DB},
        "properties": {
            "一句话DNA（压缩·任何AI都能问）": {"title": [{"text": {"content": f"#DNA-{now_compact()[:8]}-旧导出备份整理·{total_archives}包·释放{freed_bytes}字节"}}]},
            "操作类型": {"select": {"name": "入档"}},
            "状态": {"status": {"name": "通过"}},
            "对外公开": {"checkbox": True},
            "任务卡编号": rich(f"旧备份整理#{now_compact()}"),
            "DNA标签": {"multi_select": [{"name": "草日志"}, {"name": "铁律守岗"}]},
            "三层归位": {"multi_select": [{"name": "🅱️ 铁律（内部守岗）"}]},
            "谁说话谁签名": {"multi_select": [{"name": "🌙 Kimi"}]},
            "🌙 Kimi 怎么评": rich(f"自动整理 {total_archives} 个旧备份，释放 {freed_bytes} 字节"),
            "真实结果证据": rich(f"归档位置：{DEST_PACKS}\n压缩备份：{DEST_OLD}\nDNA链：~/chain_hash.jsonl"),
            "输出到哪": rich(f"{DEST_OLD} / {DEST_PACKS}"),
            "怎么算完成": rich("1) 顶层条目逐个归档 2) 旧备份整体压缩 3) 校验 4) 删除原文件 5) Notion汇总"),
            "用了什么本地资源": rich("~/龍魂待整理/Export-... 、 ~/longhun-archive/2026-06-01 、 ~/cnsh_l4_龍魂系统备份_20260601"),
            "🎨 风险等级": {"select": {"name": "🟡 需要观察"}},
            "老大终判": {"select": {"name": "🕐 待复盘"}},
            "🌱 演化阶段": {"select": {"name": "本地化阶段"}},
            "🎯 本次按需分配 AI": {"multi_select": [{"name": "🌙 Kimi（长文/中文）"}]},
        },
        "children": children,
    }

    payload_path = DEST_OLD / f"旧备份整理_{now_compact()}_notion_payload.json"
    payload_path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")

    token = os.environ.get("NOTION_TOKEN", "")
    if not token:
        print("ERR: 无 NOTION_TOKEN", file=sys.stderr)
        return None
    try:
        res = subprocess.run(
            [
                "curl", "-s", "-m", "30", "-X", "POST", "https://api.notion.com/v1/pages",
                "-H", f"Authorization: Bearer {token}",
                "-H", "Notion-Version: 2022-06-28",
                "-H", "Content-Type: " + "application/json",
                "--data-binary", f"@{payload_path}",
            ],
            capture_output=True,
            text=True,
            timeout=60,
        )
        data = json.loads(res.stdout)
        return data.get("id")
    except Exception as e:
        print(f"Notion 创建失败: {e}", file=sys.stderr)
        return None


def main():
    DEST_PACKS.mkdir(parents=True, exist_ok=True)
    DEST_OLD.mkdir(parents=True, exist_ok=True)

    start_dna = log_dna("OLD-EXPORT-CLEANUP-START", "开始整理旧 Notion 导出与备份")
    observer("旧导出备份整理开始", str(HOME), "high")

    records = []
    freed = 0

    # 1. 主导出按顶层条目归档
    if PRIMARY_EXPORT.exists():
        export_uuid = PRIMARY_EXPORT.name
        dest_subdir = DEST_PACKS / export_uuid
        entries = sorted([p for p in PRIMARY_EXPORT.iterdir() if p.name not in {".DS_Store"}], key=lambda p: p.name)
        print(f"主导出共 {len(entries)} 个顶层条目，开始归档...")
        for idx, entry in enumerate(entries, 1):
            print(f"[{idx}/{len(entries)}] 归档 {entry.name} ...")
            try:
                rec = archive_entry(entry, dest_subdir)
                if verify_archive(Path(rec["archive_path"])):
                    records.append(rec)
                    freed += rec["original_size"]
                    delete_original(entry)
                else:
                    print(f"  校验失败，保留原文件 {entry.name}", file=sys.stderr)
            except Exception as e:
                print(f"  归档失败 {entry.name}: {e}", file=sys.stderr)
        # 如果主导出目录已空，删除
        if PRIMARY_EXPORT.exists() and not any(PRIMARY_EXPORT.iterdir()):
            PRIMARY_EXPORT.rmdir()
            log_dna("EMPTY-EXPORT-DIR-DELETED", f"删除空导出目录 {PRIMARY_EXPORT}")

    # 2. 旧备份整体压缩
    for old in OLD_DIRS:
        if not old.exists():
            continue
        # 避免重复压缩已归档的路径
        archive_name = f"{old.name}_backup_{now_compact()}.tar.gz"
        if old == HOME / "longhun-archive" / "2026-06-01":
            archive_name = f"longhun-archive_2026-06-01_backup_{now_compact()}.tar.gz"
        elif old == HOME / "cnsh_l4_龍魂系统备份_20260601":
            archive_name = f"cnsh_l4_龍魂系统备份_20260601_backup_{now_compact()}.tar.gz"
        print(f"\n整体压缩旧目录: {old}\n  -> {DEST_OLD / archive_name}")
        try:
            rec = archive_whole(old, DEST_OLD, archive_name)
            if verify_archive(Path(rec["archive_path"])):
                records.append(rec)
                freed += rec["original_size"]
                delete_original(old)
            else:
                print(f"  校验失败，保留 {old}", file=sys.stderr)
        except Exception as e:
            print(f"  压缩失败 {old}: {e}", file=sys.stderr)

    # 3. 总报告
    report = {
        "task": "旧 Notion 导出/备份整理",
        "time": now_iso(),
        "records": records,
        "freed_bytes": freed,
        "start_dna": start_dna,
    }
    report_path = DEST_OLD / f"旧备份整理报告_{now_compact()}.json"
    report_path.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")

    # 4. Notion 汇总
    page_id = notion_summary(records, freed)
    if page_id:
        log_dna("OLD-EXPORT-CLEANUP-NOTION", f"Notion 汇总页 {page_id}")
        observer("旧导出备份整理Notion汇总页已创建", f"page={page_id}", "high")
    else:
        log_dna("OLD-EXPORT-CLEANUP-NOTION-FAILED", "Notion 汇总页创建失败")

    final_dna = log_dna("OLD-EXPORT-CLEANUP-DONE", f"整理完成，释放 {freed} 字节")
    observer("旧导出备份整理完成", str(DEST_OLD), "high")

    print(json.dumps({
        "archives": len(records),
        "freed_bytes": freed,
        "report_path": str(report_path),
        "notion_page_id": page_id,
        "final_dna": final_dna,
    }, ensure_ascii=False, indent=2))


if __name__ == "__main__":
    main()
