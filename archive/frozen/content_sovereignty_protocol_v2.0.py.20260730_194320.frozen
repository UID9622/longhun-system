    print("\n🔐 验证终端头完整性...")
    终端头验证 = 协议.验证终端头完整性(
        协议.生成终端头("2.0.0") + "\n#龍芯⚡️2026-06-18-TEST-v2.0.0"
    )
    print(f"   结果: {终端头验证['信息']}")
    print(f"   置信度: {终端头验证['置信度']:.4f}")

    # 执行三层监督
    print("\n📋 执行三层监督校验...")
    监督结果 = 协议.执行三层监督(样本内容)
    for layer, detail in 监督结果.get("层级结果", {}).items():
        emoji = "✅" if detail["通过"] else "🔴"
        print(f"   {emoji} {layer}: {detail['信息']}")

    # 生成完整报告
    print("\n" + "=" * 70)
    print(协议.生成完整报告())

    # 输出审计摘要
    print("\n📊 最终审计摘要 / Final Audit Summary:")
    print(json.dumps(协议.获取审计摘要(), ensure_ascii=False, indent=2))
