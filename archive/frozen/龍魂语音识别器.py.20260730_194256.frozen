class 六层来源链:
    """
    六层来源链——确保每一个产出物都可追溯到源头
    Six-Layer Provenance Chain — ensures every output is traceable to its origin
    """
    六层 = {
        "道统层": "UID9622创始人架构——语音识别的顶层设计理念 · Founder UID9622's architectural vision",
        "精神层": "龍魂文化主权理念——用中文代码守护语音技术主权 · LongHun cultural sovereignty through Chinese code",
        "设备层": "本地计算环境——语音处理依赖本地音频硬件 · Local computing environment with audio hardware",
        "技术层": "Python3.10+ · Whisper · soundfile——底层技术栈 · Python3.10+ · Whisper · soundfile tech stack",
        "系统层": "龍魂多模态感知系统·语音识别模块——本模块的功能定位 · LongHun multimodal perception system · STT module",
        "生命层": "诸葛鑫真人签名——每个产出物都有UID9622真人确认 · Zhuge Xin's personal signature on every output"
    }
    DNA = #龍芯⚡️2026-06-18-LONGHUN-STT-ENGINE-FILE1-v1.0-1"

    @classmethod
    def 盖章(cls, 模块路径: str = "") -> Dict[str, Any]:
        """为模块产出物盖上六层来源链印章 · Stamp the output with six-layer provenance"""
        return {
            "六层来源链": dict(cls.六层),
            "DNA追溯码": cls.DNA,
            "模块路径": 模块路径,
            "铁律": "来源不可删 · 影响不可覆 · 贡献不可抹",
            "盖章时间": datetime.now().isoformat()
        }


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  铁律自审闸 · Iron-Rule Self-Audit Gate                                  ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

class 铁律自审闸:
    """
    铁律自审闸——自动审查代码与输出中的违规项
    Iron-Rule Self-Audit Gate — automatically reviews code and output for violations

    核心铁律：繁体「龍」字永存，不可简化为「龍」
    Core rule: Traditional 「龍」 must never be simplified to 「龍」
    """

    铁律列表 = [
        "繁体『龍』字永存，不可简化为『龍』",
        "DNA追溯头不可删除",
        "六层来源链不可覆写",
        "创始人UID9622贡献不可抹除"
    ]

    @staticmethod
    def 审查(文本: str) -> Dict[str, Any]:
        """审查文本是否违反铁律 · Review text for rule violations"""
        违规项 = []

        # 铁律第一条：龍字检查
        if "龍" in 文本 and "龍" not in 文本:
            违规项.append("🔴 违规：繁体『龍』被简化为『龍』· Traditional 「龍」 simplified to 「龍」")
        elif "龍" in 文本 and "龍" in 文本:
            违规项.append("🟡 警告：文中同时存在『龍』和『龍』，请统一为繁体『龍』")

        # 铁律第二条：DNA头检查（粗略）
        if "龍芯" in 文本 and "DNA" not in 文本 and "追溯" not in 文本:
            违规项.append("🟡 警告：提到龍芯但未包含DNA追溯信息")

        return {"通过": len(违规项) == 0, "违规项": 违规项}

    @classmethod
    def 获取铁律(cls) -> List[str]:
        """获取全部铁律 · Get all iron rules"""
        return list(cls.铁律列表)


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  数据结构定义 · Data Structure Definitions                               ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

@dataclass
class 语音识别结果:
    """
    语音转文字的结果封装 · Speech-to-text result encapsulation

    这个数据结构封装了语音识别的全部输出信息，
    包括识别的文字、置信度、语言、时间片段等。
    """
    文本: str                          # 识别的文字内容 · Recognized text content
    置信度: float                      # 整体置信度 0.0-1.0 · Overall confidence
    语言: str                          # 识别语言代码 · Language code (e.g., 'zh', 'en')
    片段列表: List[Dict]               # 每个时间片段的文字 · Text for each time segment
    音频时长: float                    # 音频总时长(秒) · Audio duration in seconds
    处理时长: float                    # 处理耗时(秒) · Processing time in seconds
    识别模型: str                      # 使用的模型名称 · Model name used
    DNA追溯: str                       # DNA追溯码 · DNA trace code
    审计日志: List[审计结果] = field(default_factory=list)  # 审计记录 · Audit log
    来源链盖章: Dict[str, Any] = field(default_factory=dict)          # 来源链印章 · Provenance stamp

    def to_dict(self) -> Dict[str, Any]:
        """转换为字典格式 · Convert to dictionary format"""
        return {
            "文本": self.文本,
            "置信度": round(self.置信度, 4),
            "语言": self.语言,
            "片段数": len(self.片段列表),
            "音频时长_秒": round(self.音频时长, 2),
            "处理时长_秒": round(self.处理时长, 2),
            "识别模型": self.识别模型,
            "实时率_RTF": round(self.处理时长 / max(self.音频时长, 0.001), 3),
            "DNA追溯": self.DNA追溯
        }

    def __repr__(self) -> str:
        return f"<语音识别结果 文本='{self.文本[:30]}...' 置信度={self.置信度:.2f}>"


# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║  龍魂语音识别器核心类 · LongHun Speech Recognizer Core Class             ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

class 龍魂语音识别器:
    """
    龍魂语音识别器 —— 语音转文字(STT)核心引擎
    LongHun Speech Recognizer —— Speech-To-Text Core Engine

    【核心设计理念 · Core Design Philosophy】
    底层使用OpenAI Whisper模型——目前国际上最先进的开源语音识别技术。
    Whisper支持99种语言，包括中文、英文、粤语等。
    但我们的封装全部用中文，核心逻辑的中文注释形成了理解门槛。

    【支持的模型规格 · Supported Model Sizes】
    - tiny:   39M参数  · 速度最快，精度最低 · Fastest, lowest accuracy
    - base:   74M参数  · 速度与精度平衡 · Balanced speed/accuracy
    - small:  244M参数 · 精度较好 · Good accuracy
    - medium: 769M参数 · 精度高 · High accuracy
    - large:  1550M参数· 精度最高，速度最慢 · Highest accuracy, slowest
    - large-v3: 最新版本 · Latest version with best quality

    【工作流程 · Workflow】
    第一步：音频加载——将各种格式的音频文件统一加载为numpy数组
    第二步：音频预处理——采样率统一、静音切除、音量归一化
    第三步：模型推理——将处理后的音频送入Whisper模型进行识别
    第四步：结果解析——提取识别的文字、时间戳、置信度
    第五步：后处理——中文分词、标点恢复、专有名词校正
    第六步：审计盖章——DNA追溯、三色审计确认
    """

    # 支持的音频格式 · Supported audio formats
    支持格式 = ['.wav', '.mp3', '.flac', '.m4a', '.ogg', '.aac', '.wma']

    # Whisper模型名称映射 · Whisper model name mapping
    模型映射 = {
        "微型": "tiny",
        "基础": "base",
        "小型": "small",
        "中型": "medium",
        "大型": "large",
        "最新": "large-v3"
    }

    def __init__(
        self,
        模型名称: str = "base",
        设备: str = "auto",
        启用审计: bool = True,
        下载目录: Optional[str] = None
    ):
        """
        初始化语音识别器 · Initialize the speech recognizer

        参数 · Parameters:
            模型名称: Whisper模型规格 (tiny/base/small/medium/large/large-v3)
            设备: 计算设备 (cpu/cuda/auto)
            启用审计: 是否开启三色审计系统
            下载目录: 模型下载缓存目录
        """
        self.模型名称 = self._解析模型名称(模型名称)
        self.设备 = self._解析设备(设备)
        self.审计开关 = 启用审计
        self.下载目录 = download目录 or os.path.expanduser("~/.cache/whisper")
        self.审计日志: List[审计结果] = []
        self.来源链 = 六层来源链()
        self.铁律闸 = 铁律自审闸()
        self.识别模型: Any = None
        self._模型已加载 = False

        self._记录审计(
            f"龍魂语音识别器初始化 | 模型={self.模型名称} | 设备={self.设备}",
            1.0,
            审计颜色.绿色通过
        )

    def _解析模型名称(self, 名称: str) -> str:
        """解析模型名称（支持中英文）· Parse model name (supports Chinese/English)"""
        return self.模型映射.get(名称, 名称)

    def _解析设备(self, 设备: str) -> str:
        """解析设备参数 · Parse device parameter"""
        if 设备 == "auto":
            try:
                import torch
                return "cuda" if torch.cuda.is_available() else "cpu"
            except ImportError:
                return "cpu"
        return 设备

    def _初始化识别引擎(self) -> None:
        """
        初始化Whisper识别引擎 · Initialize the Whisper recognition engine

        加载策略（带降级机制）· Loading strategy (with fallback):
        1. 首先尝试加载OpenAI官方whisper
        2. 如果失败，尝试faster-whisper（更快的推理速度）
        3. 如果都失败，抛出错误并给出安装建议
        """
        if self._模型已加载:
            return

        # 尝试策略一：OpenAI官方Whisper
        try:
            import whisper
            self._记录审计("正在加载OpenAI Whisper模型...", 0.8)
            self.识别模型 = whisper.load_model(
                self.模型名称,
                device=self.设备,
                download_root=self.下载目录
            )
            self._模型已加载 = True
            self._记录审计(
                f"✅ OpenAI Whisper模型加载成功: {self.模型名称}",
                0.95,
                审计颜色.绿色通过
            )
            return
        except ImportError:
            self._记录_audit(
                "OpenAI whisper未安装，尝试降级到faster-whisper",
                0.5,
                审计颜色.黄色警告
            )

        # 尝试策略二：faster-whisper（更快的推理引擎）
        try:
            from faster_whisper import WhisperModel
            self._记录审计("正在加载faster-whisper模型...", 0.7)
            self.识别模型 = WhisperModel(
                self.模型名称,
                device=self.设备 if self.设备 != "cuda" else "cuda",
                compute_type="float16" if self.设备 == "cuda" else "int8",
                download_root=self.下载目录
            )
            self._模型已加载 = True
            self._记录审计(
                f"✅ faster-whisper加载成功: {self.模型名称}",
                0.90,
                审计颜色.绿色通过
            )
            return
        except ImportError:
            self._记录审计(
                "faster-whisper也未安装",
                0.2,
                审计颜色.黄色警告
            )

        # 策略三：尝试whisper-openai（pip包名不同的情况）
        try:
            import whisper_openai as whisper
            self.识别模型 = whisper.load_model(self.模型名称)
            self._模型已加载 = True
            self._记录审计("✅ whisper-openai加载成功", 0.90, 审计颜色.绿色通过)
            return
        except ImportError:
            pass

        # 全部失败，抛出错误
        错误信息 = (
            "❌ 语音识别引擎未安装 · Speech recognition engine not installed\n"
            "请安装以下任一引擎 · Please install one of the following:\n"
            "  1) pip install openai-whisper\n"
            "  2) pip install faster-whisper\n"
            "  3) pip install git+https://github.com/openai/whisper.git"
        )
        self._记录审计(错误信息, 0.0, 审计颜色.红色阻断)
        raise RuntimeError(错误信息)

    # ═══════════════════════════════════════════════════════════════════════
    #  核心API：语音转文字 · Core API: Speech-to-Text
    # ═══════════════════════════════════════════════════════════════════════

    def 语音转文字(
        self,
        音频路径: str,
        语言: Optional[str] = None,
        初始提示: Optional[str] = None,
        温度: float = 0.0,
        返回时间戳: bool = True,
        静音阈值: float = 0.05
    ) -> 语音识别结果:
        """
        核心方法：将语音转换为文字 · Core method: Convert speech to text

        参数 · Parameters:
            音频路径: 音频文件路径 (wav/mp3/flac/m4a等)
            语言: 语言代码 (zh/en/ja等，None则自动检测)
            初始提示: 给模型的上下文提示，提高专有名词识别率
            温度: 采样温度，0=确定性最高，1=多样性最高
            返回时间戳: 是否返回每个词的时间戳
            静音阈值: 静音切除的能量阈值比例

        返回 · Returns:
            语音识别结果对象，包含文字、置信度、时间片段等
        """
        import time
        import numpy as np

        开始时间 = time.time()

        # 确保引擎已初始化
        if not self._模型已加载:
            self._初始化识别引擎()

        # ═══════════════════════════════════════════════
        # 阶段零：铁律审查
        # ═══════════════════════════════════════════════
        审查结果 = self.铁律闸.审查(音频路径)
        if not 审查结果["通过"]:
            for 违规 in 审查结果["违规项"]:
                self._记录审计(f"铁律审查: {违规}", 0.3, 审计颜色.红色阻断)

        # ═══════════════════════════════════════════════
        # 阶段一：音频加载
        # ═══════════════════════════════════════════════
        self._记录审计(f"开始加载音频: {音频路径}", 0.8)
        if not os.path.exists(音频路径):
            raise FileNotFoundError(f"音频文件不存在 · Audio file not found: {音频路径}")

        音频数据, 采样率 = self._加载音频(音频路径)
        self._记录审计(
            f"音频加载完成 | 采样率={采样率}Hz | 长度={len(音频数据)/采样率:.2f}s | 声道=单声道",
            0.9,
            审计颜色.绿色通过
        )

        # ═══════════════════════════════════════════════
        # 阶段二：音频预处理
        # ═══════════════════════════════════════════════
        处理后的音频 = self._预处理音频(音频数据, 采样率, 静音阈值)
        self._记录审计(
            f"音频预处理完成 | 处理后长度={len(处理后的音频)/16000:.2f}s | 目标采样率=16000Hz",
            0.9,
            审计颜色.绿色通过
        )

        # ═══════════════════════════════════════════════
        # 阶段三：模型推理（核心识别步骤）
        # ═══════════════════════════════════════════════
        self._记录审计("开始模型推理...", 0.8)
        识别语言 = 语言  # None表示自动检测

        结果字典: Dict[str, Any] = {}

        if hasattr(self.识别模型, 'transcribe'):
            # OpenAI Whisper原生接口 · Native OpenAI Whisper API
            推理参数 = {
                "language": 识别语言,
                "task": "transcribe",
                "verbose": False,
                "temperature": 温度,
                "initial_prompt": 初始提示,
                "condition_on_previous_text": True
            }
            # 过滤None值
            推理参数 = {k: v for k, v in 推理参数.items() if v is not None}

            结果 = self.识别_model.transcribe(处理后的音频, **推理参数)
            文本 = 结果.get("text", "").strip()
            片段列表 = 结果.get("segments", [])

            # 计算平均置信度（从log概率转换）
            if 片段列表:
                对数概率总和 = sum(
                    seg.get("avg_logprob", -1) for seg in 片段列表
                )
                平均对数概率 = 对数概率总和 / len(片段列表)
                # logprob转0-1：logprob通常在-1到0之间
                平均置信度 = max(0.0, min(1.0, 1.0 + 平均对数概率))
            else:
                平均置信度 = 0.0

            # 检测语言
            检测语言 = 结果.get("language", 识别语言 or "auto")

            self._记录审计(
                f"Whisper推理完成 | 语言={检测语言} | 片段数={len(片段列表)}",
                平均置信度,
                审计颜色.绿色通过 if 平均置信度 > 0.7 else 审计颜色.黄色警告
            )

        else:
            # faster-whisper接口 · faster-whisper API
            片段列表 = []
            文本 = ""
            平均置信度 = 0.0
            检测语言 = 识别语言 or "auto"

            推理参数 = {
                "language": 识别语言,
                "task": "transcribe",
                "temperature": 温度,
                "condition_on_previous_text": True,
                "vad_filter": True  # 启用语音活动检测
            }
            推理参数 = {k: v for k, v in 推理参数.items() if v is not None}

            片段生成器, 信息 = self.识别_model.transcribe(处理后的音频, **推理参数)
            检测语言 = 信息.language if hasattr(信息, 'language') else (识别语言 or "auto")

            概率列表 = []
            for 片段 in 片段生成器:
                片段列表.append({
                    "id": 片段.id,
                    "start": 片段.start,
                    "end": 片段.end,
                    "text": 片段.text,
                    "avg_logprob": getattr(片段, 'avg_logprob', -0.5)
                })
                文本 += 片段.text + " "
                概率列表.append(getattr(片段, 'avg_logprob', -0.5))

            文本 = 文本.strip()
            if 概率列表:
                平均置信度 = max(0.0, min(1.0, 1.0 + sum(概率列表) / len(概率列表)))

            self._记录审计(
                f"faster-whisper推理完成 | 语言={检测语言} | 片段数={len(片段列表)}",
                平均置信度,
                审计颜色.绿色通过 if 平均置信度 > 0.7 else 审计颜色.黄色警告
            )

        # ═══════════════════════════════════════════════
        # 阶段四：后处理
        # ═══════════════════════════════════════════════
        处理后文本 = self._后处理文本(文本, 检测语言)

        # ═══════════════════════════════════════════════
        # 阶段五：组装结果
        # ═══════════════════════════════════════════════
        音频时长 = len(音频数据) / max(采样率, 1)
        结束时间 = time.time()
        处理耗时 = 结束时间 - 开始时间

        # DNA追溯码生成
        文件哈希 = hashlib.md5(音频路径.encode()).hexdigest()[:8]
        DNA戳 = f"#龍芯⚡️{datetime.now().strftime('%Y-%m-%d')}-STT-{self.模型名称}-{文件哈希}"

        # 来源链盖章
        来源印章 = self.来源链.盖章(f"龍魂语音识别器/语音转文字/{os.path.basename(音频路径)}")

        # ═══════════════════════════════════════════════
        # 阶段六：三色审计
        # ═══════════════════════════════════════════════
        if 平均置信度 >= 0.85:
            self._记录审计(
                f"🟢 语音识别质量优秀 | 置信度={平均置信度:.2f} | RTF={处理耗时/max(音频时长,0.001):.2f}x",
                平均置信度,
                审计颜色.绿色通过
            )
        elif 平均置信度 >= 0.60:
            self._记录审计(
                f"🟡 语音识别质量一般 | 置信度={平均置信度:.2f} | 建议检查音频质量",
                平均置信度,
                审计颜色.黄色警告
            )
        else:
            self._记录审计(
                f"🔴 语音识别质量差 | 置信度={平均置信度:.2f} | 建议重录或使用更大模型",
                平均置信度,
                审计颜色.红色阻断
            )

        # 组装最终结果
        识别结果 = 语音识别结果(
            文本=处理后文本,
            置信度=平均置信度,
            语言=检测语言,
            片段列表=片段列表,
            音频时长=音频时长,
            处理时长=处理耗时,
            识别模型=f"Whisper-{self.模型名称}",
            DNA追溯=DNA戳,
            审计日志=list(self.审计日志),
            来源链盖章=来源印章
        )

        return 识别结果

    # ═══════════════════════════════════════════════════════════════════════
    #  音频处理内部方法 · Audio Processing Internal Methods
    # ═══════════════════════════════════════════════════════════════════════

    def _加载音频(self, 音频路径: str) -> Tuple[Any, int]:
        """
        加载音频文件为numpy数组 · Load audio file as numpy array

        支持多种格式：WAV、MP3、FLAC、M4A等。
        优先使用soundfile库（速度快、支持格式多），
        如果不可用则降级到wave模块（仅支持WAV）。
        """
        import numpy as np

        文件后缀 = Path(音频路径).suffix.lower()
        if 文件后缀 not in self.支持格式:
            self._记录审计(
                f"⚠️ 不常见格式: {文件后缀}，尝试用soundfile加载",
                0.5,
                审计颜色.黄色警告
            )

        # 策略一：使用soundfile（推荐，支持多格式）
        try:
            import soundfile as sf
            音频数据, 采样率 = sf.read(音频路径, dtype='float32')

            # 转换为单声道（如果是多声道）
            if len(音频数据.shape) > 1 and 音频数据.shape[1] > 1:
                音频数据 = 音频_data.mean(axis=1)

            return 音频_data.astype(np.float32), 采样率

        except ImportError:
            self._记录_audit(
                "soundfile未安装，降级到标准库wave",
                0.4,
                审计颜色.黄色警告
            )

        # 策略二：使用标准库wave（仅WAV格式）
        if 文件后缀 == '.wav':
            with wave.open(音频路径, 'rb') as 波形文件:
                声道数 = 波形文件.getnchannels()
                采样宽度 = 波形文件.getsampwidth()
                采样率 = 波形文件.getframerate()
                帧数 = 波形文件.getnframes()
                原始数据 = 波形文件.readframes(帧数)

                # 根据采样宽度选择数据类型
                if 采样宽度 == 1:
                    # 8-bit unsigned
                    音频数据 = np.frombuffer(原始数据, dtype=np.uint8).astype(np.float32)
                    音频数据 = (音频数据 - 128) / 128.0
                elif 采样宽度 == 2:
                    # 16-bit signed
                    音频数据 = np.frombuffer(原始数据, dtype=np.int16).astype(np.float32) / 32768.0
                elif 采样宽度 == 4:
                    # 32-bit signed
                    音频数据 = np.frombuffer(原始数据, dtype=np.int32).astype(np.float32) / 2147483648.0
                else:
                    raise ValueError(f"不支持的采样宽度: {采样宽度}")

                # 多声道转单声道
                if 声道数 > 1:
                    音频数据 = 音频_data.reshape(-1, 声道数).mean(axis=1)

                return 音频_data.astype(np.float32), 采样率

        # 策略三：尝试ffmpeg转码为WAV后加载
        try:
            import subprocess
            with tempfile.NamedTemporaryFile(suffix='.wav', delete=False) as 临时文件:
                临时路径 = 临时文件.name

            subprocess.run(
                ['ffmpeg', '-i', 音频路径, '-ar', '16000', '-ac', '1', '-f', 'wav', 临时路径],
                check=True, capture_output=True, timeout=30
            )
            结果 = self._加载音频(临时路径)
            os.unlink(临时路径)
            self._记录审计("✅ 使用ffmpeg转码加载成功", 0.85, 审计颜色.绿色通过)
            return 结果
        except (subprocess.SubprocessError, FileNotFoundError):
            pass

        raise RuntimeError(
            f"无法加载音频文件 · Cannot load audio file: {音频路径}\n"
            f"请安装soundfile: pip install soundfile\n"
            f"或安装ffmpeg以支持更多格式"
        )

    def _预处理音频(
        self,
        音频数据,
        原始采样率: int,
        静音阈值: float = 0.05
    ):
        """
        音频预处理——让识别更准确 · Audio preprocessing for better recognition

        预处理流程（核心算法中文注释）：
        1. 重采样：Whisper需要16kHz采样率，如果不是则转换
        2. 静音切除：去掉开头和结尾的无声部分，减少噪声干扰
        3. 音量归一化：统一音量大小，避免忽大忽小影响识别

        Preprocessing steps:
        1. Resample to 16kHz (Whisper's required sample rate)
        2. Remove leading/trailing silence
        3. Normalize volume to prevent loudness variations
        """
        import numpy as np

        目标采样率 = 16000  # Whisper要求16kHz · Whisper requires 16kHz
        处理后的音频 = 音频数据.copy()

        # ═══════════════════════════════════════════════
        # 步骤一：重采样 · Resample
        # ═══════════════════════════════════════════════
        if 原始采样率 != 目标采样率:
            # 使用线性插值进行重采样
            采样比率 = 目标采样率 / 原始采样率
            新长度 = int(len(处理后的音频) * 采样比率)
            处理后的音频 = np.interp(
                np.linspace(0, len(处理后的音频), 新长度),
                np.arange(len(处理后的音频)),
                处理后的音频
            )
            self._记录审计(f"重采样: {原始采样率}Hz → {目标采样率}Hz", 0.9)

        # ═══════════════════════════════════════════════
        # 步骤二：静音切除 · Silence removal
        # ═══════════════════════════════════════════════
        # 分帧计算能量——每帧25ms，帧移10ms
        # Frame-based energy calculation: 25ms frames, 10ms hop
        帧长度 = int(0.025 * 目标采样率)  # 25ms一帧
        帧移 = int(0.010 * 目标采样率)    # 10ms移动

        能量列表 = []
        for i in range(0, len(处理后的音频) - 帧长度, 帧移):
            帧 = 处理后的音频[i:i + 帧长度]
            能量 = np.sum(帧 ** 2)
            能量列表.append(能量)

        if not 能量列表:
            self._记录审计("音频过短，跳过静音切除", 0.5, 审计颜色.黄色警告)
            return 处理后的音频.astype(np.float32)

        能量数组 = np.array(能量列表)
        最大能量 = np.max(能量数组)
        能量阈值 = 最大能量 * 静音阈值 if 最大能量 > 0 else 0.001

        # 找到有效语音帧的位置
        有效帧索引 = np.where(能量数组 > 能量阈值)[0]

        if len(有效帧索引) > 0:
            # 保留前后各10帧的缓冲
            起始帧 = max(0, 有效帧索引[0] - 10)
            结束帧 = min(len(能量列表) - 1, 有效帧索引[-1] + 10)
            起始样本 = 起始帧 * 帧移
            结束样本 = min(结束帧 * 帧移 + 帧长度, len(处理后的音频))
            处理后的音频 = 处理后的音频[起始样本:结束样本]

            静音移除比例 = 1 - (结束样本 - 起始样本) / max(len(处理后的音频), 1)
            self._记录审计(
                f"静音切除完成 | 保留={len(处理后的音频)/目标采样率:.2f}s | 移除比例={静音移除比例:.1%}",
                0.85
            )

        # ═══════════════════════════════════════════════
        # 步骤三：音量归一化 · Volume normalization
        # ═══════════════════════════════════════════════
        峰值 = np.max(np.abs(处理后的音频))
        if 峰值 > 0:
            # 归一化到-1dB（0.891倍满幅）
            # Normalize to -1dB (0.891 of full scale)
            目标峰值 = 0.891
            增益 = 目标峰值 / 峰值
            处理后的音频 = 处理后的音频 * 增益

            self._记录审计(f"音量归一化: 峰值={峰值:.4f} → {目标峰值:.4f} (增益={增益:.2f}x)", 0.9)

        return 处理后的音频.astype(np.float32)

    def _后处理文本(self, 原始文本: str, 语言: str) -> str:
        """
        文本后处理 · Text post-processing

        对识别结果进行优化：
        1. 去除多余空格
        2. 中文文本优化标点
        3. 去除常见识别错误模式
        """
        文本 = 原始文本.strip()

        # 去除多余空格
        import re
        文本 = re.sub(r'\s+', ' ', 文本)

        # 中文文本特殊处理
        if language in ('zh', 'zh-cn', 'zh-tw', 'zh-hk', 'yue'):
            # 中文前后无空格
            文本 = re.sub(r'(?<=[\u4e00-\u9fff])\s+(?=[\u4e00-\u9fff])', '', 文本)
            # 中英文之间加空格（可选，根据偏好）
            文本 = re.sub(r'(?<=[\u4e00-\u9fff])(?=[a-zA-Z])', ' ', 文本)
            文本 = re.sub(r'(?<=[a-zA-Z])(?=[\u4e00-\u9fff])', ' ', 文本)

        return 文本.strip()

    # ═══════════════════════════════════════════════════════════════════════
    #  审计与日志 · Audit and Logging
    # ═══════════════════════════════════════════════════════════════════════

    def _记录审计(
        self,
        消息: str,
        置信度: float,
        颜色: 审计颜色 = 审计颜色.绿色通过
    ) -> None:
        """记录审计日志 · Record audit log"""
        if not self.审计开关:
            return
        self.审计日志.append(审计结果(
            颜色=颜色,
            置信度=置信度,
            原因=消息,
            建议=""
        ))

    def 获取审计日志(self) -> List[审计结果]:
        """获取全部审计日志 · Get all audit logs"""
        return list(self.审计日志)

    def 打印审计日志(self) -> None:
        """打印审计日志 · Print audit logs"""
        print("\n" + "=" * 60)
        print("  龍魂语音识别器 · 审计日志")
        print("=" * 60)
        for i, 记录 in enumerate(self.审计日志, 1):
            print(f"  [{i}] {记录.颜色.value} 置信度={记录.置信度:.2f} | {记录.原因}")
        print("=" * 60)

    # ═══════════════════════════════════════════════════════════════════════
    #  工具方法 · Utility Methods
    # ═══════════════════════════════════════════════════════════════════════

    def 批量识别(
        self,
        音频路径列表: List[str],
        语言: Optional[str] = None
    ) -> List[语音识别结果]:
        """
        批量识别多个音频文件 · Batch recognize multiple audio files
        """
        结果列表 = []
        for i, 路径 in enumerate(音频路径列表, 1):
            self._记录审计(f"批量处理 [{i}/{len(音频路径列表)}]: {路径}", 0.8)
            try:
                结果 = self.语音转文字(路径, 语言=语言)
                结果列表.append(结果)
            except Exception as e:
                self._记录审计(f"处理失败: {路径} | 错误: {e}", 0.0, 审计颜色.红色阻断)
                结果列表.append(None)
        return 结果列表

    def 获取模型信息(self) -> Dict[str, Any]:
        """获取当前模型信息 · Get current model information"""
        return {
            "模型名称": self.模型名称,
            "计算设备": self.设备,
            "模型已加载": self._模型已加载,
            "审计开关": self.审计开关,
            "Whisper版本": self._获取_whisper版本(),
            "DNA追溯": 六层来源链.DNA
        }

    def _获取_whisper版本(self) -> str:
        """获取Whisper库版本 · Get Whisper library version"""
        try:
            import whisper
            return getattr(whisper, '__version__', 'unknown')
        except:
            try:
                from faster_whisper import __version__
                return f"faster-whisper-{__version__}"
            except:
                return "not_installed"

    def __repr__(self) -> str:
        return f"<龍魂语音识别器 模型={self.模型名称} 设备={self.设备} 已加载={self._模型已加载}>"

    def __del__(self):
        """析构时清理资源 · Clean up resources on destruction"""
        if hasattr(self, '识别模型') and self.识别模型 is not None:
            # 释放GPU内存
            try:
                import torch
                if hasattr(self.识别模型, 'device'):
                    if 'cuda' in str(self.识别_model.device):
                        torch.cuda.empty_cache()
            except ImportError:
                pass


