class 审计颜色(Enum):
    """三色审计标签 · Three-color audit labels"""
    绿色通过 = "🟢"   # 质量优秀 · Excellent quality
    黄色警告 = "🟡"   # 需要注意 · Needs attention
    红色阻断 = "🔴"   # 严重问题 · Critical issue


@dataclass
class 审计结果:
    """审计结果数据结构 · Audit result data structure"""
    颜色: 审计颜色
    置信度: float
    原因: str
    建议: str


