            print(f"  ✅ 音频加载成功 | 采样率={加载采样率}Hz | 样本数={len(音频数据)}")

            print("\n【测试6】音频预处理测试 · Audio preprocessing test")
            处理后 = 识别器._预处理音频(音频数据, 加载采样率)
            print(f"  ✅ 预处理完成 | 输出长度={len(处理后)} | 采样率=16000Hz")

            # 注意：实际的Whisper模型推理需要安装whisper
            # 这里不做实际推理，因为测试环境可能没有模型
            print("\n【测试7】语音识别结果数据结构测试 · Result data structure test")
            测试结果 = 语音识别结果(
                文本="这是一个测试识别的文本结果",
                置信度=0.92,
                语言="zh",
                片段列表=[
                    {"start": 0.0, "end": 2.5, "text": "这是一个测试"},
                    {"start": 2.5, "end": 5.0, "text": "识别的文本结果"}
                ],
                音频时长=5.0,
                处理时长=1.2,
                识别模型="Whisper-base",
                DNA追溯="#龍芯⚡️2026-06-18-STT-test"
            )
            print(f"  ✅ 结果对象: {测试结果}")
            print(f"  字典输出: {测试结果.to_dict()}")

    except Exception as e:
        print(f"  ⚠️ 测试音频生成失败: {e}")

    # 清理
    if os.path.exists("/tmp/龍魂测试音频.wav"):
        os.unlink("/tmp/龍魂测试音频.wav")

    # 最终审计日志
    if 识别器:
        print("\n")
        识别器.打印审计日志()

    # 君子协议 · Gentleman's Agreement
    print("\n" + "=" * 70)
    print("  君子协议 · Gentleman's Agreement · CC BY-NC-SA 4.0")
