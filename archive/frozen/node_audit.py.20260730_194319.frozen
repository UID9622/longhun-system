#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂系统 · 节点质量审计器 v1.0
UID9622 | 诸葛鑫·龍芯北辰
功能：验证P0-P4协议合规性、DNA完整性、架构硬度
"""

import os
import json
import hashlib
import time
from datetime import datetime
from pathlib import Path

DNA_ANCHOR = os.environ.get("LONGHUN_DNA_ANCHOR", "")
CONFIRM = os.environ.get("LONGHUN_CONFIRM", "")
NODE_ID = os.environ.get("LONGHUN_NODE_ID", "unknown")

# P0-P4 协议检查项
AUDIT_RULES = {
    "P0_底座焊死": [
        ("DNA锚定存在", lambda: bool(DNA_ANCHOR)),
        ("确认码存在", lambda: bool(CONFIRM)),
        ("数据目录可写", lambda: Path("/data").exists() or Path("./data").exists()),
        ("日志系统就绪", lambda: (Path("/data/logs").exists() or Path("./data/logs").exists())),
    ],
    "P1_核心宪法": [
        ("节点ID有效", lambda: NODE_ID.startswith("LH-") and len(NODE_ID) > 10),
        ("环境变量完整", lambda: all([DNA_ANCHOR, CONFIRM, NODE_ID])),
    ],
    "P2_系统规则": [
        ("心跳服务可运行", lambda: True),
        ("抓取引擎可导入", lambda: True),
    ],
    "P3_区域适配": [
        ("时区设置为上海", lambda: time.strftime("%Z") in ["CST", "China Standard Time"]),
    ],
    "P4_用户自定义": [
        ("数据主权声明", lambda: True),
    ]
}

def run_audit():
    """执行审计"""
    print(f"\n{'='*60}")
    print(f"🐉 龍魂节点质量审计 v1.0")
    print(f"🐉 节点ID: {NODE_ID}")
    print(f"{'='*60}\n")

    results = {}
    total_pass = 0
    total_fail = 0

    for layer, rules in AUDIT_RULES.items():
        print(f"[{layer}]")
        layer_pass = 0
        layer_fail = 0

        for rule_name, check_fn in rules:
            try:
                passed = check_fn()
            except Exception as e:
                passed = False
                print(f"   ⚠️  {rule_name} 检查异常: {e}")

            status = "✅" if passed else "❌"
            if passed:
                layer_pass += 1
                total_pass += 1
            else:
                layer_fail += 1
                total_fail += 1

            print(f"   {status} {rule_name}")

        results[layer] = {"pass": layer_pass, "fail": layer_fail}
        print(f"   通过: {layer_pass}/{layer_pass + layer_fail}")
        print()

    # 生成审计报告
    report = {
        "node_id": NODE_ID,
        "audited_at": datetime.now().isoformat(),
        "dna_anchor": DNA_ANCHOR[:30] + "..." if DNA_ANCHOR else "",
        "summary": {
            "total_rules": total_pass + total_fail,
            "passed": total_pass,
            "failed": total_fail,
            "score": round(total_pass / (total_pass + total_fail) * 100, 1) if (total_pass + total_fail) > 0 else 0
        },
        "layers": results
    }

    # DNA签章
    report["signature"] = hashlib.sha256(
        (json.dumps(report, sort_keys=True, ensure_ascii=False) + DNA_ANCHOR + CONFIRM).encode()
    ).hexdigest()[:32]

    # 保存
    audit_dir = Path("/data/audit") if Path("/data").exists() else Path("./data/audit")
    audit_dir.mkdir(parents=True, exist_ok=True)

    audit_file = audit_dir / f"audit_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json"
    with open(audit_file, 'w', encoding='utf-8') as f:
        json.dump(report, f, ensure_ascii=False, indent=2)

    print(f"{'='*60}")
    print(f"📊 审计结果:")
    print(f"   总分: {report['summary']['score']}%")
    print(f"   通过: {total_pass} | 失败: {total_fail}")
    print(f"   报告: {audit_file}")
    print(f"{'='*60}")

    return report

def main():
    while True:
        run_audit()
        print(f"\n⏱️  下次审计: 1小时后...\n")
        time.sleep(3600)

if __name__ == "__main__":
    run_audit()
    main()
