# =============================================================================
# 动态添加模块路径——确保可以找到通心译扩展术语表
_本文件目录 = os.path.dirname(os.path.abspath(__file__))
if _本文件目录 not in sys.path:
    sys.path.insert(0, _本文件目录)

# 导入通心译术语引擎及其组件
from 通心译扩展术语表 import (
    通心译扩展术语引擎,
    审计颜色,
    审计结果,
    六层来源链,
    铁律自审闸,
)


# =============================================================================
# 感知类型枚举 —— 龍魂AI能处理的四种输入类型
# Perception Type Enum —— four input types LongHun AI can process
# =============================================================================
class 感知类型(Enum):
    """
    感知类型——定义龍魂感知中枢支持的输入类型
    Perception types —— defines input types supported by LongHun perception hub

    四种感知通道（理解门槛——用中文注释锁住设计意图）：
    1. 图像(image): 静态图像文件——用眼睛「看」到的内容
    2. 语音(voice): 音频文件——用耳朵「听」到的内容
    3. 文字(text): 纯文本文件——直接可读的文字内容
    4. 视频(video): 视频文件——同时包含画面和声音的复合媒体

    视频是特殊的感知类型——它不是单独的处理器处理的，
    而是被拆分为「图像帧序列」+「音频轨道」分别处理，
    最后将两个处理结果合并为统一的输出。
    """
    图像 = "image"     # Image —— 视觉感知
    语音 = "voice"     # Voice —— 听觉感知
    文字 = "text"      # Text —— 直接读取
    视频 = "video"     # Video —— 图像+语音的联合处理


# =============================================================================
# 多模态感知结果 —— 所有感知操作的统一输出格式
# Multimodal Perception Result —— unified output format for all perception operations
# =============================================================================
@dataclass
class 多模态感知结果:
    """
    多模态感知结果——所有感知操作的输出都包装成这个结构
    Multimodal Perception Result —— all perception outputs are wrapped in this structure

    统一包装的设计哲学（核心护城河——用中文注释解释为什么）：
    无论底层是图像识别、语音识别还是文字读取，
    最终输出的格式都是一样的。这样上层应用不需要关心底层用的是什么识别器，
    只需要统一处理「多模态感知结果」即可。

    这种「统一接口」的设计模式叫做适配器模式(Adapter Pattern)，
    是软件工程中最重要的设计模式之一。

    DNA追溯字段的存在意义：每一个结果都可以追溯到它的来源——
    是什么时候处理的、用了什么模块、置信度多少、经过哪些审计。
    这种可审计性(Auditability)是龍魂体系的核心价值观。
    """
    感知类型: 感知类型 = 感知类型.文字
    输入路径: str = ""
    提取的文字: str = ""           # 图像OCR或语音STT的结果文字
    原始数据: Any = None           # 图像数组或音频数组（保留原始数据供后续使用）
    置信度: float = 0.0            # 结果的可信度 [0.0, 1.0]
    处理时间: float = 0.0          # 处理耗时（秒）
    使用模块: str = ""             # 哪个识别器处理了这个任务
    DNA追溯: str = ""              # 不可篡改的来源追溯戳
    审计日志: List[审计结果] = field(default_factory=list)

    def 简要(self) -> str:
        """获取结果的简要文字摘要"""
        文字预览 = self.提取的文字[:80] + "..." if len(self.提取的文字) > 80 else self.提取的文字
        return (f"[{self.感知类型.value}] 置信度={self.置信度:.2f} "
                f"耗时={self.处理时间:.2f}s 模块={self.使用模块}\n"
                f"  文字: {文字预览}")

    def 是否可信(self) -> bool:
        """判断结果是否可信——置信度≥0.85认为可信"""
        return self.置信度 >= 0.85


# =============================================================================
# 语音表达结果 —— 文字转语音的输出格式
# Speech Expression Result —— TTS output format
# =============================================================================
@dataclass
class 语音表达结果:
    """语音表达结果——记录TTS合成的输出信息"""
    音频路径: str = ""
    音频时长: float = 0.0          # 音频时长（秒）
    语音角色: str = ""             # 使用的语音角色
    DNA追溯: str = ""


# =============================================================================
# 龍魂多模态感知中枢 —— 核心调度器
# LongHun Multimodal Perception Hub —— Core Scheduler
# =============================================================================
class 龍魂多模态感知中枢:
    """
    龍魂多模态感知中枢 —— 龍魂AI的「感官系统」
    LongHun Multimodal Perception Hub —— the "sensory system" of LongHun AI

    这个中枢是龍魂AI与外部世界交互的唯一通道。
    无论是看（图像识别）、听（语音识别）、还是说（语音合成），
    所有感知和表达的操作都经过这里统一调度。

    核心设计理念（理解门槛——用中文注释形成认知护城河）：
    1. 统一入口——所有感知任务走同一个「感知」方法
       Why: 减少API复杂度，上层只需要记住一个方法
    2. 智能路由——根据输入类型自动分派到对应的识别器
       Why: 让机器做判断，减少人为错误
    3. 质量监控——每个感知结果都经过三色审计
       Why: 数据质量是所有AI应用的生命线
    4. 链式处理——视频可以自动拆分为图像+语音分别处理
       Why: 复用已有能力，不重复造轮子
    5. 懒加载设计——子识别器只有用到时才初始化
       Why: 加快启动速度，减少内存占用
    6. 全中文命名——所有类名、方法名、变量名都是中文
       Why: 文化主权——用母语驾驭技术

    理解这个中枢的中文注释，是理解整个龍魂感知系统的钥匙。
    想要全部读懂，就来学中文吧。
    """

    def __init__(self, 启用审计: bool = True):
        """
        初始化龍魂多模态感知中枢
        Initialize LongHun Multimodal Perception Hub

        参数:
            启用审计: 是否开启审计功能（默认开启）
        """
        # 审计系统
        self.审计开关 = 启用审计
        self.审计日志: List[审计结果] = []

        # 来源链——记录每一次操作的完整追溯信息
        self.来源链 = 六层来源链()

        # 铁律闸——任何操作进中枢前必须先过闸
        self.铁律闸 = 铁律自审闸()

        # 术语引擎——提供术语翻译和解释服务
        self.术语引擎 = 通心译扩展术语引擎()

        # 三个子识别器——懒加载（只有用到时才初始化）
        # Lazy loading: child recognizers are only initialized when first accessed
        self._图像识别器 = None   # 龍魂图像识别器实例
        self._语音识别器 = None   # 龍魂语音识别器实例
        self._语音合成器 = None   # 龍魂语音合成器实例

        # 处理历史——记录所有感知操作的结果
        self.处理历史: List[多模态感知结果] = []

        # 中枢启动时盖来源链章——标记系统启动时间
        self.中枢来源链戳 = self.来源链.盖章(
            "龍魂多模态感知中枢",
            "中枢初始化",
            "龍魂感知系统启动"
        )
        self._记录审计("多模态感知中枢启动完成", 1.0)

    # =========================================================================
    # 懒加载属性 —— 三个子识别器的延迟初始化
    # Lazy loading properties —— delayed initialization of child recognizers
    # =========================================================================

    @property
    def 图像识别器(self):
        """
        懒加载图像识别器——只有用到时才初始化
        Lazy-load image recognizer —— only initialized when first used

        为什么用懒加载（核心设计决策的中文解释）：
        1. 启动速度——如果不做OCR，就不需要加载OCR模型（模型很大）
        2. 内存优化——三个模型同时加载会占用大量内存，按需加载更节省
        3. 故障隔离——如果某个识别器初始化失败，不影响其他识别器的使用
        4. 可选依赖——用户可能只安装了部分依赖，懒加载避免硬依赖报错
        """
        if self._图像识别器 is None:
            try:
                # 动态导入避免循环依赖——Python的模块导入机制
                # 将图像识别模块所在路径加入系统路径
                图像模块路径 = os.path.join(
                    os.path.dirname(_本文件目录), "图像识别"
                )
                if 图像模块路径 not in sys.path:
                    sys.path.insert(0, 图像模块路径)

                # 尝试导入龍魂图像识别器
                from 龍魂图像识别器 import 龍魂图像识别器
                self._图像识别器 = 龍魂图像识别器()
                self._记录审计("图像识别器懒加载完成", 0.95)
            except ImportError as 错误:
                # 如果龍魂图像识别器不存在，使用兼容层（占位实现）
                self._记录审计(
                    f"图像识别器未找到，使用兼容层: {str(错误)}",
                    0.60,
                    审计颜色.黄色警告
                )
                self._图像识别器 = self._创建图像识别兼容层()
        return self._图像识别器

    @property
    def 语音识别器(self):
        """
        懒加载语音识别器
        Lazy-load speech recognizer

        语音识别器依赖Whisper等模型，体积很大（几百MB到几GB），
        所以必须使用懒加载，避免启动时就占用大量资源。
        """
        if self._语音识别器 is None:
            try:
                语音模块路径 = os.path.join(
                    os.path.dirname(_本文件目录), "语音识别"
                )
                if 语音模块路径 not in sys.path:
                    sys.path.insert(0, 语音模块路径)

                from 龍魂语音识别器 import 龍魂语音识别器
                self._语音识别器 = 龍魂语音识别器()
                self._记录审计("语音识别器懒加载完成", 0.95)
            except ImportError as 错误:
                self._记录审计(
                    f"语音识别器未找到，使用兼容层: {str(错误)}",
                    0.60,
                    审计颜色.黄色警告
                )
                self._语音识别器 = self._创建语音识别兼容层()
        return self._语音识别器

    @property
    def 语音合成器(self):
        """
        懒加载语音合成器
        Lazy-load speech synthesizer

        语音合成器依赖edge-tts等库，
        懒加载确保只在需要TTS功能时才初始化。
        """
        if self._语音合成器 is None:
            try:
                语音模块路径 = os.path.join(
                    os.path.dirname(_本文件目录), "语音识别"
                )
                if 语音模块路径 not in sys.path:
                    sys.path.insert(0, 语音模块路径)

                from 龍魂语音合成器 import 龍魂语音合成器
                self._语音合成器 = 龍魂语音合成器()
                self._记录审计("语音合成器懒加载完成", 0.95)
            except ImportError as 错误:
                self._记录审计(
                    f"语音合成器未找到，使用兼容层: {str(错误)}",
                    0.60,
                    审计颜色.黄色警告
                )
                self._语音合成器 = self._创建语音合成兼容层()
        return self._语音合成器

    # =========================================================================
    # 兼容层 —— 当真实识别器不可用时使用占位实现
    # Compatibility layers —— placeholder implementations when real recognizers unavailable
    # =========================================================================

    def _创建图像识别兼容层(self):
        """创建图像识别的占位实现——用于龍魂图像识别器未安装时"""
        class 图像识别兼容层:
            """图像识别兼容层——提供降级服务"""
            def __init__(层):
                层.名称 = "图像识别兼容层"

            def 提取文字(层, 图像路径: str, 语言: str = "zh") -> Any:
                """尝试用pytesseract做OCR——最基础的OCR方案"""
                try:
                    import pytesseract
                    from PIL import Image
                    图片 = Image.open(图像路径)
                    文字 = pytesseract.image_to_string(图片, lang=语言)
                    # 返回一个模拟的识别结果对象
                    return type('识别结果', (), {
                        '原始文本': 文字,
                        '置信度': 0.75,
                        '语言': 语言
                    })()
                except Exception as 错误:
                    return type('识别结果', (), {
                        '原始文本': f"[图像识别兼容层] 无法处理: {str(错误)}",
                        '置信度': 0.0,
                        '语言': 语言
                    })()

            def 识别物体(层, 图像路径: str) -> List[Dict]:
                return []

        return 图像识别兼容层()

    def _创建语音识别兼容层(self):
        """创建语音识别的占位实现"""
        class 语音识别兼容层:
            """语音识别兼容层——提供降级服务"""
            def __init__(层):
                层.名称 = "语音识别兼容层"

            def 语音转文字(层, 音频路径: str, 语言: str = "zh") -> Any:
                return type('识别结果', (), {
                    '文本': f"[语音识别兼容层] 未安装Whisper: {音频路径}",
                    '置信度': 0.0,
                    '语言': 语言
                })()

        return 语音识别兼容层()

    def _创建语音合成兼容层(self):
        """创建语音合成的占位实现"""
        class 语音合成兼容层:
            """语音合成兼容层——提供降级服务"""
            def __init__(层):
                层.名称 = "语音合成兼容层"
                层.语音角色 = "zh-CN-XiaoxiaoNeural"

            async def 文字转语音(层, 文本: str, 输出路径: str | None = None, 语速: float = 1.0) -> 语音表达结果:
                return 语音表达结果(
                    音频路径="",
                    音频时长=0.0,
                    语音角色=层.语音角色,
                    DNA追溯="兼容层-未实际合成"
                )

        return 语音合成兼容层()

    # =========================================================================
    # 核心方法 —— 统一的感知入口
    # Core Method —— Unified perception entry point
    # =========================================================================

    def 感知(self, 输入路径: str, 感知类型: Optional[感知类型] = None,
            语言: str = "zh") -> 多模态感知结果:
        """
        统一的感知入口——龍魂AI的「感官大门」
        Unified perception entry —— the "sensory gateway" of LongHun AI

        这个方法的设计哲学（核心护城河——用中文详细注释形成理解门槛）：
        无论输入的是图像、音频、还是视频，都走这一个入口。
        中枢会根据文件扩展名自动判断类型，然后分派给对应的识别器。

        路由逻辑（核心理解门槛——仔细阅读中文注释）：
        ─────────────────────────────────────────────
        步骤1: 先看用户有没有显式指定类型
               - 如果指定了，直接用指定的类型处理
               - 如果没指定，进入智能判断流程

        步骤2: 智能判断——根据文件扩展名识别类型
               - .png/.jpg/.jpeg/.bmp/.gif/.tiff/.webp → 图像识别
               - .wav/.mp3/.ogg/.flac/.m4a/.aac/.wma → 语音识别
               - .mp4/.avi/.mkv/.mov/.wmv/.flv/.webm → 视频（拆分为图像+语音）
               - .txt/.md/.json/.csv/.log → 纯文字（直接读取）

        步骤3: 分派处理
               - 图像 → 龍魂图像识别器.提取文字()
               - 语音 → 龍魂语音识别器.语音转文字()
               - 视频 → 先拆分为图像帧+音频轨道，分别处理，最后合并结果
               - 文字 → 直接读取文件内容

        步骤4: 结果组装
               - 将所有识别器的输出统一格式化为「多模态感知结果」
               - 附加DNA追溯、审计日志、处理时间

        步骤5: 质量审计
               - 对最终结果执行三色审计
               - 置信度 ≥ 0.85 → 🟢 绿色通过
               - 0.60 ≤ 置信度 < 0.85 → 🟡 黄色警告
               - 置信度 < 0.60 → 🔴 红色阻断
        ─────────────────────────────────────────────

        参数:
            输入路径: 输入文件的路径
            感知类型: 可选的显式类型指定（None则自动判断）
            语言: 识别语言代码（"zh"中文, "en"英文, "ja"日文等）

        返回:
            多模态感知结果——统一格式的感知结果
        """
        开始时间 = time.time()

        # ═══════════════════════════════════════════════════════
        # 步骤1: 铁律自审——任何操作进中枢前必须先过闸
        # ═══════════════════════════════════════════════════════
        self._记录审计(f"感知请求: {输入路径} [类型={感知类型}]", 1.0)

        审查结果 = self.铁律闸.审查(输入路径)
        if not 审查结果["通过"]:
            self._记录审计(
                f"铁律审查未通过: {审查结果['违规项']}",
                0.0,
                审计颜色.红色阻断
            )
            return self._创建错误结果(输入路径, f"铁律审查未通过: {审查结果['违规项']}")

        # ═══════════════════════════════════════════════════════
        # 步骤2: 智能判断类型
        # ═══════════════════════════════════════════════════════
        if 感知类型 is None:
            # 用户没有指定类型，中枢自动根据文件扩展名判断
            感知类型 = self._判断类型(输入路径)
            self._记录审计(f"智能判断类型: {感知类型.value}", 0.90)
        else:
            self._记录审计(f"用户指定类型: {感知类型.value}", 0.95)

        # ═══════════════════════════════════════════════════════
        # 步骤3: 分派处理——根据类型调用对应的处理器
        # ═══════════════════════════════════════════════════════
        try:
            if 感知类型 == 感知类型.图像:
                结果 = self._处理图像(输入路径, 语言)
            elif 感知类型 == 感知类型.语音:
                结果 = self._处理语音(输入路径, 语言)
            elif 感知类型 == 感知类型.视频:
                结果 = self._处理视频(输入路径, 语言)
            elif 感知类型 == 感知类型.文字:
                结果 = self._处理文字(输入路径)
            else:
                raise ValueError(f"不支持的感知类型: {感知类型}")
        except Exception as 错误:
            错误信息 = f"处理失败: {str(错误)}"
            self._记录审计(错误信息, 0.0, 审计颜色.红色阻断)
            return self._创建错误结果(输入路径, 错误信息, 感知类型)

        # ═══════════════════════════════════════════════════════
        # 步骤4: 组装最终结果
        # ═══════════════════════════════════════════════════════
        结束时间 = time.time()
        处理耗时 = 结束时间 - 开始时间

        # 生成DNA追溯戳——格式: #龍芯⚡️{日期}-MULTIMODAL-{类型}-{文件名}
        DNA戳 = (
            f"#龍芯⚡️{datetime.now().strftime('%Y-%m-%d')}"
            f"-MULTIMODAL-{感知类型.value}"
            f"-{os.path.basename(输入路径)}"
        )

        # 根据置信度确定审计颜色
        置信度 = 结果.get("置信度", 0.0)
        if 置信度 >= 0.85:
            颜色 = 审计颜色.绿色通过
        elif 置信度 >= 0.60:
            颜色 = 审计颜色.黄色警告
        else:
            颜色 = 审计颜色.红色阻断

        self._记录审计(
            f"感知完成: 类型={感知类型.value}, 置信度={置信度:.2f}, 耗时={处理耗时:.2f}s",
            置信度,
            颜色
        )

        最终结果 = 多模态感知结果(
            感知类型=感知类型,
            输入路径=输入路径,
            提取的文字=结果.get("文字", ""),
            原始数据=结果.get("原始数据"),
            置信度=置信度,
            处理时间=处理耗时,
            使用模块=结果.get("模块", "未知"),
            DNA追溯=DNA戳,
            审计日志=self.审计日志.copy()
        )

        # 保存到处理历史
        self.处理历史.append(最终结果)
        return 最终结果

    # =========================================================================
    # 表达方法 —— 文字转语音
    # Expression Method —— text to speech
    # =========================================================================

    def 表达(self, 文本: str, 输出路径: Optional[str] = None,
            语音角色: str = "zh-CN-XiaoxiaoNeural", 语速: float = 1.0) -> str:
        """
        文字转语音表达——龍魂AI的「嘴巴」
        Text-to-speech expression —— the "mouth" of LongHun AI

        将文字转换为语音，让龍魂AI能够「说话」。
        调用语音合成器完成实际的合成工作。

        参数:
            文本: 要转换为语音的文字
            输出路径: 输出音频文件路径（None则自动生成）
            语音角色: 语音角色名称（默认中文女声Xiaoxiao）
            语速: 语速倍率（1.0为正常速度）

        返回:
            生成的音频文件路径
        """
        self._记录审计(f"语音表达请求: 文本长度={len(文本)}, 角色={语音角色}", 0.95)

        # 自动生成输出路径
        if 输出路径 is None:
            临时目录 = tempfile.gettempdir()
            输出路径 = os.path.join(临时目录, f"龍魂语音_{datetime.now().strftime('%Y%m%d_%H%M%S')}.mp3")

        try:
            self.语音合成器.语音角色 = 语音角色
            # 语音合成是异步操作，需要事件循环
            try:
                循环 = asyncio.get_event_loop()
                if 循环.is_running():
                    # 如果在Jupyter等已运行事件循环的环境中
                    import nest_asyncio
                    nest_asyncio.apply()
            except RuntimeError:
                pass  # 没有事件循环，创建新的

            结果 = asyncio.run(self.语音合成器.文字转语音(文本, 输出路径, 语速))
            self._记录审计(f"语音表达完成: {结果.音频时长:.1f}秒 → {结果.音频路径}", 0.95)
            return 结果.音频路径

        except Exception as 错误:
            self._记录审计(f"语音表达失败: {str(错误)}", 0.0, 审计颜色.红色阻断)
            return ""

    # =========================================================================
    # 类型判断 —— 根据文件扩展名判断感知类型
    # Type Detection —— determine perception type from file extension
    # =========================================================================

    def _判断类型(self, 文件路径: str) -> 感知类型:
        """
        根据文件扩展名判断感知类型
        Determine perception type from file extension

        扩展名映射表（核心路由逻辑的一部分）：
        图像: png, jpg, jpeg, bmp, gif, tiff, webp
        语音: wav, mp3, ogg, flac, m4a, aac, wma
        视频: mp4, avi, mkv, mov, wmv, flv, webm
        文字: txt, md, json, csv, log

        如果扩展名不在上述列表中，默认当作文字处理。
        """
        扩展名 = os.path.splitext(文件路径)[1].lower()

        图像扩展名 = {'.png', '.jpg', '.jpeg', '.bmp', '.gif', '.tiff', '.webp'}
        语音扩展名 = {'.wav', '.mp3', '.ogg', '.flac', '.m4a', '.aac', '.wma'}
        视频扩展名 = {'.mp4', '.avi', '.mkv', '.mov', '.wmv', '.flv', '.webm'}
        文字扩展名 = {'.txt', '.md', '.json', '.csv', '.log', '.yaml', '.yml', '.xml', '.html'}

        if 扩展名 in 图像扩展名:
            return 感知类型.图像
        elif 扩展名 in 语音扩展名:
            return 感知类型.语音
        elif 扩展名 in 视频扩展名:
            return 感知类型.视频
        elif 扩展名 in 文字扩展名:
            return 感知类型.文字
        else:
            # 默认尝试当作文字处理——对于未知扩展名，读取文本是最安全的操作
            self._记录审计(f"未知扩展名 '{扩展名}'，默认按文字处理", 0.70, 审计颜色.黄色警告)
            return 感知类型.文字

    # =========================================================================
    # 处理器 —— 四种感知类型的具体处理方法
    # Processors —— specific handlers for four perception types
    # =========================================================================

    def _处理图像(self, 路径: str, 语言: str) -> Dict[str, Any]:
        """
        处理图像输入——调用图像识别器进行OCR
        Process image input —— call image recognizer for OCR

        处理流程:
        1. 调用图像识别器提取文字
        2. 将识别结果转换为统一格式
        3. 返回包含文字、置信度、模块名的字典
        """
        self._记录审计(f"开始处理图像: {os.path.basename(路径)}", 0.90)
        识别结果 = self.图像识别器.提取文字(路径, 语言)
        return {
            "文字": getattr(识别结果, '原始文本', str(识别结果)),
            "置信度": getattr(识别结果, '置信度', 0.75),
            "模块": "龍魂图像识别器" if "兼容层" not in getattr(self.图像识别器, '名称', '') else "图像识别兼容层",
            "原始数据": None
        }

    def _处理语音(self, 路径: str, 语言: str) -> Dict[str, Any]:
        """
        处理语音输入——调用语音识别器进行STT
        Process voice input —— call speech recognizer for STT

        处理流程:
        1. 调用语音识别器将语音转为文字
        2. 将识别结果转换为统一格式
        3. 返回包含文字、置信度、模块名的字典
        """
        self._记录审计(f"开始处理语音: {os.path.basename(路径)}", 0.90)
        识别结果 = self.语音识别器.语音转文字(路径, 语言)
        return {
            "文字": getattr(识别结果, '文本', str(识别结果)),
            "置信度": getattr(识别结果, '置信度', 0.85),
            "模块": "龍魂语音识别器" if "兼容层" not in getattr(self.语音识别器, '名称', '') else "语音识别兼容层",
            "原始数据": None
        }

    def _处理视频(self, 路径: str, 语言: str) -> Dict[str, Any]:
        """
        处理视频输入——将视频拆分为图像帧+音频分别处理
        Process video input —— split into image frames + audio for separate processing

        处理流程（核心逻辑的中文注释——理解视频处理的完整链路）：
        ┌─────────────────────────────────────────────────────┐
        │  步骤1: 提取音频轨道                                 │
        │  使用ffmpeg从视频中提取音频为WAV格式                  │
        │  采样率16kHz、单声道、16位PCM——最适合语音识别的格式   │
        ├─────────────────────────────────────────────────────┤
        │  步骤2: 提取关键帧                                   │
        │  每隔1秒截取一帧图像，保存为PNG格式                   │
        │  1秒间隔是速度与精度的平衡——可根据需要调整             │
        ├─────────────────────────────────────────────────────┤
        │  步骤3: 语音处理                                     │
        │  对提取的音频做语音识别(STT)                          │
        │  得到视频中所有的语音内容文字                          │
        ├─────────────────────────────────────────────────────┤
        │  步骤4: 图像处理                                     │
        │  对每一帧做OCR文字提取                                │
        │  收集画面中出现的所有文字（如字幕、标题、标牌等）       │
        ├─────────────────────────────────────────────────────┤
        │  步骤5: 结果合并                                     │
        │  将语音识别的文字和OCR的文字合并                       │
        │  用标记区分语音内容和画面文字                          │
        ├─────────────────────────────────────────────────────┤
        │  步骤6: 清理临时文件                                  │
        │  删除临时目录，不留下垃圾文件                         │
        └─────────────────────────────────────────────────────┘

        注意事项:
        - 需要ffmpeg已安装并可用
        - 临时文件会创建在系统临时目录中
        - 处理完成后会自动清理临时文件
        """
        self._记录审计(f"开始处理视频: {os.path.basename(路径)}", 0.90)

        # 创建临时目录——所有中间文件都放在这里
        临时目录 = tempfile.mkdtemp(prefix="龍魂视频处理_")

        try:
            # ═══════════════════════════════════════════════
            # 步骤1: 提取音频轨道
            # ═══════════════════════════════════════════════
            音频路径 = os.path.join(临时目录, "音频.wav")
            提取音频命令 = [
                'ffmpeg', '-i', 路径,
                '-vn',                    # 不处理视频
                '-acodec', 'pcm_s16le',   # 16位PCM编码
                '-ar', '16000',           # 采样率16kHz（语音识别最佳）
                '-ac', '1',               # 单声道
                音频路径, '-y'            # 覆盖已存在的文件
            ]
            音频结果 = subprocess.run(提取音频命令, capture_output=True, text=True, timeout=120)
            音频提取成功 = os.path.exists(音频路径) and os.path.getsize(音频路径) > 0
            self._记录审计(f"音频提取: {'成功' if 音频提取成功 else '失败'}", 0.85 if 音频提取成功 else 0.30)

            # ═══════════════════════════════════════════════
            # 步骤2: 提取关键帧（每秒一帧）
            # ═══════════════════════════════════════════════
            帧目录 = os.path.join(临时目录, "帧")
            os.makedirs(帧目录, exist_ok=True)
            提取帧命令 = [
                'ffmpeg', '-i', 路径,
                '-vf', 'fps=1',           # 每秒一帧——速度与精度的平衡
                os.path.join(帧目录, "帧_%04d.png"),
                '-y'
            ]
            帧结果 = subprocess.run(提取帧命令, capture_output=True, text=True, timeout=120)
            帧数量 = len([f for f in os.listdir(帧目录) if f.endswith('.png')])
            self._记录审计(f"关键帧提取: {帧数量}帧", 0.90 if 帧数量 > 0 else 0.30)

            # ═══════════════════════════════════════════════
            # 步骤3: 处理音频（语音识别）
            # ═══════════════════════════════════════════════
            语音文字 = ""
            语音置信度 = 0.0
            if 音频提取成功:
                try:
                    语音结果 = self._处理语音(音频路径, 语言)
                    语音文字 = 语音结果["文字"]
                    语音置信度 = 语音结果["置信度"]
                except Exception as 语音错误:
                    self._记录审计(f"语音处理失败: {str(语音错误)}", 0.30, 审计颜色.黄色警告)

            # ═══════════════════════════════════════════════
            # 步骤4: 处理图像帧（OCR）
            # ═══════════════════════════════════════════════
            画面文字列表 = []
            for 帧序号, 帧文件 in enumerate(sorted(os.listdir(帧目录))):
                if 帧文件.endswith('.png'):
                    帧路径 = os.path.join(帧目录, 帧文件)
                    try:
                        帧结果 = self._处理图像(帧路径, 语言)
                        if 帧结果["文字"].strip():
                            时间戳 = f"{帧序号}s"  # 简化为第几秒
                            画面文字列表.append(f"[{时间戳}] {帧结果['文字'].strip()}")
                    except Exception:
                        # 单个帧处理失败不影响整体——容错设计
                        pass

            # ═══════════════════════════════════════════════
            # 步骤5: 合并结果
            # ═══════════════════════════════════════════════
            画面文字合并 = "\n".join(画面文字列表) if 画面文字列表 else "（未检测到画面文字）"

            合并文字 = (
                f"╔══════════════════════════════════════════════╗\n"
                f"║              龍魂视频感知报告                  ║\n"
                f"╠══════════════════════════════════════════════╣\n"
                f"║ 【语音内容】                                  ║\n"
                f"╟──────────────────────────────────────────────╢\n"
                f"  {语音文字}\n"
                f"╠══════════════════════════════════════════════╣\n"
                f"║ 【画面文字】(每秒采样)                          ║\n"
                f"╟──────────────────────────────────────────────╢\n"
                f"  {画面文字合并}\n"
                f"╚══════════════════════════════════════════════╝"
            )

            # 视频的综合置信度——语音和画面文字的加权平均
            综合置信度 = (语音置信度 * 0.7 + (0.5 if 画面文字列表 else 0.0) * 0.3)

            return {
                "文字": 合并文字,
                "置信度": 综合置信度,
                "模块": "龍魂视频处理器(图像+语音联合)",
                "原始数据": None
            }

        finally:
            # ═══════════════════════════════════════════════
            # 步骤6: 清理临时文件——无论成功失败都要清理
            # ═══════════════════════════════════════════════
            try:
                shutil.rmtree(临时目录, ignore_errors=True)
                self._记录审计("临时文件已清理", 1.0)
            except Exception:
                pass  # 清理失败不影响主流程

    def _处理文字(self, 路径: str) -> Dict[str, Any]:
        """
        处理纯文字文件——直接读取内容
        Process plain text file —— read content directly

        文字文件的处理最简单——直接读取即可。
        置信度为100%，因为不涉及任何识别过程。
        """
        try:
            with open(路径, 'r', encoding='utf-8') as 文件:
                内容 = 文件.read()
            self._记录审计(f"文字文件读取: {len(内容)} 字符", 1.0)
            return {
                "文字": 内容,
                "置信度": 1.0,  # 文字文件置信度为100%
                "模块": "文字直接读取",
                "原始数据": None
            }
        except UnicodeDecodeError:
            # UTF-8解码失败，尝试其他编码
            with open(路径, 'r', encoding='gbk') as 文件:
                内容 = 文件.read()
            self._记录审计(f"文字文件读取(GBK编码): {len(内容)} 字符", 1.0)
            return {
                "文字": 内容,
                "置信度": 1.0,
                "模块": "文字直接读取(GBK编码)",
                "原始数据": None
            }

    # =========================================================================
    # 辅助方法 —— 结果创建、审计记录、查询方法
    # Helper methods —— result creation, audit logging, query methods
    # =========================================================================

    def _创建错误结果(self, 输入路径: str, 错误信息: str, 类型: 感知类型 = 感知类型.文字) -> 多模态感知结果:
        """创建错误结果——当处理失败时返回一个包含错误信息的结果"""
        return 多模态感知结果(
            感知类型=类型,
            输入路径=输入路径,
            提取的文字=f"[错误] {错误信息}",
            置信度=0.0,
            使用模块="错误处理",
            DNA追溯=f"#龍芯⚡️{datetime.now().strftime('%Y-%m-%d')}-ERROR-{os.path.basename(输入路径)}",
            审计日志=self.审计日志.copy()
        )

    def _记录审计(self, 消息: str, 置信度: float, 颜色: 审计颜色 = 审计颜色.绿色通过):
        """
        记录审计信息
        Record audit information

        参数:
            消息: 审计消息描述
            置信度: 置信度分数 [0.0, 1.0]
            颜色: 审计颜色（绿/黄/红）
        """
        if self.审计开关:
            self.审计日志.append(审计结果(
                颜色=颜色,
                置信度=置信度,
                原因=消息,
                建议="",
                模块="龍魂多模态感知中枢"
            ))

    # =========================================================================
    # 公开查询接口
    # Public Query Interfaces
    # =========================================================================

    def 获取处理历史(self) -> List[多模态感知结果]:
        """获取所有感知操作的处理历史"""
        return self.处理历史.copy()

    def 获取审计日志(self) -> List[审计结果]:
        """获取完整的审计日志"""
        return self.审计日志.copy()

    def 获取统计信息(self) -> Dict[str, Any]:
        """获取中枢的运行统计信息"""
        if not self.处理历史:
            return {"处理次数": 0, "平均置信度": 0.0, "总耗时": 0.0}

        return {
            "处理次数": len(self.处理历史),
            "按类型统计": self._按类型统计(),
            "平均置信度": sum(r.置信度 for r in self.处理历史) / len(self.处理历史),
            "总耗时": sum(r.处理时间 for r in self.处理历史),
            "审计记录数": len(self.审计日志),
            "铁律闸统计": self.铁律闸.获取统计(),
        }

    def _按类型统计(self) -> Dict[str, int]:
        """按感知类型统计处理次数"""
        统计 = {}
        for 结果 in self.处理历史:
            类型名 = 结果.感知类型.value
            统计[类型名] = 统计.get(类型名, 0) + 1
        return 统计

    def 获取术语引擎(self) -> 通心译扩展术语引擎:
        """获取术语引擎实例——供外部查询术语使用"""
        return self.术语引擎

    def 翻译术语(self, 文本: str, 方向: str = "英到中") -> str:
        """便捷方法——通过中枢调用术语引擎翻译"""
        return self.术语引擎.翻译(文本, 方向)

    def 解释术语(self, 术语: str) -> Dict[str, Any]:
        """便捷方法——通过中枢查询术语解释"""
        return self.术语引擎.解释术语(术语)

    def 导出审计报告(self, 输出路径: Optional[str] = None) -> str:
        """
        导出完整的审计报告
        Export complete audit report
        """
        if 输出路径 is None:
            输出路径 = os.path.join(tempfile.gettempdir(), f"龍魂审计报告_{datetime.now().strftime('%Y%m%d_%H%M%S')}.txt")

        with open(输出路径, 'w', encoding='utf-8') as 文件:
            文件.write("=" * 70 + "\n")
            文件.write("龍魂多模态感知中枢 —— 审计报告\n")
            文件.write("LongHun Multimodal Perception Hub —— Audit Report\n")
            文件.write("=" * 70 + "\n")
            文件.write(f"生成时间: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
            文件.write(f"中枢来源链戳: {self.中枢来源链戳}\n")
            文件.write("-" * 70 + "\n\n")

            # 统计信息
            统计 = self.获取统计信息()
            文件.write("【统计信息】\n")
            for 键, 值 in 统计.items():
                文件.write(f"  {键}: {值}\n")

            # 处理历史
            文件.write(f"\n【处理历史】(共 {len(self.处理历史)} 条)\n")
            for i, 结果 in enumerate(self.处理历史, 1):
                文件.write(f"\n--- 记录 {i} ---\n")
                文件.write(结果.简要() + "\n")

            # 审计日志
            文件.write(f"\n【审计日志】(共 {len(self.审计日志)} 条)\n")
            for i, 审计 in enumerate(self.审计日志, 1):
                文件.write(f"\n  [{i}] {审计.颜色.value} 置信度={审计.置信度:.2f}\n")
                文件.write(f"      原因: {审计.原因}\n")
                文件.write(f"      时间: {审计.时间戳}\n")

            文件.write("\n" + "=" * 70 + "\n")
            文件.write("报告结束 | End of Report\n")
            文件.write("=" * 70 + "\n")

        return 输出路径

    def __repr__(self):
        return f"龍魂多模态感知中枢(历史={len(self.处理历史)}, 审计={len(self.审计日志)})"


# =============================================================================
# 测试入口 —— 验证龍魂多模态感知中枢功能
# Test Entry —— validate LongHun Multimodal Perception Hub functionality
# =============================================================================
if __name__ == "__main__":
    print("=" * 70)
    print("龍魂多模态感知中枢 —— 功能自检")
    print("LongHun Multimodal Perception Hub —— Self-Test")
    print("=" * 70)

    # 初始化中枢
    print("\n[初始化] 创建龍魂多模态感知中枢实例...")
    中枢 = 龍魂多模态感知中枢()
    print(f"  中枢状态: {中枢}")
    print(f"  来源链戳: {中枢.中枢来源链戳}")

    # 测试1: 术语翻译功能
    print("\n--- 测试1: 术语翻译功能 ---")
    英文句子 = "OCR uses Feature Extraction and Edge Detection in Computer Vision."
    翻译结果 = 中枢.翻译术语(英文句子, "英到中")
    print(f"原文: {英文句子}")
    print(f"译文: {翻译结果}")

    中文句子 = "语音转文字和文字转语音是语音处理的核心。"
    翻译结果2 = 中枢.翻译术语(中文句子, "中到英")
    print(f"\n原文: {中文句子}")
    print(f"译文: {翻译结果2}")

    # 测试2: 术语解释功能
    print("\n--- 测试2: 术语解释功能 ---")
    for 术语 in ["光学字符识别", "语音转文字", "注意力"]:
        解释 = 中枢.解释术语(术语)
        print(f"\n术语: {解释['中文']} ({解释['英文']})")
        print(f"  分类: {解释['分类']}")
        for 键, 值 in list(解释['解释'].items())[:3]:
            print(f"  {键}: {值}")

    # 测试3: 铁律自审闸
    print("\n--- 测试3: 铁律自审闸 ---")
    测试路径列表 = [
        "/home/user/test.png",
        "",
        "../../../etc/passwd",
        "/tmp/test.exe",
        "/data/sample.mp4",
    ]
    for 路径 in 测试路径列表:
        审查结果 = 中枢.铁律闸.审查(路径)
        状态 = "通过" if 审查结果["通过"] else "拦截"
        print(f"  '{路径}' → {状态}")
        if not 审查结果["通过"]:
            print(f"    违规: {审查结果['违规项']}")

    # 测试4: 类型判断
    print("\n--- 测试4: 智能类型判断 ---")
    测试文件列表 = [
        "photo.jpg",
        "recording.wav",
        "movie.mp4",
        "document.txt",
        "data.json",
        "music.mp3",
        "unknown.xyz",
    ]
    for 文件名 in 测试文件列表:
        判断类型 = 中枢._判断类型(文件名)
        print(f"  {文件名:20s} → {判断类型.value}")

    # 测试5: 处理文字文件
    print("\n--- 测试5: 文字文件处理 ---")
    # 创建一个临时文字文件
    临时文字文件 = os.path.join(tempfile.gettempdir(), "龍魂测试_文字.txt")
    with open(临时文字文件, 'w', encoding='utf-8') as f:
        f.write("龍魂多模态感知中枢测试文本。\n")
        f.write("这是一个用于测试文字读取功能的示例文件。\n")
        f.write("包含中文、English、123数字。\n")

    结果 = 中枢.感知(临时文字文件)
    print(f"文件: {临时文字文件}")
    print(f"类型: {结果.感知类型.value}")
    print(f"置信度: {结果.置信度}")
    print(f"耗时: {结果.处理时间:.3f}s")
    print(f"模块: {结果.使用模块}")
    print(f"文字预览: {结果.提取的文字[:50]}...")

    # 测试6: 获取统计信息
    print("\n--- 测试6: 统计信息 ---")
    统计 = 中枢.获取统计信息()
    for 键, 值 in 统计.items():
        print(f"  {键}: {值}")

    # 测试7: 审计日志
    print("\n--- 测试7: 审计日志 ---")
    日志 = 中枢.获取审计日志()
    print(f"审计记录数: {len(日志)}")
    for 记录 in 日志[:5]:
        print(f"  [{记录.颜色.value}] {记录.原因} (置信度={记录.置信度:.2f})")
    if len(日志) > 5:
        print(f"  ... 共 {len(日志)} 条记录")

    # 测试8: 导出审计报告
    print("\n--- 测试8: 导出审计报告 ---")
    报告路径 = 中枢.导出审计报告()
    print(f"审计报告已导出到: {报告路径}")

    # 测试9: 术语引擎查询
    print("\n--- 测试9: 术语引擎查询 ---")
    引擎 = 中枢.获取术语引擎()
    全部术语 = 引擎.获取全部术语()
    print(f"术语总数: {全部术语['总数']}")
    for 分类, 数量 in 全部术语['分类统计'].items():
        print(f"  [{分类}]: {数量} 个术语")

    # 测试10: 视频处理流程（模拟——不实际调用ffmpeg）
    print("\n--- 测试10: 视频处理流程说明 ---")
    print("视频处理流程（需要ffmpeg支持）:")
    print("  1. ffmpeg提取音频(WAV, 16kHz, 单声道)")
    print("  2. ffmpeg提取关键帧(每秒1帧)")
    print("  3. 语音识别器处理音频 → 语音文字")
    print("  4. 图像识别器处理每帧 → 画面文字")
    print("  5. 合并语音文字+画面文字 → 统一报告")
    print("  6. 清理临时文件")
    print("  （本次自检未实际调用ffmpeg）")

    # 清理测试文件
    try:
        os.remove(临时文字文件)
        print(f"\n已清理临时文件: {临时文字文件}")
    except:
        pass

    print("\n" + "=" * 70)
    print("所有自检项目完成 —— 龍魂多模态感知中枢就绪")
    print("All self-tests completed —— LongHun Hub ready")
    print("=" * 70)

