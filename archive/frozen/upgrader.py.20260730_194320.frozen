"""
升级叠送引擎：版本推进、备份、补丁、追溯。
DNA: #龍芯⚡️2026-06-24-UID9622-BRAIN-UPGRADER-v1.0
"""

import shutil
import tarfile
from datetime import datetime
from pathlib import Path
from typing import Any, Dict

from . import generate_dna, now_cn, get_target_root, get_brain_root
from .utils import load_config, save_json, append_trace


class Upgrader:
    """对指定子项目执行受控升级。"""

    def __init__(self):
        self.config = load_config().get("升级", {})
        self.root = get_target_root()
        self.backup_dir = get_brain_root() / self.config.get("备份目录", "backups")
        self.backup_dir.mkdir(parents=True, exist_ok=True)

    def _backup(self, project_name: str, project_path: Path) -> Path:
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_name = f"{project_name}_{timestamp}.tar.gz"
        backup_path = self.backup_dir / backup_name
        with tarfile.open(backup_path, "w:gz") as tar:
            tar.add(project_path, arcname=project_path.name)
        return backup_path

    def _cleanup_old_backups(self, project_name: str):
        keep = int(self.config.get("保留备份数", 5))
        backups = sorted(self.backup_dir.glob(f"{project_name}_*.tar.gz"), key=lambda p: p.stat().st_mtime, reverse=True)
        for old in backups[keep:]:
            old.unlink()

    def upgrade(self, project_name: str, patches: Dict[str, Any] = None) -> Dict[str, Any]:
        project_path = self.root / project_name
        if not project_path.exists():
            return {"状态": "失败", "原因": f"项目 {project_name} 不存在"}
        patches = patches or {}
        dna = generate_dna(f"upgrade-{project_name}")
        backup_path = self._backup(project_name, project_path)
        self._cleanup_old_backups(project_name)
        applied = []
        for key, value in patches.items():
            config_file = project_path / "uid9622_config.json"
            if key == "version" and config_file.exists():
                data = {}
                try:
                    with open(config_file, "r", encoding="utf-8") as f:
                        import json
                        data = json.load(f)
                except Exception:
                    pass
                data["版本"] = value
                data["升级DNA"] = dna
                data["升级时间"] = now_cn()
                with open(config_file, "w", encoding="utf-8") as f:
                    json.dump(data, f, ensure_ascii=False, indent=2)
                applied.append({"字段": "版本", "新值": value})
        append_trace({
            "类型": "升级",
            "项目": project_name,
            "DNA": dna,
            "备份": str(backup_path),
            "补丁": patches,
            "已应用": applied,
        })
        return {
            "状态": "成功",
            "项目": project_name,
            "升级DNA": dna,
            "备份文件": str(backup_path.relative_to(get_brain_root())),
            "已应用补丁": applied,
            "提示": "升级已完成，备份可用于回滚。",
        }


def run_upgrade(project_name: str, version: str | None = None) -> Dict[str, Any]:
    up = Upgrader()
    patches = {}
    if version:
        patches["version"] = version
    return up.upgrade(project_name, patches)