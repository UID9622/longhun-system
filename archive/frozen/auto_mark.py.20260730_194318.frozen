# ==================== 龍魂系统核心引擎 ====================

class DragonSoulEngine:
    """龍魂系统标识注入引擎"""
    
    def __init__(self):
        self.config = DRAGON_SOUL_CONFIG
    
    def generate_dna(self, doc_id: str) -> str:
        """生成DNA追溯码"""
        now = datetime.datetime.now()
        date_str = now.strftime("%Y-%m-%d")
        return f"{self.config['dna_prefix']}{date_str}-{doc_id}"
    
    def format_template(self, template_name: str, **kwargs) -> str:
        """格式化模板"""
        template = TEMPLATES.get(template_name, "")
        now = datetime.datetime.now()
        
        # 默认参数
        defaults = {
            'uid': self.config['uid'],
            'founder': self.config['founder'],
            'confirm_code': self.config['confirm_code'],
            'dna_prefix': self.config['dna_prefix'],
            'signature': self.config['signature'],
            'version': self.config['version'],
            'priority': self.config['priority'],
            'theory_guide': self.config['theory_guide'],
            'date': now.strftime("%Y-%m-%d"),
            'time': now.strftime("%H:%M"),
            'datetime': now.strftime("%Y-%m-%d %H:%M:%S")
        }
        
        # 合并用户传入参数
        defaults.update(kwargs)
        return template.format(**defaults)
    
    def inject_to_file(self, file_path: str, file_type: str = "doc") -> bool:
        """向文件注入龍魂标识"""
        try:
            path = Path(file_path)
            if not path.exists():
                print(f"❌ 文件不存在: {file_path}")
                return False
            
            # 读取原内容
            content = path.read_text(encoding='utf-8')
            
            # 检查是否已注入
            if "龍魂系统" in content or "DragonSoul" in content:
                print(f"⚠️ 文件已存在龍魂标识，跳过: {file_path}")
                return False
            
            # 生成标识
            doc_id = hashlib.md5(file_path.encode()).hexdigest()[:8].upper()
            
            if file_type == "doc":
                header = self.format_template("doc_header", title=path.name, doc_id=doc_id)
                footer = self.format_template("doc_footer", doc_id=doc_id)
                new_content = header + "\n" + content + "\n" + footer
            
            elif file_type == "code_py":
                header = self.format_template("code_header_py",
                                            filename=path.name,
                                            project_id=doc_id)
                footer = self.format_template("code_footer_py", project_id=doc_id)
                new_content = header + content + footer
            
            else:
                print(f"❌ 不支持的文件类型: {file_type}")
                return False
            
            # 备份原文件
            backup_path = str(path) + ".backup"
            path.rename(backup_path)
            
            # 写入新内容
            path.write_text(new_content, encoding='utf-8')
            print(f"✅ 成功注入龍魂标识: {file_path}")
            return True
        
        except Exception as e:
            print(f"❌ 注入失败 {file_path}: {str(e)}")
            return False
    
    def batch_inject(self, directory: str, pattern: str = "*", file_type: str = "doc"):
        """批量注入目录下所有文件"""
        path = Path(directory)
        files = list(path.glob(pattern))
        
        success_count = 0
        for file in files:
            if file.is_file():
                if self.inject_to_file(str(file), file_type):
                    success_count += 1
        
        print(f"\n📊 批量注入完成: 成功 {success_count}/{len(files)} 个文件")

# ==================== 本地仓库管理 ====================

class LocalRepositoryManager:
    """本地仓库管理器"""
    
    def __init__(self, repo_path: str):
        self.repo_path = Path(repo_path)
        self.engine = DragonSoulEngine()
    
    def init_repository(self):
        """初始化龍魂系统仓库结构"""
        dirs = ['templates', 'scripts', 'configs', 'docs', 'output']
        for d in dirs:
            (self.repo_path / d).mkdir(parents=True, exist_ok=True)
        
        # 创建核心配置文件
        config_file = self.repo_path / "configs" / "dragon-soul.yaml"
        config_content = f"""# 龍魂系统核心配置
uid: {DRAGON_SOUL_CONFIG['uid']}
founder: {DRAGON_SOUL_CONFIG['founder']}
confirm_code: {DRAGON_SOUL_CONFIG['confirm_code']}
signature: {DRAGON_SOUL_CONFIG['signature']}
version: {DRAGON_SOUL_CONFIG['version']}

# 自动注入规则
auto_inject:
  enabled: true
  watch_dirs:
    - ./documents
    - ./code
  file_types:
    - .md
    - .py
    - .js
    - .txt
"""
        config_file.write_text(config_content, encoding='utf-8')
        print(f"✅ 已初始化龍魂系统仓库: {self.repo_path}")
    
    def sync_to_gitee(self, gitee_repo: str):
        """同步到Gitee仓库"""
        import subprocess
        
        try:
            # 检查git是否安装
            result = subprocess.run(['git', '--version'], capture_output=True, text=True)
            if result.returncode != 0:
                print("❌ 请先安装Git")
                return False
            
            # 初始化git仓库
            git_dir = self.repo_path / ".git"
            if not git_dir.exists():
                subprocess.run(['git', 'init'], cwd=self.repo_path, check=True)
            
            # 添加所有文件
            subprocess.run(['git', 'add', '.'], cwd=self.repo_path, check=True)
            
            # 提交
            commit_msg = f"龍魂系统自动同步 {datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
            subprocess.run(['git', 'commit', '-m', commit_msg], cwd=self.repo_path, check=True)
            
            # 添加远程仓库
            remote_url = f"https://gitee.com/{gitee_repo}.git"
            try:
                subprocess.run(['git', 'remote', 'add', 'origin', remote_url],
                             cwd=self.repo_path, check=True)
            except:
                pass  # 远程已存在
            
            # 推送
            subprocess.run(['git', 'push', '-u', 'origin', 'master'],
                         cwd=self.repo_path, check=True)
            
            print(f"✅ 已成功同步到Gitee: {gitee_repo}")
            return True
        
        except Exception as e:
            print(f"❌ 同步失败: {str(e)}")
            return False

# ==================== 命令行接口 ====================

def main():
    """命令行入口"""
    import argparse
    
    parser = argparse.ArgumentParser(description='龍魂系统仓库管理工具')
    parser.add_argument('command', choices=['init', 'inject', 'sync', 'batch'],
                       help='命令: init(初始化), inject(注入文件), sync(同步Gitee), batch(批量注入)')
    parser.add_argument('--path', '-p', default='./dragon-soul-repo',
                       help='仓库路径')
    parser.add_argument('--file', '-f', help='要注入的文件路径')
    parser.add_argument('--type', '-t', default='doc', choices=['doc', 'code_py', 'code_js'],
                       help='文件类型')
    parser.add_argument('--gitee', '-g', help='Gitee仓库名 (如: lucky9622/dragon-soul)')
    
    args = parser.parse_args()
    
    if args.command == 'init':
        manager = LocalRepositoryManager(args.path)
        manager.init_repository()
    
    elif args.command == 'inject':
        if not args.file:
            print("❌ 请指定文件路径: --file")
            return
        engine = DragonSoulEngine()
        engine.inject_to_file(args.file, args.type)
    
    elif args.command == 'sync':
        if not args.gitee:
            print("❌ 请提供Gitee仓库名: --gitee")
            return
        manager = LocalRepositoryManager(args.path)
        manager.sync_to_gitee(args.gitee)
    
    elif args.command == 'batch':
        engine = DragonSoulEngine()
        engine.batch_inject(args.path, "*.*", args.type)

if __name__ == "__main__":
    main()