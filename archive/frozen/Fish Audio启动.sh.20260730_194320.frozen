#!/bin/bash
# 🎙️ Fish Audio TTS 启动器
# DNA: #龍芯⚡️20260629-FISH-AUDIO-LAUNCHER-v1.0
# 用法: bash "Fish Audio启动.sh" [文字]

set -e

ROOT="$HOME/longhun-system/_private/小快乐/语音互动"
cd "$ROOT"

# 加载 secrets
if [ -f "$HOME/.longhun/secrets.env" ]; then
    source "$HOME/.longhun/secrets.env"
fi

# 检查虚拟环境
if [ -d "$ROOT/voice_env" ]; then
    source "$ROOT/voice_env/bin/activate"
fi

# 检查 requests
python3 -c "import requests" 2>/dev/null || {
    echo "🟡 安装 requests..."
    pip install -q requests
}

if [ -z "$1" ]; then
    # 交互模式
    python3 "$ROOT/fish_audio.py" --interactive
else
    python3 "$ROOT/fish_audio.py" "$@"
fi
