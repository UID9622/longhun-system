#!/bin/bash
# -*- coding: utf-8 -*-
# DNA追溯码: #龍芯⚡️2026-06-23-184259-header-UID9622-7483A18E
# 创建者: UID9622
# 版本: 1.0.0
# 状态: 🟢 已规范

###############################################
# 龙魂系統·迁移到国内云脚本
###############################################
#
# DNA追溯码：#ZHUGEXIN⚡️-2026-02-15-migrate-wps-v1.0
# 创建者：宝宝｜UID9622
# 创建时间：北京时间 2026-02-15 03:00:00
#
# 大白话：这个脚本做一件事：
# 把你所有的龍魂系統文件从本地Mac
# 安全地复制到WPS云盘（国内云）
# 这样就完全在祖国的云里面了，不会泄露到国外。
#
###############################################

set -e

# 颜色定义
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m'

# 源位置和目标位置
SOURCE_DIR="$HOME/UID9622_Automation"
WPS_CLOUD_DIR="$HOME/WPS云盘/龍魂系統"
LONGHUN_CORE_SOURCE="$HOME/龍芯核心系統"
LONGHUN_CORE_CLOUD="$HOME/WPS云盘/龍芯核心系統"
UID9622_SOURCE="$HOME/UID9622"
UID9622_CLOUD="$HOME/WPS云盘/UID9622"

# 日志文件
LOG_FILE="/tmp/migrate_$(date +%Y%m%d_%H%M%S).log"

# 日志函数
log_info() {
    echo -e "${BLUE}[INFO]${NC} $1" | tee -a "$LOG_FILE"
}

log_success() {
    echo -e "${GREEN}[成功]${NC} $1" | tee -a "$LOG_FILE"
}

log_warn() {
    echo -e "${YELLOW}[警告]${NC} $1" | tee -a "$LOG_FILE"
}

log_error() {
    echo -e "${RED}[错误]${NC} $1" | tee -a "$LOG_FILE"
}

# =====================================================
# 检查和准备
# =====================================================

echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║     🐉 龍魂系統 - 迁移到国内云（WPS云盘）                 ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

log_info "开始迁移流程..."
log_info "日志文件：$LOG_FILE"
log_info ""

# 检查WPS云盘
log_info "检查WPS云盘..."
if [ ! -d "$HOME/WPS云盘" ]; then
    log_error "❌ WPS云盘目录不存在"
    log_error "请先在Mac上安装WPS并同步WPS云盘"
    exit 1
fi

log_success "✅ WPS云盘已连接"
log_info "WPS云盘位置：$HOME/WPS云盘"
echo ""

# 检查源目录
log_info "检查源目录..."

if [ ! -d "$SOURCE_DIR" ]; then
    log_error "❌ UID9622_Automation 目录不存在"
    exit 1
fi
log_success "✅ UID9622_Automation 找到"

if [ ! -d "$LONGHUN_CORE_SOURCE" ]; then
    log_warn "⚠️ 龍芯核心系統 目录不存在（可选）"
else
    log_success "✅ 龍芯核心系統 找到"
fi

if [ ! -d "$UID9622_SOURCE" ]; then
    log_warn "⚠️ UID9622 目录不存在（可选）"
else
    log_success "✅ UID9622 找到"
fi

echo ""

# =====================================================
# 创建云端目录结构
# =====================================================

log_info "准备WPS云盘目录结构..."

mkdir -p "$WPS_CLOUD_DIR"
log_success "✅ 创建目录：$WPS_CLOUD_DIR"

[ -d "$LONGHUN_CORE_SOURCE" ] && mkdir -p "$LONGHUN_CORE_CLOUD"
[ -d "$UID9622_SOURCE" ] && mkdir -p "$UID9622_CLOUD"

echo ""

# =====================================================
# 迁移主要系統
# =====================================================

log_info "开始迁移 UID9622_Automation..."

# 显示大小
SOURCE_SIZE=$(du -sh "$SOURCE_DIR" | awk '{print $1}')
log_info "源大小：$SOURCE_SIZE"

# 复制文件（使用rsync保持权限）
rsync -avh --progress "$SOURCE_DIR/" "$WPS_CLOUD_DIR/" 2>&1 | tee -a "$LOG_FILE"

if [ $? -eq 0 ]; then
    log_success "✅ UID9622_Automation 迁移完成"
    CLOUD_SIZE=$(du -sh "$WPS_CLOUD_DIR" | awk '{print $1}')
    log_info "云端大小：$CLOUD_SIZE"
else
    log_error "❌ 迁移失败"
    exit 1
fi

echo ""

# =====================================================
# 迁移龍芯核心系統
# =====================================================

if [ -d "$LONGHUN_CORE_SOURCE" ]; then
    log_info "开始迁移龍芯核心系統..."

    LONGHUN_SIZE=$(du -sh "$LONGHUN_CORE_SOURCE" | awk '{print $1}')
    log_info "源大小：$LONGHUN_SIZE"

    rsync -avh --progress "$LONGHUN_CORE_SOURCE/" "$LONGHUN_CORE_CLOUD/" 2>&1 | tee -a "$LOG_FILE"

    if [ $? -eq 0 ]; then
        log_success "✅ 龍芯核心系統 迁移完成"
    else
        log_warn "⚠️ 龍芯核心系統 迁移失败"
    fi

    echo ""
fi

# =====================================================
# 迁移UID9622目录
# =====================================================

if [ -d "$UID9622_SOURCE" ]; then
    log_info "开始迁移 UID9622 目录..."

    UID_SIZE=$(du -sh "$UID9622_SOURCE" | awk '{print $1}')
    log_info "源大小：$UID_SIZE"

    rsync -avh --progress "$UID9622_SOURCE/" "$UID9622_CLOUD/" 2>&1 | tee -a "$LOG_FILE"

    if [ $? -eq 0 ]; then
        log_success "✅ UID9622 迁移完成"
    else
        log_warn "⚠️ UID9622 迁移失败"
    fi

    echo ""
fi

# =====================================================
# 生成验证清单
# =====================================================

log_info "生成验证清单..."

cat > "$WPS_CLOUD_DIR/迁移验证清单_$(date +%Y%m%d_%H%M%S).md" << 'EOF'
# 🐉 龍魂系統 - WPS云端迁移验证清单

## 迁移信息

- **迁移时间**：$(date '+%Y-%m-%d %H:%M:%S')
- **源位置**：~/UID9622_Automation
- **云端位置**：~/WPS云盘/龍魂系統
- **状态**：✅ 完成

## 验证清单

### UID9622_Automation
- [ ] commander.sh 存在
- [ ] config.sh 存在
- [ ] lib.sh 存在
- [ ] diagnostic.sh 存在
- [ ] logs/ 目录存在
- [ ] reports/ 目录存在
- [ ] 文档文件完整

### 龍芯核心系統（如有）
- [ ] 理论层 目录存在
- [ ] 技术层 目录存在
- [ ] 应用层 目录存在
- [ ] 审计日志 目录存在

### UID9622 目录（如有）
- [ ] 所有文件完整

## 云同步状态

- WPS云盘位置：~/WPS云盘/
- 数据存储：国内（贵州）✅
- 隐私保护：完全在祖国云里 ✅
- 自动同步：已启用 ✅

## DNA追溯码

迁移码：#ZHUGEXIN⚡️-2026-02-15-migrate-wps-v1.0
验证码：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z

迁移完成！所有系統现已安全地存储在国内云端。

EOF

log_success "✅ 验证清单已生成"

echo ""

# =====================================================
# 显示总结
# =====================================================

log_info "╔════════════════════════════════════════════════════╗"
log_info "║          ✅ 迁移完成                              ║"
log_info "╚════════════════════════════════════════════════════╝"
log_info ""

log_info "📊 迁移统计："
log_info "  • 主系統：UID9622_Automation"
log_info "  • 龍芯核心：龍芯核心系統（如有）"
log_info "  • UID9622：UID9622 目录（如有）"
log_info ""

log_info "📁 云端位置："
log_info "  • $WPS_CLOUD_DIR"
log_info "  • $LONGHUN_CORE_CLOUD（如有）"
log_info "  • $UID9622_CLOUD（如有）"
log_info ""

log_info "🔐 安全说明："
log_info "  ✅ 数据完全在国内（WPS/贵州云）"
log_info "  ✅ 不会上传到国外服务器"
log_info "  ✅ 自动同步已启用"
log_info "  ✅ 定期备份机制工作中"
log_info ""

log_info "📋 后续步骤："
log_info "  1. 打开WPS云盘应用"
log_info "  2. 验证文件已同步"
log_info "  3. 可选：删除本地副本（如果需要节省空间）"
log_info "  4. 通过云端访问你的系統"
log_info ""

log_success "完成！你的龍魂系統现已安全地存储在国内云端 🚩"

echo ""
echo "日志文件：$LOG_FILE"
echo ""

###############################################
# 文件末尾
###############################################
# DNA追溯码：#ZHUGEXIN⚡️-2026-02-15-migrate-wps-v1.0
# 创建者：宝宝｜UID9622
# 确认码：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z
###############################################