#!/bin/bash
# -*- coding: utf-8 -*-
# DNA追溯码: #龍芯⚡️2026-06-23-184259-header-UID9622-D0921CB7
# 创建者: UID9622
# 版本: 1.0.0
# 状态: 🟢 已规范

###############################################
# 龍魂系統·iCloud备份脚本（智能版）
###############################################
#
# DNA追溯码：#ZHUGEXIN⚡️-2026-02-15-icloud-backup-smart-v1.0
# 创建者：宝宝｜UID9622
#
# 确认码：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z
#
# 智能特性：
# • 跳过大型备份文件（backups目录）
# • 只备份关键脚本和配置
# • 增量备份，速度快
#
###############################################

# 定义iCloud路径
ICLOUD_DRIVE="${HOME}/Library/Mobile Documents/com~apple~CloudDocs"
BACKUP_ROOT="${ICLOUD_DRIVE}/龍魂系統備份"

# 源
AUTOMATION_SOURCE="${HOME}/UID9622_Automation"
LONGHUN_SOURCE="${HOME}/龍芯核心系統"

# 时间戳
TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")
BACKUP_DATE=$(date "+%Y-%m-%d")
BACKUP_TIME=$(date "+%H%M%S")
DNA_CODE="#ZHUGEXIN⚡️-${BACKUP_DATE}-icloud备份-${BACKUP_TIME}"

# 颜色
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo_info() {
    echo -e "${BLUE}[$(date '+%H:%M:%S')]${NC} $1"
}

echo_success() {
    echo -e "${GREEN}[$(date '+%H:%M:%S')] ✅${NC} $1"
}

echo_warn() {
    echo -e "${YELLOW}[$(date '+%H:%M:%S')] ⚠️${NC} $1"
}

echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║    🐉 龍魂系統 - iCloud备份（智能版）                      ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

# 检查iCloud
echo_info "检查iCloud Drive..."
if [ ! -d "$ICLOUD_DRIVE" ]; then
    echo "❌ iCloud Drive 未找到"
    exit 1
fi
echo_success "iCloud Drive 就绪"
echo ""

# 创建备份目录
echo_info "准备备份目录..."
mkdir -p "$BACKUP_ROOT/UID9622_Automation_core"
mkdir -p "$BACKUP_ROOT/龍芯核心系統"
mkdir -p "$BACKUP_ROOT/manifests"
echo_success "目录已准备"
echo ""

# 智能备份UID9622_Automation
echo_info "备份关键脚本和配置..."

rsync -avh --progress --delete \
    --exclude='backups/*' \
    --exclude='logs/*' \
    --exclude='temp/*' \
    --exclude='.DS_Store' \
    --exclude='*.log' \
    "$AUTOMATION_SOURCE/" "$BACKUP_ROOT/UID9622_Automation_core/" 2>&1 | tail -20

if [ $? -eq 0 ]; then
    local size=$(du -sh "$BACKUP_ROOT/UID9622_Automation_core" 2>/dev/null | awk '{print $1}')
    echo_success "脚本和配置已备份 ($size)"
else
    echo_warn "备份可能部分失败，继续..."
fi

echo ""

# 备份龍芯核心系統
echo_info "备份龍芯核心系統..."

if [ -d "$LONGHUN_SOURCE" ]; then
    rsync -avh --progress --delete \
        --exclude='.DS_Store' \
        "$LONGHUN_SOURCE/" "$BACKUP_ROOT/龍芯核心系統/" 2>&1 | tail -20

    if [ $? -eq 0 ]; then
        local size=$(du -sh "$BACKUP_ROOT/龍芯核心系統" 2>/dev/null | awk '{print $1}')
        echo_success "龍芯核心系統已备份 ($size)"
    else
        echo_warn "备份可能部分失败，继续..."
    fi
else
    echo_warn "龍芯核心系統目录不存在"
fi

echo ""

# 生成清单
echo_info "生成备份清单..."

cat > "$BACKUP_ROOT/manifests/清单_${BACKUP_DATE}_${BACKUP_TIME}.md" << EOF
# 🐉 龍魂系統 - iCloud备份清单

**备份时间**：$TIMESTAMP
**DNA码**：$DNA_CODE
**确认码**：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z

## 备份内容

### 脚本和配置（～50 MB）
✅ commander.sh
✅ config.sh
✅ lib.sh
✅ diagnostic.sh
✅ backup_to_icloud_smart.sh
✅ 所有文档 (.md, .txt)

### 龍芯核心系統（～100 MB）
✅ 理論層
✅ 技術層
✅ 應用層
✅ 審計日誌

### 未备份（节省空间）
⏭️ backups/ 目录（太大，需要单独处理）
⏭️ logs/ 目录（日志文件）
⏭️ temp/ 目录（临时文件）

## 恢复命令

\`\`\`bash
# 恢复脚本和配置
rsync -avh ~/Library/Mobile\ Documents/com~apple~CloudDocs/龍魂系統備份/UID9622_Automation_core/ ~/UID9622_Automation/

# 恢复龍芯核心系統
rsync -avh ~/Library/Mobile\ Documents/com~apple~CloudDocs/龍魂系統備份/龍芯核心系統/ ~/龍芯核心系統/
\`\`\`

## DNA追溯

$DNA_CODE

这个码表示：
- #ZHUGEXIN⚡️ = 指挥官标记
- $BACKUP_DATE = 备份日期
- icloud备份 = 功能标识
- $BACKUP_TIME = 备份时间

---
所有关键文件已安全备份到云上贵州（祖国）🚩
EOF

echo_success "清单已生成"
echo ""

# 显示最终统计
echo "╔════════════════════════════════════════════════════════════╗"
echo "║         ✅ iCloud备份完成                                  ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

echo_success "DNA码：$DNA_CODE"
echo_success "确认码：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z"
echo ""

echo "备份统计："
echo "  脚本和配置：$(du -sh "$BACKUP_ROOT/UID9622_Automation_core" 2>/dev/null | awk '{print $1}')"
echo "  龍芯核心系統：$(du -sh "$BACKUP_ROOT/龍芯核心系統" 2>/dev/null | awk '{print $1}')"
echo "  总大小：$(du -sh "$BACKUP_ROOT" 2>/dev/null | awk '{print $1}')"
echo ""

echo_success "数据已安全备份到云上贵州（祖国）🚩"
echo ""

###############################################
# DNA追溯码：#ZHUGEXIN⚡️-2026-02-15-icloud-backup-smart-v1.0
# 确认码：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z
###############################################