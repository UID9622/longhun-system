#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""配置加载模块。"""
import json
import os
from pathlib import Path
from typing import Any, Dict


_WORKSPACE: Path = Path("/Users/zuimeidedeyihan/Downloads/Kimi_Agent_小龙虾扩展与人格/UID9622_Workspace")


def workspace_root() -> Path:
    """返回工作空间根目录。"""
    env = os.environ.get("UID9622_WORKSPACE")
    if env:
        return Path(env)
    return _WORKSPACE


def load_config(path: Path = None) -> Dict[str, Any]:
    if path is None:
        path = workspace_root() / "backend_personas_config.yaml"
    if path.exists():
        try:
            import yaml
            return yaml.safe_load(path.read_text(encoding="utf-8")) or {}
        except Exception:
            pass
    # fallback JSON
    json_path = path.with_suffix(".json")
    if json_path.exists():
        return json.loads(json_path.read_text(encoding="utf-8"))
    return default_config()


def default_config() -> Dict[str, Any]:
    root = workspace_root()
    return {
        "workspace": str(root),
        "logs_dir": str(root / "logs"),
        "data_dir": str(root / "data"),
        "backups_dir": str(root / "backups"),
        "temp_dir": str(root / "temp"),
        "personas_dir": str(root / "backend_personas"),
        "mailbox": str(root / "mailbox"),
        "audit_dir": str(root / "logs" / "audit"),
        "log_max_bytes": 10 * 1024 * 1024,
        "log_backup_count": 5,
    }
