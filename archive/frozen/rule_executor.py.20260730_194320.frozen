║                                                                  ║
║  责任: UID9622·不免责                                            ║
║  状态: 🟢 MAIN·可公开                                            ║
╚══════════════════════════════════════════════════════════════════╝

规则执行器职责：
  1. 评估规则条件 (condition expression evaluation)
  2. 执行规则动作 (action function invocation)
  3. 审计执行结果 (three-color audit)
  4. 返回结构化结果 (execution result with metadata)

执行流程：
  条件评估 → 条件不满足? 返回🟢
              ↓
           执行动作
              ↓
           审计检查 (if audit_required)
              ↓
           返回结果 (success/result/color/message/execution_time)
"""

from typing import Dict, Any
import time
from .rule_node import Rule


class RuleExecutor:
    """
    规则执行器

    负责在给定的上下文中执行单条规则，包括：
      - 条件评估
      - 动作执行
      - 结果审计
      - 性能统计
    """

    def __init__(self):
        """初始化规则执行器"""
        self.execution_count = 0
        self.total_execution_time = 0.0

    # ═══════════════════════════════════════════════════════════════
    # 【核心执行方法】
    # ═══════════════════════════════════════════════════════════════

    def execute(self, rule: Rule, context: Dict[str, Any]) -> Dict[str, Any]:
        """
        执行规则

        Args:
            rule: Rule 对象
            context: 执行上下文（变量字典）

        Returns:
            {
                "success": bool,           # 执行是否成功
                "result": Any,             # 执行结果
                "color": str,              # 三色判定: 🟢/🟡/🔴
                "message": str,            # 执行消息
                "execution_time": float    # 执行耗时（秒）
            }
        """
        start_time = time.time()

        try:
            # 【第1步】评估条件表达式
            condition_result = self._evaluate_condition(rule.condition, context)

            # 条件不满足，返回 🟢 但不执行动作
            if not condition_result:
                execution_time = time.time() - start_time
                self._record_execution(execution_time)

                return {
                    "success": True,
                    "result": None,
                    "color": "🟢",
                    "message": f"条件不满足，跳过执行: {rule.name}",
                    "execution_time": execution_time,
                    "rule_id": rule.rule_id,
                    "rule_type": rule.rule_type.value
                }

            # 【第2步】执行规则动作
            action_result = self._execute_action(rule.action, context)

            # 【第3步】审计检查（如果需要）
            if rule.audit_required:
                color = self._audit_result(action_result, context, rule)
            else:
                color = "🟢"

            execution_time = time.time() - start_time
            self._record_execution(execution_time)

            return {
                "success": True,
                "result": action_result,
                "color": color,
                "message": f"规则执行成功: {rule.name}",
                "execution_time": execution_time,
                "rule_id": rule.rule_id,
                "rule_type": rule.rule_type.value
            }

        except Exception as e:
            execution_time = time.time() - start_time
            self._record_execution(execution_time)

            return {
                "success": False,
                "result": None,
                "color": "🔴",
                "message": f"规则执行失败 ({rule.name}): {str(e)}",
                "execution_time": execution_time,
                "rule_id": rule.rule_id,
                "rule_type": rule.rule_type.value,
                "error": str(e)
            }

    # ═══════════════════════════════════════════════════════════════
    # 【条件评估】
    # ═══════════════════════════════════════════════════════════════

    def _evaluate_condition(self, condition: str, context: Dict[str, Any]) -> bool:
        """
        评估条件表达式

        支持 Python 表达式（使用 eval）或简单的 JSON 条件。
        为了安全，只允许在 context 变量作用域中访问。

        Args:
            condition: 条件表达式字符串
            context: 执行上下文

        Returns:
            True/False
        """
        if not condition or condition == "True":
            return True

        if condition == "False":
            return False

        try:
            # 在受限的命名空间中评估条件
            # 只允许访问 context 字典中的数据
            result = eval(condition, {"__builtins__": {}}, {"context": context})
            return bool(result)
        except Exception as e:
            # 条件评估失败，返回 False（安全策略：默认不执行）
            # print(f"⚠️  条件评估失败: {condition} - {str(e)}")
            return False

    # ═══════════════════════════════════════════════════════════════
    # 【动作执行】
    # ═══════════════════════════════════════════════════════════════

    def _execute_action(self, action: str, context: Dict[str, Any]) -> Any:
        """
        执行规则动作

        动作是一个函数名称，可以是：
          1. 内置方法（在 executor 中定义）
          2. 简单的 lambda 表达式

        Args:
            action: 动作名称或表达式
            context: 执行上下文

        Returns:
            动作执行的结果
        """
        if not action:
            return None

        # 尝试调用内置方法
        if hasattr(self, action):
            func = getattr(self, action)
            if callable(func):
                return func(context)

        # 如果是简单的 lambda 或表达式，尝试评估
        try:
            # 注意：这里提供了更多的命名空间用于动作执行
            # 比条件评估更开放，但仍然受限
            result = eval(action, {"__builtins__": {}}, {"context": context})
            return result
        except Exception as e:
            raise ValueError(f"无法执行动作 '{action}': {str(e)}")

    # ═══════════════════════════════════════════════════════════════
    # 【内置动作方法】
    # ═══════════════════════════════════════════════════════════════

    def noop(self, context: Dict[str, Any]) -> Dict[str, Any]:
        """无操作 (no-op) - 只返回成功"""
        return {"status": "noop", "success": True}

    def return_context(self, context: Dict[str, Any]) -> Dict[str, Any]:
        """返回整个上下文（用于调试）"""
        return {"context": context}

    def three_color_judgment(self, context: Dict[str, Any]) -> Dict[str, Any]:
        """
        三色判定动作

        根据 context 中的 score 进行判定：
          score >= 80: 🟢 GREEN (通过)
          50 <= score < 80: 🟡 YELLOW (待审)
          score < 50: 🔴 RED (阻断)
        """
        score = context.get("score", 0)
        if score >= 80:
            color = "🟢"
            status = "PASS"
        elif score >= 50:
            color = "🟡"
            status = "REVIEW"
        else:
            color = "🔴"
            status = "BLOCK"

        return {
            "score": score,
            "color": color,
            "status": status,
            "threshold_pass": 80,
            "threshold_review": 50
        }

    def veto_block(self, context: Dict[str, Any]) -> Dict[str, Any]:
        """
        一票否决动作

        高危操作必须明确确认。
        如果 context 中有 confirmed=True，返回 🟢；否则返回 🔴。
        """
        operation = context.get("operation", "unknown")
        confirmed = context.get("confirmed", False)

        return {
            "operation": operation,
            "confirmed": confirmed,
            "blocked": not confirmed,
            "color": "🟢" if confirmed else "🔴",
            "message": f"操作 '{operation}' {'已确认通过' if confirmed else '被一票否决'}"
        }

    # ═══════════════════════════════════════════════════════════════
    # 【审计检查】
    # ═══════════════════════════════════════════════════════════════

    def _audit_result(self, result: Any, context: Dict[str, Any], rule: Rule) -> str:
        """
        审计执行结果，进行三色判定

        规则：
          1. 如果 result 是字典，检查 "color" 字段
          2. 如果 result 是字典，检查 "score" 字段进行判定
          3. 默认返回 🟢

        Args:
            result: 执行结果
            context: 执行上下文
            rule: 规则对象

        Returns:
            "🟢" / "🟡" / "🔴"
        """
        # 情形1：结果中已经有 color 字段
        if isinstance(result, dict) and "color" in result:
            return result["color"]

        # 情形2：结果中有 score 字段，进行三色判定
        if isinstance(result, dict) and "score" in result:
            score = result["score"]
            if score >= 80:
                return "🟢"
            elif score >= 50:
                return "🟡"
            else:
                return "🔴"

        # 情形3：result 是布尔值
        if isinstance(result, bool):
            return "🟢" if result else "🔴"

        # 默认：返回 🟢
        return "🟢"

    # ═══════════════════════════════════════════════════════════════
    # 【性能统计】
    # ═══════════════════════════════════════════════════════════════

    def _record_execution(self, execution_time: float):
        """记录执行统计"""
        self.execution_count += 1
        self.total_execution_time += execution_time

    def get_statistics(self) -> Dict[str, Any]:
        """获取执行统计信息"""
        avg_time = (
            self.total_execution_time / self.execution_count
            if self.execution_count > 0
            else 0
        )
        return {
            "execution_count": self.execution_count,
            "total_execution_time": self.total_execution_time,
            "average_execution_time": avg_time
        }

    def reset_statistics(self):
        """重置执行统计"""
        self.execution_count = 0
        self.total_execution_time = 0.0
