#!/bin/bash
# 龍魂系统 · Mac Crontab 安装器
# 功能：自动安装每日定时抓取任务

echo "🐉 龍魂定时任务安装器"
echo "🐉 #龍芯⚡️丙午·辛未·乙酉·卯时·讼-TRAIN-DATA-SOURCES-v1.0"

WORK_DIR="$HOME/longhun-data"
CRON_SCRIPT="$WORK_DIR/longhun_cron_daily.sh"

# 检查工作目录
if [ ! -d "$WORK_DIR" ]; then
    echo "❌ 工作目录不存在: $WORK_DIR"
    echo "请先运行 install_longhun_data_engine.sh 初始化"
    exit 1
fi

# 复制定时脚本
cp longhun_cron_daily.sh "$CRON_SCRIPT"
chmod +x "$CRON_SCRIPT"

# 设置crontab（每天凌晨3点执行）
CRON_JOB="0 3 * * * $CRON_SCRIPT >> $WORK_DIR/logs/cron_master.log 2>&1"

# 检查是否已存在
(crontab -l 2>/dev/null | grep -q "longhun_cron_daily") && {
    echo "⚠️ 定时任务已存在，跳过"
    exit 0
}

# 添加crontab
(crontab -l 2>/dev/null; echo "$CRON_JOB") | crontab -

echo "✅ Crontab 安装完成"
echo "   执行时间: 每天 03:00"
echo "   脚本路径: $CRON_SCRIPT"
echo "   日志路径: $WORK_DIR/logs/"
echo ""
echo "📋 查看任务: crontab -l"
echo "📋 手动测试: $CRON_SCRIPT"
echo "📋 删除任务: crontab -l | grep -v longhun | crontab -"
