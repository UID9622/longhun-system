# 核心枚举 / Core Enumerations
# ═══════════════════════════════════════════════════════════════════════════

class 五行元素(Enum):
    """Five Elements - 五行元素枚举"""
    金 = "金"  # Metal - 资金、风控
    木 = "木"  # Wood - 增长、投资
    水 = "水"  # Water - 流动性、资金流动
    火 = "火"  # Fire - 热度、市场情绪
    土 = "土"  # Earth - 稳定性、基础设施

class 交易状态(Enum):
    """Transaction Status - 交易状态"""
    待审核 = "pending_review"
    五行决策中 = "wuxing_deciding"
    卦象审计中 = "gua_auditing"
    已批准 = "approved"
    已拒绝 = "rejected"
    已熔断 = "circuit_breaker"
    执行中 = "executing"
    已完成 = "completed"
    已回滚 = "rolled_back"

class 审计结果(Enum):
    """Audit Result - 审计结果三色标注"""
    吉祥 = "🟢 吉祥"       # Auspicious - Green
    警告 = "🟡 警告"       # Warning - Yellow
    凶险 = "🔴 凶险"       # Dangerous - Red
    熔断 = "🔴 熔断"       # Circuit Breaker - Red

class 身份状态(Enum):
    """Identity Status - 双轨数字人身份状态"""
    未初始化 = "uninitialized"
    虚拟代体已激活 = "virtual_active"
    实体原型已绑定 = "physical_bound"
    已塌缩固化 = "collapsed_final"
    已注销 = "revoked"

class 三才(Enum):
    """Three Powers (San Cai) - 三才枚举"""
    天 = "天"  # Heaven - 宏观趋势
    地 = "地"  # Earth - 市场环境
    人 = "人"  # Human - 交易者自身

# ═══════════════════════════════════════════════════════════════════════════
# 数据类 / Data Classes
# ═══════════════════════════════════════════════════════════════════════════

@dataclass
class 五行数据:
    """Five Elements Data - 五行数据容器"""
    金值: float = 0.5   # Metal value - 资金/风控 [0,1]
    木值: float = 0.5   # Wood value - 增长/投资 [0,1]
    水值: float = 0.5   # Water value - 流动性 [0,1]
    火值: float = 0.5   # Fire value - 热度/情绪 [0,1]
    土值: float = 0.5   # Earth value - 稳定性 [0,1]
    时间戳: str = field(default_factory=lambda: datetime.datetime.now().isoformat())

@dataclass
class 交易请求:
    """Transaction Request - 交易请求数据"""
    请求ID: str
    发起方: str
    接收方: str
    金额: float
    货币: str
    交易类型: str
    时间戳: str
    元数据: Dict[str, Any] = field(default_factory=dict)

@dataclass
class 交易记录:
    """Transaction Record - 交易记录"""
    交易ID: str
    请求: 交易请求
    状态: 交易状态
    五行决策结果: Optional[Dict] = None
    卦象审计结果: Optional[Dict] = None
    审计标签: str = ""
    时间戳: str = field(default_factory=lambda: datetime.datetime.now().isoformat())

@dataclass
class 卦象结果:
    """Hexagram Result - 卦象结果"""
    卦序号: int
    卦名: str
    卦象: str
    八维度评分: Dict[str, float]
    动爻列表: List[int]
    吉凶判定: str
    爻辞解读: List[str]

@dataclass
class 双轨身份:
    """Dual-Track Identity - 双轨数字人身份"""
    身份哈希: str
    虚拟代体ID: str
    实体原型指纹: str = ""
    状态: 身份状态 = 身份状态.未初始化
    创建时间: str = field(default_factory=lambda: datetime.datetime.now().isoformat())
    固化时间: str = ""
    交易历史: List[str] = field(default_factory=list)


