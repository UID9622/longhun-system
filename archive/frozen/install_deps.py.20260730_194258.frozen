#!/usr/bin/env python3
import subprocess
import sys

def install(pkg):
    try:
        subprocess.check_call([sys.executable, "-m", "pip", "install", pkg])
        print(f"✅ {pkg} 安装成功")
    except:
        print(f"❌ {pkg} 安装失败")

packages = ["torch", "transformers", "pillow", "requests", "torchvision"]
for p in packages:
    install(p)
