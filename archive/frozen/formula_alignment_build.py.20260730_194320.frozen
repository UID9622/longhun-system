#!/usr/local/bin/python3
# -*- coding: utf-8 -*-

"""
🐉 公式对准表向量重建脚本
DNA: #龍芯⚡️2026-06-28-FORMULA-ALIGNMENT-BUILD-v1.0

用法：
    python3 formula_alignment_build.py

读取 ~/_work/formula_alignment_v1_6_raw.md，重新生成：
    ~/_work/formula_alignment_v1_6_vectors.json
"""

import json
import os
import re
import hashlib
from datetime import datetime, timezone
from pathlib import Path

import numpy as np
from sklearn.feature_extraction.text import TfidfVectorizer

HOME = Path.home()
RAW_PATH = HOME / "_work" / "formula_alignment_v1_6_raw.md"
VECTOR_PATH = HOME / "_work" / "formula_alignment_v1_6_vectors.json"

PATCH_DNA = "#龍芯⚡️2026-06-28-FORMULA-ALIGNMENT-v1.6-PATCH-COMPLETE"


def tokenize(text):
    """中文按字切分，英/数/希腊字母按连续序列切分。"""
    text = text.lower()
    tokens = []
    i = 0
    n = len(text)
    while i < n:
        c = text[i]
        if "\u4e00" <= c <= "\u9fa5":
            tokens.append(c)
            i += 1
        elif re.match(r"[a-z0-9_αβγδεζηθικλμνξοπρστυφχψω]+", c):
            m = re.match(r"[a-z0-9_αβγδεζηθικλμνξοπρστυφχψω]+", text[i:])
            tokens.append(m.group(0))
            i += m.end()
        else:
            i += 1
    return tokens


def generate_dna(title, idx):
    ts = datetime.now(timezone.utc).strftime("%Y%m%d%H%M%S%f")[:-3]
    h = hashlib.blake2b(f"{ts}-{idx}-{title}".encode(), digest_size=8).hexdigest()
    return f"#龍芯⚡️{ts}-FORMULA-v1.6-B{idx:03d}-{h.upper()}"


def parse_sections(text):
    """按 ## 二级标题切分（三级及以下归入父节），返回 [(title, body), ...]"""
    # 只按 ## 切分，保留 ### 作为 body 的一部分
    parts = re.split(r"\n(?=##\s)", text)
    sections = []
    for part in parts:
        part = part.strip()
        if not part:
            continue
        m = re.match(r"##\s+(.*?)\n", part)
        if not m:
            # 可能是开头没有 ## 的元信息，跳过
            continue
        title = m.group(1).strip()
        sections.append((title, part))
    return sections


def extract_formulas(body):
    formulas = []
    # 匹配 F01-F25 编号
    formulas.extend(re.findall(r"F(?:0?[1-9]|1\d|2[0-5])\b", body))
    # 匹配行内公式：`...`
    formulas.extend(re.findall(r"`([^`]+(?:=|⊕|∈|Σ|∏|≥|≤)[^`]*)`", body))
    # 去重保留前20
    seen = []
    for f in formulas:
        if f not in seen:
            seen.append(f)
    return seen[:20]


def extract_dnas(body):
    dnas = re.findall(r"#龍芯⚡️[A-Za-z0-9\-_\.]+", body)
    return dnas[:5]


def main():
    print("🐉 开始重建公式对准表向量…")
    raw_text = RAW_PATH.read_text(encoding="utf-8")
    sections = parse_sections(raw_text)
    print(f"  解析到 {len(sections)} 个区块")

    titles = []
    bodies = []
    for title, body in sections:
        titles.append(title)
        bodies.append(body)

    # 使用自定义 tokenizer 拟合 TF-IDF
    vectorizer = TfidfVectorizer(
        tokenizer=tokenize,
        token_pattern=None,
        lowercase=False,
        ngram_range=(1, 2),
        max_features=512,
        norm="l2",
        use_idf=True,
        smooth_idf=True,
    )
    X = vectorizer.fit_transform(bodies)

    vocab = {k: int(v) for k, v in vectorizer.vocabulary_.items()}
    feature_names = vectorizer.get_feature_names_out().tolist()
    idf = [float(x) for x in vectorizer.idf_]

    section_list = []
    for idx, (title, body) in enumerate(sections):
        row = X[idx]
        sparse = {}
        for col, val in zip(row.indices, row.data):
            sparse[str(col)] = round(float(val), 10)

        section_list.append({
            "index": idx,
            "title": title,
            "char_count": len(body),
            "formulas": extract_formulas(body),
            "dnas": extract_dnas(body),
            "vector_sparse": sparse,
        })

    output = {
        "module_id": "formula_alignment_v1_6_patched",
        "version": "v1.6-PATCH-2026-06-28",
        "dna": PATCH_DNA,
        "vectorizer": {
            "type": "sklearn-TfidfVectorizer",
            "max_features": 512,
            "ngram_range": [1, 2],
            "vocab_size": len(vocab),
            "feature_names": feature_names,
            "vocabulary": vocab,
            "idf": idf,
        },
        "sections": section_list,
    }

    VECTOR_PATH.write_text(json.dumps(output, ensure_ascii=False, indent=2), encoding="utf-8")
    print(f"  ✅ 已保存: {VECTOR_PATH}")
    print(f"  📊 区块数: {len(section_list)}, 词表: {len(vocab)}, 矩阵: {X.shape}")


if __name__ == "__main__":
    main()
