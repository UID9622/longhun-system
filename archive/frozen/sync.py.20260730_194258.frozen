# -*- coding: utf-8 -*-
"""#龍芯⚡️2026-06-29-SECOND-BRAIN-SYNC-v1.0
Obsidian → 龍魂第二大脑 同步 orchestrator
"""
import json
from pathlib import Path
from typing import Dict, List, Any

from . import config
from .importer import ObsidianImporter
from .indexer import SecondBrainIndex
from .models import Note


class SecondBrainSync:
    def __init__(self, vault_path: Path = None, skip_embeddings: bool = False):
        self.importer = ObsidianImporter(vault_path)
        self.index = SecondBrainIndex(skip_embeddings=skip_embeddings)

    def run(self) -> Dict[str, Any]:
        notes: List[Note] = list(self.importer.iter_notes())

        title_to_id = {note.title: note.note_id for note in notes}
        # 别名也映射
        for note in notes:
            for alias in note.aliases:
                title_to_id.setdefault(alias, note.note_id)

        existing_ids = set(self.index.get_all_note_ids())
        new_count = updated_count = unchanged_count = 0
        note_ids = set()

        for note in notes:
            note_ids.add(note.note_id)
            existed = note.note_id in existing_ids
            changed = self.index.index_note(note)
            if changed:
                if existed:
                    updated_count += 1
                else:
                    new_count += 1
            else:
                unchanged_count += 1

        # 建立图谱边
        for note in notes:
            self.index.index_edges(note, title_to_id)

        # 清理已删除文件
        current_ids = set(self.index.get_all_note_ids())
        deleted = current_ids - note_ids
        for note_id in deleted:
            self.index.delete_note(note_id)

        # 如果启用本地 TF-IDF 降级，训练并写入 Chroma
        embed_status = self.index.fit_tfidf()

        stats = self.index.stats()

        result = {
            "ts": config.now_iso(),
            "vault": str(self.importer.vault_path),
            "scanned": len(notes),
            "new": new_count,
            "updated": updated_count,
            "unchanged": unchanged_count,
            "deleted": len(deleted),
            "stats": stats,
            "embed_status": embed_status,
            "dna": f"{config.DNA_PREFIX}{config.now_iso().replace('-','').replace(':','').replace('T','')}-SECOND-BRAIN-SYNC-v1.0",
        }

        # 写入审计日志
        config.AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
        with open(config.AUDIT_LOG, "a", encoding="utf-8") as f:
            f.write(json.dumps(result, ensure_ascii=False) + "\n")

        return result
