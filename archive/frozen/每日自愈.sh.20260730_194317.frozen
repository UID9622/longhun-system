set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR"

echo "🌅 UID9622，早上好。大脑中枢开始每日自愈..."
bash 一键启动.sh > /tmp/uid9622_daily.log 2>&1

SCORE=$(python3 - <<'PY'
import json
with open('reports/reflection_report.json', encoding='utf-8') as f:
    print(json.load(f)['健康评分'])
PY
)

echo ""
echo "💖 今日健康评分：$SCORE / 100"

if [ "$SCORE" -ge 80 ]; then
    echo "🌟 系统状态很好，老大可以放心去干大事。"
elif [ "$SCORE" -ge 60 ]; then
    echo "🌱 有些地方需要注意，但我已经帮你整理好建议了，看 reports/ 就行。"
else
    echo "🔧 今天需要关注一下，建议先打开 reports/reflection_report.json 看看具体问题。"
fi

echo ""
echo "📝 详细日志：/tmp/uid9622_daily.log"
echo "📊 报告目录：reports/"