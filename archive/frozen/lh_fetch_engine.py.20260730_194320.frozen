#!/usr/bin/env python3
"""
龍魂·训练数据自动拉取引擎 v2.0 (四层降级融合版)
DNA: #龍芯⚡️丙午·辛未·乙酉·卯时·讼-LH-FETCH-ENGINE-v2.0

四层降级解析策略（自动降级）:
    1. RSS/XML解析 — 识别 <rss>/<feed>/<channel>/<item>/<entry>
    2. JSON API解析 — 解析API返回的JSON数据
    3. HTML结构化解析 — 提取标题/段落/链接/heading
    4. Fallback降级 — 去标签提取纯文本，任何内容都能读

原则:
- 中国法律准绳，所有操作符合《网络安全法》《数据安全法》《个人信息保护法》
- 遵守 robots.txt，控制请求频率(>=1秒)
- User-Agent 明确标识 LonghunBot/1.0
- 只拉取公开可访问内容，不爬取需登录/付费内容
- 每条数据绑定 DNA，来源可追溯
- 四层降级保证：任何网站都能读，解析不出来也能提取纯文本

用法:
    python3 lh_fetch_engine.py --priority P0          # 拉取P0优先级源
    python3 lh_fetch_engine.py --source CN-001        # 拉取指定源
    python3 lh_fetch_engine.py --category CN-02       # 拉取指定分类
    python3 lh_fetch_engine.py --check-new            # 检查是否有新内容
    python3 lh_fetch_engine.py --stats                # 查看拉取统计
"""

import json
import os
import sys
import time
import hashlib
import random
import re
import argparse
from datetime import datetime, timezone, timedelta
from pathlib import Path
from typing import Any
from urllib.parse import urlparse
from urllib.robotparser import RobotFileParser
import xml.etree.ElementTree as ET

try:
    import requests
    from bs4 import BeautifulSoup
except ImportError:
    print("请安装依赖: pip install requests beautifulsoup4")
    sys.exit(1)

# === 常量 ===
CST = timezone(timedelta(hours=8))
BASE_DIR = Path(__file__).parent
SOURCES_FILE = BASE_DIR / "sources.json"
FETCHED_DIR = BASE_DIR / "fetched"
CLEANED_DIR = BASE_DIR / "cleaned"
TRAIN_DIR = BASE_DIR / "train"
LOGS_DIR = BASE_DIR / "logs"
STATE_FILE = BASE_DIR / "fetch_state.json"

USER_AGENT = "LonghunBot/1.0 (TrainingData; UID9622; +https://docs.longhun888.com)"
MIN_DELAY = 1.0  # 最小请求间隔（秒）
MAX_DELAY = 3.0  # 最大随机延迟（秒）
REQUEST_TIMEOUT = 30
MAX_ARTICLES_PER_SOURCE = 20  # 每次最多拉取文章数
MAX_CONTENT_LENGTH = 10000  # 单篇文章最大长度

# 创建目录
for d in [FETCHED_DIR, CLEANED_DIR, TRAIN_DIR, LOGS_DIR]:
    d.mkdir(parents=True, exist_ok=True)


class RobotChecker:
    """robots.txt 检查器（带缓存）"""
    def __init__(self):
        self._cache = {}

    def can_fetch(self, url: str) -> bool:
        parsed = urlparse(url)
        domain = f"{parsed.scheme}://{parsed.netloc}"
        robots_url = f"{domain}/robots.txt"

        if domain not in self._cache:
            rp = RobotFileParser()
            rp.set_url(robots_url)
            try:
                rp.read()
                self._cache[domain] = rp
            except Exception:
                # robots.txt 读取失败，默认允许
                self._cache[domain] = None
                return True

        checker = self._cache[domain]
        if checker is None:
            return True
        return checker.can_fetch(USER_AGENT, url)


class DNAGenerator:
    """DNA绑定生成器"""
    @staticmethod
    def generate(source_id: str, url: str, content: str) -> str:
        content_hash = hashlib.sha256(content.encode()).hexdigest()[:8]
        timestamp = datetime.now(CST).strftime("%Y%m%d%H%M%S")
        return f"#龍芯⚡️{source_id}-{timestamp}-{content_hash}"

    @staticmethod
    def bind_metadata(item: dict[str, Any], source_id: str, url: str) -> dict[str, Any]:
        item["metadata"] = {
            "source_id": source_id,
            "source_url": url,
            "fetch_time": datetime.now(CST).isoformat(),
            "dna": DNAGenerator.generate(source_id, url, json.dumps(item, ensure_ascii=False)),
            "content_hash": hashlib.sha256(json.dumps(item, ensure_ascii=False).encode()).hexdigest()[:16]
        }
        return item


class FetchState:
    """拉取状态管理器"""
    def __init__(self):
        self.state = self._load()

    def _load(self) -> dict[str, Any]:
        if STATE_FILE.exists():
            with open(STATE_FILE) as f:
                return json.load(f)
        return {"last_fetch": {}, "total_fetched": 0, "source_stats": {}}

    def save(self):
        with open(STATE_FILE, 'w') as f:
            json.dump(self.state, f, ensure_ascii=False, indent=2)

    def get_last_fetch(self, source_id: str) -> str:
        return self.state["last_fetch"].get(source_id, "")

    def update_source(self, source_id: str, count: int):
        self.state["last_fetch"][source_id] = datetime.now(CST).isoformat()
        self.state["total_fetched"] += count
        if source_id not in self.state["source_stats"]:
            self.state["source_stats"][source_id] = 0
        self.state["source_stats"][source_id] += count
        self.save()


class LonghunDataFetcher:
    """龍魂训练数据拉取引擎"""

    def __init__(self):
        with open(SOURCES_FILE) as f:
            self.config = json.load(f)
        self.sources = self.config["sources"]
        self.robot_checker = RobotChecker()
        self.state = FetchState()
        self.session = requests.Session()
        self.session.headers.update({
            "User-Agent": USER_AGENT,
            "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
            "Accept-Language": "zh-CN,zh;q=0.9",
            "Accept-Encoding": "gzip, deflate",
        })

    def log(self, msg: str, level: str = "INFO"):
        timestamp = datetime.now(CST).strftime("%Y-%m-%d %H:%M:%S")
        log_line = f"[{timestamp}] [{level}] {msg}"
        print(log_line)
        with open(LOGS_DIR / f"fetch_{datetime.now(CST).strftime('%Y%m%d')}.log", 'a') as f:
            f.write(log_line + '\n')

    def fetch_source(self, source: dict[str, Any]) -> list[Any]:
        """拉取单个源的公开内容"""
        source_id = source["id"]
        articles = []

        if not source.get("fetch_enabled", False):
            self.log(f"{source_id} {source['name']}: 抓取已禁用", "SKIP")
            return articles

        strategy = source.get("fetch_strategy", "rss_or_api")

        try:
            if strategy == "direct_scrape":
                articles = self._fetch_direct_scrape(source)
            elif strategy == "rss_or_api":
                articles = self._fetch_rss_or_scrape(source)
            elif strategy == "rss":
                articles = self._fetch_rss(source)
            elif strategy == "api_only":
                self.log(f"{source_id} {source['name']}: 需API，暂不支持", "SKIP")
            elif strategy == "direct_api":
                articles = self._fetch_direct_api(source)
            else:
                self.log(f"{source_id}: 未知策略 {strategy}", "WARN")
        except Exception as e:
            self.log(f"{source_id} {source['name']}: 抓取异常 - {e}", "ERROR")

        return articles

    # ============================================================
    #  四层降级解析引擎 (RSS → JSON → HTML → Fallback)
    #  融合自 longhun_data_engine_v1.0
    # ============================================================

    def _parse_with_degradation(self, content: str, url: str, strategy: str) -> dict[str, Any]:
        """四层降级解析：RSS→JSON→HTML→Fallback，自动降级确保任何内容都能读"""
        parsed = None
        parse_method = "unknown"

        # 第1层：RSS/XML解析
        if strategy in ["rss", "rss_or_api"]:
            if "<rss" in content[:500] or "<feed" in content[:500] or "<channel" in content[:500]:
                parsed = self._parse_rss_xml(content)
                if parsed:
                    parse_method = "rss"
                    self.log(f"    第1层 RSS解析: {len(parsed)} 条")

        # 第2层：JSON API解析
        if parsed is None and strategy in ["api", "api_only", "direct_api", "rss_or_api"]:
            try:
                parsed = json.loads(content)
                parse_method = "json_api"
                self.log(f"    第2层 JSON解析成功")
            except json.JSONDecodeError:
                pass

        # 第3层：HTML结构化解析
        if parsed is None:
            if "<html" in content[:500] or "<!DOCTYPE" in content[:500]:
                parsed = self._parse_html_structured(content, url)
                parse_method = "html"
                self.log(f"    第3层 HTML解析: 标题={parsed.get('title', 'N/A')[:40]}")

        # 第4层：Fallback降级（终极兜底）
        if parsed is None:
            parsed = self._fallback_parse(content, url)
            parse_method = "fallback"
            self.log(f"    第4层 Fallback降级: {len(parsed.get('text_extracted', ''))} 字符")

        parsed["parse_method"] = parse_method
        return parsed

    def _parse_rss_xml(self, content: str) -> list[Any]:
        """第1层：RSS/XML解析"""
        items = []
        try:
            root = ET.fromstring(content)
            for item in root.iter():
                if item.tag.endswith('item') or item.tag.endswith('entry'):
                    entry = {}
                    for child in item:
                        tag = child.tag.split('}')[-1] if '}' in child.tag else child.tag
                        if tag in ['title', 'link', 'description', 'pubDate', 'guid', 'content']:
                            entry[tag] = child.text or ""
                    if entry:
                        items.append(entry)
        except Exception:
            # ET解析失败，用正则兜底
            titles = re.findall(r'<title>([^<]+)</title>', content)
            links = re.findall(r'<link>([^<]+)</link>', content)
            for i, title in enumerate(titles[:20]):
                entry = {"title": title}
                if i < len(links):
                    entry["link"] = links[i]
                items.append(entry)
        return items

    def _parse_html_structured(self, content: str, url: str) -> dict[str, Any]:
        """第3层：HTML结构化解析"""
        result = {
            "title": "",
            "meta_description": "",
            "headings": [],
            "paragraphs": [],
            "links": [],
            "source_url": url,
        }
        # 标题
        title_match = re.search(r'<title[^>]*>([^<]+)</title>', content, re.IGNORECASE)
        if title_match:
            result["title"] = title_match.group(1).strip()
        # Meta描述
        meta_match = re.search(r'<meta[^>]*name=["\']description["\'][^>]*content=["\']([^"\']+)["\']', content, re.IGNORECASE)
        if meta_match:
            result["meta_description"] = meta_match.group(1).strip()
        # Headings
        for level in range(1, 7):
            headings = re.findall(rf'<h{level}[^>]*>([^<]+)</h{level}>', content, re.IGNORECASE)
            result["headings"].extend([{"level": level, "text": h.strip()} for h in headings[:10]])
        # 段落
        paragraphs = re.findall(r'<p[^>]*>([^<]+)</p>', content, re.IGNORECASE)
        result["paragraphs"] = [p.strip() for p in paragraphs[:20] if len(p.strip()) > 10]
        # 链接
        links = re.findall(r'href=["\']([^"\']+)["\']', content)
        result["links"] = [l for l in links[:20] if l.startswith('http')]
        return result

    def _fallback_parse(self, content: str, url: str) -> dict[str, Any]:
        """第4层：终极降级 — 去标签纯文本提取"""
        text_extracted = re.sub(r'<[^>]+>', '', content)[:5000]
        return {
            "raw_preview": content[:3000],
            "text_extracted": text_extracted,
            "source_url": url,
            "parse_method_note": "fallback_raw_extraction"
        }

    def _degradation_result_to_articles(self, parsed: dict[str, Any], source: dict[str, Any], url: str) -> list[Any]:
        """将降级解析结果统一转为文章列表"""
        articles = []
        parse_method = parsed.get("parse_method", "unknown")

        if parse_method == "rss":
            for item in parsed:
                title = item.get("title", "")
                content = item.get("description") or item.get("content", "")
                if title and content:
                    articles.append({
                        "title": title,
                        "content": content[:MAX_CONTENT_LENGTH],
                        "url": item.get("link", url),
                        "source_name": source["name"],
                        "parse_method": parse_method,
                    })

        elif parse_method == "json_api":
            if isinstance(parsed, dict):
                text = json.dumps(parsed, ensure_ascii=False)[:MAX_CONTENT_LENGTH]
                articles.append({
                    "title": source["name"],
                    "content": text,
                    "url": url,
                    "source_name": source["name"],
                    "parse_method": parse_method,
                })

        elif parse_method == "html":
            title = parsed.get("title", source["name"])
            paragraphs = parsed.get("paragraphs", [])
            content = " ".join(paragraphs)
            if not content and parsed.get("meta_description"):
                content = parsed["meta_description"]
            if not content:
                content = title
            if content:
                articles.append({
                    "title": title,
                    "content": content[:MAX_CONTENT_LENGTH],
                    "url": url,
                    "source_name": source["name"],
                    "parse_method": parse_method,
                })

        elif parse_method == "fallback":
            text = parsed.get("text_extracted", "")
            if len(text) > 50:
                articles.append({
                    "title": source["name"],
                    "content": text[:MAX_CONTENT_LENGTH],
                    "url": url,
                    "source_name": source["name"],
                    "parse_method": parse_method,
                })

        return articles

    def _fetch_direct_scrape(self, source: dict[str, Any]) -> list[Any]:
        """直接爬取网页内容（v2.0: 使用四层降级引擎）"""
        articles = []
        url = source["url"]

        if not self.robot_checker.can_fetch(url):
            self.log(f"{source['id']}: robots.txt 禁止访问", "SKIP")
            return articles

        try:
            resp = self.session.get(url, timeout=REQUEST_TIMEOUT)
            if resp.status_code != 200:
                self.log(f"{source['id']}: HTTP {resp.status_code}", "WARN")
                return articles

            # v2.0: 使用四层降级引擎
            parsed = self._parse_with_degradation(resp.text, url, source.get("fetch_strategy", "rss_or_api"))
            articles = self._degradation_result_to_articles(parsed, source, url)

            # 降级兜底：如果降级引擎也没产出，用BeautifulSoup
            if not articles:
                soup = BeautifulSoup(resp.text, 'html.parser')
                body_text = soup.body.get_text(strip=True) if soup.body else ""
                if len(body_text) > 100:
                    articles.append({
                        "title": soup.title.string if soup.title else source['name'],
                        "content": body_text[:MAX_CONTENT_LENGTH],
                        "url": url,
                        "source_name": source['name'],
                        "parse_method": "bs4_fallback",
                    })

        except Exception as e:
            self.log(f"{source['id']}: 爬取失败 - {e}", "ERROR")

        return articles

    def _fetch_rss_or_scrape(self, source: dict[str, Any]) -> list[Any]:
        """v2.0: 四层降级 — RSS → Scrape → HTML → Fallback"""
        url = source["url"]

        if not self.robot_checker.can_fetch(url):
            self.log(f"{source['id']}: robots.txt 禁止访问", "SKIP")
            return []

        articles = []
        try:
            resp = self.session.get(url, timeout=REQUEST_TIMEOUT)
            if resp.status_code != 200:
                self.log(f"{source['id']}: HTTP {resp.status_code}", "WARN")
                # 降级到RSS路径尝试
                articles = self._fetch_rss(source)
                return articles

            # v2.0: 使用四层降级引擎
            parsed = self._parse_with_degradation(resp.text, url, source.get("fetch_strategy", "rss_or_api"))
            articles = self._degradation_result_to_articles(parsed, source, url)

            if not articles:
                # 四层都失败了，尝试RSS路径
                self.log(f"{source['id']}: 主页降级无结果，尝试RSS路径", "INFO")
                articles = self._fetch_rss(source)

        except Exception as e:
            self.log(f"{source['id']}: 拉取异常 - {e}, 尝试RSS路径", "WARN")
            articles = self._fetch_rss(source)

        return articles

    def _fetch_rss(self, source: dict[str, Any]) -> list[Any]:
        """v2.0: 通过RSS/Atom拉取，使用降级解析引擎"""
        articles = []
        domain = source["domain"]
        base_url = source["url"]

        rss_paths = [
            f"{base_url}/rss",
            f"{base_url}/feed",
            f"{base_url}/rss.xml",
            f"{base_url}/feed.xml",
            f"https://{domain}/rss",
            f"https://{domain}/feed",
        ]

        for rss_url in rss_paths[:3]:
            try:
                if not self.robot_checker.can_fetch(rss_url):
                    continue
                resp = self.session.get(rss_url, timeout=REQUEST_TIMEOUT)
                if resp.status_code != 200:
                    continue

                # v2.0: 使用四层降级引擎处理RSS响应
                parsed = self._parse_with_degradation(resp.text, rss_url, "rss")
                articles = self._degradation_result_to_articles(parsed, source, rss_url)

                if articles:
                    self.log(f"{source['id']}: RSS成功 {len(articles)} 条 → {rss_url}")
                    break
            except Exception:
                continue

        return articles

    def _fetch_direct_api(self, source: dict[str, Any]) -> list[Any]:
        """直接API拉取（如CSDN）"""
        articles = []

        if source["id"] == "CN-011":  # CSDN特殊处理
            try:
                # CSDN博客列表API
                api_url = "https://blog.csdn.net/UID9622/article/list/1"
                resp = self.session.get(api_url, timeout=REQUEST_TIMEOUT)
                if resp.status_code == 200:
                    soup = BeautifulSoup(resp.text, 'html.parser')
                    article_links = soup.find_all('a', href=True)
                    for link in article_links[:MAX_ARTICLES_PER_SOURCE]:
                        href = link.get('href', '')
                        if '/article/details/' in href:
                            try:
                                art_resp = self.session.get(href, timeout=REQUEST_TIMEOUT)
                                if art_resp.status_code == 200:
                                    art_soup = BeautifulSoup(art_resp.text, 'html.parser')
                                    art_body = art_soup.find('article') or art_soup.find('div', class_='article_content')
                                    if art_body:
                                        articles.append({
                                            "title": art_soup.title.string if art_soup.title else "",
                                            "content": art_body.get_text(strip=True)[:MAX_CONTENT_LENGTH],
                                            "url": href,
                                            "source_name": source['name'],
                                        })
                                time.sleep(MIN_DELAY)
                            except Exception:
                                continue
            except Exception as e:
                self.log(f"CSDN拉取异常: {e}", "ERROR")

        return articles

    def save_articles(self, source_id: str, articles: list[Any]):
        """保存拉取的文章"""
        if not articles:
            return

        # 保存原始内容
        output_path = FETCHED_DIR / f"{source_id}_{datetime.now(CST).strftime('%Y%m%d_%H%M%S')}.jsonl"
        with open(output_path, 'w') as f:
            for article in articles:
                article = DNAGenerator.bind_metadata(article, source_id, article.get('url', ''))
                f.write(json.dumps(article, ensure_ascii=False) + '\n')

        self.log(f"{source_id}: 保存 {len(articles)} 篇文章 → {output_path.name}")
        return output_path

    def run(self, priority_filter: str | None = None, source_filter: str | None = None, category_filter: str | None = None):
        """执行拉取任务"""
        self.log(f"🚀 龍魂训练数据拉取引擎启动")
        self.log(f"   配置源: {len(self.sources)} 个")

        # 筛选源
        targets = self.sources
        if priority_filter:
            targets = [s for s in targets if s.get('priority') == priority_filter]
        if source_filter:
            targets = [s for s in targets if s['id'] == source_filter]
        if category_filter:
            targets = [s for s in targets if s['category'] == category_filter]

        enabled = [s for s in targets if s.get('fetch_enabled', False)]
        disabled = len(targets) - len(enabled)

        self.log(f"   本次目标: {len(targets)} 个源 (已启用: {len(enabled)}, 需API/已禁用: {disabled})")

        total_articles = 0
        for i, source in enumerate(enabled):
            self.log(f"  [{i+1}/{len(enabled)}] {source['id']} {source['name']} ({source['domain']})")

            if not source.get('fetch_enabled', False):
                continue

            articles = self.fetch_source(source)
            if articles:
                self.save_articles(source['id'], articles)
                total_articles += len(articles)
                self.state.update_source(source['id'], len(articles))

            # 请求间隔
            if i < len(enabled) - 1:
                delay = MIN_DELAY + random.uniform(0, MAX_DELAY - MIN_DELAY)
                time.sleep(delay)

        self.log(f"✅ 拉取完成: {total_articles} 篇文章, {len(enabled)} 个源")
        return total_articles

    def check_new(self):
        """检查是否有新内容"""
        self.log("🔍 检查新内容...")
        new_count = 0
        for source in self.sources:
            if not source.get('fetch_enabled', False):
                continue
            last = self.state.get_last_fetch(source['id'])
            if not last:
                self.log(f"  {source['id']} {source['name']}: 从未拉取", "NEW")
                new_count += 1
            else:
                self.log(f"  {source['id']} {source['name']}: 上次拉取 {last}", "OK")
        self.log(f"  未拉取过的源: {new_count} 个")
        return new_count

    def stats(self):
        """显示拉取统计"""
        print(f"\n🐉 龍魂训练数据拉取统计")
        print(f"{'='*60}")
        print(f"总拉取次数: {self.state.state['total_fetched']}")
        print(f"\n各源统计:")
        for sid, count in sorted(self.state.state['source_stats'].items(), key=lambda x: -x[1]):
            source = next((s for s in self.sources if s['id'] == sid), None)
            name = source['name'] if source else sid
            last = self.state.get_last_fetch(sid)
            print(f"  {sid} {name}: {count} 条 | 最后: {last[:19] if last else '从未'}")
        print(f"{'='*60}\n")


def main():
    parser = argparse.ArgumentParser(description="龍魂训练数据自动拉取引擎")
    parser.add_argument('--priority', choices=['P0', 'P1', 'P2', 'P3'], help='按优先级拉取')
    parser.add_argument('--source', help='拉取指定源 (如 CN-001)')
    parser.add_argument('--category', help='拉取指定分类 (如 CN-02)')
    parser.add_argument('--check-new', action='store_true', help='检查新内容')
    parser.add_argument('--stats', action='store_true', help='查看统计')
    parser.add_argument('--all', action='store_true', help='拉取所有已启用源')

    args = parser.parse_args()
    fetcher = LonghunDataFetcher()

    if args.stats:
        fetcher.stats()
    elif args.check_new:
        fetcher.check_new()
    elif args.priority or args.source or args.category or args.all:
        if args.all:
            fetcher.run()
        else:
            fetcher.run(
                priority_filter=args.priority,
                source_filter=args.source,
                category_filter=args.category
            )
    else:
        # 默认：拉取P0优先级源
        print("未指定参数，默认拉取 P0 优先级源...")
        fetcher.run(priority_filter="P0")


if __name__ == "__main__":
    main()
