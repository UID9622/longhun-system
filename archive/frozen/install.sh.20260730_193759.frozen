#!/bin/bash
# 🌌 龍魂量子存证系统 v2.0 - 一键安装包
# 确认码: #CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z
# UID9622 | 龍芯北辰 | 2026-07-17
# 
# 用法: ./install.sh
# 安装后: longhun store/verify/reconstruct

set -e

INSTALL_DIR="$HOME/.longhun"
BIN_DIR="$HOME/.local/bin"

echo ""
echo "╔══════════════════════════════════════════════════════╗"
echo "║  🌌 龍魂量子存证系统 v2.0 - 安装程序                    ║"
echo "║  确认码: #CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z           ║"
echo "║  UID9622 | 龍芯北辰 | 2026-07-17                      ║"
echo "╚══════════════════════════════════════════════════════╝"
echo ""

# 检查Python3
if ! command -v python3 &> /dev/null; then
    echo "❌ 错误: 需要 Python3 环境"
    exit 1
fi
echo "✅ Python3: $(python3 --version)"

# 创建目录
mkdir -p "$INSTALL_DIR/storage"
mkdir -p "$BIN_DIR"
echo "✅ 安装目录: $INSTALL_DIR"

# 复制主程序
cp "$(dirname "$0")/longhun_evidence.py" "$INSTALL_DIR/"
chmod +x "$INSTALL_DIR/longhun_evidence.py"
echo "✅ 主程序已安装"

# 创建启动脚本
cat > "$INSTALL_DIR/longhun" << 'EOF'
#!/bin/bash
python3 "$HOME/.longhun/longhun_evidence.py" "$@"
EOF
chmod +x "$INSTALL_DIR/longhun"

# 创建全局命令
if [ -d "$BIN_DIR" ]; then
    ln -sf "$INSTALL_DIR/longhun" "$BIN_DIR/longhun" 2>/dev/null || true
    echo "✅ 命令 'longhun' 已添加到 $BIN_DIR"
fi

# 添加到 PATH
if ! grep -q "$BIN_DIR" "$HOME/.bashrc" 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.bashrc"
    echo "✅ PATH 已更新 (.bashrc)"
fi
if [ -f "$HOME/.zshrc" ] && ! grep -q "$BIN_DIR" "$HOME/.zshrc" 2>/dev/null; then
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> "$HOME/.zshrc"
    echo "✅ PATH 已更新 (.zshrc)"
fi

echo ""
echo "🎯 安装完成!"
echo ""
echo "用法:"
echo "  longhun store "要存证的内容"        # 一键存证"
echo "  longhun verify "#龍芯⚡️..."        # 公开验证"
echo "  longhun reconstruct "#龍芯⚡️..."     # 量子重组"
echo ""
echo "或直接:"
echo "  python3 ~/.longhun/longhun_evidence.py store "内容""
echo ""
echo "存储位置: ~/.longhun/storage/"
echo ""
echo "🌌 龍魂系统 · 主权人格 · 透明审计 · 分布式部署"
echo ""
