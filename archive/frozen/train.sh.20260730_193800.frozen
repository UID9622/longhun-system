#!/bin/bash
# 🐉 龍魂 longhun LoRA 一键训练（HF镜像版）
# 自动下载模型 → LoRA微调 → 合并导出
# 使用国内镜像加速下载

set -e
cd "$(dirname "$0")/../.."

PYTHON=/opt/homebrew/opt/python@3.12/bin/python3.12
export HF_ENDPOINT=https://hf-mirror.com

echo "=================================================="
echo "🐉 龍魂 longhun LoRA 微调训练"
echo "   底模: Qwen2.5-1.5B-Instruct"
echo "   镜像: $HF_ENDPOINT"
echo "=================================================="

# Step 0: 检查依赖
echo ""
echo "📦 Step 0/4: 检查依赖..."
$PYTHON -c "import mlx; import mlx_lm; print('MLX OK')" || {
    echo "请先安装: pip3 install mlx mlx-lm --break-system-packages"
    exit 1
}

# Step 1: 准备数据
echo ""
echo "📝 Step 1/4: 准备训练数据..."
$PYTHON bin/lh_lora_trainer.py prepare

# Step 2: 训练
echo ""
echo "🚀 Step 2/4: LoRA 微调..."
$PYTHON bin/lh_lora_trainer.py train

# Step 3: 合并
echo ""
echo "🔗 Step 3/4: 合并 adapter..."
$PYTHON bin/lh_lora_trainer.py fuse

# Step 4: 导出
echo ""
echo "📦 Step 4/4: 导出 GGUF..."
$PYTHON bin/lh_lora_trainer.py export

echo ""
echo "=================================================="
echo "✅ 训练完成！"
echo "   部署: ollama create longhun-lora -f models/longhun-v1.0/lora_output/gguf/Modelfile"
echo "=================================================="
