###############################################
# 🐉 龍魂系统 - DNA追溯码生成器
###############################################
#
# 文件名：DNA追溯码生成器
# 文件类型：.cnsh.py
#
# DNA追溯码：#龙芯⚡️2026-02-11-DNA生成器-v1.0
# 创建者：宝宝｜UID9622
# 创建时间：北京时间 2026-02-11 23:30:00
# 最后修改：北京时间 2026-02-11 23:45:00
#
# 🎯 这个文件的作用（用大白话）：
#    当龍魂系统生成代码、文档、协议时，这个程序就会自动
#    给它们一个"身份证号"，就像 #龙芯⚡️2026-02-11-DEMO-v1.0
#    这样，别人拿到你的代码，就能知道：
#      ✅ 这是龍魂系统的正版代码
#      ✅ 生成于什么时间
#      ✅ 是什么功能
#      ✅ 版本号是多少
#    如果有人改了DNA码，就说明代码被篡改过了。
#
# 📚 逻辑来源：
#    - 《龙魂底线协议·双轨治理标准》中的"DNA追溯原则"
#    - 《北辰-母协议》中的"版权追踪机制"
#    - SHA-256 哈希算法（业界标准，用来生成唯一指纹）
#
# ⚠️ 重要说明：
#    DNA码一旦生成，就永远不能改变。这是整个龍魂系统
#    的信任基础。如果发现DNA码被改过，就说明这份代码
#    被别人篡改了，不能再信任。
#
###############################################

import hashlib
import json
import datetime
from typing import Dict, Optional, Any

# =====================================================
# 第一步：导入工具库
# =====================================================
# 大白话：这些是Python内置的工具。
# - hashlib：用来生成密码指纹（DNA码）
# - json：用来处理JSON数据（就像结构化的表格）
# - datetime：用来记录当前时间
# - typing：用来标记变量类型（这样别人看代码时能更清楚）


class DNA生成器_龍魂系统:
    """
    龍魂系统的DNA码生成器

    大白话解释：
      这是一个"身份证工厂"。你告诉它"我要给这个代码
      生成DNA码"，它就会：
      1. 读取代码内容
      2. 生成一个唯一的指纹
      3. 加上龍魂系统的标记
      4. 返回完整的DNA码

      比如：输入"你好"，输出可能是
      #龙芯⚡️2026-02-11-测试-a1b2c3d4

      改一个字："你好啊"，输出就完全不同了：
      #龙芯⚡️2026-02-11-测试-x9y8z7w6

      所以，用DNA码就能检查代码有没有被篡改。
    """

    def __init__(self):
        """
        初始化DNA生成器

        大白话：这是启动生成器的过程。
        """
        # 龍魂系统的标记符号
        self.系统标记 = "龙芯⚡️"

        # 当前使用的加密算法（SHA-256，业界标准）
        self.加密算法 = "SHA-256"

        # DNA码的版本号（如果以后要改格式，就改这个）
        self.DNA版本 = "v1.0"

    def 生成DNA码(
        self,
        文本内容: str,
        功能名称: str = "DEFAULT",
        版本号: str = "v1.0",
        创建者: str = "UID9622"
    ) -> str:
        """
        生成DNA追溯码

        参数说明（大白话）：
          - 文本内容：你要保护的代码或文档
          - 功能名称：这段代码的功能是什么（比如"DNA生成器"）
          - 版本号：这是第几个版本（比如"v1.0"）
          - 创建者：谁创建的（默认是UID9622）

        返回值（大白话）：
          生成好的DNA码，格式像这样：
          #龙芯⚡️2026-02-11-DNA生成器-v1.0-a1b2c3d4

        逻辑流程：
          第1步：把文本转成计算机能理解的字节
          第2步：用SHA-256算法生成指纹
          第3步：取指纹的前8位作为简短标识
          第4步：加上日期、功能名、版本号
          第5步：返回完整的DNA码
        """

        # ========== 第1步：转换文本为字节 ==========
        # 大白话：计算机只能理解0和1（字节），
        # 不能直接理解中文。所以要先把中文转成字节。
        # 用UTF-8编码是国际标准。
        文本字节 = 文本内容.encode('utf-8')

        # ========== 第2步：生成SHA-256指纹 ==========
        # 大白话：SHA-256是一个数学函数。
        # 你输入任何文本，它就能生成一个64位的密码指纹。
        # 特点：
        #   ✅ 同样的输入，总是生成同样的输出
        #   ✅ 改一个字，输出就完全不同
        #   ✅ 不可能反推：看着输出，无法推出输入是什么
        # 这就是为什么它能用来检查代码有没有被篡改。

        SHA256对象 = hashlib.sha256(文本字节)
        完整指纹 = SHA256对象.hexdigest()  # hexdigest() = 十六进制显示

        # ========== 第3步：取指纹的前8位 ==========
        # 大白话：64位太长了，容易记错。
        # 前8位足以区分不同的代码了。
        # （数学上，前8位就有2^32种组合，远多于需要）
        简短指纹 = 完整指纹[:8]

        # ========== 第4步：获取当前日期 ==========
        # 大白话：DNA码要包含生成日期，
        # 这样你能知道代码是什么时候创建的。
        当前日期 = datetime.datetime.now().strftime('%Y-%m-%d')

        # ========== 第5步：组装DNA码 ==========
        # 大白话：把所有信息组合成最终的DNA码格式
        # 格式说明：
        #   #龙芯⚡️ = 龍魂系统的标记（#是为了突出它）
        #   2026-02-11 = 生成日期
        #   DNA生成器 = 功能名称
        #   v1.0 = 版本号
        #   a1b2c3d4 = 指纹的前8位
        DNA码 = f"#{self.系统标记}{当前日期}-{功能名称}-{版本号}-{简短指纹}"

        return DNA码

    def 验证DNA码(
        self,
        原文本: str,
        声称的DNA码: str
    ) -> Dict[str, bool]:
        """
        验证DNA码是否真实

        大白话解释：
          你有一份代码和它的DNA码。
          这个函数会检查：
          "这个DNA码真的是这份代码的吗？"

          如果有人改了代码，但没改DNA码，
          这个检查就会失败，说明代码被篡改了。

        返回值（大白话）：
          返回一个字典，比如：
          {
            "有效": True,           # DNA码是有效的
            "与内容匹配": True,     # 代码内容和DNA码匹配
            "信息": "DNA码有效"     # 详细说明
          }
        """

        # ========== 第1步：检查DNA码格式 ==========
        # 大白话：有效的DNA码必须以 #龙芯⚡️ 开头
        if not 声称的DNA码.startswith("#龙芯⚡️"):
            return {
                "有效": False,
                "与内容匹配": False,
                "信息": "DNA码格式无效：不是龍魂系统的标记"
            }

        # ========== 第2步：提取DNA码中的指纹 ==========
        # 大白话：DNA码的最后8位是指纹
        # 比如 #龙芯⚡️2026-02-11-DEMO-v1.0-a1b2c3d4
        # 最后的 a1b2c3d4 就是指纹
        DNA码的指纹 = 声称的DNA码.split('-')[-1]

        # ========== 第3步：重新计算原文本的指纹 ==========
        # 大白话：用同样的方法，从原文本生成指纹
        # 然后和DNA码中的指纹对比
        重新计算的指纹 = hashlib.sha256(
            原文本.encode('utf-8')
        ).hexdigest()[:8]

        # ========== 第4步：对比两个指纹 ==========
        # 大白话：如果两个指纹一样，说明DNA码是真的
        # 如果不一样，说明代码被改过了
        匹配 = (DNA码的指纹 == 重新计算的指纹)

        return {
            "有效": True,
            "与内容匹配": 匹配,
            "信息": "DNA码匹配" if 匹配 else "警告：DNA码与内容不匹配，可能被篡改"
        }

    def 生成完整元数据(
        self,
        文本内容: str,
        功能名称: str,
        版本号: str = "v1.0",
        创建者: str = "UID9622",
        额外说明: Optional[str] = None
    ) -> Dict[str, Any]:
        """
        生成完整的DNA码和元数据（JSON格式）

        大白话解释：
          不只生成DNA码，还生成一个完整的"身份证"，
          包括生成时间、创建者、功能说明等等。
          用JSON格式保存，容易被计算机处理。
        """

        DNA码 = self.生成DNA码(文本内容, 功能名称, 版本号, 创建者)

        元数据 = {
            "cnsh_metadata": {
                "dna_code": DNA码,
                "creator": 创建者,
                "created_at": datetime.datetime.now().isoformat(),
                "feature_name": 功能名称,
                "version": 版本号,
                "hash_algorithm": self.加密算法
            },
            "cnsh_content_hash": hashlib.sha256(
                文本内容.encode('utf-8')
            ).hexdigest(),
            "cnsh_remarks": 额外说明 or "龍魂系统官方发布"
        }

        return 元数据


# =====================================================
# 第四步：使用示例（测试代码）
# =====================================================
# 大白话：现在我们试试这个生成器能不能用

if __name__ == "__main__":
    print("=" * 60)
    print("🐉 龍魂系统 - DNA生成器 v1.0")
    print("=" * 60)
    print()

    # 创建生成器实例
    # 大白话：就像启动一个"身份证工厂"
    生成器 = DNA生成器_龍魂系统()

    # ========== 示例1：简单的DNA码生成 ==========
    print("【示例1】生成简单的DNA码")
    print("-" * 60)

    测试文本1 = "龍魂系统：以人民为中心，拒绝资本剥削"
    DNA码1 = 生成器.生成DNA码(
        文本内容=测试文本1,
        功能名称="核心价值观",
        版本号="v1.0"
    )

    print(f"输入文本：{测试文本1}")
    print(f"生成的DNA码：{DNA码1}")
    print()

    # ========== 示例2：验证DNA码（代码未被篡改） ==========
    print("【示例2】验证DNA码（正常情况）")
    print("-" * 60)

    验证结果1 = 生成器.验证DNA码(测试文本1, DNA码1)
    print(f"验证结果：{验证结果1}")
    print(f"是否匹配：{'✅ 是' if 验证结果1['与内容匹配'] else '❌ 否'}")
    print()

    # ========== 示例3：验证DNA码（代码被篡改） ==========
    print("【示例3】验证DNA码（代码被篡改）")
    print("-" * 60)

    被篡改的文本 = "龍魂系统：以资本为中心，拥抱商业剥削"  # 改了一个字
    验证结果2 = 生成器.验证DNA码(被篡改的文本, DNA码1)
    print(f"被篡改的文本：{被篡改的文本}")
    print(f"原始的DNA码：{DNA码1}")
    print(f"验证结果：{验证结果2}")
    print(f"是否匹配：{'✅ 是' if 验证结果2['与内容匹配'] else '❌ 否（代码被篡改）'}")
    print()

    # ========== 示例4：生成完整元数据 ==========
    print("【示例4】生成完整元数据（JSON格式）")
    print("-" * 60)

    元数据 = 生成器.生成完整元数据(
        文本内容=测试文本1,
        功能名称="核心价值观",
        版本号="v1.0",
        创建者="宝宝｜UID9622",
        额外说明="龍魂系统的官方核心价值观声明"
    )

    # 把元数据转成JSON格式并打印
    # 大白话：JSON是一种通用的数据格式，
    # 任何编程语言都能读，容易保存和传输
    JSON输出 = json.dumps(元数据, ensure_ascii=False, indent=2)
    print(JSON输出)
    print()

    print("=" * 60)
    print("✅ DNA生成器测试完成！")
    print("=" * 60)


