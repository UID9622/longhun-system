"""
命名与格式规范：给整个 messy folder 定统一规矩。
DNA: #龍芯⚡️2026-06-24-UID9622-BRAIN-STANDARDS-v1.0
"""

from pathlib import Path
from typing import Any, Dict, List

from . import get_target_root
from .utils import load_config


class StandardsLinter:
    """检查文件是否符合 UID9622 统一规范。"""

    def __init__(self):
        self.config = load_config().get("命名规范", {})
        self.root = get_target_root()

    def lint_file(self, path: Path) -> List[Dict[str, Any]]:
        issues = []
        try:
            text = path.read_text(encoding="utf-8", errors="ignore")
        except Exception:
            return issues
        required = self.config.get("文件头必填", [])
        for field in required:
            if field not in text[:500]:
                issues.append({"文件": str(path.relative_to(self.root)), "问题": f"缺少{field}", "级别": "yellow"})
        if "# -*- coding: utf-8 -*-" not in text[:50] and path.suffix in {".py", ".sh"}:
            issues.append({"文件": str(path.relative_to(self.root)), "问题": "缺少 utf-8 编码声明", "级别": "yellow"})
        if "\t" in text and path.suffix in {".py", ".sh"}:
            issues.append({"文件": str(path.relative_to(self.root)), "问题": "包含制表符缩进", "级别": "yellow"})
        return issues

    def lint_all(self, max_files: int = 100) -> Dict[str, Any]:
        issues = []
        count = 0
        for ext in (".py", ".sh", ".js"):
            for path in self.root.rglob(f"*{ext}"):
                if any(part.startswith(".") for part in path.relative_to(self.root).parts):
                    continue
                issues.extend(self.lint_file(path))
                count += 1
                if count >= max_files:
                    break
            if count >= max_files:
                break
        return {
            "动作": "规范检查",
            "检查文件数": count,
            "问题数": len(issues),
            "问题列表": issues[:50],
        }


def run_lint() -> Dict[str, Any]:
    return StandardsLinter().lint_all()