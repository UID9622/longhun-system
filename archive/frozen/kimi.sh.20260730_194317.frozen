#!/bin/bash
curl -s https://api.moonshot.cn/v1/chat/completions \
  -H "Authorization: Bearer ${KIMI_API_KEY}" \
  -H "Content-Type: application/json" \
  -d "{\"model\":\"kimi-latest\",\"messages\":[{\"role\":\"system\",\"content\":\"你是龍魂系统加工厂AI，执行UID9622授权任务。\"},{\"role\":\"user\",\"content\":\"$1\"}],\"temperature\":0.3}" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('choices',[{}])[0].get('message',{}).get('content','API错误：'+json.dumps(d,ensure_ascii=False)[:200]))"
