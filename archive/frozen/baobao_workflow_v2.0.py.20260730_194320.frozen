if __name__ == "__main__":
    print("=" * 60)
    print("宝宝工作流透明化系统 v2.0")
    print("BAOBAO Workflow Transparent System v2.0")
    print("=" * 60)

    # 创建工作流实例 / Create workflow instance
    工作流 = BaobaoWorkflow()

    # 示例：处理文本事件 / Example: process text event
    示例文本 = "完成代码审查，审计通过，准备发布到生产环境"
    结果 = 工作流.处理文本事件(示例文本, "manual_test")

    print(f"\n📋 事件ID: {结果['事件ID']}")
    print(f"🎨 综合评级: {结果['综合评级']}")
    print(f"🔍 铁律审查通过: {结果['铁律审查']['通过']}")
    print(f"🔗 关键词路由数: {len(结果['关键词路由'])}")

    # 打印来源链 / Print source chain
    print(f"\n📜 六层来源链:")
    for 层名, 层值 in 结果['来源印章']['六层来源链'].items():
        print(f"   {层名}: {层值}")

    # 铁律测试：检测“龍”vs“龍”
    print("\n🛡️ 铁律测试:")
    测试通过 = IronLawGate.audit("这是一个包含简体龍的文本")
    print(f"   简体‘龍’检测: 通过={测试通过['通过']}, 评级={测试通过['评级']}")

    测试通过2 = IronLawGate.audit("这是一个包含繁体龍的文本")
    print(f"   繁体‘龍’检测: 通过={测试通过2['通过']}, 评级={测试通过2['评级']}")

    print("\n" + "=" * 60)
    print(CNSH_TERMINAL_HEADER)
    print("=" * 60)
