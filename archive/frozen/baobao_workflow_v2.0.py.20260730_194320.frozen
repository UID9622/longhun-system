import json


# ═══════════════════════════════════════════════════════════════
# 三层监督机制标记 / Three-Level Supervision Markers
# ═══════════════════════════════════════════════════════════════

class 监督层级(Enum):
    """Three-Level Supervision System / 三层监督体系"""
    L1逻辑 = "L1逻辑层"      # L1-Logic: 代码逻辑与算法正确性
    L2价值观 = "L2价值观层"  # L2-Values: 龍魂文化主权与伦理
    L3技术 = "L3技术层"      # L3-Tech: 技术实现与系统稳定性


# ═══════════════════════════════════════════════════════════════
# 三色审计枚举 / Three-Color Audit Enumeration
# ═══════════════════════════════════════════════════════════════

class AuditColor(Enum):
    """三色审计标注 / Three-Color Audit Labels"""
    GREEN = "🟢"   # 通过 conf ≥ 0.85 / PASS
    YELLOW = "🟡"  # 警告 0.60 ≤ conf < 0.85 / WARNING
    RED = "🔴"     # 阻断 conf < 0.60 / BLOCKED


# ═══════════════════════════════════════════════════════════════
# 六层来源链盖章器 / Six-Layer Source Chain Stamper
# ═══════════════════════════════════════════════════════════════

class SourceChain:
    """
    SourceChain —— 六层来源链盖章器
    Six-Layer Source Chain Stamper

    确保每一份代码产出都有完整的六层来源追溯：
    道统层→精神层→设备层→技术层→系统层→生命层
    Ensures every code artifact has complete 6-layer provenance.

    【L1逻辑】六层结构完整，缺一不可
    【L2价值观】道统层与精神层体现龍魂文化主权
    【L3技术】静态配置，线程安全，不可篡改
    """

    # 六层来源链定义 / Six-Layer Definition
    # 修复: 原代码中的转义符错误已修正（下划线前多余反斜杠）
    SIX_LAYER = {
        "道统层": "UID9622创始人架构",
        "精神层": "龍魂文化主权理念",
        "设备层": "本地计算环境",
        "技术层": "Python3.10+/NotionAPI",
        "系统层": "宝宝工作流透明化系统",
        "生命层": "诸葛鑫真人签名"
    }

    # DNA追溯码 / DNA Trace Code
    DNA = "#龍芯⚡️2026-06-18-BAOBAO-WORKFLOW-v2.0"

    # 铁律三不可 / Three Iron Laws
    IRON_LAWS = [
        "来源不可删",      # Source shall not be deleted
        "影响不可覆",      # Impact shall not be overwritten
        "贡献不可抹"       # Contribution shall not be erased
    ]

    @staticmethod
    def stamp(文件路径: str = "") -> Dict[str, Any]:
        """
        盖章 / Stamp the source chain onto an artifact.

        为指定文件路径盖下六层来源链印章，返回完整的来源追溯信息。
        Applies the six-layer provenance stamp to the given file path.

        Args:
            文件路径: 目标文件的相对路径 / Relative path of target file

        Returns:
            Dict containing 六层来源链, DNA追溯码, 铁律, 时间戳, 文件哈希
        """
        时间戳 = datetime.now().isoformat()
        文件哈希 = ""
        if 文件路径 and os.path.exists(文件路径):
            with open(文件路径, "rb") as f:
                文件哈希 = hashlib.sha256(f.read()).hexdigest()[:16]

        return {
            "六层来源链": dict(SourceChain.SIX_LAYER),
            "DNA追溯码": SourceChain.DNA,
            "铁律": " · ".join(SourceChain.IRON_LAWS),
            "盖章时间": 时间戳,
            "文件路径": 文件路径,
            "文件哈希": 文件哈希 if 文件哈希 else None,
            "监督层级": [监督层级.L1逻辑.value, 监督层级.L2价值观.value, 监督层级.L3技术.value]
        }

    @staticmethod
    def verify(印章: Dict[str, Any]) -> Dict[str, Any]:
        """
        验证印章完整性 / Verify stamp integrity.

        检查给定的来源链印章是否包含所有必需的六层。
        Checks if the given stamp contains all required six layers.

        Args:
            印章: 由stamp()方法生成的来源链字典

        Returns:
            验证结果字典，含完整性布尔值和缺失层列表
        """
        必需层 = set(SourceChain.SIX_LAYER.keys())
        实际层 = set(印章.get("六层来源链", {}).keys())
        缺失层 = 必需层 - 实际层

        return {
            "完整": len(缺失层) == 0,
            "缺失层": list(缺失层),
            "审计色": AuditColor.GREEN.value if len(缺失层) == 0 else AuditColor.RED.value,
            "验证时间": datetime.now().isoformat()
        }


# ═══════════════════════════════════════════════════════════════
# 铁律自审闸 / Iron Law Self-Audit Gate
# ═══════════════════════════════════════════════════════════════

class IronLawGate:
    """
    IronLawGate —— 铁律自审闸
    Iron Law Self-Audit Gate

    自动审查文本内容，确保符合龍魂体系铁律：
    1. 繁体“龍”不得简化为“龍”
    2. 禁止蒸馏：原创成果不得被AI概括或替代
    3. 禁止顶替作者：UID9622是唯一创作者

    Automatically audits text for compliance with Dragon Soul system iron laws.

    【L1逻辑】规则匹配引擎，逐条检测
    【L2价值观】守护龍魂文化主权，捍卫创作者权益
    【L3技术】正则+关键词检测，O(1)时间复杂度
    """

    # 铁律规则集 / Iron Law Rules
    RULES = {
        "龍字规范": {
            "描述": "繁体‘龍’被简化为‘龍’",
            "检测": lambda text: "龍" in text and "龍" not in text,
            "严重级": AuditColor.RED
        },
        "禁止蒸馏": {
            "描述": "禁止蒸馏：原创成果不得被AI概括或替代",
            "检测": lambda text: any("蒸馏" in line and "禁止" not in line for line in text.split("\n")),
            "严重级": AuditColor.RED
        },
        "禁止顶替": {
            "描述": "禁止顶替作者：UID9622是唯一创作者",
            "检测": lambda text: any(("顶替" in line or "替代作者" in line) and "禁止" not in line for line in text.split("\n")),
            "严重级": AuditColor.RED
        },
        "CNSH终端头保护": {
            "描述": "CNSH不可删除终端头被移除",
            "检测": lambda text: "CNSH" not in text and "终端头" in text,
            "严重级": AuditColor.YELLOW
        }
    }

    @staticmethod
    def audit(文本: str) -> Dict[str, Any]:
        """
        铁律自审 / Iron law self-audit.

        对给定文本执行完整的铁律审查，检测所有违规项。
        Performs complete iron law audit on the given text.

        Args:
            文本: 待审查的文本内容 / Text content to audit

        Returns:
            审计结果字典，含通过状态、违规项列表、三色评级
        """
        违规项 = []
        详细报告 = []

        for 规则名, 规则配置 in IronLawGate.RULES.items():
            if 规则配置["检测"](文本):
                违规 = {
                    "规则": 规则名,
                    "描述": 规则配置["描述"],
                    "级别": 规则配置["严重级"].value
                }
                违规项.append(违规)
                详细报告.append(f"{规则配置['严重级'].value} [{规则名}] {规则配置['描述']}")

        通过 = len(违规项) == 0

        # 计算综合置信度
        if 通过:
            置信度 = 1.0
            评级 = AuditColor.GREEN
        else:
            红计数 = sum(1 for v in 违规项 if v["级别"] == AuditColor.RED.value)
            if 红计数 > 0:
                置信度 = max(0.0, 0.6 - 0.1 * 红计数)
                评级 = AuditColor.RED
            else:
                置信度 = 0.75
                评级 = AuditColor.YELLOW

        return {
            "通过": 通过,
            "置信度": round(置信度, 2),
            "评级": 评级.value,
            "违规项": 违规项,
            "详细报告": 详细报告,
            "审计时间": datetime.now().isoformat(),
            "监督层级": [监督层级.L1逻辑.value, 监督层级.L2价值观.value]
        }

    @staticmethod
    def audit_file(文件路径: str) -> Dict[str, Any]:
        """
        对文件执行铁律自审 / Audit a file.

        Args:
            文件路径: 目标文件的绝对路径

        Returns:
            审计结果字典
        """
        if not os.path.exists(文件路径):
            return {
                "通过": False,
                "评级": AuditColor.RED.value,
                "违规项": [{"规则": "文件存在性", "描述": f"文件不存在: {文件路径}", "级别": AuditColor.RED.value}],
                "审计时间": datetime.now().isoformat()
            }

        with open(文件路径, "r", encoding="utf-8") as f:
            内容 = f.read()

        return IronLawGate.audit(内容)


# ═══════════════════════════════════════════════════════════════
# 关键词→Notion自动路由器 / Keyword→Notion Auto Router
# ═══════════════════════════════════════════════════════════════

class NotionKeywordRouter:
    """
    NotionKeywordRouter —— 关键词→Notion自动路由器
    Keyword to Notion Automatic Router

    监听工作流关键词，自动触发Notion数据库更新：
    Monitors workflow keywords and auto-triggers Notion database updates.

    关键词映射规则 / Keyword Mapping Rules:
    - "完成" → tasks数据库 → status=Done
    - "审计" → audit数据库 → status=Review
    - "发布" → releases数据库 → status=Published
    - "更新" → updates数据库 → status=Updated
    - "部署" → deploys数据库 → status=Deployed
    - "修复" → fixes数据库 → status=Fixed
    - "优化" → optimizes数据库 → status=Optimized

    【L1逻辑】关键词匹配→数据库路由→状态更新
    【L2价值观】工作流透明化，确保每一步可追溯
    【L3技术】可扩展注册表，支持动态添加映射
    """

    # 自动触发关键词列表 / Auto-Trigger Keywords
    # 修复: 原代码中的转义符错误已修正
    AUTO_TRIGGER_KEYWORDS = [
        "完成",   # Done
        "更新",   # Update
        "审计",   # Audit
        "发布",   # Publish
        "部署",   # Deploy
        "修复",   # Fix
        "优化"    # Optimize
    ]

    # 关键词→Notion注册表 / Keyword→Notion Registry
    # 修复: 原代码中的转义符错误已修正
    KEYWORD_NOTION_REGISTRY = {
        "完成":   {"database": "tasks",    "status": "Done",       "标签": ["任务完成"]},
        "更新":   {"database": "updates",  "status": "Updated",    "标签": ["内容更新"]},
        "审计":   {"database": "audit",    "status": "Review",     "标签": ["审计中"]},
        "发布":   {"database": "releases", "status": "Published",  "标签": ["已发布"]},
        "部署":   {"database": "deploys",  "status": "Deployed",   "标签": ["已部署"]},
        "修复":   {"database": "fixes",    "status": "Fixed",      "标签": ["已修复"]},
        "优化":   {"database": "optimizes","status": "Optimized",  "标签": ["已优化"]}
    }

    def __init__(self):
        """初始化路由器 / Initialize the router."""
        # 修复: 原代码为 def init(self)，现修正为 def __init__(self)
        self.触发历史 = []
        self.监听器列表 = []

    def 匹配关键词(self, 文本: str) -> List[Dict[str, Any]]:
        """
        从文本中匹配关键词 / Match keywords in text.

        Args:
            文本: 待分析的文本

        Returns:
            匹配到的关键词配置列表
        """
        匹配结果 = []
        for 关键词 in self.AUTO_TRIGGER_KEYWORDS:
            if 关键词 in 文本:
                配置 = self.KEYWORD_NOTION_REGISTRY.get(关键词, {})
                if 配置:
                    匹配结果.append({
                        "关键词": 关键词,
                        "database": 配置.get("database"),
                        "status": 配置.get("status"),
                        "标签": 配置.get("标签", [])
                    })
        return 匹配结果

    def 路由到Notion(self, 关键词: str, 附加数据: Optional[Dict] = None) -> Dict[str, Any]:
        """
        将关键词事件路由到Notion / Route keyword event to Notion.

        Args:
            关键词: 触发路由的关键词
            附加数据: 额外的上下文数据

        Returns:
            路由结果字典
        """
        配置 = self.KEYWORD_NOTION_REGISTRY.get(关键词, {})
        if not 配置:
            return {
                "成功": False,
                "错误": f"未注册关键词: {关键词}",
                "时间戳": datetime.now().isoformat()
            }

        路由记录 = {
            "关键词": 关键词,
            "目标数据库": 配置["database"],
            "目标状态": 配置["status"],
            "标签": 配置.get("标签", []),
            "附加数据": 附加数据 or {},
            "时间戳": datetime.now().isoformat(),
            "来源链": SourceChain.stamp()
        }

        self.触发历史.append(路由记录)

        return {
            "成功": True,
            "路由记录": 路由记录,
            "审计色": AuditColor.GREEN.value
        }

    def 处理文本(self, 文本: str, 附加数据: Optional[Dict] = None) -> List[Dict[str, Any]]:
        """
        处理文本中的所有关键词 / Process all keywords in text.

        Args:
            文本: 输入文本
            附加数据: 额外上下文

        Returns:
            所有路由结果列表
        """
        匹配列表 = self.匹配关键词(文本)
        结果列表 = []

        for 匹配 in 匹配列表:
            结果 = self.路由到Notion(匹配["关键词"], 附加数据)
            结果列表.append(结果)

        return 结果列表

    def 注册关键词(self, 关键词: str, 数据库: str, 状态: str, 标签: Optional[List[str]] = None) -> bool:
        """
        动态注册新关键词 / Dynamically register a new keyword.

        Args:
            关键词: 新关键词
            数据库: 目标Notion数据库名
            状态: 对应状态值
            标签: 可选标签列表

        Returns:
            是否注册成功
        """
        if 关键词 in self.KEYWORD_NOTION_REGISTRY:
            return False

        self.AUTO_TRIGGER_KEYWORDS.append(关键词)
        self.KEYWORD_NOTION_REGISTRY[关键词] = {
            "database": 数据库,
            "status": 状态,
            "标签": 标签 or []
        }
        return True


# ═══════════════════════════════════════════════════════════════
# 三色审计系统 / Three-Color Audit System
# ═══════════════════════════════════════════════════════════════

class ThreeColorAudit:
    """
    ThreeColorAudit —— 三色审计系统
    Three-Color Audit System

    提供🟢通过/🟡警告/🔴阻断三级审计机制。
    Provides GREEN/YELLOW/RED three-level audit mechanism.

    【L1逻辑】基于置信度的分级判定
    【L2价值观】守护质量底线，不放行违规内容
    【L3技术】可配置阈值，支持自定义规则
    """

    def __init__(self):
        """初始化三色审计系统 / Initialize audit system."""
        # 修复: 原代码为 def init(self)，现修正为 def __init__(self)
        self.阈值通过 = 0.85   # GREEN threshold
        self.阈值警告 = 0.60   # YELLOW threshold
        self.审计历史 = []

    def 审计(self, 置信度: float, 上下文: str = "") -> Dict[str, Any]:
        """
        执行三色审计 / Perform three-color audit.

        Args:
            置信度: 0.0-1.0之间的置信度值
            上下文: 审计上下文描述

        Returns:
            审计结果字典
        """
        if 置信度 >= self.阈值通过:
            颜色 = AuditColor.GREEN
            结论 = "通过"
        elif 置信度 >= self.阈值警告:
            颜色 = AuditColor.YELLOW
            结论 = "警告：需人工复核"
        else:
            颜色 = AuditColor.RED
            结论 = "阻断：不符合标准"

        结果 = {
            "置信度": round(置信度, 2),
            "阈值通过": self.阈值通过,
            "阈值警告": self.阈值警告,
            "审计色": 颜色.value,
            "结论": 结论,
            "上下文": 上下文,
            "时间戳": datetime.now().isoformat()
        }

        self.审计历史.append(结果)
        return 结果

    def 批量审计(self, 项目列表: List[Dict[str, Any]]) -> List[Dict[str, Any]]:
        """
        批量审计多个项目 / Batch audit multiple items.

        Args:
            项目列表: 含置信度和上下文的项目字典列表

        Returns:
            审计结果列表
        """
        结果列表 = []
        for 项目 in 项目列表:
            结果 = self.审计(项目.get("置信度", 0.0), 项目.get("上下文", ""))
            结果列表.append(结果)
        return 结果列表


# ═══════════════════════════════════════════════════════════════
# 宝宝工作流主类 / BAOBAO Workflow Main Class
# ═══════════════════════════════════════════════════════════════

class BaobaoWorkflow:
    """
    BaobaoWorkflow —— 宝宝工作流透明化主类
    Baobao Workflow Transparent Main Class

    集成SourceChain、IronLawGate、NotionKeywordRouter三大核心组件，
    提供一站式工作流透明化管理。

    Integrates the three core components for one-stop workflow management.

    【L1逻辑】组件编排，流水线处理
    【L2价值观】全程透明，来源可追溯
    【L3技术】模块化设计，高内聚低耦合
    """

    def __init__(self):
        """初始化宝宝工作流 / Initialize BAOBAO workflow."""
        # 修复: 原代码为 def init(self)，现修正为 def __init__(self)
        self.来源链 = SourceChain()
        self.铁律闸 = IronLawGate()
        self.关键词路由器 = NotionKeywordRouter()
        self.审计系统 = ThreeColorAudit()
        self.工作流日志 = []

    def 处理文本事件(self, 文本: str, 来源: str = "unknown") -> Dict[str, Any]:
        """
        处理文本事件 / Process a text event.

        完整的处理流水线：铁律审查 → 关键词路由 → 来源盖章 → 三色审计
        Complete pipeline: Iron audit → Keyword routing → Source stamp → Color audit

        Args:
            文本: 事件文本内容
            来源: 事件来源标识

        Returns:
            完整的处理结果字典
        """
        时间戳 = datetime.now().isoformat()

        # Step 1: 铁律自审闸 / Iron Law Gate
        铁律结果 = self.铁律闸.audit(文本)

        # Step 2: 关键词路由 / Keyword Routing
        路由结果 = self.关键词路由器.处理文本(文本)

        # Step 3: 来源链盖章 / Source Chain Stamp
        来源印章 = self.来源链.stamp()

        # Step 4: 三色审计 / Three-Color Audit
        置信度 = 铁律结果["置信度"]
        审计结果 = self.审计系统.审计(置信度, f"文本事件来自: {来源}")

        # 综合结果
        综合结果 = {
            "事件ID": hashlib.md5(f"{文本}{时间戳}".encode()).hexdigest()[:12],
            "时间戳": 时间戳,
            "来源": 来源,
            "铁律审查": 铁律结果,
            "关键词路由": 路由结果,
            "来源印章": 来源印章,
            "三色审计": 审计结果,
            "综合评级": 审计结果["审计色"],
            "CNSH终端头": "#龍芯⚡️BAOBAO-WORKFLOW-v2.0-TERMINAL-不可删除"
        }

        self.工作流日志.append(综合结果)
        return 综合结果

    def 审查文件(self, 文件路径: str) -> Dict[str, Any]:
        """
        审查指定文件 / Review a file.

        Args:
            文件路径: 目标文件路径

        Returns:
            审查结果字典
        """
        # 铁律文件审查
        铁律结果 = self.铁律闸.audit_file(文件路径)

        # 来源链盖章
        来源印章 = self.来源链.stamp(文件路径)

        # 验证来源链
        验证结果 = SourceChain.verify(来源印章)

        # 三色审计
        审计结果 = self.审计系统.审计(铁律结果["置信度"], f"文件审查: {文件路径}")

        return {
            "文件路径": 文件路径,
            "铁律审查": 铁律结果,
            "来源印章": 来源印章,
            "印章验证": 验证结果,
            "三色审计": 审计结果,
            "综合评级": 审计结果["审计色"]
        }

    def 获取日志(self) -> List[Dict[str, Any]]:
        """获取工作流日志 / Get workflow log."""
        return self.工作流日志

    def 导出报告(self, 输出路径: str) -> bool:
        """
        导出工作流审计报告 / Export workflow audit report.

        Args:
            输出路径: 报告输出文件路径

        Returns:
            是否导出成功
        """
        try:
            报告 = {
                "报告标题": "宝宝工作流透明化审计报告",
                "生成时间": datetime.now().isoformat(),
                "DNA追溯码": SourceChain.DNA,
                "总事件数": len(self.工作流日志),
                "事件日志": self.工作流日志,
                "来源链": SourceChain.stamp(),
                "铁律审计": self.铁律闸.audit(" ".join(str(e) for e in self.工作流日志))
            }

            with open(输出路径, "w", encoding="utf-8") as f:
                json.dump(报告, f, ensure_ascii=False, indent=2)

            return True
        except Exception as e:
            print(f"导出报告失败: {e}")
            return False


