        # ═══════════════════════════════════════════════════════════════
        Rule(
            rule_id="RULE-FORMULA-002",
            name="time_decay",
            rule_type=RuleType.FORMULA,
            status=RuleStatus.ACTIVE,
            condition="'age_days' in context",
