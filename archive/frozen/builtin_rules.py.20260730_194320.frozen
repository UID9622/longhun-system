                "alpha_tau": {
                    "L0_ETERNAL": 0,
                    "L1_SEASONAL": 0.01,
                    "L2_DECENNIAL": 0.1,
                    "L3_GENERATIONAL": 1.0,
                    "L4_INSTANT": float('inf')
                },
                "category": "temporal_evaluation"
            }
