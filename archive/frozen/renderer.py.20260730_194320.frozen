"""
渲染器：把粒子的路径变成视觉震撼的图像。
DNA: #龍芯⚡️2026-06-24-UID9622-FLOW-FIELD-RENDERER-v1.0
"""

import json
import math
from pathlib import Path
from typing import Any, Dict, List

try:
    from PIL import Image, ImageDraw, ImageFilter
    HAS_PIL = True
except Exception:
    HAS_PIL = False

from .particle import Particle
from . import generate_dna


def _lerp_color(a, b, t):
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def render(particles: List[Particle], preset: Dict[str, Any], seed: int, output_dir: Path) -> Path:
    if not HAS_PIL:
        raise RuntimeError("PIL 未安装，请先运行 .venv/bin/pip install Pillow")

    w, h = preset["宽度"], preset["高度"]
    bg = tuple(preset["背景色"])
    alpha = int(preset.get("不透明度", 60))
    palette = preset["色彩谱"]
    field_name = preset["场函数"]

    img = Image.new("RGBA", (w, h), bg + (255,))
    draw = ImageDraw.Draw(img)

    for p in particles:
        path = p.path
        if len(path) < 2:
            continue
        total = len(path)
        for i in range(1, len(path)):
            t = i / total
            # taper width for calligraphy, otherwise constant
            if field_name == "calligraphy_flow":
                # 起笔粗 -> 行笔细 -> 收笔飞白
                if t < 0.1:
                    width = p.width * (1.0 + t * 2)
                elif t < 0.8:
                    width = p.width * (1.0 - t * 0.6)
                else:
                    width = max(0.5, p.width * (0.4 - (t - 0.8) * 1.5))
            else:
                width = max(0.5, p.width * (1.0 - t * 0.3))

            # color shifts along palette by life position
            color_idx = int(t * (len(palette) - 1))
            next_idx = min(color_idx + 1, len(palette) - 1)
            local_t = t * (len(palette) - 1) - color_idx
            color = _lerp_color(palette[color_idx], palette[next_idx], local_t)

            draw.line([path[i - 1], path[i]], fill=color + (alpha,), width=int(width))

    # 分层光晕：为星云/火焰/水纹等增加体积感
    if field_name in ("curl_noise", "turbulent_up", "sine_perlin"):
        glow = img.filter(ImageFilter.GaussianBlur(radius=2))
        img = Image.blend(img, glow, 0.3)

    # 全局柔化：减少像素锯齿，保留线条韵律
    img = img.filter(ImageFilter.SMOOTH_MORE)

    # 暗角压边，让视觉中心收紧
    vignette = Image.new("RGBA", (w, h), (0, 0, 0, 0))
    vdraw = ImageDraw.Draw(vignette)
    margin = min(w, h) // 2
    for i in range(margin, 0, -10):
        alpha_v = int(45 * (i / margin))
        vdraw.ellipse([w // 2 - i, h // 2 - i, w // 2 + i, h // 2 + i], outline=(0, 0, 0, alpha_v))
    img = Image.alpha_composite(img, vignette)

    output_dir.mkdir(parents=True, exist_ok=True)
    safe_name = preset.get("英文名", "flow")
    png_path = output_dir / f"{safe_name}_seed{seed}.png"
    img.convert("RGB").save(png_path, "PNG")

    meta = {
        "DNA": generate_dna(f"flow-field-{safe_name}"),
        "预设": preset,
        "种子": seed,
        "输出": str(png_path),
        "粒子数": len(particles),
        "总步数": sum(len(p.path) for p in particles),
    }
    json_path = output_dir / f"{safe_name}_seed{seed}.json"
    with open(json_path, "w", encoding="utf-8") as f:
        json.dump(meta, f, ensure_ascii=False, indent=2)

    return png_path
