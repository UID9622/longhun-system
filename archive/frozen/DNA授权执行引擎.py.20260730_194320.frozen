    # ── 64卦数据库 / 64 Hexagrams Database ──
    六十四卦: Dict[int, Dict[str, str]] = {
        1: {"卦名": "乾为天", "卦象": "☰☰", "含义": "天行健，君子以自强不息", "属性": "纯阳"},
