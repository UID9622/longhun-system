        3: {"卦名": "水雷屯", "卦象": "☵☳", "含义": "云雷屯，君子以经纶", "属性": "起始艰难"},
        4: {"卦名": "山水蒙", "卦象": "☶☵", "含义": "山下出泉蒙，君子以果行育德", "属性": "启蒙"},
        5: {"卦名": "水天需", "卦象": "☵☰", "含义": "云上于天需，君子以饮食宴乐", "属性": "等待时机"},
        6: {"卦名": "天水讼", "卦象": "☰☵", "含义": "天与水违行讼，君子以作事谋始", "属性": "争讼"},
        7: {"卦名": "地水师", "卦象": "☷☵", "含义": "地中有水师，君子以容民畜众", "属性": "行师用兵"},
        8: {"卦名": "水地比", "卦象": "☵☷", "含义": "地上有水比，先王以建万国亲诸侯", "属性": "亲比"},
        9: {"卦名": "风天小畜", "卦象": "☴☰", "含义": "风行天上小畜，君子以懿文德", "属性": "小有积蓄"},
        10: {"卦名": "天泽履", "卦象": "☰☱", "含义": "上天下泽履，君子以辨上下定民志", "属性": "谨慎践履"},
