"""
预设加载与规则校验。
DNA: #龍芯⚡️2026-06-24-UID9622-FLOW-FIELD-PRESETS-MODULE-v1.0
"""

import json
from pathlib import Path
from typing import Any, Dict, List

from . import project_root


def load_presets() -> Dict[str, Any]:
    path = project_root() / "config" / "presets.json"
    with open(path, "r", encoding="utf-8") as f:
        return json.load(f)


def list_presets() -> List[str]:
    return list(load_presets()["预设"].keys())


def get_preset(name: str) -> Dict[str, Any]:
    presets = load_presets()
    if name not in presets["预设"]:
        raise ValueError(f"未知预设：{name}。可用预设：{', '.join(list_presets())}")
    return presets["预设"][name]


def validate_preset(name: str, cfg: Dict[str, Any]) -> List[str]:
    """校验预设是否符合规矩。"""
    errors = []
    required = ["五行", "卦象", "场函数", "宽度", "高度", "粒子数", "步数", "步长", "色彩谱", "背景色", "规矩"]
    for key in required:
        if key not in cfg:
            errors.append(f"预设 {name} 缺少字段：{key}")
    if not isinstance(cfg.get("色彩谱"), list) or len(cfg["色彩谱"]) < 2:
        errors.append(f"预设 {name} 色彩谱必须至少包含 2 种颜色")
    if not isinstance(cfg.get("背景色"), list) or len(cfg["背景色"]) != 3:
        errors.append(f"预设 {name} 背景色必须是 RGB 三元组")
    return errors
