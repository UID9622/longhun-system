# -*- coding: utf-8 -*-
"""#龍芯⚡️2026-06-29-SECOND-BRAIN-API-v1.0
FastAPI 本地后台
"""
import os
from fastapi import FastAPI
from pydantic import BaseModel
from typing import List, Dict, Optional, Any

from . import config
from .indexer import SecondBrainIndex
from .sync import SecondBrainSync

app = FastAPI(title="龍魂第二大脑 API", version="1.0")
index = SecondBrainIndex(skip_embeddings=os.environ.get("SECOND_BRAIN_SKIP_EMBED") == "1")


class QueryRequest(BaseModel):
    q: str
    top_k: int = 5


class CNSHResponse(BaseModel):
    M: Dict[str, Any]
    CNSH: Dict[str, Any]


def _wrap(data: Dict[str, Any], dna: str = "") -> Dict[str, Any]:
    return {
        "M::": {
            "type": "second_brain_response",
            "status": "pass",
            "payload": data,
        },
        "CNSH::": {
            "dna": dna or f"{config.DNA_PREFIX}{config.now_iso().replace('-','').replace(':','').replace('T','')}-SECOND-BRAIN-API",
            "gate": "#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z",
            "seal": "#ZHUGEXIN⚡️2025-🇨🇳🐉⚖️♠️🧚🏼‍♀️❤️♾️-DEVICE-BIND-SOUL",
            "audit": "🟢",
            "policy": "pass",
        },
    }


@app.get("/health")
def health():
    stats = index.stats()
    return _wrap({"status": "ok", "stats": stats})


@app.post("/query")
def query(req: QueryRequest):
    results = index.search(req.q, top_k=req.top_k)
    return _wrap({"query": req.q, "results": results})


@app.get("/note/{note_id}")
def get_note(note_id: str):
    note = index.get_note(note_id)
    if note is None:
        return _wrap({"error": "not found"})
    links = index.graph(note_id)
    return _wrap({"note": note, "links": links})


@app.get("/graph/{note_id}")
def graph(note_id: str):
    links = index.graph(note_id)
    return _wrap({"note_id": note_id, "links": links})


@app.post("/sync")
def sync():
    syncer = SecondBrainSync()
    result = syncer.run()
    return _wrap(result, dna=result["dna"])


@app.get("/stats")
def stats():
    return _wrap(index.stats())
