#!/bin/bash
# -*- coding: utf-8 -*-
# DNA追溯码: #龍芯⚡️2026-06-23-184259-header-UID9622-075B68AC
# 创建者: UID9622
# 版本: 1.0.0
# 状态: 🟢 已规范

###############################################
# 龙魂人格军团·总调度指挥官
###############################################
#
# DNA追溯码：#ZHUGEXIN⚡️-2026-02-15-commander-v1.0
# 创建者：宝宝｜UID9622
# 创建时间：北京时间 2026-02-15 02:00:00
#
# 大白话：这个脚本是"指挥官"。
# 它根据配置调度其他五个人格脚本，
# 监控执行状态，生成报告，记录日志。
#
# 确认码：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z
#
###############################################

set -e

# =====================================================
# 初始化和配置加载
# =====================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_FILE="${SCRIPT_DIR}/config.sh"
LIB_FILE="${SCRIPT_DIR}/lib.sh"

# 检查配置文件
if [ ! -f "$CONFIG_FILE" ]; then
    echo "❌ 错误：找不到配置文件: $CONFIG_FILE"
    echo "请确保 config.sh 在同一目录下"
    exit 1
fi

# 检查函数库
if [ ! -f "$LIB_FILE" ]; then
    echo "❌ 错误：找不到函数库: $LIB_FILE"
    echo "请确保 lib.sh 在同一目录下"
    exit 1
fi

# 加载配置和函数库
source "$CONFIG_FILE"
source "$LIB_FILE"

# =====================================================
# 全局变量
# =====================================================

COMMANDER_START_TIME=$(date +%s)
EXECUTION_ID=$(date "+%Y%m%d_%H%M%S")
LOG_FILE="${LOGS_DIR}/commander_${EXECUTION_ID}.log"
REPORT_FILE="${REPORTS_DIR}/commander_汇总报告_${EXECUTION_ID}.md"
COMMANDER_DNA_CODE=$(generate_dna_code "总调度")

# 统计变量
SCRIPTS_EXECUTED=0
SCRIPTS_SUCCESS=0
SCRIPTS_FAILED=0
declare -a SCRIPT_RESULTS

# 创建日志目录
mkdir -p "$LOGS_DIR" "$REPORTS_DIR" "$TEMP_DIR"

# =====================================================
# 帮助信息
# =====================================================

show_help() {
    cat << EOF

🐉 龍魂人格军团 - 总调度指挥官 v1.0

用法：
    commander.sh [选项] [参数]

选项：
    --wenwen                 只执行雯雯·技术整理师
    --eye                    只执行上帝之眼·守护者
    --baobao /path/to/project   执行宝宝·构建师（需指定项目目录）
    --scout                  只执行侦察兵·信息猎手
    --wenxin                 只执行文心·同步专家
    --all                    执行所有已启用的脚本（默认行为）
    --help                   显示此帮助信息

示例：
    commander.sh                           # 执行所有已启用脚本
    commander.sh --wenwen                  # 只执行雯雯
    commander.sh --baobao ~/my-project     # 执行宝宝，指定项目目录
    commander.sh --wenwen --scout          # 执行雯雯和侦察兵

配置文件：
    编辑 config.sh 可以启用/禁用各个人格脚本

日志位置：
    ${LOGS_DIR}/commander_*.log

报告位置：
    ${REPORTS_DIR}/commander_汇总报告_*.md

EOF
}

# =====================================================
# 初始化报告
# =====================================================

init_report() {
    log_info "初始化报告..."

    generate_report_header "$REPORT_FILE" "总调度执行报告" "$COMMANDER_DNA_CODE"

    cat >> "$REPORT_FILE" << EOF

---

## 📋 执行概览

- **执行时间**：$(generate_timestamp)
- **执行ID**：${EXECUTION_ID}
- **DNA追溯码**：${COMMANDER_DNA_CODE}
- **日志文件**：logs/commander_${EXECUTION_ID}.log

---

## 🚀 执行计划

EOF

    # 列出将要执行的脚本
    if [ "$MODE" = "all" ]; then
        cat >> "$REPORT_FILE" << EOF
### 模式：全量执行

EOF
        [ "$ENABLE_WENWEN" = "1" ] && echo "- ✅ 雯雯·技术整理师 (已启用)" >> "$REPORT_FILE"
        [ "$ENABLE_EYE" = "1" ] && echo "- ✅ 上帝之眼·守护者 (已启用)" >> "$REPORT_FILE"
        [ "$ENABLE_BAOBAO" = "1" ] && echo "- ✅ 宝宝·构建师 (已启用)" >> "$REPORT_FILE"
        [ "$ENABLE_SCOUT" = "1" ] && echo "- ✅ 侦察兵·信息猎手 (已启用)" >> "$REPORT_FILE"
        [ "$ENABLE_WENXIN" = "1" ] && echo "- ✅ 文心·同步专家 (已启用)" >> "$REPORT_FILE"
    else
        cat >> "$REPORT_FILE" << EOF
### 模式：选择性执行

EOF
        [ -n "$SELECTED_SCRIPTS" ] && echo "$SELECTED_SCRIPTS" >> "$REPORT_FILE"
    fi

    cat >> "$REPORT_FILE" << EOF

---

## 📊 执行结果

EOF

    log_success "报告初始化完成"
}

# =====================================================
# 磁盘检查
# =====================================================

check_disk_space() {
    log_info "===== 开始磁盘检查 ====="

    local disk_usage=$(get_disk_usage "$HOME")
    local available_gb=$(get_disk_available_gb "$HOME")

    log_info "磁盘使用率：${disk_usage}%"
    log_info "可用空间：${available_gb} GB"

    # 检查backups目录大小
    if [ -d "$BACKUPS_DIR" ]; then
        local backup_size=$(get_directory_size_mb "$BACKUPS_DIR")
        log_info "备份目录大小：${backup_size} MB"

        if [ "$AUTO_CLEANUP_BACKUPS" = "1" ]; then
            log_info "自动清理旧备份..."
            cleanup_old_backups "$BACKUPS_DIR" "$BACKUP_RETAIN_COUNT"
        fi
    fi

    # 发出警告
    if [ "$disk_usage" -gt "$DISK_ERROR_THRESHOLD" ]; then
        log_error "❌ 磁盘使用率危险！超过 ${DISK_ERROR_THRESHOLD}%"
        log_error "请立即清理磁盘或执行备份清理"
        return 1
    elif [ "$disk_usage" -gt "$DISK_WARNING_THRESHOLD" ]; then
        log_warn "⚠️ 磁盘使用率较高，已达到 ${disk_usage}%"
    else
        log_success "✅ 磁盘空间充足"
    fi

    log_info "===== 磁盘检查完成 ====="
    return 0
}

# =====================================================
# 脚本执行
# =====================================================

execute_script() {
    local script_path="$1"
    local script_name="$2"
    local script_args="${3:-}"

    log_info "===== 准备执行: ${script_name} ====="

    if [ ! -f "$script_path" ]; then
        log_error "❌ 脚本不存在: $script_path"
        SCRIPT_RESULTS+=("${script_name}:失败:脚本不存在")
        ((SCRIPTS_FAILED++))
        return 1
    fi

    if [ ! -x "$script_path" ]; then
        log_warn "脚本无执行权限，添加权限..."
        chmod +x "$script_path"
    fi

    ((SCRIPTS_EXECUTED++))

    local start_time=$(generate_timestamp)
    log_info "开始时间：${start_time}"

    if [ -n "$script_args" ]; then
        run_script_with_args "$script_path" $script_args
    else
        run_script "$script_path"
    fi

    local exit_code=$?
    local end_time=$(generate_timestamp)

    log_info "结束时间：${end_time}"

    if [ $exit_code -eq 0 ]; then
        log_success "✅ ${script_name} 执行成功"
        SCRIPT_RESULTS+=("${script_name}:成功")
        ((SCRIPTS_SUCCESS++))
    else
        log_error "❌ ${script_name} 执行失败 (返回码: $exit_code)"
        SCRIPT_RESULTS+=("${script_name}:失败:返回码 $exit_code")
        ((SCRIPTS_FAILED++))
    fi

    log_info "===== ${script_name} 执行结束 ====="
    return $exit_code
}

# =====================================================
# 生成最终报告
# =====================================================

generate_final_report() {
    log_info "===== 生成最终报告 ====="

    local end_time=$(generate_timestamp)
    local total_time=$(($(date +%s) - COMMANDER_START_TIME))
    local minutes=$((total_time / 60))
    local seconds=$((total_time % 60))

    cat >> "$REPORT_FILE" << EOF

### 执行统计

| 指标 | 数值 |
|------|------|
| 总共执行脚本数 | $SCRIPTS_EXECUTED |
| 成功 | $SCRIPTS_SUCCESS ✅ |
| 失败 | $SCRIPTS_FAILED ❌ |
| 执行耗时 | ${minutes}分${seconds}秒 |

---

## 📝 详细结果

EOF

    for result in "${SCRIPT_RESULTS[@]}"; do
        local IFS=":"
        read -r name status detail <<< "$result"

        if [ "$status" = "成功" ]; then
            echo "### ✅ ${name}" >> "$REPORT_FILE"
            echo "- **状态**：执行成功" >> "$REPORT_FILE"
        else
            echo "### ❌ ${name}" >> "$REPORT_FILE"
            echo "- **状态**：执行失败" >> "$REPORT_FILE"
            [ -n "$detail" ] && echo "- **原因**：$detail" >> "$REPORT_FILE"
        fi
        echo "" >> "$REPORT_FILE"
    done

    # 添加日志链接
    cat >> "$REPORT_FILE" << EOF

## 📋 日志和记录

- **日志文件**：[logs/commander_${EXECUTION_ID}.log](logs/commander_${EXECUTION_ID}.log)
- **报告生成时间**：${end_time}
- **执行ID**：${EXECUTION_ID}

---

## 🔒 验证信息

EOF

    generate_report_footer "$REPORT_FILE"

    log_success "✅ 最终报告生成完成"
    log_info "报告位置：$REPORT_FILE"
}

# =====================================================
# 显示执行摘要
# =====================================================

show_summary() {
    log_info ""
    log_info "╔════════════════════════════════════════╗"
    log_info "║    🐉 龍魂人格军团 - 执行完成          ║"
    log_info "╚════════════════════════════════════════╝"
    log_info ""
    log_info "📊 执行统计："
    log_info "   • 总共执行脚本：$SCRIPTS_EXECUTED"
    log_info "   • 成功：$SCRIPTS_SUCCESS ✅"
    log_info "   • 失败：$SCRIPTS_FAILED ❌"
    log_info ""
    log_info "📋 日志位置："
    log_info "   • ${LOG_FILE}"
    log_info ""
    log_info "📄 报告位置："
    log_info "   • ${REPORT_FILE}"
    log_info ""
    log_info "🔒 DNA追溯码："
    log_info "   • ${COMMANDER_DNA_CODE}"
    log_info ""
}

# =====================================================
# 主执行流程
# =====================================================

main() {
    local MODE="all"
    local SELECTED_SCRIPTS=""
    local BAOBAO_PROJECT_DIR=""

    # 解析命令行参数
    while [ $# -gt 0 ]; do
        case "$1" in
            --wenwen)
                MODE="single"
                SELECTED_SCRIPTS="${SELECTED_SCRIPTS}
- ✅ 雯雯·技术整理师"
                shift
                ;;
            --eye)
                MODE="single"
                SELECTED_SCRIPTS="${SELECTED_SCRIPTS}
- ✅ 上帝之眼·守护者"
                shift
                ;;
            --baobao)
                MODE="single"
                if [ -z "$2" ]; then
                    log_error "❌ --baobao 需要指定项目目录"
                    show_help
                    exit 1
                fi
                BAOBAO_PROJECT_DIR="$2"
                SELECTED_SCRIPTS="${SELECTED_SCRIPTS}
- ✅ 宝宝·构建师 (项目: $BAOBAO_PROJECT_DIR)"
                shift 2
                ;;
            --scout)
                MODE="single"
                SELECTED_SCRIPTS="${SELECTED_SCRIPTS}
- ✅ 侦察兵·信息猎手"
                shift
                ;;
            --wenxin)
                MODE="single"
                SELECTED_SCRIPTS="${SELECTED_SCRIPTS}
- ✅ 文心·同步专家"
                shift
                ;;
            --all)
                MODE="all"
                shift
                ;;
            --help)
                show_help
                exit 0
                ;;
            *)
                log_error "❌ 未知选项: $1"
                show_help
                exit 1
                ;;
        esac
    done

    # 输出标题
    log_info ""
    log_info "╔════════════════════════════════════════╗"
    log_info "║  🐉 龍魂人格军团 - 总调度指挥官 v1.0   ║"
    log_info "╚════════════════════════════════════════╝"
    log_info ""
    log_info "执行ID：${EXECUTION_ID}"
    log_info "DNA追溯码：${COMMANDER_DNA_CODE}"
    log_info ""

    # 初始化报告
    init_report

    # 磁盘检查（即使失败也继续）
    check_disk_space || log_warn "磁盘检查警告，继续执行..."

    log_info ""
    log_info "===== 开始执行人格脚本 ====="
    log_info ""

    # 根据模式执行脚本
    if [ "$MODE" = "all" ]; then
        # 全量执行
        [ "$ENABLE_WENWEN" = "1" ] && execute_script "$WENWEN_SCRIPT" "雯雯·技术整理师"
        [ "$ENABLE_EYE" = "1" ] && execute_script "$EYE_SCRIPT" "上帝之眼·守护者"
        [ "$ENABLE_BAOBAO" = "1" ] && execute_script "$BAOBAO_SCRIPT" "宝宝·构建师"
        [ "$ENABLE_SCOUT" = "1" ] && execute_script "$SCOUT_SCRIPT" "侦察兵·信息猎手"
        [ "$ENABLE_WENXIN" = "1" ] && execute_script "$WENXIN_SCRIPT" "文心·同步专家"
    else
        # 选择性执行
        [[ "$SELECTED_SCRIPTS" == *"雯雯"* ]] && execute_script "$WENWEN_SCRIPT" "雯雯·技术整理师"
        [[ "$SELECTED_SCRIPTS" == *"上帝之眼"* ]] && execute_script "$EYE_SCRIPT" "上帝之眼·守护者"
        [[ "$SELECTED_SCRIPTS" == *"宝宝"* ]] && execute_script "$BAOBAO_SCRIPT" "宝宝·构建师" "$BAOBAO_PROJECT_DIR"
        [[ "$SELECTED_SCRIPTS" == *"侦察兵"* ]] && execute_script "$SCOUT_SCRIPT" "侦察兵·信息猎手"
        [[ "$SELECTED_SCRIPTS" == *"文心"* ]] && execute_script "$WENXIN_SCRIPT" "文心·同步专家"
    fi

    log_info ""
    log_info "===== 人格脚本执行完毕 ====="
    log_info ""

    # 生成最终报告
    generate_final_report

    # 显示摘要
    if [ "$SHOW_SUMMARY" = "1" ]; then
        show_summary
    fi

    # 确定退出码
    if [ $SCRIPTS_FAILED -eq 0 ]; then
        log_success "✅ 所有脚本执行成功！"
        exit 0
    else
        log_error "❌ 有 $SCRIPTS_FAILED 个脚本执行失败"
        exit 1
    fi
}

# =====================================================
# 执行主程序
# =====================================================

main "$@"

