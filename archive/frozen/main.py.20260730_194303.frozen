#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龙魂数据导出工具
根据《个人信息保护法》第四十五条：
个人有权向个人信息处理者查阅、复制其个人信息

DNA追溯码：#龙芯⚡️2026-02-09-DATA-EXPORTER-v1.0
作者：诸葛鑫（Lucky）｜UID9622
"""

import requests
import json
import csv
from datetime import datetime
from typing import Dict, List, Any, Optional
import argparse
import sys


class DataExporter:
    """数据导出器"""

    def __init__(self, platform_url: str):
        """
        初始化数据导出器

        参数:
            platform_url: 平台基础URL
        """
        self.platform_url = platform_url.rstrip('/')
        self.export_data = {
            'basic_info': {},
            'behavior_data': [],
            'consumption_data': [],
            'social_data': []
        }

    def request_data_export(self, user_token: str, timeout: int = 30) -> Dict[str, Any]:
        """
        请求数据导出

        根据法律，平台必须提供数据导出功能
        如果平台不提供，可以投诉

        参数:
            user_token: 用户认证token
            timeout: 请求超时时间（秒）

        返回:
            导出的数据
        """
        headers = {'Authorization': f'Bearer {user_token}'}

        # 导出基础信息
        try:
            basic_url = f"{self.platform_url}/api/user/basic"
            basic_resp = requests.get(basic_url, headers=headers, timeout=timeout)
            basic_resp.raise_for_status()
            self.export_data['basic_info'] = basic_resp.json()
            print(f"✅ 基础信息导出成功")
        except Exception as e:
            print(f"⚠️ 基础信息导出失败: {e}")

        # 导出行为数据
        try:
            behavior_url = f"{self.platform_url}/api/user/behavior"
            behavior_resp = requests.get(behavior_url, headers=headers, timeout=timeout)
            behavior_resp.raise_for_status()
            self.export_data['behavior_data'] = behavior_resp.json()
            print(f"✅ 行为数据导出成功 ({len(self.export_data['behavior_data'])}条)")
        except Exception as e:
            print(f"⚠️ 行为数据导出失败: {e}")

        # 导出消费数据
        try:
            consumption_url = f"{self.platform_url}/api/user/consumption"
            consumption_resp = requests.get(consumption_url, headers=headers, timeout=timeout)
            consumption_resp.raise_for_status()
            self.export_data['consumption_data'] = consumption_resp.json()
            print(f"✅ 消费数据导出成功 ({len(self.export_data['consumption_data'])}条)")
        except Exception as e:
            print(f"⚠️ 消费数据导出失败: {e}")

        # 导出社交数据
        try:
            social_url = f"{self.platform_url}/api/user/social"
            social_resp = requests.get(social_url, headers=headers, timeout=timeout)
            social_resp.raise_for_status()
            self.export_data['social_data'] = social_resp.json()
            print(f"✅ 社交数据导出成功 ({len(self.export_data['social_data'])}条)")
        except Exception as e:
            print(f"⚠️ 社交数据导出失败: {e}")

        return self.export_data

    def analyze_data_value(self) -> Dict[str, Any]:
        """
        分析数据价值

        基于公开的数据交易价格估算
        这不是精确值，仅用于参考

        返回:
            数据价值分析结果
        """
        # 数据价格参考（公开数据交易市场）
        PRICE_BASIC = 1.30  # 姓名+手机+身份证 ≈ ¥1.30
        PRICE_BEHAVIOR = 0.001  # 每条行为数据 ≈ ¥0.001
        PRICE_CONSUMPTION = 0.05  # 每条消费数据 ≈ ¥0.05
        PRICE_SOCIAL = 0.02  # 每条社交数据 ≈ ¥0.02

        # 计算价值
        basic_value = PRICE_BASIC if self.export_data['basic_info'] else 0
        behavior_count = len(self.export_data['behavior_data'])
        behavior_value = behavior_count * PRICE_BEHAVIOR
        consumption_count = len(self.export_data['consumption_data'])
        consumption_value = consumption_count * PRICE_CONSUMPTION
        social_count = len(self.export_data['social_data'])
        social_value = social_count * PRICE_SOCIAL

        total_value = basic_value + behavior_value + consumption_value + social_value

        return {
            'total_value': total_value,
            'basic_value': basic_value,
            'behavior_value': behavior_value,
            'consumption_value': consumption_value,
            'social_value': social_value,
            'behavior_count': behavior_count,
            'consumption_count': consumption_count,
            'social_count': social_count,
            'currency': 'CNY',
            'note': '数据价值为公开市场估算，仅供参考'
        }

    def export_to_csv(self, filename: str) -> str:
        """
        导出数据到CSV文件

        参数:
            filename: 输出文件名（不含扩展名）

        返回:
            输出文件路径
        """
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        output_file = f"{filename}_{timestamp}.csv"

        with open(output_file, 'w', newline='', encoding='utf-8') as f:
            writer = csv.writer(f)
            writer.writerow(['数据类型', '数据内容', '收集时间', '估值'])

            # 写入基础信息
            for key, value in self.export_data['basic_info'].items():
                writer.writerow(['基础信息', f"{key}: {value}", '-', '¥1.30'])

            # 写入行为数据
            for item in self.export_data['behavior_data']:
                writer.writerow([
                    '行为数据',
                    json.dumps(item, ensure_ascii=False),
                    item.get('timestamp', '-'),
                    '¥0.001'
                ])

            # 写入消费数据
            for item in self.export_data['consumption_data']:
                writer.writerow([
                    '消费数据',
                    json.dumps(item, ensure_ascii=False),
                    item.get('timestamp', '-'),
                    '¥0.05'
                ])

            # 写入社交数据
            for item in self.export_data['social_data']:
                writer.writerow([
                    '社交数据',
                    json.dumps(item, ensure_ascii=False),
                    item.get('timestamp', '-'),
                    '¥0.02'
                ])

        print(f"✅ 数据已导出到：{output_file}")
        return output_file

    def export_to_json(self, filename: str) -> str:
        """
        导出数据到JSON文件

        参数:
            filename: 输出文件名（不含扩展名）

        返回:
            输出文件路径
        """
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        output_file = f"{filename}_{timestamp}.json"

        with open(output_file, 'w', encoding='utf-8') as f:
            json.dump(self.export_data, f, ensure_ascii=False, indent=2)

        print(f"✅ 数据已导出到：{output_file}")
        return output_file

    def generate_report(self) -> str:
        """
        生成数据价值报告

        返回:
            报告文本
        """
        value = self.analyze_data_value()

        report = f"""
{'='*70}
🐉 龙魂数据导出报告
{'='*70}

平台：{self.platform_url}
导出时间：{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}

📊 数据统计
{'-'*70}
基础信息：{'✅' if self.export_data['basic_info'] else '❌'}
行为数据：{value['behavior_count']} 条
消费数据：{value['consumption_count']} 条
社交数据：{value['social_count']} 条

💰 数据价值分析
{'-'*70}
基础信息：¥{value['basic_value']:.2f}
行为数据：¥{value['behavior_value']:.2f} ({value['behavior_count']}条 × ¥0.001)
消费数据：¥{value['consumption_value']:.2f} ({value['consumption_count']}条 × ¥0.05)
社交数据：¥{value['social_value']:.2f} ({value['social_count']}条 × ¥0.02)
────────────────────────────────────────────────
总计：¥{value['total_value']:.2f}

⚠️  提示
{'-'*70}
1. 数据价值为公开市场估算，仅供参考
2. 如果平台拒绝提供数据导出，你可以：
   - 向12315投诉
   - 向网信办举报
   - 发送律师函
   - 提起诉讼

📜 法律依据
{'-'*70}
《中华人民共和国个人信息保护法》第四十五条：
"个人有权向个人信息处理者查阅、复制其个人信息"

🧬 DNA追溯码
#龙芯⚡️2026-02-09-DATA-EXPORTER-v1.0
确认码：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z

{'='*70}
"""
        return report


def main():
    """主函数"""
    parser = argparse.ArgumentParser(
        description='龙魂数据导出工具 - 导出你的数据，查看平台收集了什么',
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
示例：
  python main.py --platform https://example.com --token YOUR_TOKEN
  python main.py --platform https://example.com --token YOUR_TOKEN --format json
  python main.py --platform https://example.com --token YOUR_TOKEN --output my_data
        """
    )

    parser.add_argument('--platform', '-p', required=True,
                        help='平台基础URL (如: https://example.com)')
    parser.add_argument('--token', '-t', required=True,
                        help='用户认证token')
    parser.add_argument('--format', '-f', choices=['csv', 'json'], default='csv',
                        help='输出格式 (默认: csv)')
    parser.add_argument('--output', '-o', default='data_export',
                        help='输出文件名 (不含扩展名)')
    parser.add_argument('--timeout', type=int, default=30,
                        help='请求超时时间（秒，默认: 30）')

    args = parser.parse_args()

    # 创建导出器
    print("\n" + "="*70)
    print("🐉 龙魂数据导出工具")
    print("="*70)
    print(f"\n平台：{args.platform}")
    print(f"输出格式：{args.format}")
    print(f"输出文件：{args.output}")
    print()

    exporter = DataExporter(args.platform)

    # 请求数据导出
    print("📥 正在请求数据导出...")
    print("-"*70)
    try:
        data = exporter.request_data_export(args.token, args.timeout)
    except KeyboardInterrupt:
        print("\n\n⚠️ 用户中断")
        sys.exit(0)
    except Exception as e:
        print(f"\n\n❌ 导出失败: {e}")
        print("\n💡 可能的原因：")
        print("1. 平台URL错误")
        print("2. Token无效或已过期")
        print("3. 平台不提供数据导出API")
        print("4. 网络连接问题")
        print("\n📜 法律依据：")
        print("《个人信息保护法》第四十五条 - 个人有权查阅、复制自己的个人信息")
        sys.exit(1)

    # 生成报告
    print()
    print("📊 生成报告...")
    print("-"*70)
    report = exporter.generate_report()
    print(report)

    # 导出文件
    print(f"📥 导出为{args.format}格式...")
    print("-"*70)
    try:
        if args.format == 'csv':
            exporter.export_to_csv(args.output)
        else:
            exporter.export_to_json(args.output)
    except Exception as e:
        print(f"\n❌ 导出失败: {e}")
        sys.exit(1)

    print()
    print("="*70)
    print("✅ 数据导出完成！")
    print("="*70)
    print()


if __name__ == "__main__":
    main()
