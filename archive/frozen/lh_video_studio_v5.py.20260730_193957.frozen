#!/usr/bin/env python3
"""
龍魂·视频工坊 v5.0 — AI画面 + 云端TTS + 专业合成
DNA: #龍芯⚡️丙午·乙巳·癸酉·亥时·☰乾-VIDEO-STUDIO-V5.0-AI-IMAGES-ed8f2a1c
创建者: 诸葛鑫（UID9622）
协议: CC BY-NC-SA 4.0

v5.0 改进:
- 支持 AI 生成画面素材（--image-dir）
- edge-tts 云端秒级配音（不再卡CPU）
- 场景自动分割 + 画面匹配
- 淡入淡出转场
- 字幕叠加 + 龍魂签章
"""

import os, sys, json, re, shutil, subprocess, tempfile, argparse, hashlib
from pathlib import Path
from datetime import datetime

# ─── 项目根 ───
PROJECT_ROOT = Path(__file__).resolve().parent.parent
OUTPUT_DIR = PROJECT_ROOT / "output"
TEMP_DIR = OUTPUT_DIR / "_temp"
os.makedirs(TEMP_DIR, exist_ok=True)


# ══════════════════════════════════════════════════════════════════════
# 配置
# ══════════════════════════════════════════════════════════════════════

VIDEO_CONFIG = {
    "width": 1920,
    "height": 1080,
    "fps": 30,
    "bg_color": (10, 10, 20),  # 接近黑色暗蓝底
    "subtitle": {
        "font_size": 52,
        "font_color": "white",
        "stroke_width": 3,
        "stroke_color": "black",
        "position": ("center", 0.82),
        "max_chars_per_line": 22,
    },
    "title": {
        "font_size": 72,
        "font_color": "#FFD700",  # 金色
        "stroke_width": 4,
        "stroke_color": "black",
    },
    "transition_duration": 0.3,  # 转场秒数
    "seal": {
        "size": 100,
        "position": ("right", "bottom"),
        "margin": 30,
    },
}


# ══════════════════════════════════════════════════════════════════════
# 1. 脚本解析 — 按段落分场景
# ══════════════════════════════════════════════════════════════════════

def parse_script_md(filepath: str) -> list:
    """
    解析 Markdown 脚本，返回场景列表。
    每个空行/分隔符 `---` 分割一个场景。
    首行标题作为开篇。
    """
    with open(filepath, "r", encoding="utf-8") as f:
        text = f.read()

    # 按 --- 分割大段
    blocks = re.split(r"\n---\n", text)

    scenes = []
    for block in blocks:
        block = block.strip()
        if not block:
            continue

        # 去掉 Markdown 标记
        cleaned = re.sub(r"^#{1,4}\s+", "", block, flags=re.MULTILINE)
        cleaned = re.sub(r"\*\*(.+?)\*\*", r"\1", cleaned)
        cleaned = cleaned.strip()

        if not cleaned:
            continue

        # 按自然段（双换行）拆句子
        paragraphs = [p.strip() for p in cleaned.split("\n\n") if p.strip()]
        sentences = []
        for p in paragraphs:
            # 按句号/感叹号/问号拆，保留标点
            parts = re.split(r"(?<=[。！？……])", p)
            for part in parts:
                part = part.strip()
                if part and len(part) > 2:
                    sentences.append(part)

        if sentences:
            scenes.append({
                "title": sentences[0] if sentences else "",
                "text": "\n".join(sentences),
                "sentences": sentences,
            })

    return scenes


# ══════════════════════════════════════════════════════════════════════
# 2. 场景→画面匹配
# ══════════════════════════════════════════════════════════════════════

def match_images_to_scenes(scenes: list, image_dir: str) -> list:
    """把图片按顺序匹配到场景，不足的用渐变替代"""
    img_files = sorted([
        f for f in os.listdir(image_dir)
        if f.lower().endswith((".png", ".jpg", ".jpeg", ".webp"))
    ])

    for i, scene in enumerate(scenes):
        if i < len(img_files):
            scene["image"] = os.path.join(image_dir, img_files[i])
        else:
            scene["image"] = None  # fallback to gradient

    return scenes


# ══════════════════════════════════════════════════════════════════════
# 3. TTS — edge-tts 云端配音
# ══════════════════════════════════════════════════════════════════════

async def tts_edge(text: str, output_mp3: str, voice: str = "zh-CN-YunxiNeural"):
    """使用 edge-tts 生成配音"""
    try:
        import edge_tts
    except ImportError:
        print("⚠ edge-tts 未安装，尝试 pip install edge-tts ...")
        subprocess.check_call([sys.executable, "-m", "pip", "install", "edge-tts", "-q"])
        import edge_tts

    communicate = edge_tts.Communicate(text, voice)
    await communicate.save(output_mp3)
    return output_mp3


def generate_audio(scenes: list, voice: str, audio_dir: str) -> list:
    """为每个场景生成配音"""
    import asyncio

    os.makedirs(audio_dir, exist_ok=True)

    async def gen_all():
        tasks = []
        for i, scene in enumerate(scenes):
            text = scene.get("text", "")
            if not text:
                continue
            mp3_path = os.path.join(audio_dir, f"scene_{i:02d}.mp3")
            tasks.append((i, text, mp3_path))

        results = []
        for i, text, mp3_path in tasks:
            print(f"  🔊 配音场景 {i+1}/{len(scenes)} ... ({len(text)} 字)")
            try:
                await tts_edge(text, mp3_path, voice)
                results.append((i, mp3_path))
            except Exception as e:
                print(f"  ⚠ 场景 {i} TTS 失败: {e}")
                results.append((i, None))
        return results

    return asyncio.run(gen_all())


# ══════════════════════════════════════════════════════════════════════
# 4. 视频合成 — MoviePy
# ══════════════════════════════════════════════════════════════════════

def compose_video(scenes: list, audio_map: dict, output_path: str, seals: bool = True):
    """
    合成最终视频:
    1. 每场景 = 画面(图片/渐变) + 音频 + 字幕
    2. 场景间淡入淡出
    3. 開篇标题 + 结尾龍魂签章
    """
    try:
        from moviepy import (
            VideoFileClip, AudioFileClip, ImageClip, CompositeVideoClip,
            TextClip, concatenate_videoclips, vfx, ColorClip
        )
    except ImportError:
        print("⚠ moviepy 未安装，尝试安装...")
        subprocess.check_call([sys.executable, "-m", "pip", "install", "moviepy", "-q"])
        from moviepy import (
            VideoFileClip, AudioFileClip, ImageClip, CompositeVideoClip,
            TextClip, concatenate_videoclips, vfx, ColorClip
        )

    W, H = VIDEO_CONFIG["width"], VIDEO_CONFIG["height"]
    FPS = VIDEO_CONFIG["fps"]
    TRANS = VIDEO_CONFIG["transition_duration"]

    clips = []

    for i, scene in enumerate(scenes):
        audio_path = audio_map.get(i)
        sentences = scene.get("sentences", [])

        if not audio_path or not os.path.exists(audio_path):
            continue

        # ── 画面: 图片或渐变 ──
        img_path = scene.get("image")
        if img_path and os.path.exists(img_path):
            # 调整图片到 1920x1080（保持比例，填充）
            clip = ImageClip(img_path).resized(width=W, height=H)
        else:
            # 渐变背景
            clip = ColorClip(size=(W, H), color=VIDEO_CONFIG["bg_color"])

        # ── 音频 ──
        audio = AudioFileClip(audio_path)
        duration = audio.duration

        clip = clip.with_duration(duration + TRANS * 2)  # 额外留转场时间

        # ── 淡入淡出 ──
        clip = clip.with_effects([
            vfx.FadeIn(TRANS),
            vfx.FadeOut(TRANS),
        ])

        # ── 字幕 ──
        subtitle_clips = []
        # 把整个场景的文字作为字幕，逐句切换
        total_dur = duration
        if sentences and total_dur > 0:
            dur_per_sentence = total_dur / len(sentences)
            for j, sent in enumerate(sentences):
                # 分行（太长的句子自动折行）
                max_chars = VIDEO_CONFIG["subtitle"]["max_chars_per_line"]
                lines = []
                current = ""
                for ch in sent:
                    current += ch
                    if len(current) >= max_chars and ch in "，。！？、；：""''）":
                        lines.append(current)
                        current = ""
                    elif len(current) >= max_chars + 3:
                        lines.append(current)
                        current = ""
                if current:
                    lines.append(current)

                subtitle_text = "\n".join(lines)
                if not subtitle_text.strip():
                    continue

                try:
                    # macOS 中文字体路径 (pillow 需要完整路径)
                    font_name = "/System/Library/Fonts/Hiragino Sans GB.ttc"
                    txt = TextClip(
                        text=subtitle_text,
                        font_size=VIDEO_CONFIG["subtitle"]["font_size"],
                        color=VIDEO_CONFIG["subtitle"]["font_color"],
                        stroke_color=VIDEO_CONFIG["subtitle"]["stroke_color"],
                        stroke_width=VIDEO_CONFIG["subtitle"]["stroke_width"],
                        font=font_name,
                        size=(W - 200, None),
                        method="caption",
                    )
                    txt = txt.with_position(("center", int(H * 0.78)))
                    txt = txt.with_start(TRANS + j * dur_per_sentence)
                    txt = txt.with_duration(dur_per_sentence)
                    txt = txt.with_effects([vfx.FadeIn(0.15), vfx.FadeOut(0.15)])
                    subtitle_clips.append(txt)
                except Exception as e:
                    print(f"  ⚠ 字幕错误: {e} (场景{i}, 句{j})")

        # ── 拼合 ──
        layer_clips = [clip] + subtitle_clips
        composite = CompositeVideoClip(layer_clips, size=(W, H))
        composite = composite.with_duration(duration + TRANS * 2)

        clips.append(composite)
        print(f"  🎬 场景 {i+1}/{len(scenes)} — {duration:.1f}s — {len(sentences)} 句")

    if not clips:
        print("❌ 没有有效片段")
        return None

    # ── 全部拼接 ──
    final = concatenate_videoclips(clips, method="compose")

    # ── 龍魂签章水印 ──
    if seals:
        try:
            seal_txt = TextClip(
                text="龍",
                font_size=80,
                color="#FFD700",
                stroke_color="black",
                stroke_width=3,
                font="/System/Library/Fonts/Hiragino Sans GB.ttc",
            )
            seal_txt = seal_txt.with_position((W - 120, H - 110))
            seal_txt = seal_txt.with_duration(final.duration)
            seal_txt = seal_txt.with_opacity(0.35)

            dna_txt = TextClip(
                text="#龍芯⚡️UID9622",
                font_size=24,
                color="#888888",
                font="/System/Library/Fonts/Hiragino Sans GB.ttc",
            )
            dna_txt = dna_txt.with_position((24, H - 38))
            dna_txt = dna_txt.with_duration(final.duration)
            dna_txt = dna_txt.with_opacity(0.5)

            final = CompositeVideoClip([final, seal_txt, dna_txt], size=(W, H))
        except Exception as e:
            print(f"  ⚠ 签章叠加失败: {e}")

    # ── 输出 ──
    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    print(f"\n🎥 渲染中... (共 {len(clips)} 场景)")
    final.write_videofile(
        output_path,
        fps=FPS,
        codec="libx264",
        audio_codec="aac",
        preset="medium",
        threads=4,
    )
    final.close()
    return output_path


# ══════════════════════════════════════════════════════════════════════
# 主流程
# ══════════════════════════════════════════════════════════════════════

def main():
    parser = argparse.ArgumentParser(description="龍魂视频工坊 v5.0")
    parser.add_argument("--script", required=True, help="脚本 Markdown 文件")
    parser.add_argument("--image-dir", default=None, help="AI画面素材目录")
    parser.add_argument("--voice", default="zh-CN-YunxiNeural", help="TTS 语音 (edge-tts)")
    parser.add_argument("--name", default="video", help="输出视频名称")
    parser.add_argument("--no-seals", action="store_true", help="不加簽章")
    args = parser.parse_args()

    print("╔══════════════════════════════════════╗")
    print("║  龍魂·视频工坊 v5.0 — AI画面+云端TTS  ║")
    print("╚══════════════════════════════════════╝")
    print(f"  脚本: {args.script}")
    print(f"  画面: {args.image_dir or '(无，用渐变)'}")
    print(f"  配音: {args.voice}")
    print(f"  输出: {args.name}")
    print()

    # 1. 解析脚本
    print("📄 解析脚本...")
    scenes = parse_script_md(args.script)
    print(f"  → {len(scenes)} 个场景")

    # 2. 匹配画面
    if args.image_dir and os.path.isdir(args.image_dir):
        print("🖼 匹配画面...")
        scenes = match_images_to_scenes(scenes, args.image_dir)
        img_count = sum(1 for s in scenes if s.get("image"))
        print(f"  → {img_count}/{len(scenes)} 场景有画面")

    # 3. 生成配音
    print("🔊 生成配音...")
    audio_dir = os.path.join(TEMP_DIR, f"audio_{datetime.now().strftime('%H%M%S')}")
    results = generate_audio(scenes, args.voice, audio_dir)
    audio_map = {i: path for i, path in results if path}
    print(f"  → {len(audio_map)}/{len(scenes)} 配音完成")

    # 4. 合成视频
    print("🎬 合成视频...")
    output_path = OUTPUT_DIR / f"{args.name}_v5.mp4"
    result = compose_video(scenes, audio_map, str(output_path), seals=not args.no_seals)

    if result:
        # 5. 输出信息
        size_mb = os.path.getsize(result) / 1024 / 1024
        print(f"\n✅ 视频已生成: {result}")
        print(f"   大小: {size_mb:.1f} MB")

        # DNA 签章
        dna_hash = hashlib.sha256(open(result, "rb").read(4096)).hexdigest()[:8]
        print(f"   DNA: #龍芯⚡️{datetime.now().strftime('%Y%m%d')}-VIDEO-V5-{dna_hash}")

        # 创建 JSON 索引
        meta = {
            "name": args.name,
            "script": args.script,
            "output": str(result),
            "scenes": len(scenes),
            "images": args.image_dir,
            "voice": args.voice,
            "created": datetime.now().isoformat(),
            "dna": f"#龍芯⚡️{datetime.now().strftime('%Y%m%d')}-VIDEO-V5-{dna_hash}",
            "creator": "诸葛鑫（UID9622）",
            "protocol": "CC BY-NC-SA 4.0",
        }
        meta_path = str(output_path).replace(".mp4", ".json")
        with open(meta_path, "w", encoding="utf-8") as f:
            json.dump(meta, f, ensure_ascii=False, indent=2)
        print(f"   元数据: {meta_path}")

    else:
        print("❌ 合成失败")
        sys.exit(1)


if __name__ == "__main__":
    main()
