"""
大脑中枢自监控：看自己健不健康、定时任务在不在、报告新不新鲜。
DNA: #龍芯⚡️2026-06-24-UID9622-BRAIN-SELF-MONITOR-v1.0
"""

import shutil
import subprocess
from datetime import datetime, timezone, timedelta
from pathlib import Path
from typing import Any, Dict, List

from . import generate_dna, now_cn, get_target_root


class SelfMonitor:
    """监控大脑中枢自身的运行状态。"""

    def __init__(self):
        self.root = get_target_root() / "UID9622_大脑中枢"
        self.target_root = get_target_root()

    def _dir_size(self, path: Path) -> int:
        total = 0
        try:
            for p in path.rglob("*"):
                if p.is_file():
                    total += p.stat().st_size
        except Exception:
            pass
        return total

    def _human(self, b: int) -> str:
        for unit in ["B", "KB", "MB", "GB"]:
            if b < 1024:
                return f"{b:.1f} {unit}"
            b /= 1024
        return f"{b:.1f} TB"

    def _disk_usage(self) -> Dict[str, Any]:
        usage = shutil.disk_usage(self.target_root)
        return {
            "总空间": self._human(usage.total),
            "已用空间": self._human(usage.used),
            "可用空间": self._human(usage.free),
            "使用率": f"{usage.used / usage.total * 100:.1f}%",
        }

    def _cron_status(self) -> Dict[str, Any]:
        try:
            result = subprocess.run(["crontab", "-l"], capture_output=True, text=True, timeout=10)
            installed = "UID9622_大脑中枢_时辰调度_BEGIN" in result.stdout
            return {
                "已安装": installed,
                "crontab输出": result.stdout[-1000:] if result.returncode == 0 else "未安装 crontab",
            }
        except Exception as e:
            return {"已安装": False, "错误": str(e)}

    def _report_freshness(self) -> Dict[str, Any]:
        reports_dir = self.root / "reports"
        if not reports_dir.exists():
            return {"报告目录存在": False}
        files = sorted(reports_dir.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
        if not files:
            return {"报告目录存在": True, "最新报告": None}
        latest = files[0]
        age_hours = (datetime.now().timestamp() - latest.stat().st_mtime) / 3600
        return {
            "报告目录存在": True,
            "最新报告": latest.name,
            "报告数": len(files),
            "最新报告距今小时": round(age_hours, 1),
        }

    def _backup_status(self) -> Dict[str, Any]:
        backup_dir = self.root / "backups"
        if not backup_dir.exists():
            return {"备份目录存在": False, "备份数": 0}
        backups = list(backup_dir.glob("*.tar.gz"))
        total_size = sum(b.stat().st_size for b in backups)
        return {
            "备份目录存在": True,
            "备份数": len(backups),
            "备份总大小": self._human(total_size),
        }

    def monitor(self) -> Dict[str, Any]:
        issues: List[str] = []
        disk = self._disk_usage()
        cron = self._cron_status()
        reports = self._report_freshness()
        backups = self._backup_status()
        brain_size = self._dir_size(self.root)
        target_size = self._dir_size(self.target_root)

        if float(disk["使用率"].rstrip("%")) > 85:
            issues.append("磁盘使用率超过 85%，建议清理或扩容。")
        if not cron["已安装"]:
            issues.append("系统定时任务未安装，运行 `bash install_cron.sh` 启用自动化。")
        if reports.get("最新报告距今小时", 0) > 25:
            issues.append("报告超过 25 小时未更新，请检查定时任务。")
        if backups["备份数"] == 0:
            issues.append("尚未生成任何升级备份。")

        return {
            "动作": "大脑中枢自监控",
            "扫描时间": now_cn(),
            "磁盘使用": disk,
            "定时任务": cron,
            "报告新鲜度": reports,
            "备份状态": backups,
            "大脑中枢自身大小": self._human(brain_size),
            "目标根目录总大小": self._human(target_size),
            "异常": issues,
            "健康状态": "健康" if not issues else "需要关注",
        }


def run_self_monitor() -> Dict[str, Any]:
    return SelfMonitor().monitor()
