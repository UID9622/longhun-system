    queue = list(tasks)
    while queue:
        t = queue.pop(0)
        done = min(t, quantum)
        print(f"run {done}, remaining {max(0,t-done)}")
        if t > quantum: queue.append(t-quantum)

rr([5,3,7], quantum=2)
'''


