def forward_diffusion(x0, t, beta=0.1):
    alpha = 1 - beta
    alpha_bar = alpha**t
    noise = random.gauss(0, 1)
    return math.sqrt(alpha_bar)*x0 + math.sqrt(1-alpha_bar)*noise

x0 = 2.0
