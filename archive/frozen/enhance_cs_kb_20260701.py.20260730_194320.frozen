def _kmeans(cid: str) -> str:
    return _header(cid, "K-Means") + '''
import math

def dist(a,b): return math.sqrt(sum((x-y)**2 for x,y in zip(a,b)))

def kmeans(points, k=2, iters=10):
    cents = points[:k]
    for _ in range(iters):
        clusters = [[] for _ in range(k)]
        for p in points:
            clusters[min(range(k), key=lambda i: dist(p, cents[i]))].append(p)
        cents = [[sum(coord)/len(cluster) for coord in zip(*cluster)] if cluster else cents[i]
                 for i, cluster in enumerate(clusters)]
    return cents

points = [[0,0],[0,1],[5,5],[5,6]]
print(kmeans(points))
'''


def _knn(cid: str) -> str:
    return _header(cid, "K-NN") + '''
import math
from collections import Counter

def knn(train, labels, x, k=3):
    dists = [(math.sqrt(sum((a-b)**2 for a,b in zip(p,x))), lbl) for p,lbl in zip(train, labels)]
    return Counter([lbl for _,lbl in sorted(dists)[:k]]).most_common(1)[0][0]

train = [[0,0],[1,1],[5,5],[6,6]]
labels = ["A","A","B","B"]
print(knn(train, labels, [5.5,5.5]))
'''


def _xgboost(cid: str) -> str:
    return _header(cid, "XGBoost") + '''
def gradient_boosting(y, rounds=3, lr=0.3):
    pred = [0.0]*len(y)
    for _ in range(rounds):
        residuals = [yi - pi for yi, pi in zip(y, pred)]
        pred = [pi + lr*ri for pi, ri in zip(pred, residuals)]
    return pred

print(gradient_boosting([1.0, 2.0, 3.0]))
'''


def _naive_bayes(cid: str) -> str:
    return _header(cid, "朴素贝叶斯") + '''
from collections import Counter

# Toy text classifier
train = [("免费 优惠", "spam"), ("会议 明天", "ham"), ("中奖 免费", "spam")]
vocab = Counter()
cls = Counter()
for text, label in train:
    cls[label] += 1
    for w in text.split():
        vocab[(label,w)] += 1

def predict(text):
    words = text.split()
    scores = {l: cls[l]/len(train) for l in cls}
    for l in scores:
        total = sum(vocab[(l,w)] for w,_ in vocab if (l,w) in vocab)
        for w in words:
            scores[l] *= (vocab[(l,w)] + 1)/(total + len(vocab))
    return max(scores, key=scores.get)

print(predict("免费 中奖"))
'''


def _pca(cid: str) -> str:
    return _header(cid, "PCA") + '''
import math

def mean(v): return sum(v)/len(v)
def cov_matrix(data):
    m = [mean(col) for col in zip(*data)]
    n = len(data)
    return [[sum((r[i]-m[i])*(r[j]-m[j]) for r in data)/(n-1) for j in range(len(m))] for i in range(len(m))]

def eig_2x2(M):
    a,b,c,d=M[0][0],M[0][1],M[1][0],M[1][1]
    tr, det = a+d, a*d-b*c
    disc = math.sqrt(max(tr*tr/4 - det, 0))
    return tr/2+disc, tr/2-disc

data = [[1,2],[2,3],[3,5],[4,7]]
print("eigenvalues:", eig_2x2(cov_matrix(data)))
'''


