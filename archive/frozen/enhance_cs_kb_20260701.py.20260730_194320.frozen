def get_routing_params(r: dict[str, Any]) -> str:
    if not is_system_module(r):
        return ""
    key = r["知识点名称"].lower().replace("🐲 ", "").replace("v2.0", "").replace("v3.0", "").replace("v1.0", "").replace("v1.1", "").replace("v1.9", "").replace("v2.0-v2.2", "").strip()
    for k, v in ROUTING_TEMPLATES.items():
        if k in key or key in k:
            return v
    # Generic fallback
    return '{"input": {"payload": "dict", "context": "dict", "source_dna": "str"}, "return": {"result": "Any", "dna": "str"}}'


