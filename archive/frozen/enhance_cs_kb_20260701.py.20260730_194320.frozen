import math

def sphere_intersect(ro, rd, center, radius):
    oc = tuple(a-b for a,b in zip(ro,center))
    b = 2*sum(oc*d for oc,d in zip(oc,rd))
    c = sum(x*x for x in oc) - radius*radius
    disc = b*b - 4*c
    return disc >= 0

