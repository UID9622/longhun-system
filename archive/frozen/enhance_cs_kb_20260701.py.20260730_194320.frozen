# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------
def snake(name: str) -> str:
    """Convert a Chinese or mixed key to a safe snake_case column name."""
    return COLUMN_MAP.get(name, re.sub(r"[^0-9a-zA-Z_]+", "_", name).strip("_").lower())


def indent(code: str, spaces: int = 4) -> str:
    return textwrap.indent(code.strip(), " " * spaces)


def extract_dr(dr_str: str) -> str:
    m = re.search(r"DR\s*=\s*(\d+)", str(dr_str))
    return f"DR={m.group(1)}" if m else ""


