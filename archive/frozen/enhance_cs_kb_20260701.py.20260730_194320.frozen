# ---------------------------------------------------------------------------
# Main enhancement logic
# ---------------------------------------------------------------------------
def enhance_record(r: dict[str, Any]) -> dict[str, Any]:
    enhanced = dict(r)

    # 算法公式
    formula = str(r.get("核心公式", "")).strip()
    if not formula or len(formula) < 3:
        formula = EMPTY_FORMULA_FALLBACK.get(r["知识卡片ID"], formula)
    enhanced["算法公式"] = formula

    # 路由回调参数
    enhanced["路由回调参数"] = get_routing_params(r)

    # PY代码示例
    enhanced["PY代码示例"] = code_for_record(r).strip()

    return enhanced


def create_database(records: list[dict]) -> None:
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    if DB_PATH.exists():
        DB_PATH.unlink()
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    cur = conn.cursor()

    # Build table with snake_case columns
    columns = [f'"{snake(k)}" TEXT' for k in records[0].keys()]
    cur.execute(f"CREATE TABLE cs_kb ({', '.join(columns)})")

    # Indexes
    cur.execute('CREATE INDEX idx_card_id ON cs_kb("card_id")')
    cur.execute('CREATE INDEX idx_category ON cs_kb("category")')
    cur.execute('CREATE INDEX idx_subcategory ON cs_kb("subcategory")')
    cur.execute('CREATE INDEX idx_status ON cs_kb("status")')
    cur.execute('CREATE INDEX idx_dr ON cs_kb("dr_wuxing_gong")')
    cur.execute('CREATE INDEX idx_arch ON cs_kb("architecture_layer")')
    cur.execute('CREATE INDEX idx_in_system ON cs_kb("is_in_system")')
    cur.execute('CREATE INDEX idx_audit ON cs_kb("tri_color_audit")')

    # FTS5 virtual table for full-text search
    cur.execute('''
        CREATE VIRTUAL TABLE cs_kb_fts USING fts5(
            name, description, context_trigger,
            content='cs_kb',
            content_rowid='rowid'
        )
    ''')

    # Insert records
    keys = list(records[0].keys())
    cols = [snake(k) for k in keys]
    placeholders = ",".join("?" * len(keys))
    insert_sql = f'INSERT INTO cs_kb ("{"\",\"".join(cols)}") VALUES ({placeholders})'

    for rec in records:
        row = [json.dumps(v, ensure_ascii=False) if isinstance(v, (list, dict)) else str(v) for v in rec.values()]
        cur.execute(insert_sql, row)

    # Populate FTS
    cur.execute('''
        INSERT INTO cs_kb_fts(rowid, name, description, context_trigger)
        SELECT rowid, name, description, context_trigger FROM cs_kb
    ''')

    conn.commit()
    conn.close()


def main() -> None:
    with open(SRC_JSON, "r", encoding="utf-8") as f:
        records = json.load(f)

    enhanced = [enhance_record(r) for r in records]

    # Write enhanced JSON
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    with open(ENHANCED_JSON, "w", encoding="utf-8") as f:
        json.dump(enhanced, f, ensure_ascii=False, indent=2)

    # Create SQLite DB
    create_database(enhanced)

    # Copy originals
    shutil.copy2(SRC_JSON, BACKUP_DIR / "cs_kb_complete.json")
    shutil.copy2(SRC_RAW, BACKUP_DIR / "kb_data_raw.py")
    shutil.copy2(SRC_SKILL, BACKUP_DIR / "SKILL.md")
    shutil.copy2(SRC_NOTION, BACKUP_DIR / "notion_portal.json")

    # Stats
    empty_formula = sum(1 for r in enhanced if not str(r.get("核心公式", "")).strip())
    with_routing = sum(1 for r in enhanced if r.get("路由回调参数"))
    print(f"Enhanced {len(enhanced)} records")
    print(f"Original empty formulas filled: {empty_formula}")
    print(f"Records with routing params: {with_routing}")
    print(f"Backup dir: {BACKUP_DIR}")
    print(f"DB: {DB_PATH}")
    print(f"Enhanced JSON: {ENHANCED_JSON}")


if __name__ == "__main__":
    main()
