# ---------------------------------------------------------------------------
# Code templates (kept compact, stdlib only)
# ---------------------------------------------------------------------------
def _header(cid: str, name: str) -> str:
    return f"# 知识点ID={cid} · {name}\n"


def _linear_regression(cid: str) -> str:
    return _header(cid, "线性回归") + '''
def mat_mul(A, B):
    return [[sum(a*b for a,b in zip(row, col)) for col in zip(*B)] for row in A]
def transpose(A): return list(map(list, zip(*A)))
def invert_2x2(M):
    a,b,c,d = M[0][0], M[0][1], M[1][0], M[1][1]
    det = a*d - b*c
    return [[d/det, -b/det], [-c/det, a/det]]

X = [[1, 1], [1, 2], [1, 3], [1, 4]]
y = [[2], [3], [5], [7]]
XtX = mat_mul(transpose(X), X)
inv = invert_2x2(XtX)
w = mat_mul(mat_mul(inv, transpose(X)), y)
print("w,b =", w[1][0], w[0][0])
'''


def _decision_tree(cid: str) -> str:
    return _header(cid, "决策树") + '''
from math import log2
from collections import Counter

def entropy(labels):
    n = len(labels); return -sum((c/n)*log2(c/n) for c in Counter(labels).values())

def info_gain(data, labels, feature_idx):
    base = entropy(labels)
    vals = set(row[feature_idx] for row in data)
    weighted = sum((sum(1 for r in data if r[feature_idx]==v)/len(data)) *
                   entropy([labels[i] for i,r in enumerate(data) if r[feature_idx]==v]) for v in vals)
    return base - weighted

data = [["sunny","hot"],["sunny","mild"],["rain","cool"]]
labels = ["no","yes","yes"]
print("IG(feature0)=", info_gain(data, labels, 0))
'''


