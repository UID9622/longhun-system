import math

def sigmoid(x): return 1/(1+math.exp(-x))
def generator(z, w): return z*w
def discriminator(x, w): return sigmoid(x*w)

for step in range(5):
    z = 0.5
    fake = generator(z, 0.8)
    d_real = discriminator(1.0, 0.6)
    d_fake = discriminator(fake, 0.6)
    loss = -math.log(d_real) - math.log(1-d_fake)
    print(f"step {step}: D(real)={d_real:.3f} D(fake)={d_fake:.3f} loss={loss:.3f}")
'''


