def _adam(cid: str) -> str:
    return _header(cid, "Adam") + '''
import math

w, m, v = 1.0, 0.0, 0.0
beta1, beta2, eps, lr = 0.9, 0.999, 1e-8, 0.1
for t in range(1, 11):
    g = 2*w  # gradient of w^2
    m = beta1*m + (1-beta1)*g
    v = beta2*v + (1-beta2)*g*g
    m_hat = m/(1-beta1**t)
    v_hat = v/(1-beta2**t)
    w -= lr*m_hat/(math.sqrt(v_hat)+eps)
print("w =", w)
'''


