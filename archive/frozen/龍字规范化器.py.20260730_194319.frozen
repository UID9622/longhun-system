# ═══════════════════════════════════════════════════════════════════════════════
# 數據類定義
# ═══════════════════════════════════════════════════════════════════════════════

class 字符規範級別(Enum):
    """字符規範化級別"""
    嚴格 = "strict"       # 僅允許標準繁體
    標準 = "normal"       # 自動映射到標準繁體
    寬鬆 = "loose"        # 接受簡體和異體


@dataclass
class 龍字分析結果:
    """龍字分析結果"""
    原始文本: str
    規範化文本: str
    發現的龍字: List[dict]
    替換記錄: List[Tuple[str, str, str]]  # (位置, 原始, 替換後)
    統計: dict[str, Any]


# ═══════════════════════════════════════════════════════════════════════════════
# 核心類：龍字规范化器
# ═══════════════════════════════════════════════════════════════════════════════

class 龍字規範化器:
    """
    龍魂龍字规范化器
    
    功能：
    1. 統一龍字編碼為 U+9F8D
    2. 繁簡容錯搜索
    3. Unicode 標準化處理
    4. 龍魂術語規範化
    5. 文本完整性校驗
    
    三色審計：
    - 🟢 標準繁體龍（U+9F8D）
    - 🟡 簡體龍（U+9F99）- 自動轉換
    - 🔴 異體龍 - 需要特別處理
    """
    
    def __init__(self, 級別: 字符規範級別 = 字符規範級別.標準):
        self.級別 = 級別
        self.映射表 = self._構建映射表()
        self.統計 = {
            "處理文本數": 0,
            "替換次數": 0,
            "標準龍字數": 0,
            "簡體龍字數": 0,
            "異體龍字數": 0,
        }
    
    def _構建映射表(self) -> Dict[str, str]:
        """構建標準化映射表"""
        映射 = {
            # 簡體 → 繁體
            "\u9F99": "\u9F8D",   # 龙 → 龍
            # 異體 → 標準
            "\u9F92": "\u9F8D",   # 龒 → 龍
            "\u7ADC": "\u9F8D",   # 竜 → 龍
            # 兼容區 → 標準
            "\uF9C4": "\u9F8D",   # 龍 → 龍
        }
        return 映射
    
    # ───────────────────────────────────────────────
    # 核心功能
    # ───────────────────────────────────────────────
    
    def 規範化(self, 文本: str) -> str:
        """
        將文本中的龍字規範化為標準繁體 U+9F8D
        
        參數:
            文本: 輸入文本
        
        返回:
            規範化後的文本
        """
        結果 = 文本
        for 原始, 標準 in self.映射表.items():
            結果 = 結果.replace(原始, 標準)
        
        self.統計["處理文本數"] += 1
        return 結果
    
    def 分析文本(self, 文本: str) -> 龍字分析結果:
        """
        分析文本中的龍字使用情況
        
        參數:
            文本: 輸入文本
        
        返回:
            分析結果對象
        """
        發現的龍字 = []
        替換記錄 = []
        規範化文本 = 文本
        
        統計 = {"標準": 0, "簡體": 0, "異體": 0, "其他": 0}
        
        for i, 字符 in enumerate(文本):
            if 字符 == "\u9F8D":  # 標準龍
                統計["標準"] += 1
                發現的龍字.append({"位置": i, "字符": 字符, "碼點": "U+9F8D", "類型": "標準繁體"})
            elif 字符 == "\u9F99":  # 簡體龍
                統計["簡體"] += 1
                替換記錄.append((str(i), 字符, "龍"))
                發現的龍字.append({"位置": i, "字符": 字符, "碼點": "U+9F99", "類型": "簡體"})
            elif 字符 in self.映射表:  # 異體
                統計["異體"] += 1
                原始碼點 = 龍字映射表.get(字符, {}).get("標準碼", f"U+{ord(字符):04X}")
                替換記錄.append((str(i), 字符, "龍"))
                發現的龍字.append({"位置": i, "字符": 字符, "碼點": 原始碼點, "類型": "異體"})
        
        # 統計更新
        self.統計["標準龍字數"] += 統計["標準"]
        self.統計["簡體龍字數"] += 統計["簡體"]
        self.統計["異體龍字數"] += 統計["異體"]
        self.統計["替換次數"] += len(替換記錄)
        
        # 規範化
        規範化文本 = self.規範化(文本)
        
        return 龍字分析結果(
            原始文本=文本,
            規範化文本=規範化文本,
            發現的龍字=發現的龍字,
            替換記錄=替換記錄,
            統計=統計
        )
    
    def 檢查規範性(self, 文本: str) -> Tuple[bool, List[str]]:
        """
        檢查文本是否符合龍字規範
        
        返回:
            (是否規範, 問題列表)
        """
        問題 = []
        
        for i, 字符 in enumerate(文本):
            if 字符 == "\u9F99":  # 簡體龍
                問題.append(f"位置 {i}: 發現簡體龍字(U+9F99)，應使用繁體龍(U+9F8D)")
            elif 字符 in ("\u9F92", "\u7ADC", "\uF9C4"):  # 異體
                碼點 = f"U+{ord(字符):04X}"
                問題.append(f"位置 {i}: 發現異體龍字({碼點})，應使用標準繁體龍(U+9F8D)")
        
        return len(問題) == 0, 問題
    
    def 容錯搜索(self, 查詢詞: str, 目標文本: str) -> List[Tuple[int, int]]:
        """
        繁簡容錯搜索
        
        同時匹配繁體和簡體形式的龍字
        
        參數:
            查詢詞: 搜索關鍵詞
            目標文本: 被搜索文本
        
        返回:
            [(起始位置, 結束位置), ...]
        """
        結果 = []
        
        # 規範化查詢詞和目標文本
        規範查詢 = self.規範化(查詢詞)
        規範目標 = self.規範化(目標文本)
        
        # 搜索
        起始 = 0
        while True:
            位置 = 規範目標.find(規範查詢, 起始)
            if 位置 == -1:
                break
            結果.append((位置, 位置 + len(規範查詢)))
            起始 = 位置 + 1
        
        return 結果
    
    def 生成龍字DNA(self, 文本: str) -> str:
        """
        生成文本的龍字DNA校驗碼
        
        基於規範化後的文本計算
        """
        規範文本 = self.規範化(文本)
        數據 = f"{規範文本}:{DNA標識}"
        return hashlib.sha256(數據.encode('utf-8')).hexdigest()[:16]
    
    def 驗證龍字DNA(self, 文本: str, DNA: str) -> bool:
        """驗證龍字DNA校驗碼"""
        return self.生成龍字DNA(文本) == DNA
    
    # ───────────────────────────────────────────────
    # 術語規範化
    # ───────────────────────────────────────────────
    
    def 規範化術語(self, 文本: str) -> str:
        """
        規範化龍魂體系術語
        
        將簡體術語替換為繁體標準形式
        """
        結果 = 文本
        
        for 標準術語, 信息 in 龍魂術語表.items():
            簡體 = 信息.get("簡體", "")
            if 簡體 and 簡體 in 結果:
                結果 = 結果.replace(簡體, 標準術語)
        
        return 結果
    
    def 獲取術語信息(self, 術語: str) -> Optional[dict]:
        """獲取術語的詳細信息"""
        # 先規範化
        規範術語 = self.規範化術語(術語)
        
        for 標準術語, 信息 in 龍魂術語表.items():
            if 標準術語 in 規範術語 or 信息.get("簡體", "") in 術語:
                return {
                    "術語": 標準術語,
                    **信息
                }
        
        return None
    
    def 列出所有術語(self) -> List[dict]:
        """列出所有龍魂術語"""
        return [
            {"術語": k, **v}
            for k, v in 龍魂術語表.items()
        ]
    
    # ───────────────────────────────────────────────
    # 幣種名稱規範化
    # ───────────────────────────────────────────────
    
    def 規範化幣種名稱(self, 名稱: str, 目標形式: str = "繁體") -> str:
        """
        規範化幣種名稱
        
        參數:
            名稱: 幣種名稱或代碼
            目標形式: "繁體", "簡體", "英文"
        """
        名稱 = 名稱.upper().strip()
        
        # 直接查找代碼
        if 名稱 in 幣種名稱映射:
            return 幣種名稱映射[名稱].get(目標形式, 名稱)
        
        # 反向查找（通過名稱找代碼）
        for 代碼, 映射 in 幣種名稱映射.items():
            if 名稱 in (映射["繁體"].upper(), 映射["簡體"].upper(), 映射["英文"].upper()):
                return 映射.get(目標形式, 代碼)
        
        return 名稱
    
    def 獲取幣種信息(self, 代碼或名稱: str) -> Optional[dict]:
        """獲取幣種的完整信息"""
        輸入 = 代碼或名稱.upper().strip()
        
        # 直接查找代碼
        if 輸入 in 幣種名稱映射:
            return {"代碼": 輸入, **幣種名稱映射[輸入]}
        
        # 反向查找
        for 代碼, 映射 in 幣種名稱映射.items():
            if 輸入 in (映射["繁體"].upper(), 映射["簡體"].upper(), 映射["英文"].upper()):
                return {"代碼": 代碼, **映射}
        
        return None
    
    # ───────────────────────────────────────────────
    # Unicode 工具
    # ───────────────────────────────────────────────
    
    def 獲取字符信息(self, 字符: str) -> dict[str, Any]:
        """獲取字符的 Unicode 詳細信息"""
        碼點 = ord(字符)
        return {
            "字符": 字符,
            "碼點": f"U+{碼點:04X}",
            "十進制": 碼點,
            "UTF-8": 字符.encode('utf-8').hex().upper(),
            "Unicode名稱": unicodedata.name(字符, "未知"),
            "類別": unicodedata.category(字符),
            "是否龍字": 字符 in self.映射表 or 字符 == "\u9F8D",
            "標準形式": self.映射表.get(字符, 字符) if 字符 in self.映射表 else (
                "龍(U+9F8D)" if 字符 == "\u9F8D" else "非龍字"
            )
        }
    
    def 獲取統計(self) -> dict[str, Any]:
        """獲取處理統計"""
        return {
            **self.統計,
            "映射規則數": len(self.映射表),
            "術語數": len(龍魂術語表),
            "幣種數": len(幣種名稱映射),
            "DNA": DNA標識,
            "版本": 版本號
        }


# ═══════════════════════════════════════════════════════════════════════════════
# 实用工具函數
# ═══════════════════════════════════════════════════════════════════════════════

def 快速規範化(文本: str) -> str:
    """快速規範化函數（無需實例化）"""
    規範化器 = 龍字規範化器()
    return 規範化器.規範化(文本)


def 檢查文本龍字(文本: str) -> dict[str, Any]:
    """快速檢查文本中的龍字"""
    規範化器 = 龍字規範化器()
    return 規範化器.分析文本(文本)


# ═══════════════════════════════════════════════════════════════════════════════
# 命令行入口
# ═══════════════════════════════════════════════════════════════════════════════

def 主函數():
    """命令行入口"""
    import argparse
    
    解析器 = argparse.ArgumentParser(
        description="龍字规范化器 - 龍魂体系字符编码核心",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=f"""
示例:
  python 龍字规范化器.py --normalize "龙魂体系"           # 規範化文本
  python 龍字规范化器.py --analyze "龙魂体系"             # 分析文本
  python 龍字规范化器.py --check "龙魂体系"               # 檢查規範性
  python 龍字规范化器.py --search "龍魂" "龙魂体系介紹"   # 容錯搜索
  python 龍字规范化器.py --char 龍                        # 字符信息
  python 龍字规范化器.py --terms                         # 列出術語
  python 龍字规范化器.py --currency USD                  # 幣種信息
  python 龍字规范化器.py --panel                         # 顯示面板

DNA: {DNA標識}
        """
    )
    
    解析器.add_argument("--normalize", "-n", type=str, metavar="文本",
                        help="規範化文本中的龍字")
    解析器.add_argument("--analyze", "-a", type=str, metavar="文本",
                        help="分析文本中的龍字")
    解析器.add_argument("--check", type=str, metavar="文本",
                        help="檢查文本是否符合龍字規範")
    解析器.add_argument("--search", nargs=2, metavar=("查詢", "目標"),
                        help="容錯搜索")
    解析器.add_argument("--char", type=str, metavar="字符",
                        help="獲取字符的 Unicode 信息")
    解析器.add_argument("--terms", "-t", action="store_true",
                        help="列出所有龍魂術語")
    解析器.add_argument("--currency", "-c", type=str, metavar="代碼",
                        help="獲取幣種信息")
    解析器.add_argument("--panel", "-p", action="store_true",
                        help="顯示完整面板")
    解析器.add_argument("--dna", type=str, metavar="文本",
                        help="生成龍字DNA校驗碼")
    
    參數 = 解析器.parse_args()
    
    規範化器 = 龍字規範化器()
    
    if 參數.normalize:
        結果 = 規範化器.規範化(參數.normalize)
        print(f"\n{'─'*50}")
        print(f"  📝 龍字規範化")
        print(f"{'─'*50}")
        print(f"  原始: {參數.normalize}")
        print(f"  結果: {結果}")
        print(f"{'─'*50}\n")
    
    elif 參數.analyze:
        結果 = 規範化器.分析文本(參數.analyze)
        print(f"\n{'═'*60}")
        print(f"  🔍 龍字分析結果")
        print(f"{'═'*60}")
        print(f"  原始文本: {結果.原始文本}")
        print(f"  規範文本: {結果.規範化文本}")
        print(f"\n  統計:")
        for 類型, 數量 in 結果.統計.items():
            圖標 = {"標準": "🟢", "簡體": "🟡", "異體": "🔴", "其他": "⚪"}.get(類型, "•")
            print(f"    {圖標} {類型}: {數量}")
        
        if 結果.發現的龍字:
            print(f"\n  發現的龍字詳情:")
            for 龍字 in 結果.發現的龍字:
                print(f"    位置 {龍字['位置']:3d}: {龍字['字符']} ({龍字['碼點']}) - {龍字['類型']}")
        
        if 結果.替換記錄:
            print(f"\n  替換記錄:")
            for 位置, 原始, 替換後 in 結果.替換記錄:
                print(f"    位置 {位置}: {原始} → {替換後}")
        
        print(f"{'═'*60}\n")
    
    elif 參數.check:
        是否規範, 問題 = 規範化器.檢查規範性(參數.check)
        print(f"\n{'─'*50}")
        print(f"  🔍 規範性檢查")
        print(f"{'─'*50}")
        print(f"  文本: {參數.check}")
        print(f"  結果: {'🟢 符合規範' if 是否規範 else '🔴 不符合規範'}")
        if 問題:
            print(f"\n  問題列表:")
            for 問題項 in 問題:
                print(f"    ⚠️ {問題項}")
        print(f"{'─'*50}\n")
    
    elif 參數.search:
        查詢, 目標 = 參數.search
        結果 = 規範化器.容錯搜索(查詢, 目標)
        print(f"\n{'─'*50}")
        print(f"  🔍 容錯搜索")
        print(f"{'─'*50}")
        print(f"  查詢: {查詢}")
        print(f"  目標: {目標}")
        print(f"  匹配數: {len(結果)}")
        if 結果:
            for 起始, 結束 in 結果:
                片段 = 目標[起始:結束]
                print(f"    位置 {起始}-{結束}: '{片段}'")
        print(f"{'─'*50}\n")
    
    elif 參數.char:
        字符 = 參數.char[0] if len(參數.char) > 0 else 參數.char
        信息 = 規範化器.獲取字符信息(字符)
        print(f"\n{'═'*50}")
        print(f"  🔤 字符信息")
        print(f"{'═'*50}")
        for 鍵, 值 in 信息.items():
            print(f"  {鍵:12s}: {值}")
        print(f"{'═'*50}\n")
    
    elif 參數.terms:
        術語列表 = 規範化器.列出所有術語()
        print(f"\n{'═'*60}")
        print(f"  📚 龍魂術語表（共 {len(術語列表)} 條）")
        print(f"{'═'*60}")
        print(f"  {'術語':<10} {'簡體':<10} {'拼音':<12} {'類別':<12}")
        print(f"  {'─'*56}")
        for 術語 in 術語列表:
            print(f"  {術語['術語']:<10} {術語.get('簡體', ''):<10} "
                  f"{術語.get('拼音', ''):<12} {術語.get('類別', ''):<12}")
        print(f"{'═'*60}\n")
    
    elif 參數.currency:
        信息 = 規範化器.獲取幣種信息(參數.currency)
        if 信息:
            print(f"\n{'─'*50}")
            print(f"  💱 幣種信息")
            print(f"{'─'*50}")
            for 鍵, 值 in 信息.items():
                print(f"  {鍵:10s}: {值}")
            print(f"{'─'*50}\n")
        else:
            print(f"[❌] 未找到幣種: {參數.currency}")
    
    elif 參數.dna:
        DNA = 規範化器.生成龍字DNA(參數.dna)
        print(f"\n{'─'*50}")
        print(f"  🧬 龍字DNA校驗碼")
        print(f"{'─'*50}")
        print(f"  文本: {參數.dna}")
        print(f"  DNA:  {DNA}")
        print(f"{'─'*50}\n")
    
    elif 參數.panel:
        print(f"\n{'█'*70}")
        print(f"█{'龍字规范化器':^68}█")
        print(f"█{'Dragon Character Normalizer':^68}█")
        print(f"{'█'*70}")
        
        print(f"\n{'─'*70}")
        print(f"  📋 龍字 Unicode 映射表")
        print(f"{'─'*70}")
        print(f"  {'字符':<6} {'碼點':<10} {'類型':<14} {'狀態':<20}")
        print(f"  {'─'*62}")
        
        for 字符, 信息 in 龍字映射表.items():
            print(f"  {字符:<6} {信息['標準碼']:<10} {信息['類型']:<14} {信息['狀態']:<20}")
        
        print(f"\n{'─'*70}")
        print(f"  📊 統計信息")
        print(f"{'─'*70}")
        統計 = 規範化器.獲取統計()
        for 鍵, 值 in 統計.items():
            print(f"  {鍵:20s}: {值}")
        
        print(f"\n{'─'*70}")
        print(f"  💡 使用說明")
        print(f"{'─'*70}")
        print(f"  標準龍字: 龍 (U+9F8D)")
        print(f"  簡體映射: 龙 (U+9F99) → 龍 (U+9F8D)")
        print(f"  異體映射: 龒(U+9F92), 竜(U+7ADC), 龍(U+F9C4) → 龍 (U+9F8D)")
        print(f"  用法: python 龍字规范化器.py --normalize '文本'")
        
        print(f"\n{'█'*70}")
        print(f"  DNA: {DNA標識}")
        print(f"  版本: v{版本號}")
        print(f"{'█'*70}\n")
    
    else:
        解析器.print_help()


if __name__ == "__main__":
    主函數()
