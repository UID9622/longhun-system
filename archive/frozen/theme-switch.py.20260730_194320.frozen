#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
龍魂万年历 · 主题切换脚本
DNA: #龍芯⚡️2026-06-27-LONGHUN-CALENDAR-THEME-SWITCH-v2.0

用法：lh 万年历主题 <dark|light|classic|longhun>
修改 config.json 中的 theme 字段，刷新页面后生效。
"""

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
CONFIG = ROOT / 'config.json'
THEMES = ['dark', 'light', 'classic', 'longhun']


def main():
    if len(sys.argv) < 2:
        print('用法: lh 万年历主题 <dark|light|classic|longhun>')
        print(f'可用主题: {", ".join(THEMES)}')
        return 1

    theme = sys.argv[1].lower()
    if theme not in THEMES:
        print(f'❌ 未知主题: {theme}')
        print(f'可用主题: {", ".join(THEMES)}')
        return 1

    cfg = json.loads(CONFIG.read_text(encoding='utf-8'))
    old = cfg.get('theme')
    cfg['theme'] = theme
    CONFIG.write_text(json.dumps(cfg, ensure_ascii=False, indent=2), encoding='utf-8')

    print(f'✅ 主题已切换: {old} → {theme}')
    print('   刷新万年历页面即可生效')
    print(f'   配置文件: {CONFIG}')
    return 0


if __name__ == '__main__':
    main()
