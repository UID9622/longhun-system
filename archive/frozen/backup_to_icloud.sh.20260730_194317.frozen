###############################################
# 龍魂系統·iCloud备份脚本（云上贵州）
###############################################
#
# DNA追溯码：#ZHUGEXIN⚡️-2026-02-15-icloud-backup-v1.0
# 创建者：宝宝｜UID9622
# 创建时间：北京时间 2026-02-15 03:30:00
#
# 大白话：
# 这个脚本做一件事：
# 把你的龍魂系統（UID9622_Automation 和 龍芯核心系統）
# 增量备份到你的 iCloud 云上贵州（6TB空间）
# 每次备份都带DNA追溯码，完全可追踪。
#
# 确认码：#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z
#
###############################################

set -e

# =====================================================
# 配置
# =====================================================

# iCloud路径（云上贵州）
ICLOUD_BASE="$HOME/Library/Mobile Documents/com~apple~CloudDocs"
BACKUP_ROOT="${ICLOUD_BASE}/龍魂系統备份"
AUTOMATION_BACKUP="${BACKUP_ROOT}/UID9622_Automation"
LONGHUN_CORE_BACKUP="${BACKUP_ROOT}/龍芯核心系統"

# 确保所有路径都正确处理空格
export ICLOUD_BASE
export BACKUP_ROOT
export AUTOMATION_BACKUP
export LONGHUN_CORE_BACKUP

# 源位置
AUTOMATION_SOURCE="$HOME/UID9622_Automation"
LONGHUN_CORE_SOURCE="$HOME/龍芯核心系統"

# 日志和报告
BACKUP_LOG_DIR="${BACKUP_ROOT}/备份日志"
BACKUP_MANIFEST="${BACKUP_ROOT}/备份清单"

# 生成时间戳
TIMESTAMP=$(date "+%Y-%m-%d %H:%M:%S")
FILENAME_TIMESTAMP=$(date "+%Y%m%d_%H%M%S")
BACKUP_DATE=$(date "+%Y-%m-%d")

# 生成DNA码
DNA_CODE="#ZHUGEXIN⚡️-${BACKUP_DATE}-icloud备份-${FILENAME_TIMESTAMP}"
CONFIRM_CODE="#CONFIRM🌌9622-ONLY-ONCE🧬LK9X-772Z"

# 日志文件
LOG_FILE="${BACKUP_LOG_DIR}/backup_${FILENAME_TIMESTAMP}.log"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# =====================================================
# 日志函数
# =====================================================

log_info() {
    local msg="$1"
    echo -e "${BLUE}[$(date '+%H:%M:%S')]${NC} [INFO] $msg" | tee -a "$LOG_FILE"
}

log_success() {
    local msg="$1"
    echo -e "${GREEN}[$(date '+%H:%M:%S')]${NC} [成功] ✅ $msg" | tee -a "$LOG_FILE"
}

log_warn() {
    local msg="$1"
    echo -e "${YELLOW}[$(date '+%H:%M:%S')]${NC} [警告] ⚠️ $msg" | tee -a "$LOG_FILE"
}

log_error() {
    local msg="$1"
    echo -e "${RED}[$(date '+%H:%M:%S')]${NC} [错误] ❌ $msg" | tee -a "$LOG_FILE"
}

# =====================================================
# 初始化
# =====================================================

init_backup() {
    echo ""
    echo "╔════════════════════════════════════════════════════════════╗"
    echo "║    🐉 龍魂系統 - iCloud备份（云上贵州）                   ║"
    echo "╚════════════════════════════════════════════════════════════╝"
    echo ""

    # 检查iCloud是否可用（使用正确的路径处理）
    if [ ! -d "$ICLOUD_BASE" ]; then
        log_error "iCloud Drive 目录不存在"
        log_error "请确保："
        log_error "  1. Mac登录了iCloud账户"
        log_error "  2. iCloud Drive已启用"
        log_error "  3. 目录路径：$ICLOUD_BASE"
        exit 1
    fi

    log_success "iCloud Drive 可用"
    log_info "iCloud 路径：$ICLOUD_BASE"
    log_info ""

    # 创建备份目录结构（使用引号处理空格）
    log_info "准备备份目录..."
    mkdir -p "$AUTOMATION_BACKUP" 2>/dev/null || true
    mkdir -p "$LONGHUN_CORE_BACKUP" 2>/dev/null || true
    mkdir -p "$BACKUP_LOG_DIR" 2>/dev/null || true
    mkdir -p "$BACKUP_MANIFEST" 2>/dev/null || true

    # 验证目录是否成功创建
    if [ ! -d "$BACKUP_LOG_DIR" ]; then
        log_error "日志目录创建失败：$BACKUP_LOG_DIR"
        # 尝试替代路径（去掉特殊字符）
        BACKUP_LOG_DIR="${BACKUP_ROOT}/logs"
        mkdir -p "$BACKUP_LOG_DIR" 2>/dev/null || true
        log_warn "使用替代日志目录：$BACKUP_LOG_DIR"
    fi

    log_success "备份目录已准备"
    log_info "  • 自动化系統备份：$AUTOMATION_BACKUP"
    log_info "  • 龍芯核心备份：$LONGHUN_CORE_BACKUP"
    log_info "  • 日志目录：$BACKUP_LOG_DIR"
    log_info ""

    log_info "DNA追溯码：$DNA_CODE"
    log_info "确认码：$CONFIRM_CODE"
    log_info ""
}

# =====================================================
# 增量备份函数
# =====================================================

backup_directory() {
    local source_dir="$1"
    local backup_dir="$2"
    local dir_name="$3"

    log_info "开始备份：$dir_name"

    if [ ! -d "$source_dir" ]; then
        log_warn "源目录不存在，跳过：$source_dir"
        return 1
    fi

    # 获取源目录大小
    local source_size=$(du -sh "$source_dir" | awk '{print $1}')
    log_info "源大小：$source_size"

    # 使用rsync增量备份（保留权限，跳过已存在文件）
    log_info "执行增量备份..."

    rsync -avh --progress --delete \
        --exclude=".DS_Store" \
        --exclude="logs/*" \
        --exclude="*.log" \
        "$source_dir/" "$backup_dir/" 2>&1 | tee -a "$LOG_FILE"

    local exit_code=$?

    if [ $exit_code -eq 0 ]; then
        local backup_size=$(du -sh "$backup_dir" | awk '{print $1}')
        log_success "$dir_name 备份完成"
        log_info "备份大小：$backup_size"
        return 0
    else
        log_error "$dir_name 备份失败"
        return 1
    fi
}

# =====================================================
# 备份清单生成
# =====================================================

generate_manifest() {
    log_info "生成备份清单..."

    local manifest_file="${BACKUP_MANIFEST}/清单_${FILENAME_TIMESTAMP}.cnsh.md"

    cat > "$manifest_file" << EOF
###############################################
# 🐉 龍魂系統 - iCloud备份清单
###############################################
#
# 备份时间：$TIMESTAMP
# DNA追溯码：$DNA_CODE
# 确认码：$CONFIRM_CODE
#
###############################################

## 备份信息

- **备份时间**：$TIMESTAMP
- **备份日期**：$BACKUP_DATE
- **备份ID**：$FILENAME_TIMESTAMP
- **DNA追溯码**：$DNA_CODE
- **确认码**：$CONFIRM_CODE

## 备份位置（iCloud - 云上贵州）

- **主目录**：~/Library/Mobile Documents/com~apple~CloudDocs/龍魂系統备份/
- **自动化系統**：龍魂系統备份/UID9622_Automation/
- **龍芯核心**：龍魂系統备份/龍芯核心系統/
- **日志目录**：龍魂系統备份/备份日志/
- **清单目录**：龍魂系統备份/备份清单/

## 备份内容

### UID9622_Automation
- \`commander.sh\` - 总调度指挥官
- \`config.sh\` - 配置系统
- \`lib.sh\` - 函数库
- \`diagnostic.sh\` - 诊断工具
- 各种文档和日志

### 龍芯核心系統
- 理论層
- 技術層
- 配置層
- 應用層
- 部署與文檔
- 審計日誌

## 备份特点

✅ **增量备份**
  - 只备份变更文件
  - 节省iCloud空间
  - 速度快

✅ **DNA追溯**
  - 每次备份都带唯一DNA码
  - 可以追踪备份历史
  - 完全可审计

✅ **云上贵州**
  - 国资背景
  - 完全在祖国
  - 数据主权有保障
  - 6TB足够用

✅ **自动化**
  - 可以设置定时备份
  - crontab自动执行
  - 无需手动操作

## 备份验证

要验证备份完整性，运行：

\`\`\`bash
