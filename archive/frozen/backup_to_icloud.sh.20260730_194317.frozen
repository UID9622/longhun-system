# =====================================================
# 主程序
# =====================================================

main() {
    # 初始化
    init_backup

    # 统计
    local success_count=0
    local fail_count=0

    # 备份UID9622_Automation
    if backup_directory "$AUTOMATION_SOURCE" "$AUTOMATION_BACKUP" "UID9622_Automation"; then
        ((success_count++))
    else
        ((fail_count++))
    fi

    echo ""

    # 备份龍芯核心系統
    if [ -d "$LONGHUN_CORE_SOURCE" ]; then
        if backup_directory "$LONGHUN_CORE_SOURCE" "$LONGHUN_CORE_BACKUP" "龍芯核心系統"; then
            ((success_count++))
        else
            ((fail_count++))
        fi
    else
        log_warn "龍芯核心系統目录不存在，跳过"
    fi

    echo ""

    # 生成清单和报告
    generate_manifest
    echo ""
    generate_report
    echo ""

    # 显示完成信息
    log_info "╔════════════════════════════════════════════════════════╗"
    log_info "║         ✅ iCloud备份完成                              ║"
    log_info "╚════════════════════════════════════════════════════════╝"
    log_info ""
    log_info "备份统计："
    log_info "  • 成功：$success_count ✅"
    log_info "  • 失败：$fail_count ❌"
    log_info ""
    log_info "备份位置（iCloud - 云上贵州）："
    log_info "  ~/Library/Mobile Documents/com~apple~CloudDocs/龍魂系統备份/"
    log_info ""
    log_info "DNA追溯码：$DNA_CODE"
    log_info "确认码：$CONFIRM_CODE"
    log_info ""
    log_info "日志文件：$LOG_FILE"
    log_info ""

    # 显示iCloud使用空间
    log_info "检查iCloud备份大小..."
    local backup_total=$(du -sh "${BACKUP_ROOT}" 2>/dev/null | awk '{print $1}')
    log_info "当前iCloud备份总大小：$backup_total"
    log_info ""

    log_success "备份已安全存储在云上贵州（iCloud）✅"
    log_info "献给祖国的系統，现已备份到国内云端 🚩"
    log_info ""
}

# 执行主程序
main "$@"

