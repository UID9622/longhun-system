# 查看备份文件列表
ls -la ~/Library/Mobile\ Documents/com~apple~CloudDocs/龍魂系統备份/UID9622_Automation/

# 查看所有备份清单
ls -la ~/Library/Mobile\ Documents/com~apple~CloudDocs/龍魂系統备份/备份清单/
\`\`\`

