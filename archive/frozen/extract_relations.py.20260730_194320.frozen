#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Notion 反向链接与关系提取（并发限速版）
DNA: #龍芯⚡️2026-07-01-NOTION-EXTRACT-RELATIONS-v1.1
"""
import json
import os
import re
import subprocess
import sys
import threading
import time
from concurrent.futures import ThreadPoolExecutor, as_completed
from pathlib import Path
from datetime import datetime, timezone

sys.stdout.reconfigure(line_buffering=True)

HOME = Path.home()
OUT_DIR = HOME / "longhun-system" / "notion_absorb"
CONTENT_DIR = OUT_DIR / "page_contents"
DNA_PREFIX = "#龍芯⚡️"

TOKEN = os.environ.get("NOTION_TOKEN") or os.environ.get("LONGHUN_NOTION_TOKEN")
if not TOKEN:
    print("🔴 未找到 NOTION_TOKEN", flush=True)
    sys.exit(1)

HEADERS = [
    "-H", f"Authorization: Bearer {TOKEN}",
    "-H", "Notion-Version: 2022-06-28",
    "-H", "Content-Type: application/json",
]

rate_lock = threading.Lock()
last_request_time = [0.0]
MIN_INTERVAL = 0.35


def log(msg):
    print(f"[{datetime.now(timezone.utc).isoformat()}] {msg}", flush=True)


def rate_limited_notion_api(method, endpoint, payload=None):
    with rate_lock:
        elapsed = time.time() - last_request_time[0]
        if elapsed < MIN_INTERVAL:
            time.sleep(MIN_INTERVAL - elapsed)
        last_request_time[0] = time.time()
    
    url = f"https://api.notion.com/v1/{endpoint}"
    args = ["curl", "-s", "-S", "-L", "--max-time", "60", "-X", method] + HEADERS
    data_file = None
    try:
        if payload is not None:
            data_file = Path(f"/tmp/.notion_rel_{threading.current_thread().ident}_{os.getpid()}.json")
            data_file.write_text(json.dumps(payload, ensure_ascii=False), encoding="utf-8")
            args += ["-d", f"@{data_file}"]
        args.append(url)
        proc = subprocess.run(args, capture_output=True, text=True, timeout=65)
        if proc.returncode != 0:
            return {"ok": False, "error": proc.stderr[:500]}
        return {"ok": True, "data": json.loads(proc.stdout)}
    except Exception as e:
        return {"ok": False, "error": str(e)}
    finally:
        if data_file and data_file.exists():
            data_file.unlink()


def extract_mentions_and_links(text):
    relations = []
    uuid_pattern = re.compile(r'[0-9a-f]{8}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{4}-?[0-9a-f]{12}', re.I)
    for m in uuid_pattern.finditer(text):
        relations.append({"type": "mention_or_link", "target_id": m.group().replace('-', '')})
    return relations


def extract_relations_from_blocks(blocks):
    relations = []
    for b in blocks:
        t = b.get("type", "")
        if t == "link_to_page":
            lid = b.get("link_to_page", {}).get("page_id") or b.get("link_to_page", {}).get("database_id")
            if lid:
                relations.append({"type": "link_to_page", "target_id": lid})
        elif t == "child_page":
            relations.append({"type": "child_page", "target_id": b.get("id")})
        elif t == "child_database":
            relations.append({"type": "child_database", "target_id": b.get("id")})
        for key in ["paragraph", "heading_1", "heading_2", "heading_3", "bulleted_list_item", "numbered_list_item", "quote", "callout", "toggle"]:
            if key == t:
                for rt in b.get(key, {}).get("rich_text", []):
                    if rt.get("type") == "mention" and rt.get("mention", {}).get("page"):
                        relations.append({"type": "mention", "target_id": rt["mention"]["page"].get("id", "")})
                    elif rt.get("type") == "mention" and rt.get("mention", {}).get("database"):
                        relations.append({"type": "mention_db", "target_id": rt["mention"]["database"].get("id", "")})
        children = b.get("children", [])
        if children:
            relations.extend(extract_relations_from_blocks(children))
    return relations


def extract_relations_from_properties(props):
    relations = []
    for name, meta in props.items():
        if meta.get("type") == "relation":
            for rel in meta.get("relation", []):
                relations.append({"type": f"property_relation:{name}", "target_id": rel.get("id", "")})
    return relations


def process_one_page(rec, pages_map, dbs_map):
    pid = rec["page_id"]
    text = rec.get("text_preview", "")
    blocks_path = CONTENT_DIR / f"{pid}_blocks.json"
    blocks = []
    if blocks_path.exists():
        blocks = json.loads(blocks_path.read_text(encoding="utf-8"))
    
    rels = []
    rels.extend(extract_mentions_and_links(text))
    rels.extend(extract_relations_from_blocks(blocks))
    
    resp = rate_limited_notion_api("GET", f"pages/{pid}")
    if resp["ok"]:
        rels.extend(extract_relations_from_properties(resp["data"].get("properties", {})))
    
    records = []
    for r in rels:
        tid = r["target_id"]
        records.append({
            "source_id": pid,
            "source_title": rec.get("title", ""),
            "relation_type": r["type"],
            "target_id": tid,
            "target_title": pages_map.get(tid, {}).get("title", "") or dbs_map.get(tid, {}).get("title", ""),
        })
    return records


def main():
    scan_path = OUT_DIR / "workspace_scan.json"
    if not scan_path.exists():
        log("🔴 workspace_scan.json 不存在")
        return
    
    scan = json.loads(scan_path.read_text(encoding="utf-8"))
    pages_map = {p["id"]: p for p in scan.get("pages", [])}
    dbs_map = {d["id"]: d for d in scan.get("databases", [])}
    
    records = []
    completed = 0
    files = sorted(CONTENT_DIR.glob("*.json"))
    files = [f for f in files if not f.name.endswith('_blocks.json')]
    log(f"🟢 开始提取 {len(files)} 个页面的关系")
    
    with ThreadPoolExecutor(max_workers=3) as executor:
        future_to_rec = {}
        for fpath in files:
            rec = json.loads(fpath.read_text(encoding="utf-8"))
            future = executor.submit(process_one_page, rec, pages_map, dbs_map)
            future_to_rec[future] = rec
        
        for future in as_completed(future_to_rec):
            rec = future_to_rec[future]
            completed += 1
            try:
                result = future.result()
                records.extend(result)
                if completed % 100 == 0:
                    log(f"🟢 [{completed}/{len(files)}] 关系提取中，已收集 {len(records)} 条关系")
            except Exception as e:
                log(f"🔴 [{completed}/{len(files)}] 异常: {e}")
    
    rel_path = OUT_DIR / "notion_relations.json"
    rel_path.write_text(json.dumps(records, ensure_ascii=False, indent=2), encoding="utf-8")
    log(f"🟢 关系提取完成：{len(records)} 条关系")
    log(f"🟢 保存：{rel_path}")


if __name__ == "__main__":
    main()
