║  《网络安全法》检查器 — 网安法合规引擎                              ║
║  CSL (Cybersecurity Law) Compliance Checker                         ║
╚══════════════════════════════════════════════════════════════════════╝

法律依据 / Legal Basis:
  - 第22条：网络产品服务安全 / Art.22: Network product/service security
  - 第40条：网络运营者信息保护义务 / Art.40: Operator info protection obligations
  - 第42条：个人信息不得泄露、篡改、毁损 / Art.42: No disclosure/alteration/damage

三色审计 / Three-Color Audit:
  🟢 合规 Compliant | 🟡 警示 Warning | 🔴 违规 Violation
"""

import json
from datetime import datetime
from typing import Dict, List, Any


class 网安法检查结果:
    """网安法检查结果 / CSL Check Result"""

    def __init__(self):
        self.法律名称 = "《网络安全法》"
        self.检查通过 = True
        self.综合得分 = 100
        self.风险等级 = "🟢低"
        self.检查项: List[Dict[str, Any]] = []
        self.不合规项: List[str] = []
        self.改进建议: List[str] = []
        self.检查时间 = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        self.法律依据引用: List[str] = []

    def to_dict(self) -> Dict[str, Any]:
        return {
            "法律名称": self.法律名称,
            "检查通过": self.检查通过,
            "综合得分": self.综合得分,
            "风险等级": self.风险等级,
            "检查项": self.检查项,
            "不合规项": self.不合规项,
            "改进建议": self.改进建议,
            "检查时间": self.检查时间,
            "法律依据引用": self.法律依据引用,
        }

    def to_markdown(self) -> str:
        md = f"""## {self.法律名称} 合规检查报告

**检查时间**: {self.检查时间}
**综合得分**: {self.综合得分}/100
**风险等级**: {self.风险等级}

### 检查结果概览

| 检查维度 | 得分 | 状态 |
|---------|------|------|
"""
        for item in self.检查项:
            status_icon = "🟢" if item["得分"] >= 80 else "🟡" if item["得分"] >= 60 else "🔴"
            md += f"| {item['维度']} | {item['得分']} | {status_icon} |\n"

        if self.不合规项:
            md += "\n### 🔴 不合规项\n"
            for i, item in enumerate(self.不合规项, 1):
                md += f"{i}. {item}\n"

        if self.改进建议:
            md += "\n### 💡 改进建议\n"
            for i, sug in enumerate(self.改进建议, 1):
                md += f"{i}. {sug}\n"

        if self.法律依据引用:
            md += "\n### 📚 法律依据\n"
            for law in self.法律依据引用:
                md += f"- {law}\n"

        return md

    def _更新评分(self):
        """内部方法：更新综合评分"""
        if not self.检查项:
            return
        total = sum(item["得分"] for item in self.检查项)
        self.综合得分 = round(total / len(self.检查项))
        self.风险等级 = "🟢低" if self.综合得分 >= 80 else "🟡中" if self.综合得分 >= 60 else "🔴高"
        self.检查通过 = self.综合得分 >= 60


class 网安法检查器:
    """
    《网络安全法》合规检查器
    CSL Compliance Checker
    """

    def __init__(self):
        self.DNA = "#龍芯⚡️2026-06-19-CNSH-CHINA-COMPLIANCE-v1.0"
        self.法律 = "《网络安全法》"

    def 检查(self, 操作数据: Dict[str, Any]) -> 网安法检查结果:
        """
        执行网安法全面检查
        Perform comprehensive CSL compliance check

        参数 / Parameters:
            操作数据: 包含以下键：
                    - 安全认证: bool 是否有安全认证
                    - 安全漏洞报告: bool 是否有漏洞报告机制
                    - 恶意程序防范: bool 是否有恶意程序防范
                    - 日志留存: bool 是否留存网络日志（不少于六个月）
                    - 日志留存月数: int 日志留存月数
                    - 数据加密: bool 是否对用户数据加密
                    - 信息泄露事件: bool 是否发生过信息泄露
                    - 事件报告: bool 是否及时报告安全事件
                    - 应急预案: bool 是否有应急预案
                    - 用户身份核验: bool 是否核验用户真实身份
                    - 违法信息处置: bool 是否处置违法信息
                    - 协助执法: bool 是否协助执法机关
                    - 等级保护: bool 是否完成等级保护备案
                    - 等保级别: str 等保级别（1-5级）

        返回 / Returns:
            网安法检查结果对象
        """
        结果 = 网安法检查结果()

        # ═══════════════════════════════════════════════
        # 维度1: 网络产品服务安全 (第22条)
        # ═══════════════════════════════════════════════
        结果.检查项.append(self._检查产品安全(操作数据))

        # ═══════════════════════════════════════════════
        # 维度2: 日志留存
        # ═══════════════════════════════════════════════
        结果.检查项.append(self._检查日志留存(操作数据))

        # ═══════════════════════════════════════════════
        # 维度3: 信息保护 (第40条)
        # ═══════════════════════════════════════════════
        结果.检查项.append(self._检查信息保护(操作数据))

        # ═══════════════════════════════════════════════
        # 维度4: 信息泄露处置 (第42条)
        # ═══════════════════════════════════════════════
        结果.检查项.append(self._检查泄露处置(操作数据))

        # ═══════════════════════════════════════════════
        # 维度5: 用户身份核验
        # ═══════════════════════════════════════════════
        结果.检查项.append(self._检查身份核验(操作数据))

        # ═══════════════════════════════════════════════
        # 维度6: 违法信息处置
        # ═══════════════════════════════════════════════
        结果.检查项.append(self._检查违法信息处置(操作数据))

        # ═══════════════════════════════════════════════
        # 维度7: 等级保护
        # ═══════════════════════════════════════════════
        结果.检查项.append(self._检查等级保护(操作数据))

        # ═══════════════════════════════════════════════
        # 维度8: 应急响应
        # ═══════════════════════════════════════════════
        结果.检查项.append(self._检查应急响应(操作数据))

        结果._更新评分()

        结果.法律依据引用 = [
            "第22条：网络产品、服务应当符合相关国家标准的强制性要求",
            "第40条：网络运营者应当对其收集的用户信息严格保密，并建立健全用户信息保护制度",
            "第42条：网络运营者不得泄露、篡改、毁损其收集的个人信息",
        ]

        return 结果

    def _检查产品安全(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """检查网络产品服务安全 / Check product security"""
        安全认证 = 数据.get("安全认证", False)
        安全漏洞报告 = 数据.get("安全漏洞报告", False)
        恶意程序防范 = 数据.get("恶意程序防范", False)

        if 安全认证 and 安全漏洞报告 and 恶意程序防范:
            return {
                "维度": "产品服务安全",
                "得分": 100,
                "状态": "🟢合规",
                "详情": "通过安全认证，有漏洞报告和恶意程序防范机制",
            }
        elif 安全认证 and 安全漏洞报告:
            return {
                "维度": "产品服务安全",
                "得分": 80,
                "状态": "🟢合规",
                "详情": "有安全认证和漏洞报告，建议增加恶意程序防范",
            }
        elif 安全认证 or 安全漏洞报告 or 恶意程序防范:
            return {
                "维度": "产品服务安全",
                "得分": 55,
                "状态": "🟡警示",
                "详情": "安全措施部分到位，建议完善",
            }
        else:
            return {
                "维度": "产品服务安全",
                "得分": 15,
                "状态": "🔴违规",
                "详情": "网络产品服务安全措施严重不足，违反第22条",
            }

    def _检查日志留存(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """检查网络日志留存 / Check log retention"""
        日志留存 = 数据.get("日志留存", False)
        日志留存月数 = 数据.get("日志留存月数", 0)

        if 日志留存 and 日志留存月数 >= 6:
            return {
                "维度": "日志留存",
                "得分": 100,
                "状态": "🟢合规",
                "详情": f"网络日志留存{日志留存月数}个月，符合不少于六个月要求",
            }
        elif 日志留存 and 日志留存月数 >= 3:
            return {
                "维度": "日志留存",
                "得分": 60,
                "状态": "🟡警示",
                "详情": f"日志留存{日志留存月数}个月，不足六个月",
            }
        elif 日志留存:
            return {
                "维度": "日志留存",
                "得分": 35,
                "状态": "🟡警示",
                "详情": "日志留存时间过短",
            }
        else:
            return {
                "维度": "日志留存",
                "得分": 10,
                "状态": "🔴违规",
                "详情": "未留存网络日志，违反网安法要求",
            }

    def _检查信息保护(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """检查信息保护义务 (第40条) / Check info protection"""
        数据加密 = 数据.get("数据加密", False)
        用户信息保护制度 = 数据.get("用户信息保护制度", False)
        保密协议 = 数据.get("保密协议", False)

        if 数据加密 and 用户信息保护制度 and 保密协议:
            return {
                "维度": "信息保护义务",
                "得分": 100,
                "状态": "🟢合规",
                "详情": "已建立完善的用户信息保护制度",
            }
        elif 数据加密 and 用户信息保护制度:
            return {
                "维度": "信息保护义务",
                "得分": 80,
                "状态": "🟢合规",
                "详情": "有数据加密和保护制度",
            }
        elif 数据加密 or 用户信息保护制度:
            return {
                "维度": "信息保护义务",
                "得分": 55,
                "状态": "🟡警示",
                "详情": "信息保护措施部分到位",
            }
        else:
            return {
                "维度": "信息保护义务",
                "得分": 15,
                "状态": "🔴违规",
                "详情": "未建立用户信息保护制度，违反第40条",
            }

    def _检查泄露处置(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """检查信息泄露处置 (第42条) / Check leak handling"""
        信息泄露事件 = 数据.get("信息泄露事件", False)
        事件报告 = 数据.get("事件报告", False)
        补救措施 = 数据.get("补救措施", False)

        if not 信息泄露事件:
            return {
                "维度": "泄露处置",
                "得分": 100,
                "状态": "🟢合规",
                "详情": "未发生信息泄露事件",
            }
        elif 信息泄露事件 and 事件报告 and 补救措施:
            return {
                "维度": "泄露处置",
                "得分": 80,
                "状态": "🟢合规",
                "详情": "发生泄露但已报告并采取补救措施",
            }
        elif 信息泄露事件 and 事件报告:
            return {
                "维度": "泄露处置",
                "得分": 50,
                "状态": "🟡警示",
                "详情": "已报告泄露事件但未采取补救措施",
            }
        elif 信息泄露事件 and 补救措施:
            return {
                "维度": "泄露处置",
                "得分": 45,
                "状态": "🟡警示",
                "详情": "已采取补救但未报告有关部门",
            }
        else:
            return {
                "维度": "泄露处置",
                "得分": 10,
                "状态": "🔴违规",
                "详情": "发生泄露未报告未补救，严重违反第42条",
            }

    def _检查身份核验(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """检查用户身份核验 / Check user identity verification"""
        用户身份核验 = 数据.get("用户身份核验", False)
        实名制 = 数据.get("实名制", False)

        if 用户身份核验 and 实名制:
            return {
                "维度": "身份核验",
                "得分": 100,
                "状态": "🟢合规",
                "详情": "已实施用户真实身份核验和实名制",
            }
        elif 用户身份核验:
            return {
                "维度": "身份核验",
                "得分": 75,
                "状态": "🟡警示",
                "详情": "有身份核验但未完全实施实名制",
            }
        elif 实名制:
            return {
                "维度": "身份核验",
                "得分": 60,
                "状态": "🟡警示",
                "详情": "有实名制要求但核验机制不完善",
            }
        else:
            return {
                "维度": "身份核验",
                "得分": 20,
                "状态": "🔴违规",
                "详情": "未核验用户真实身份，违反第24条",
            }

    def _检查违法信息处置(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """检查违法信息处置 / Check illegal content handling"""
        违法信息处置 = 数据.get("违法信息处置", False)
        处置时限 = 数据.get("处置时限", "")
        协助执法 = 数据.get("协助执法", False)

        if 违法信息处置 and 协助执法 and 处置时限 in ["立即", "1小时内", "24小时内"]:
            return {
                "维度": "违法信息处置",
                "得分": 100,
                "状态": "🟢合规",
                "详情": f"违法信息{处置时限}处置，配合执法机关",
            }
        elif 违法信息处置 and 协助执法:
            return {
                "维度": "违法信息处置",
                "得分": 75,
                "状态": "🟢合规",
                "详情": "处置违法信息并协助执法",
            }
        elif 违法信息处置:
            return {
                "维度": "违法信息处置",
                "得分": 55,
                "状态": "🟡警示",
                "详情": "有违法信息处置机制，但配合执法不够",
            }
        else:
            return {
                "维度": "违法信息处置",
                "得分": 15,
                "状态": "🔴违规",
                "详情": "未建立违法信息处置机制",
            }

    def _检查等级保护(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """检查网络安全等级保护 / Check classified protection"""
        等级保护 = 数据.get("等级保护", False)
        等保级别 = 数据.get("等保级别", "")

        if 等级保护 and 等保级别 in ["二级", "三级", "四级", "五级"]:
            return {
                "维度": "等级保护",
                "得分": 100,
                "状态": "🟢合规",
                "详情": f"已完成网络安全等级保护{等保级别}备案",
            }
        elif 等级保护:
            return {
                "维度": "等级保护",
                "得分": 70,
                "状态": "🟡警示",
                "详情": "已完成等保备案但级别不明确",
            }
        else:
            return {
                "维度": "等级保护",
                "得分": 25,
                "状态": "🔴违规",
                "详情": "未完成网络安全等级保护备案",
            }

    def _检查应急响应(self, 数据: Dict[str, Any]) -> Dict[str, Any]:
        """检查应急响应 / Check emergency response"""
        应急预案 = 数据.get("应急预案", False)
        演练记录 = 数据.get("演练记录", False)
        报告时限 = 数据.get("报告时限", "")

        if 应急预案 and 演练记录 and 报告时限 in ["立即", "1小时内"]:
            return {
                "维度": "应急响应",
                "得分": 100,
                "状态": "🟢合规",
                "详情": f"有应急预案和演练，安全事件{报告时限}报告",
            }
        elif 应急预案 and 演练记录:
            return {
                "维度": "应急响应",
                "得分": 80,
                "状态": "🟢合规",
                "详情": "有应急预案和演练记录",
            }
        elif 应急预案:
            return {
                "维度": "应急响应",
                "得分": 60,
                "状态": "🟡警示",
                "详情": "有应急预案但未演练",
            }
        else:
            return {
                "维度": "应急响应",
                "得分": 20,
                "状态": "🔴违规",
                "详情": "无网络安全应急预案",
            }


