# ═══════════════════════════════════════════════════════════════
# SM4国密分组密码 (纯Python实现)
# ═══════════════════════════════════════════════════════════════
class SM4密码器:
    """
    通心译 | TongXinYi: SM4 Block Cipher
    国密SM4分组密码算法，分组长度128位，密钥长度128位
    本实现为纯Python版本，兼容gmssl接口
    """

    # S盒 (256字节)
    S盒 = bytes([
        0xD6, 0x90, 0xE9, 0xFE, 0xCC, 0xE1, 0x3D, 0xB7, 0x16, 0xB6, 0x14, 0xC2, 0x28, 0xFB, 0x2C, 0x05,
        0x2B, 0x67, 0x9A, 0x76, 0x2A, 0xBE, 0x04, 0xC3, 0xAA, 0x44, 0x13, 0x26, 0x49, 0x86, 0x06, 0x99,
        0x9C, 0x42, 0x50, 0xF4, 0x91, 0xEF, 0x98, 0x7A, 0x33, 0x54, 0x0B, 0x43, 0xED, 0xCF, 0xAC, 0x62,
        0xE4, 0xB3, 0x1C, 0xA9, 0xC9, 0x08, 0xE8, 0x95, 0x80, 0xDF, 0x94, 0xFA, 0x75, 0x8F, 0x3F, 0xA6,
        0x47, 0x07, 0xA7, 0xFC, 0xF3, 0x73, 0x17, 0xBA, 0x83, 0x59, 0x3C, 0x19, 0xE6, 0x85, 0x4F, 0xA8,
        0x68, 0x6B, 0x81, 0xB2, 0x71, 0x64, 0xDA, 0x8B, 0xF8, 0xEB, 0x0F, 0x4B, 0x70, 0x56, 0x9D, 0x35,
        0x1E, 0x24, 0x0E, 0x5E, 0x63, 0x58, 0xD1, 0xA2, 0x25, 0x22, 0x7C, 0x3B, 0x01, 0x21, 0x78, 0x87,
        0xD4, 0x00, 0x46, 0x57, 0x9F, 0xD3, 0x27, 0x52, 0x4C, 0x36, 0x02, 0xE7, 0xA0, 0xC4, 0xC8, 0x9E,
        0xEA, 0xBF, 0x8A, 0xD2, 0x40, 0xC7, 0x38, 0xB5, 0xA3, 0xF7, 0xF2, 0xCE, 0xF9, 0x61, 0x15, 0xA1,
        0xE0, 0xAE, 0x5D, 0xA4, 0x9B, 0x34, 0x1A, 0x55, 0xAD, 0x93, 0x32, 0x30, 0xF5, 0x8C, 0xB1, 0xE3,
        0x1D, 0xF6, 0xE2, 0x2E, 0x82, 0x66, 0xCA, 0x60, 0xC0, 0x29, 0x23, 0xAB, 0x0D, 0x53, 0x4E, 0x6F,
        0xD5, 0xDB, 0x37, 0x45, 0xDE, 0xFD, 0x8E, 0x2F, 0x03, 0xFF, 0x6A, 0x72, 0x6D, 0x6C, 0x5B, 0x51,
        0x8D, 0x1B, 0xAF, 0x92, 0xBB, 0xDD, 0xBC, 0x7F, 0x11, 0xD9, 0x5C, 0x41, 0x1F, 0x10, 0x5A, 0xD8,
        0x0A, 0xC1, 0x31, 0x88, 0xA5, 0xCD, 0x7B, 0xBD, 0x2D, 0x74, 0xD0, 0x12, 0xB8, 0xE5, 0xB4, 0xB0,
        0x89, 0x69, 0x97, 0x4A, 0x0C, 0x96, 0x77, 0x7E, 0x65, 0xB9, 0xF1, 0x09, 0xC5, 0x6E, 0xC6, 0x84,
        0x18, 0xF0, 0x7D, 0xEC, 0x3A, 0xDC, 0x4D, 0x20, 0x79, 0xEE, 0x5F, 0x3E, 0xD7, 0xCB, 0x39, 0x48
    ])

    # FK常量 (密钥扩展用)
    FK = [0xA3B1BAC6, 0x56AA3350, 0x677D9197, 0xB27022DC]

    # CK常量 (轮密钥扩展用) - 32个
    CK = [
        0x00070E15, 0x1C232A31, 0x383F464D, 0x545B6269,
        0x70777E85, 0x8C939AA1, 0xA8AFB6BD, 0xC4CBD2D9,
        0xE0E7EEF5, 0xFC030A11, 0x181F262D, 0x343B4249,
        0x50575E65, 0x6C737A81, 0x888F969D, 0xA4ABB2B9,
        0xC0C7CED5, 0xDCE3EAF1, 0xF8FF060D, 0x141B2229,
        0x30373E45, 0x4C535A61, 0x686F767D, 0x848B9299,
        0xA0A7AEB5, 0xBCC3CAD1, 0xD8DFE6ED, 0xF4FB0209,
        0x10171E25, 0x2C333A41, 0x484F565D, 0x646B7279
    ]

    def __init__(自身):
        自身.轮密钥 = None
        print(f"[SM4密码器] 🐉 SM4分组密码已初始化 (纯Python实现)")

    @staticmethod
    def _循环左移(值, 位数):
        """🔴 32位循环左移 | 32-bit circular left shift"""
        return ((值 << 位数) & 0xFFFFFFFF) | (值 >> (32 - 位数))

    @classmethod
    def _τ变换(cls, 输入值):
        """🔴 字节替换τ | Byte substitution τ"""
        return (
            (cls.S盒[(输入值 >> 24) & 0xFF] << 24) |
            (cls.S盒[(输入值 >> 16) & 0xFF] << 16) |
            (cls.S盒[(输入值 >> 8) & 0xFF] << 8) |
            cls.S盒[输入值 & 0xFF]
        )

    @classmethod
    def _L变换(cls, 输入值):
        """🔴 线性变换L | Linear transformation L"""
        return (
            输入值 ^
            cls._循环左移(输入值, 2) ^
            cls._循环左移(输入值, 10) ^
            cls._循环左移(输入值, 18) ^
            cls._循环左移(输入值, 24)
        )

    @classmethod
    def _L_变换(cls, 输入值):
        """🔴 密钥扩展线性变换L' | Key schedule linear transformation L'"""
        return 输入值 ^ cls._循环左移(输入值, 13) ^ cls._循环左移(输入值, 23)

    @classmethod
    def _F变换(cls, X0, X1, X2, X3, 轮密钥):
        """🔴 轮函数F | Round function F"""
        return X0 ^ cls._L变换(cls._τ变换(X1 ^ X2 ^ X3 ^ 轮密钥))

    def 设置密钥(自身, 密钥: bytes):
        """
        🟢 设置SM4密钥 | Set SM4 key
        :param 密钥: 16字节(128位)密钥
        """
        if len(密钥) != 16:
            raise ValueError("SM4密钥必须为16字节(128位)")

        # 将密钥分为4个32位字
        K = [0] * 36
        for i in range(4):
            K[i] = struct.unpack('>I', 密钥[i * 4:(i + 1) * 4])[0] ^ SM4密码器.FK[i]

        # 生成32个轮密钥
        自身.轮密钥 = [0] * 32
        for i in range(32):
            K[i + 4] = K[i] ^ SM4密码器._L_变换(SM4密码器._τ变换(K[i + 1] ^ K[i + 2] ^ K[i + 3] ^ SM4密码器.CK[i]))
            自身.轮密钥[i] = K[i + 4]

    def 加密分组(自身, 明文: bytes) -> bytes:
        """
        🟢 加密单个分组 | Encrypt single block
        :param 明文: 16字节明文
        :return: 16字节密文
        """
        if 自身.轮密钥 is None:
            raise ValueError("未设置密钥")
        if len(明文) != 16:
            raise ValueError("明文必须为16字节")

        X = [0] * 36
        for i in range(4):
            X[i] = struct.unpack('>I', 明文[i * 4:(i + 1) * 4])[0]

        for i in range(32):
            X[i + 4] = SM4密码器._F变换(X[i], X[i + 1], X[i + 2], X[i + 3], 自身.轮密钥[i])

        # 反序变换
        密文 = b''.join(struct.pack('>I', X[35 - i]) for i in range(4))
        return 密文

    def 解密分组(自身, 密文: bytes) -> bytes:
        """
        🟢 解密单个分组 | Decrypt single block
        :param 密文: 16字节密文
        :return: 16字节明文
        """
        if 自身.轮密钥 is None:
            raise ValueError("未设置密钥")
        if len(密文) != 16:
            raise ValueError("密文必须为16字节")

        X = [0] * 36
        for i in range(4):
            X[i] = struct.unpack('>I', 密文[i * 4:(i + 1) * 4])[0]

        # 解密使用反序轮密钥
        for i in range(32):
            X[i + 4] = SM4密码器._F变换(X[i], X[i + 1], X[i + 2], X[i + 3], 自身.轮密钥[31 - i])

        明文 = b''.join(struct.pack('>I', X[35 - i]) for i in range(4))
        return 明文

    def ECB加密(自身, 明文: bytes) -> bytes:
        """🟡 ECB模式加密 | ECB mode encryption (不推荐用于敏感数据)"""
        填充明文 = 自身._PKCS7填充(明文, 16)
        密文 = b''
        for i in range(0, len(填充明文), 16):
            密文 += 自身.加密分组(填充明文[i:i + 16])
        return 密文

    def ECB解密(自身, 密文: bytes) -> bytes:
        """🟡 ECB模式解密 | ECB mode decryption"""
        明文 = b''
        for i in range(0, len(密文), 16):
            明文 += 自身.解密分组(密文[i:i + 16])
        return 自身._PKCS7去填充(明文)

    @staticmethod
    def _PKCS7填充(数据: bytes, 块大小: int) -> bytes:
        """🔴 PKCS7填充 | PKCS7 padding"""
        填充长度 = 块大小 - (len(数据) % 块大小)
        return 数据 + bytes([填充长度] * 填充长度)

    @staticmethod
    def _PKCS7去填充(数据: bytes) -> bytes:
        """🔴 PKCS7去填充 | PKCS7 unpadding"""
        填充长度 = 数据[-1]
        return 数据[:-填充长度]


# ═══════════════════════════════════════════════════════════════
# 加密存储引擎 | Encrypted Storage Engine
# ═══════════════════════════════════════════════════════════════
class 加密存储引擎:
    """
    通心译 | TongXinYi: Encrypted Storage Engine
    使用SM4国密算法加密存储敏感令牌数据
    """

    def __init__(自身, 密钥路径: str | None = None):
        自身.密钥路径 = 密钥路径 or os.path.expanduser("~/.cns/sm4_key.bin")
        自身.SM4 = SM4密码器()
        自身._初始化密钥()

    def _初始化密钥(自身):
        """🔴 初始化或加载SM4密钥 | Initialize or load SM4 key"""
        if os.path.exists(自身.密钥路径):
            with open(自身.密钥路径, 'rb') as f:
                密钥 = f.read()
        else:
            # 生成新密钥
            os.makedirs(os.path.dirname(自身.密钥路径), exist_ok=True)
            密钥 = secrets.token_bytes(16)
            with open(自身.密钥路径, 'wb') as f:
                f.write(密钥)
            print(f"[加密引擎] 🟢 已生成新SM4密钥: {自身.密钥路径}")

        自身.SM4.设置密钥(密钥)
        print(f"[加密引擎] 🐉 SM4加密引擎已初始化")

    def 加密(自身, 明文: bytes) -> bytes:
        """🟢 加密数据 | Encrypt data"""
        return 自身.SM4.ECB加密(明文)

    def 解密(自身, 密文: bytes) -> bytes:
        """🟢 解密数据 | Decrypt data"""
        return 自身.SM4.ECB解密(密文)


# ═══════════════════════════════════════════════════════════════
# DNA令牌存储管理器 | DNA Token Storage Manager
# ═══════════════════════════════════════════════════════════════
class DNA令牌存储管理器:
    """
    通心译 | TongXinYi: DNA Token Storage Manager
    龍魂DNA令牌的SQLite加密存储与生命周期管理
    """

    def __init__(自身, 数据库路径: str | None = None, 加密密钥路径: str | None = None):
        """
        初始化令牌存储管理器
        :param 数据库路径: SQLite数据库文件路径
        :param 加密密钥路径: SM4加密密钥路径
        """
        自身.数据库路径 = 数据库路径 or os.path.expanduser("~/.cns/龍魂令牌库.db")
        自身.锁 = threading.RLock()

        # 确保目录存在
        os.makedirs(os.path.dirname(自身.数据库路径), exist_ok=True)

        # 初始化加密引擎
        自身.加密引擎 = 加密存储引擎(加密密钥路径)

        # 初始化数据库
        自身._初始化数据库()
        print(f"[令牌存储] 🐉 DNA令牌存储管理器已初始化 | 库: {自身.数据库路径}")

    def _初始化数据库(自身):
        """🔴 初始化SQLite数据库表结构 | Initialize database schema"""
        with sqlite3.connect(自身.数据库路径) as 连接:
            游标 = 连接.cursor()

            # 令牌主表
            游标.execute('''
                CREATE TABLE IF NOT EXISTS 令牌表 (
                    token_id TEXT PRIMARY KEY,
                    user_identity TEXT NOT NULL,
                    dna_header TEXT NOT NULL,
                    identity_hash TEXT NOT NULL,
                    hexagram_audit TEXT,
                    scope_json TEXT NOT NULL,
                    platform_key TEXT,
                    expiry TEXT NOT NULL,
                    issued_at TEXT NOT NULL,
                    signature TEXT NOT NULL,
                    wuxing_json TEXT,
                    status TEXT DEFAULT '有效',
                    encrypted_payload BLOB
                )
            ''')

            # 撤销记录表
            游标.execute('''
                CREATE TABLE IF NOT EXISTS 撤销表 (
                    token_id TEXT PRIMARY KEY,
                    revoked_at TEXT NOT NULL,
                    reason TEXT,
                    revoked_by TEXT
                )
            ''')

            # 访问日志表
            游标.execute('''
                CREATE TABLE IF NOT EXISTS 访问日志 (
                    log_id INTEGER PRIMARY KEY AUTOINCREMENT,
                    token_id TEXT,
                    action TEXT NOT NULL,
                    timestamp TEXT NOT NULL,
                    platform TEXT,
                    result TEXT
                )
            ''')

            # 创建索引
            游标.execute('CREATE INDEX IF NOT EXISTS idx_token_user ON 令牌表(user_identity)')
            游标.execute('CREATE INDEX IF NOT EXISTS idx_token_status ON 令牌表(status)')
            游标.execute('CREATE INDEX IF NOT EXISTS idx_token_expiry ON 令牌表(expiry)')
            游标.execute('CREATE INDEX IF NOT EXISTS idx_log_token ON 访问日志(token_id)')

            连接.commit()

    # ═══════════════════════════════════════════════════════════════
    # 令牌CRUD操作 | Token CRUD Operations
    # ═══════════════════════════════════════════════════════════════

    def 存储令牌(自身, 令牌数据: Dict[str, Any]) -> bool:
        """
        🟢 存储新令牌 | Store a new token
        :param 令牌数据: 完整的令牌字典
        :return: 存储是否成功
        """
        with 自身.锁:
            try:
                # 加密敏感字段
                敏感数据 = json.dumps({
                    'scope': 令牌数据.get('scope', []),
                    'wuxing_sig': 令牌数据.get('wuxing_sig', {})
                }, ensure_ascii=False).encode('utf-8')
                加密负载 = 自身.加密引擎.加密(敏感数据)

                with sqlite3.connect(自身.数据库路径) as 连接:
                    游标 = 连接.cursor()
                    游标.execute('''
                        INSERT OR REPLACE INTO 令牌表 (
                            token_id, user_identity, dna_header, identity_hash,
                            hexagram_audit, scope_json, platform_key, expiry,
                            issued_at, signature, wuxing_json, status, encrypted_payload
                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                    ''', (
                        令牌数据['token_id'],
                        令牌数据.get('user_identity', ''),
                        令牌数据.get('dna_header', ''),
                        令牌数据.get('identity_hash', ''),
                        令牌数据.get('hexagram_audit', ''),
                        json.dumps(令牌数据.get('scope', []), ensure_ascii=False),
                        令牌数据.get('platform_key', ''),
                        令牌数据.get('expiry', ''),
                        令牌数据.get('issued_at', ''),
                        令牌数据.get('signature', ''),
                        json.dumps(令牌数据.get('wuxing_sig', {}), ensure_ascii=False),
                        '有效',
                        加密负载
                    ))
                    连接.commit()

                自身._记录日志(令牌数据['token_id'], '创建', '成功')
                print(f"[令牌存储] 🟢 令牌已存储: {令牌数据['token_id'][:16]}...")
                return True

            except Exception as 错误:
                自身._记录日志(令牌数据.get('token_id', ''), '创建', f'失败: {错误}')
                print(f"[令牌存储] 🔴 存储失败: {错误}")
                return False

    def 查询令牌(自身, 令牌ID: str) -> Optional[Dict]:
        """
        🟢 查询指定令牌 | Query token by ID
        :param 令牌ID: 令牌UUID
        :return: 令牌字典或None
        """
        with sqlite3.connect(自身.数据库路径) as 连接:
            连接.row_factory = sqlite3.Row
            游标 = 连接.cursor()
            游标.execute('SELECT * FROM 令牌表 WHERE token_id = ?', (令牌ID,))
            行 = 游标.fetchone()

            if 行 is None:
                return None

            return 自身._行转字典(行)

    def 查询用户令牌(自身, 用户身份: str, 包含过期: bool = False) -> List[Dict]:
        """
        🟢 查询用户的所有有效令牌 | Query user's active tokens
        :param 用户身份: 用户身份标识
        :param 包含过期: 是否包含已过期令牌
        :return: 令牌列表
        """
        with sqlite3.connect(自身.数据库路径) as 连接:
            连接.row_factory = sqlite3.Row
            游标 = 连接.cursor()

            if 包含过期:
                游标.execute('''
                    SELECT * FROM 令牌表
                    WHERE user_identity = ? AND status = '有效'
                    ORDER BY issued_at DESC
                ''', (用户身份,))
            else:
                现在 = datetime.now().isoformat()
                游标.execute('''
                    SELECT * FROM 令牌表
                    WHERE user_identity = ? AND status = '有效' AND expiry > ?
                    ORDER BY issued_at DESC
                ''', (用户身份, 现在))

            return [自身._行转字典(row) for row in 游标.fetchall()]

    def 撤销令牌(自身, 令牌ID: str, 原因: str = "用户主动撤销", 操作者: str = "用户") -> bool:
        """
        🔴 撤销指定令牌 | Revoke a token
        :param 令牌ID: 要撤销的令牌ID
        :param 原因: 撤销原因
        :param 操作者: 执行撤销的操作者
        :return: 撤销是否成功
        """
        with 自身.锁:
            try:
                现在 = datetime.now().isoformat()

                with sqlite3.connect(自身.数据库路径) as 连接:
                    游标 = 连接.cursor()

                    # 更新令牌状态
                    游标.execute('''
                        UPDATE 令牌表 SET status = '已撤销' WHERE token_id = ?
                    ''', (令牌ID,))

                    # 记录撤销
                    游标.execute('''
                        INSERT OR REPLACE INTO 撤销表 (token_id, revoked_at, reason, revoked_by)
                        VALUES (?, ?, ?, ?)
                    ''', (令牌ID, 现在, 原因, 操作者))

                    连接.commit()

                自身._记录日志(令牌ID, '撤销', '成功', 操作者)
                print(f"[令牌存储] 🔴 令牌已撤销: {令牌ID[:16]}... | 原因: {原因}")
                return True

            except Exception as 错误:
                自身._记录日志(令牌ID, '撤销', f'失败: {错误}')
                print(f"[令牌存储] 🔴 撤销失败: {错误}")
                return False

    def 清理过期令牌(自身, 批量大小: int = 100) -> int:
        """
        🟡 清理已过期令牌 | Clean up expired tokens
        :param 批量大小: 每次清理数量上限
        :return: 清理的令牌数量
        """
        现在 = datetime.now().isoformat()

        with sqlite3.connect(自身.数据库路径) as 连接:
            游标 = 连接.cursor()

            # 查找过期令牌
            游标.execute('''
                SELECT token_id FROM 令牌表
                WHERE status = '有效' AND expiry < ?
                LIMIT ?
            ''', (现在, 批量大小))

            过期令牌 = [row[0] for row in 游标.fetchall()]

            if 过期令牌:
                # 批量更新状态
                游标.executemany('''
                    UPDATE 令牌表 SET status = '已过期' WHERE token_id = ?
                ''', [(tid,) for tid in 过期令牌])
                连接.commit()

                for 令牌ID in 过期令牌:
                    自身._记录日志(令牌ID, '过期清理', '自动')

                print(f"[令牌存储] 🟡 已清理 {len(过期令牌)} 个过期令牌")

            return len(过期令牌)

    # ═══════════════════════════════════════════════════════════════
    # 内部方法 | Internal Methods
    # ═══════════════════════════════════════════════════════════════

    def _行转字典(自身, 行) -> Dict[str, Any]:
        """🔴 将数据库行转为字典 | Convert database row to dict"""
        结果 = dict(行)

        # 解密敏感负载
        if 结果.get('encrypted_payload'):
            try:
                解密数据 = 自身.加密引擎.解密(结果['encrypted_payload'])
                敏感信息 = json.loads(解密数据.decode('utf-8'))
                结果['scope'] = 敏感信息.get('scope', [])
                结果['wuxing_sig'] = 敏感信息.get('wuxing_sig', {})
            except Exception:
                结果['scope'] = json.loads(结果.get('scope_json', '[]'))
                结果['wuxing_sig'] = json.loads(结果.get('wuxing_json', '{}'))
        else:
            结果['scope'] = json.loads(结果.get('scope_json', '[]'))
            结果['wuxing_sig'] = json.loads(结果.get('wuxing_json', '{}'))

        # 移除内部字段
        结果.pop('encrypted_payload', None)
        结果.pop('scope_json', None)
        结果.pop('wuxing_json', None)

        return 结果

    def _记录日志(自身, 令牌ID: str, 动作: str, 结果: str, 平台: str = "系统"):
        """🔴 记录访问日志 | Log access"""
        try:
            现在 = datetime.now().isoformat()
            with sqlite3.connect(自身.数据库路径) as 连接:
                游标 = 连接.cursor()
                游标.execute('''
                    INSERT INTO 访问日志 (token_id, action, timestamp, platform, result)
                    VALUES (?, ?, ?, ?, ?)
                ''', (令牌ID, 动作, 现在, 平台, 结果))
                连接.commit()
        except Exception:
            pass  # 日志记录失败不影响主流程

    # ═══════════════════════════════════════════════════════════════
    # 统计与维护 | Statistics and Maintenance
    # ═══════════════════════════════════════════════════════════════

    def 获取统计(自身) -> Dict[str, Any]:
        """🟡 获取令牌库统计 | Get storage statistics"""
        with sqlite3.connect(自身.数据库路径) as 连接:
            游标 = 连接.cursor()

            游标.execute("SELECT COUNT(*) FROM 令牌表")
            总数 = 游标.fetchone()[0]

            游标.execute("SELECT COUNT(*) FROM 令牌表 WHERE status = '有效'")
            有效数 = 游标.fetchone()[0]

            游标.execute("SELECT COUNT(*) FROM 令牌表 WHERE status = '已撤销'")
            撤销数 = 游标.fetchone()[0]

            游标.execute("SELECT COUNT(*) FROM 令牌表 WHERE status = '已过期'")
            过期数 = 游标.fetchone()[0]

            游标.execute("SELECT COUNT(*) FROM 撤销表")
            撤销记录数 = 游标.fetchone()[0]

            现在 = datetime.now().isoformat()
            游标.execute('''
                SELECT COUNT(*) FROM 令牌表
                WHERE status = '有效' AND expiry < ?
            ''', (现在,))
            待清理数 = 游标.fetchone()[0]

            return {
                '总令牌数': 总数,
                '有效令牌': 有效数,
                '已撤销': 撤销数,
                '已过期': 过期数,
                '撤销记录': 撤销记录数,
                '待清理过期': 待清理数
            }

    def 获取日志(自身, 令牌ID: str | None = None, 数量: int = 50) -> List[Dict]:
        """🟡 获取访问日志 | Get access logs"""
        with sqlite3.connect(自身.数据库路径) as 连接:
            连接.row_factory = sqlite3.Row
            游标 = 连接.cursor()

            if 令牌ID:
                游标.execute('''
                    SELECT * FROM 访问日志 WHERE token_id = ?
                    ORDER BY timestamp DESC LIMIT ?
                ''', (令牌ID, 数量))
            else:
                游标.execute('''
                    SELECT * FROM 访问日志
                    ORDER BY timestamp DESC LIMIT ?
                ''', (数量,))

            return [dict(row) for row in 游标.fetchall()]


