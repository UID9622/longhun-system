        claim_003[CNSH开放]:::sovereignty
        claim_004[不归属商业]:::sovereignty
        claim_005[不绑定平台]:::sovereignty
    end

    subgraph GOVERNANCE_A[🛡️ 治理层·A]
        style GOVERNANCE_A fill:#EA580C,stroke:#9A3412,color:#fff
        root_003[普惠原则]:::governanceA
