    fuse_b003 -.->|归档审计| audit_002

    classDef sovereignty fill:#DC2626,stroke:#991B1B,color:#fff
    classDef governanceA fill:#EA580C,stroke:#9A3412,color:#fff
    classDef mechanismA fill:#16A34A,stroke:#166534,color:#fff
    classDef governanceB fill:#2563EB,stroke:#1E40AF,color:#fff
    classDef mechanismB fill:#7C3AED,stroke:#5B21B6,color:#fff
    classDef foundation fill:#4B5563,stroke:#1F2937,color:#fff

    linkStyle default stroke:#6B7280,stroke-width:2px
