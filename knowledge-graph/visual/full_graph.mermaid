        behavior_001[封锁访问]:::governanceA
        behavior_002[技术垄断]:::governanceA
        behavior_003[用户收割]:::governanceA
        behavior_004[语义篡改]:::governanceA
        behavior_005[来源混淆]:::governanceA
        behavior_006[知道不说]:::governanceA
        behavior_007[专利封存]:::governanceA
    end

    subgraph MECHANISM_A[⚙️ 机制层·A]
        style MECHANISM_A fill:#16A34A,stroke:#166534,color:#fff
        root_005[自动熔断机制]:::mechanismA
        mechanism_001[检测违规]:::mechanismA
        mechanism_002[触发熔断]:::mechanismA
