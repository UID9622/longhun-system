    pool_001 --> pool_004
    pool_003 -.->|溢出| pool_004
    reward_004 --> pool_002
    inherit_001 --> inherit_002
    inherit_001 --> inherit_003
    inherit_001 --> inherit_004
    inherit_002 --> inherit_004
    fuse_b001 --> fuse_b002
    fuse_b001 --> fuse_b003
    fuse_b001 --> fuse_b004
    fuse_b002 --> fuse_b003
    fuse_b003 --> fuse_b004

    %% 跨图谱连接（金色虚线）
    audit_003 -.->|🔴触发熔断| fuse_b001
    mechanism_002 -.->|暂停回馈| reward_001
    claim_004 -.->|约束来源| reward_002
    behavior_003 -.->|触发熔断| fuse_b001
    principle_002 -.->|产生DNA| mechanism_003
    fuse_b001 -.->|进入审计| audit_003
    inherit_004 -.->|延续DNA| mechanism_003
    term_010 -.->|使能| principle_001
