        audit_002[🟡警告]:::mechanismA
        audit_003[🔴关闭]:::mechanismA
    end

    subgraph GOVERNANCE_B[🛡️ 治理层·B]
        style GOVERNANCE_B fill:#2563EB,stroke:#1E40AF,color:#fff
        principle_001[取之于民用之于民]:::governanceB
        principle_002[贡献即存档]:::governanceB
        principle_003[回馈不依赖商业利润]:::governanceB
        principle_004[世袭继承]:::governanceB
        principle_005[永不掩盖]:::governanceB
        contrib_001[贡献三维度]:::governanceB
        contrib_002[代码贡献40%]:::governanceB
        contrib_003[协议/文档贡献30%]:::governanceB
