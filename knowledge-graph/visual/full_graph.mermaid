    subgraph MECHANISM_B[⚙️ 机制层·B]
        style MECHANISM_B fill:#7C3AED,stroke:#5B21B6,color:#fff
        reward_001[回馈机制]:::mechanismB
        reward_002[回馈来源]:::mechanismB
        reward_003[资金池分配]:::mechanismB
