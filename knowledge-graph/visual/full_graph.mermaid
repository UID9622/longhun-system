        inherit_003[后代可继承权益]:::foundation
        inherit_004[DNA追溯链可延续]:::foundation
    end

    %% 图谱A内部连接
    root_001 --> term_001
    root_001 --> claim_001
    root_001 --> term_004
    term_001 --> term_002
    term_001 --> term_003
    claim_001 --> term_009
    claim_001 --> term_010
    term_004 --> term_005
    term_004 --> term_006
    term_004 --> term_007
    term_004 --> term_008
    root_002 --> claim_002
    root_002 --> claim_003
    root_002 --> claim_004
    root_002 --> claim_005
    root_003 --> commitment_001
    root_003 --> commitment_002
    root_003 --> commitment_003
    root_003 --> commitment_004
    root_004 --> behavior_001
    root_004 --> behavior_002
    root_004 --> behavior_003
    root_004 --> behavior_004
    root_004 --> behavior_005
    root_004 --> behavior_006
    root_004 --> behavior_007
    root_005 --> mechanism_001
    mechanism_001 --> mechanism_002
    mechanism_002 --> mechanism_003
    mechanism_003 --> audit_003
    root_006 --> audit_001
    root_006 --> audit_002
    root_006 --> audit_003
    audit_002 -.->|30天整改| audit_001
    audit_002 -.->|未整改| audit_003
    mechanism_004 --> mechanism_005

    %% 图谱B内部连接
    principle_001 --> principle_002
    principle_001 --> principle_003
    principle_002 --> principle_004
    principle_003 --> principle_005
    principle_001 --> contrib_001
