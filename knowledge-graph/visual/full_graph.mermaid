graph TD
    subgraph SOVEREIGNTY[⛩️ 主权层]
        style SOVEREIGNTY fill:#DC2626,stroke:#991B1B,color:#fff
        root_001[法律管辖]:::sovereignty
        term_001[专属管辖]:::sovereignty
        term_002[中国法律]:::sovereignty
        term_003[中国法院]:::sovereignty
        term_004[国际法不适用]:::sovereignty
        term_005[排除仲裁]:::sovereignty
